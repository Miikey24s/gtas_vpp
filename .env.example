# ─────────────────────────────────────────────────────────────
# GTAS VPP - local Docker Development environment template
# Copy to .env, generate unique values, and never commit the resulting file.
# Production values live in GitHub Actions secrets, not in this file.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Development uses its own Docker volume, the TestEnv logical environment, and
# the physical database name GTAS_VPP_TEST. Production uses GTAS_VPP_LIVE.
DB_SA_PASSWORD=
MSSQL_MEMORY_LIMIT_MB=2048

# ── JWT Authentication (tối thiểu 32 ký tự) ─────────────────
# Tạo key ngẫu nhiên: openssl rand -base64 48
JWT_KEY=

# ── Optional AI report insights ─────────────────────────────────────────────
# Disabled by default. The backend chooses the first configured provider in
# ReportInsights:ProviderPriority. Never commit a real API key.
REPORT_INSIGHTS_ENABLED=false
# Khi bật AI, thêm đúng provider key cần dùng vào file .env local.

# ── Real account email (production uses a dedicated GitHub secret for password) ─
# DigitalOcean blocks SMTP 25/465/587. Resend supports STARTTLS on 2587.
EMAIL_NOTIFICATIONS_ENABLED=false
PUBLIC_BASE_URL=https://gtas-vpp.annam.id.vn
EMAIL_FROM_ADDRESS=noreply@notify.annam.id.vn
EMAIL_FROM_DISPLAY_NAME=GTAS VPP
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=2587
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USERNAME=resend
EMAIL_SMTP_PASSWORD=
