# ─────────────────────────────────────────────────────────────
# GTAS VPP – Environment Configuration (VPS Live Demo)
# Copy to .env and fill in production values:  cp .env.example .env
# Domain: gtas-vpp.annam.id.vn
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Database name: GTAS_VPP_LIVE (cả TestEnv + LiveEnv trỏ cùng DB này)
# Ollama chạy ở PC qua tunnel nên có thể dành nhiều RAM VPS hơn cho SQL Server.
DB_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_MEMORY_LIMIT_MB=4096

# ── JWT Authentication (tối thiểu 32 ký tự) ─────────────────
# Tạo key ngẫu nhiên: openssl rand -base64 48
JWT_KEY=CHANGE_THIS_TO_A_STRONG_PRODUCTION_KEY_MIN_32_CHARS

# ─────────────────────────────────────────────────────────────
# AI CONFIGURATION
# ─────────────────────────────────────────────────────────────
#
# DigitalOcean chỉ chạy GTAS VPP app + database.
# Backend luôn gọi Ollama qua domain public đã được Nginx/FRP route sẵn.
# Không dùng localhost / host.docker.internal / 100.x.x.x trong production code.
# ─────────────────────────────────────────────────────────────

# Không cần Google / Gemini API key nữa.
AI_PROVIDER=Ollama
AI_CHAT_MODEL=gemma4:e4b
AI_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama.annam.id.vn

# ── AI General ───────────────────────────────────────────────
AI_TIMEOUT_SECONDS=60
