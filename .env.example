# ─────────────────────────────────────────────────────────────
# GTAS VPP - local Docker Development environment template
# Copy to .env, generate unique values, and never commit the resulting file.
# Production values live in GitHub Actions secrets, not in this file.
# ─────────────────────────────────────────────────────────────

# ── Radzen Blazor MCP ────────────────────────────────────────
# Get free trial (50 requests/15 days): https://www.radzen.com/blazor-mcp/documentation/get-your-key
RADZEN_API_KEY=

# ── Database ─────────────────────────────────────────────────
# Development uses its own Docker volume and the TestEnv logical environment.
# The database name matches production for migration compatibility, but the
# physical SQL Server instance and data are separate.
DB_SA_PASSWORD=
MSSQL_MEMORY_LIMIT_MB=2048

# ── JWT Authentication (tối thiểu 32 ký tự) ─────────────────
# Tạo key ngẫu nhiên: openssl rand -base64 48
JWT_KEY=

# ── TripleDES password encryption (legacy compat) ───────────
# Với database local mới có thể tạo key ngẫu nhiên. Với database đã có dữ liệu,
# key bắt buộc phải khớp giá trị dùng cho tblUsers.PasswordChar trong GTAS_MENU.
PASSWORD_ENCRYPTION_KEY=

# ── Optional AI report insights ─────────────────────────────────────────────
# Disabled by default. Never commit a real API key.
REPORT_INSIGHTS_ENABLED=false
OPENAI_API_KEY=
