<div class="dna-stimulus @CssClasses" role="img" aria-label="@AccessibleDescription()">
    @if (Spec.Context == "login")
    {
        <div class="dna-preview-login">
            <div class="dna-preview-visual">
                <div class="dna-preview-media" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="dna-preview-thread"></div>
                <div class="dna-preview-map-shape"></div>
                <div class="dna-preview-fabric-card"></div>
                @if (Spec.Imagery == "photo")
                {
                    <div class="dna-preview-photo-label">FACTORY / PEOPLE / QUALITY</div>
                }
                else if (Spec.Imagery == "illustration")
                {
                    <div class="dna-preview-illustration-label">THREADLINE / VIETNAM</div>
                }
            </div>
            <div class="dna-preview-login-form">
                <span class="dna-preview-eyebrow">GTAS VPP</span>
                <div class="dna-preview-display">Đăng nhập</div>
                <div class="dna-preview-field"><span>Tên đăng nhập</span></div>
                <div class="dna-preview-field"><span>Mật khẩu</span></div>
                <div class="dna-preview-primary">Tiếp tục</div>
                <div class="dna-preview-caption">Together, work moves forward.</div>
            </div>
        </div>
    }
    else
    {
        <div class="dna-preview-shell">
            <aside class="dna-preview-sidebar">
                <div class="dna-preview-mark">V</div>
                <div class="dna-preview-nav active"><i></i>@Label("Tổng quan")</div>
                <div class="dna-preview-nav"><i></i>@Label("Đơn hàng")</div>
                <div class="dna-preview-nav"><i></i>@Label("Danh mục")</div>
                <div class="dna-preview-nav"><i></i>@Label("Báo cáo")</div>
            </aside>
            <section class="dna-preview-workspace">
                <header class="dna-preview-header">
                    <div>
                        <span class="dna-preview-eyebrow">OPERATIONS / 2026</span>
                        <div class="dna-preview-title">@TitleForContext()</div>
                    </div>
                    <div class="dna-preview-header-visual" aria-hidden="true">
                        <div class="dna-preview-media"><i></i><i></i><i></i></div>
                        <div class="dna-preview-avatar"></div>
                    </div>
                </header>

                <div class="dna-preview-disclosure" aria-hidden="true">
                    <span>Ưu tiên</span><span>Chi tiết</span><span>Lịch sử</span>
                </div>

                @if (Spec.Context == "form")
                {
                    <div class="dna-preview-steps"><b>01</b><i></i><b>02</b><i></i><b>03</b></div>
                    <div class="dna-preview-form-grid">
                        <div class="dna-preview-panel">
                            <div class="dna-preview-section-title">Thông tin yêu cầu</div>
                            <div class="dna-preview-field"><span>Đơn vị</span></div>
                            <div class="dna-preview-field"><span>Thời gian cần</span></div>
                            <div class="dna-preview-field tall"><span>Ghi chú</span></div>
                        </div>
                        <div class="dna-preview-panel emphasis">
                            <div class="dna-preview-section-title">Tóm tắt</div>
                            <div class="dna-preview-summary-line"></div>
                            <div class="dna-preview-summary-line short"></div>
                            <div class="dna-preview-primary">Tiếp tục</div>
                        </div>
                    </div>
                }
                else if (Spec.Context == "datagrid")
                {
                    <div class="dna-preview-toolbar">
                        <div class="dna-preview-search">Tìm vật tư...</div>
                        <div class="dna-preview-secondary">Bộ lọc</div>
                        <div class="dna-preview-primary compact">Thêm mới</div>
                    </div>
                    <div class="dna-preview-table">
                        <div class="dna-preview-row header"><span>Mã</span><span>Tên vật tư</span><span>Nhóm</span><span>Trạng thái</span></div>
                        @for (var index = 0; index < 4; index++)
                        {
                            <div class="dna-preview-row"><span>VP-0@(index + 1)</span><span>Vật tư văn phòng @(index + 1)</span><span>Thiết yếu</span><span><b class="dna-preview-status">Sẵn sàng</b></span></div>
                        }
                    </div>
                }
                else
                {
                    <div class="dna-preview-kpis">
                        <div class="dna-preview-kpi featured"><span>Đơn đang xử lý</span><strong>24</strong><small>+8.2%</small></div>
                        <div class="dna-preview-kpi"><span>Chờ phê duyệt</span><strong>07</strong><small>Trong hôm nay</small></div>
                        <div class="dna-preview-kpi"><span>Đúng hạn</span><strong>96%</strong><small>Right first time</small></div>
                    </div>
                    <div class="dna-preview-dashboard-grid">
                        <div class="dna-preview-panel chart-panel">
                            <div class="dna-preview-section-title">Nhịp vận hành</div>
                            <div class="dna-preview-chart">
                                <i style="--bar: 34%"></i><i style="--bar: 58%"></i><i style="--bar: 42%"></i><i style="--bar: 78%"></i><i style="--bar: 66%"></i><i style="--bar: 90%"></i>
                            </div>
                        </div>
                        <div class="dna-preview-panel activity-panel">
                            <div class="dna-preview-section-title">Dòng công việc</div>
                            <div class="dna-preview-timeline"><i></i><span>Yêu cầu được tạo</span></div>
                            <div class="dna-preview-timeline"><i></i><span>Phòng ban phê duyệt</span></div>
                            <div class="dna-preview-timeline"><i></i><span>Đang cấp phát</span></div>
                        </div>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public StimulusPreviewSpec Spec { get; set; } = null!;

    private string CssClasses => string.Join(' ', new[]
    {
        $"dna-palette-{Spec.Palette}",
        $"dna-accent-{Spec.Accent}",
        $"dna-surface-{Spec.Surface}",
        $"dna-layout-{Spec.Layout}",
        $"dna-radius-{Spec.Radius}",
        $"dna-density-{Spec.Density}",
        $"dna-type-{Spec.Typography}",
        $"dna-texture-{Spec.Texture}",
        $"dna-elevation-{Spec.Elevation}",
        $"dna-imagery-{Spec.Imagery}",
        $"dna-motion-{Spec.Motion}",
        $"dna-disclosure-{Spec.Disclosure}",
        $"dna-expression-{Spec.ExpressionLevel}"
    });

    private string Label(string value) => Spec.LabelMode == "icons" ? string.Empty : value;

    private string TitleForContext() => Spec.Context switch
    {
        "datagrid" => "Thư viện vật tư",
        "form" => "Tạo yêu cầu mới",
        _ => "Không gian vận hành"
    };

    private string AccessibleDescription() => string.Join(", ", new[]
    {
        $"Bản xem trước {ContextLabel()}",
        SurfaceLabel(),
        LayoutLabel(),
        DensityLabel(),
        TypographyLabel(),
        ImageryLabel(),
        DisclosureLabel()
    });

    private string ContextLabel() => Spec.Context switch
    {
        "login" => "màn hình đăng nhập",
        "form" => "biểu mẫu",
        "datagrid" => "bảng dữ liệu",
        _ => "bảng điều hành"
    };

    private string SurfaceLabel() => Spec.Surface switch
    {
        "dark" => "nền tối",
        "canvas" => "nền giấy ấm",
        _ => "nền sáng"
    };

    private string LayoutLabel() => Spec.Layout switch
    {
        "bento" => "bố cục bento",
        "organic" => "bố cục hữu cơ",
        "symmetric" => "bố cục đối xứng",
        "split" => "bố cục chia đôi",
        _ => "bố cục lưới"
    };

    private string DensityLabel() => Spec.Density switch
    {
        "dense" => "mật độ dày",
        "spacious" => "mật độ thoáng",
        _ => "mật độ cân bằng"
    };

    private string TypographyLabel() => Spec.Typography == "editorial"
        ? "chữ biên tập nổi bật"
        : "chữ trung tính rõ ràng";

    private string ImageryLabel() => Spec.Imagery switch
    {
        "photo" => "hình ảnh nhiếp ảnh",
        "illustration" => "hình minh họa",
        "literal" => "hình ảnh vật thể",
        "none" => "không dùng hình ảnh",
        _ => "hình ảnh trừu tượng"
    };

    private string DisclosureLabel() => Spec.Disclosure == "progressive"
        ? "chi tiết mở dần theo nhu cầu"
        : "thông tin hiển thị đầy đủ";
}
