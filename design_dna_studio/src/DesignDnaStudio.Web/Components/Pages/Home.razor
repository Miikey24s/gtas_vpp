@page "/"
@inject AssessmentService AssessmentService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>DesignDNA Studio</PageTitle>

@if (isLoading)
{
    <div class="dna-page-loading" role="status">
        <span class="dna-loader"></span>
        <p>Đang chuẩn bị phòng nghiên cứu...</p>
    </div>
}
else if (study is null)
{
    <section class="dna-state-panel error">
        <h1>Không thể khởi tạo DesignDNA Studio</h1>
        <p>@loadError</p>
        <RadzenButton Text="Thử lại" Click="LoadAsync" ButtonStyle="ButtonStyle.Primary" />
    </section>
}
else
{
    <section class="dna-hero">
        <div class="dna-hero-copy">
            <span class="dna-kicker">PERSONAL × BRAND × PRODUCT</span>
            <h1>Biến gu cảm tính thành<br /><em>design system có bằng chứng.</em></h1>
            <p>DesignDNA Studio học từ lựa chọn trực quan, kiểm tra mâu thuẫn và tạo hồ sơ thiết kế giải thích được cho GTAS VPP.</p>

            <div class="dna-method-pills" aria-label="Các thành phần nghiên cứu">
                <span>28 trục thiết kế</span>
                <span>Adaptive comparison</span>
                <span>Hidden consistency</span>
                <span>Local-first</span>
            </div>
        </div>

        <div class="dna-start-card">
            <div class="dna-start-card-head">
                <span>PHIÊN KHẢO SÁT MỚI</span>
                <strong>@EstimatedTime</strong>
            </div>
            <h2>Bắt đầu từ phản ứng thật</h2>
            <p>Bạn chỉ cần nhìn hai phương án và chọn bên mình nghiêng về. Không cần biết thuật ngữ thiết kế.</p>

            <RadzenTemplateForm TItem="StartModel" Data="startModel" Submit="StartAsync" class="dna-start-form">
                @if (participants.Count > 0)
                {
                    <label class="dna-owner-field" for="ParticipantId">
                        <span>Hồ sơ người tham gia</span>
                        <select id="ParticipantId" value="@startModel.ParticipantId" @onchange="SelectParticipant">
                            <option value="">Tạo hồ sơ mới</option>
                            @foreach (var participant in participants)
                            {
                                <option value="@participant.Id">@participant.DisplayName · @participant.CompletedProfileCount bản đã chốt</option>
                            }
                        </select>
                    </label>
                }

                <RadzenFormField Text="Tên hiển thị" Variant="Variant.Outlined">
                    <RadzenTextBox Name="DisplayName" @bind-Value="startModel.DisplayName" Placeholder="Nguyễn An Nam" MaxLength="120" aria-label="Tên hiển thị" autocomplete="name" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="DisplayName" Text="Nhập tên để lưu và tiếp tục phiên khảo sát." Popup="false" />

                <div class="dna-depth-field">
                    <span>Độ sâu khảo sát</span>
                    <div class="dna-depth-options" role="radiogroup" aria-label="Độ sâu khảo sát">
                        @foreach (var (option, index) in DepthOptions.Select((option, index) => (option, index)))
                        {
                            <button type="button"
                                    class="@(startModel.TargetComparisons == option.Comparisons ? "active" : string.Empty)"
                                    role="radio"
                                    aria-checked="@(startModel.TargetComparisons == option.Comparisons ? "true" : "false")"
                                    aria-posinset="@(index + 1)"
                                    aria-setsize="@DepthOptions.Length"
                                    @onkeydown="args => HandleDepthKeyDown(args, index)"
                                    @onclick="() => startModel.TargetComparisons = option.Comparisons">
                                <strong>@option.Label</strong>
                                <small>@option.Comparisons câu · @option.Note</small>
                            </button>
                        }
                    </div>
                </div>

                <RadzenButton Text="Khởi động Design DNA" Icon="arrow_forward" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="isStarting" Disabled="isStarting" class="dna-start-button" />
            </RadzenTemplateForm>

            <small>Dữ liệu được lưu tại máy này. AI remote không được gọi trong khảo sát lõi.</small>
        </div>

        <div class="dna-hero-thread" aria-hidden="true"><i></i><i></i><i></i></div>
    </section>

    <section class="dna-overview-grid" id="method">
        <article class="dna-overview-card featured">
            <span class="dna-card-index">01</span>
            <h2>Hiệu chuẩn có kiểm soát</h2>
            <p>Giữ nguyên nội dung, chỉ đổi màu, hình khối, typography, mật độ hoặc chất liệu để tìm đúng nguyên nhân bạn thích.</p>
        </article>
        <article class="dna-overview-card">
            <span class="dna-card-index">02</span>
            <h2>Học thích nghi</h2>
            <p>Engine chọn câu tiếp theo theo vùng chưa chắc chắn, độ phủ và sự đa dạng; không bắt trả lời mọi tổ hợp.</p>
        </article>
        <article class="dna-overview-card">
            <span class="dna-card-index">03</span>
            <h2>Hồ sơ có bằng chứng</h2>
            <p>Kết quả chứa trọng số, độ tin cậy, độ nhất quán và bằng chứng — không có chỉ số “Gen Z 87%” thiếu căn cứ.</p>
        </article>
    </section>

    <section class="dna-section" id="assessments">
        <div class="dna-section-heading">
            <div>
                <span class="dna-kicker">SESSION HISTORY</span>
                <h2>Phiên gần đây</h2>
            </div>
            <span>@study.StimulusCount stimuli · @study.MinimumComparisons–@study.MaximumComparisons comparisons</span>
        </div>

        @if (recentAssessments.Count == 0)
        {
            <div class="dna-empty-state">
                <span class="material-symbols-outlined">gesture</span>
                <h3>Chưa có Personal Design DNA</h3>
                <p>Phiên đầu tiên sẽ tạo baseline để so sánh các art direction sau này.</p>
            </div>
        }
        else
        {
            <div class="dna-session-list">
                @foreach (var item in recentAssessments)
                {
                    <a href="@SessionLink(item)" class="dna-session-row">
                        <span class="dna-session-avatar">@Initials(item.ParticipantName)</span>
                        <span><strong>@item.ParticipantName</strong><small>@StatusText(item.Status) · @item.LastActivityAt.LocalDateTime.ToString("dd/MM HH:mm")</small></span>
                        <span class="dna-session-progress"><i style="width:@Progress(item)%"></i></span>
                        <b>@item.AnswerCount/@item.TargetComparisons</b>
                        <span class="material-symbols-outlined">arrow_outward</span>
                    </a>
                }
            </div>
        }
    </section>
}

@code {
    private readonly StartModel startModel = new();
    private StudySummary? study;
    private IReadOnlyList<RecentAssessment> recentAssessments = [];
    private IReadOnlyList<ParticipantSummary> participants = [];
    private bool isLoading = true;
    private bool isStarting;
    private string loadError = string.Empty;
    private static readonly DepthOption[] DepthOptions =
    [
        new("Nhanh", 30, "đường cơ sở"),
        new("Chuẩn", 40, "khuyến nghị"),
        new("Sâu", 60, "độ phủ cao")
    ];

    private string EstimatedTime => startModel.TargetComparisons switch
    {
        <= 30 => "10–12 phút",
        >= 60 => "18–25 phút",
        _ => "12–18 phút"
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = string.Empty;
        try
        {
            study = await AssessmentService.GetBuiltInStudyAsync();
            recentAssessments = await AssessmentService.GetRecentAssessmentsAsync();
            participants = await AssessmentService.GetParticipantsAsync();
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
            study = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartAsync(StartModel model)
    {
        if (isStarting)
        {
            return;
        }

        isStarting = true;
        try
        {
            var result = await AssessmentService.StartAsync(model.DisplayName, model.TargetComparisons, model.ParticipantId);
            Navigation.NavigateTo($"/assessment/{result.SessionId}");
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Không thể bắt đầu", exception.Message, 6000);
        }
        finally
        {
            isStarting = false;
        }
    }

    private static string SessionLink(RecentAssessment item) => item.Status == AssessmentStatus.Completed
        ? $"/assessment/{item.SessionId}/results"
        : $"/assessment/{item.SessionId}";

    private static double Progress(RecentAssessment item) => item.TargetComparisons == 0
        ? 0d
        : Math.Clamp((double)item.AnswerCount / item.TargetComparisons * 100d, 0d, 100d);

    private static string StatusText(AssessmentStatus status) => status switch
    {
        AssessmentStatus.Completed => "Đã hoàn thành",
        AssessmentStatus.InProgress => "Đang thực hiện",
        AssessmentStatus.Abandoned => "Đã dừng",
        _ => "Chưa bắt đầu"
    };

    private static string Initials(string value) => string.Concat(value
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .TakeLast(2)
        .Select(item => char.ToUpperInvariant(item[0])));

    private void SelectParticipant(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var participantId))
        {
            startModel.ParticipantId = null;
            return;
        }

        startModel.ParticipantId = participantId;
        var participant = participants.First(item => item.Id == participantId);
        startModel.DisplayName = participant.DisplayName;
    }

    private void HandleDepthKeyDown(KeyboardEventArgs args, int index)
    {
        var delta = args.Key switch
        {
            "ArrowLeft" or "ArrowUp" => -1,
            "ArrowRight" or "ArrowDown" => 1,
            _ => 0
        };
        if (delta == 0)
        {
            return;
        }

        var nextIndex = Math.Clamp(index + delta, 0, DepthOptions.Length - 1);
        startModel.TargetComparisons = DepthOptions[nextIndex].Comparisons;
    }

    private sealed class StartModel
    {
        public string DisplayName { get; set; } = "Nam";

        public int TargetComparisons { get; set; } = 40;

        public Guid? ParticipantId { get; set; }
    }

    private sealed record DepthOption(string Label, int Comparisons, string Note);
}
