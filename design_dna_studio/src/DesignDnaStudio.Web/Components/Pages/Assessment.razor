@page "/assessment/{SessionId:guid}"
@layout SurveyLayout
@inject AssessmentService AssessmentService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<PageTitle>Khảo sát Personal Design DNA</PageTitle>

<div class="dna-assessment-page" tabindex="0" @ref="pageRoot" @onkeydown="HandleKeyDown">
    @if (isLoading)
    {
        <div class="dna-page-loading neutral" role="status">
            <span class="dna-loader"></span>
            <p>Đang chọn cặp so sánh có giá trị thông tin cao nhất...</p>
        </div>
    }
    else if (prompt is null)
    {
        <div class="dna-state-panel error">
            <h1>Không thể tiếp tục phiên khảo sát</h1>
            <p>@errorMessage</p>
            <RadzenButton Text="Về DesignDNA Studio" Click="GoHome" />
        </div>
    }
    else
    {
        <header class="dna-assessment-header">
            <a href="/" class="dna-neutral-brand" aria-label="Thoát về DesignDNA Studio">
                <span></span> DesignDNA
            </a>
            <div class="dna-assessment-progress-block">
                <div><span>@PhaseText(prompt.Phase)</span><strong>@(prompt.AnswerCount + 1) / @prompt.TargetComparisons</strong></div>
                <div class="dna-assessment-progress"><i style="width:@ProgressPercent%"></i></div>
            </div>
            <button type="button" class="dna-text-button" @onclick="ToggleHelp">Hướng dẫn</button>
        </header>

        @if (showHelp)
        {
            <aside class="dna-survey-help">
                <strong>Đừng phân tích quá lâu.</strong>
                <span>Chọn phương án bạn muốn nhìn và sử dụng hằng ngày hơn. “Ngang nhau” khác với “không thể đánh giá”. Có thể dùng phím 1–5.</span>
                <button type="button" @onclick="ToggleHelp" aria-label="Đóng hướng dẫn">×</button>
            </aside>
        }

        <main class="dna-assessment-main">
            <div class="dna-assessment-question">
                <span>PHẢN ỨNG ĐẦU TIÊN</span>
                <h1>Phương án nào gần với gu của bạn hơn?</h1>
                <p>Nội dung được giữ tương đương; hãy tập trung vào cảm giác thị giác và cách tổ chức giao diện.</p>
            </div>

            <div class="dna-comparison-stage" aria-busy="@(isSubmitting ? "true" : "false")">
                <article class="dna-option-card left">
                    <span class="dna-option-label">A</span>
                    <StimulusPreview Spec="prompt.Left.Spec" />
                </article>

                <div class="dna-versus" aria-hidden="true">VS</div>

                <article class="dna-option-card right">
                    <span class="dna-option-label">B</span>
                    <StimulusPreview Spec="prompt.Right.Spec" />
                </article>
            </div>

            <section class="dna-response-panel" aria-label="Mức độ yêu thích">
                <button type="button" class="dna-choice strong left" aria-keyshortcuts="1" disabled="@isSubmitting" @onclick="() => SubmitRatingAsync(PreferenceRating.StrongLeft)">
                    <span class="material-symbols-outlined">keyboard_double_arrow_left</span><b>A rõ ràng hơn</b><small>Phím 1</small>
                </button>
                <button type="button" class="dna-choice left" aria-keyshortcuts="2" disabled="@isSubmitting" @onclick="() => SubmitRatingAsync(PreferenceRating.SlightLeft)">
                    <span class="material-symbols-outlined">chevron_left</span><b>A hơi hơn</b><small>Phím 2</small>
                </button>
                <button type="button" class="dna-choice tie" aria-keyshortcuts="3" disabled="@isSubmitting" @onclick="ShowTieReasons">
                    <span class="material-symbols-outlined">balance</span><b>Ngang nhau</b><small>Phím 3</small>
                </button>
                <button type="button" class="dna-choice right" aria-keyshortcuts="4" disabled="@isSubmitting" @onclick="() => SubmitRatingAsync(PreferenceRating.SlightRight)">
                    <span class="material-symbols-outlined">chevron_right</span><b>B hơi hơn</b><small>Phím 4</small>
                </button>
                <button type="button" class="dna-choice strong right" aria-keyshortcuts="5" disabled="@isSubmitting" @onclick="() => SubmitRatingAsync(PreferenceRating.StrongRight)">
                    <span class="material-symbols-outlined">keyboard_double_arrow_right</span><b>B rõ ràng hơn</b><small>Phím 5</small>
                </button>
            </section>

            @if (showTieReasonOptions)
            {
                <div class="dna-reason-popover" role="group" aria-label="Lý do chọn ngang nhau">
                    <span>“Ngang nhau” theo nghĩa nào?</span>
                    <button type="button" @onclick="() => SubmitRatingAsync(PreferenceRating.Tie, TieReason.BothLiked)">Đều thích</button>
                    <button type="button" @onclick="() => SubmitRatingAsync(PreferenceRating.Tie, TieReason.BothDisliked)">Đều không thích</button>
                    <button type="button" @onclick="() => SubmitRatingAsync(PreferenceRating.Tie, TieReason.NoVisibleDifference)">Khó thấy khác biệt</button>
                    <button type="button" @onclick="() => SubmitRatingAsync(PreferenceRating.Tie, TieReason.ContextDependent)">Phụ thuộc ngữ cảnh</button>
                </div>
            }

            <div class="dna-skip-area">
                <button type="button" class="dna-text-button" @onclick="ToggleSkipReasons">Không thể đánh giá cặp này</button>
                @if (showSkipReasonOptions)
                {
                    <div class="dna-skip-options">
                        <button type="button" @onclick="() => SkipAsync(SkipReason.NotRelevant)">Không liên quan đến tôi</button>
                        <button type="button" @onclick="() => SkipAsync(SkipReason.CannotEvaluate)">Chưa đủ cơ sở đánh giá</button>
                        <button type="button" @onclick="() => SkipAsync(SkipReason.StimulusProblem)">Hình hiển thị có vấn đề</button>
                    </div>
                }
                <small>Bỏ qua không được tính vào tiến độ hoặc dùng để huấn luyện hồ sơ.</small>
            </div>
        </main>
    }
</div>

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private ComparisonPrompt? prompt;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showHelp;
    private bool showTieReasonOptions;
    private bool showSkipReasonOptions;
    private string errorMessage = string.Empty;
    private ElementReference pageRoot;
    private bool shouldFocusRoot;

    private double ProgressPercent => prompt is null || prompt.TargetComparisons == 0
        ? 0d
        : Math.Clamp((double)prompt.AnswerCount / prompt.TargetComparisons * 100d, 0d, 100d);

    protected override Task OnParametersSetAsync() => LoadPromptAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusRoot)
        {
            shouldFocusRoot = false;
            await pageRoot.FocusAsync(preventScroll: true);
        }
    }

    private async Task LoadPromptAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            prompt = await AssessmentService.GetPromptAsync(SessionId);
            if (prompt is null)
            {
                var result = await AssessmentService.GetResultAsync(SessionId);
                if (result is not null && result.AnswerCount > 0)
                {
                    Navigation.NavigateTo($"/assessment/{SessionId}/results", replace: true);
                    return;
                }

                errorMessage = "Phiên không tồn tại, đã hoàn thành hoặc không còn stimulus hợp lệ.";
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            prompt = null;
        }
        finally
        {
            isLoading = false;
            shouldFocusRoot = prompt is not null;
        }
    }

    private async Task SubmitRatingAsync(PreferenceRating rating, TieReason tieReason = TieReason.None)
    {
        await SubmitAsync(rating, tieReason, SkipReason.None);
    }

    private async Task SkipAsync(SkipReason skipReason)
    {
        await SubmitAsync(null, TieReason.None, skipReason);
    }

    private async Task SubmitAsync(PreferenceRating? rating, TieReason tieReason, SkipReason skipReason)
    {
        if (prompt is null || isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        showTieReasonOptions = false;
        showSkipReasonOptions = false;
        try
        {
            var elapsed = DateTimeOffset.UtcNow - prompt.PresentedAt;
            var accepted = await AssessmentService.SubmitAsync(new ComparisonSubmission(
                prompt.SessionId,
                prompt.Sequence,
                prompt.Left.Id,
                prompt.Right.Id,
                rating,
                tieReason,
                skipReason,
                (long)elapsed.TotalMilliseconds));

            if (!accepted)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Phiên đã thay đổi", "Đang tải lại câu hiện tại để tránh ghi trùng.", 3500);
            }

            prompt = await AssessmentService.GetPromptAsync(SessionId);
            if (prompt is null)
            {
                var result = await AssessmentService.GetResultAsync(SessionId);
                if (result is not null)
                {
                    Navigation.NavigateTo($"/assessment/{SessionId}/results");
                }
                else
                {
                    errorMessage = "Phiên chưa đủ câu trả lời nhưng không còn cặp so sánh hợp lệ. Hãy giữ nguyên dữ liệu và báo lỗi để kiểm tra catalog.";
                }
            }
        }
        catch (Exception exception)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Không lưu được lựa chọn", exception.Message, 6000);
        }
        finally
        {
            isSubmitting = false;
            shouldFocusRoot = prompt is not null;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (isSubmitting || showTieReasonOptions || showSkipReasonOptions)
        {
            return;
        }

        switch (args.Key)
        {
            case "1": await SubmitRatingAsync(PreferenceRating.StrongLeft); break;
            case "2": await SubmitRatingAsync(PreferenceRating.SlightLeft); break;
            case "3": ShowTieReasons(); break;
            case "4": await SubmitRatingAsync(PreferenceRating.SlightRight); break;
            case "5": await SubmitRatingAsync(PreferenceRating.StrongRight); break;
        }
    }

    private void ShowTieReasons()
    {
        showTieReasonOptions = !showTieReasonOptions;
        showSkipReasonOptions = false;
    }

    private void ToggleSkipReasons()
    {
        showSkipReasonOptions = !showSkipReasonOptions;
        showTieReasonOptions = false;
    }

    private void ToggleHelp() => showHelp = !showHelp;

    private void GoHome() => Navigation.NavigateTo("/");

    private static string PhaseText(AssessmentPhase phase) => phase switch
    {
        AssessmentPhase.Calibration => "Hiệu chuẩn thị giác",
        AssessmentPhase.AdaptiveComparison => "Khảo sát thích nghi",
        _ => "Hoàn thành"
    };
}
