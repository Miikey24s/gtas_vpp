@page "/assessment/{SessionId:guid}/results"
@using Markdig
@inject AssessmentService AssessmentService
@inject NavigationManager Navigation

<PageTitle>Kết quả Personal Design DNA</PageTitle>

@if (isLoading)
{
    <div class="dna-page-loading" role="status"><span class="dna-loader"></span><p>Đang tái dựng hồ sơ từ event log...</p></div>
}
else if (result is null)
{
    <section class="dna-state-panel error">
        <h1>Chưa có kết quả</h1>
        <p>@errorMessage</p>
        <RadzenButton Text="Về trang chủ" Click="GoHome" />
    </section>
}
else
{
    <section class="dna-result-hero">
        <div>
            <span class="dna-kicker">PROFILE / @result.MaturityLevel.ToUpperInvariant()</span>
            <h1>Personal Design DNA<br /><em>của @result.ParticipantName</em></h1>
            <p>@MaturityText(result.MaturityLevel)</p>
        </div>
        <div class="dna-result-seal">
            <span>@result.AnswerCount</span>
            <small>lựa chọn<br />đã phân tích</small>
        </div>
    </section>

    <section class="dna-reliability-grid">
        <article><span>Coverage</span><strong>@result.Coverage.ToString("P0")</strong><i><b style="width:@(result.Coverage * 100)%"></b></i><small>Độ phủ 28 trục thiết kế</small></article>
        <article class="@(result.ConsistencyProbeCount < 2 ? "insufficient" : string.Empty)">
            <span>Consistency</span>
            <strong>@(result.ConsistencyProbeCount >= 2 ? result.Consistency.ToString("P0") : "Chưa đủ")</strong>
            <i><b style="width:@(result.ConsistencyProbeCount >= 2 ? result.Consistency * 100 : 0)%"></b></i>
            <small>@(result.ConsistencyProbeCount >= 2 ? $"{result.ConsistencyProbeCount} câu kiểm tra lặp ẩn" : "Cần ít nhất 2 câu kiểm tra lặp ẩn")</small>
        </article>
        <article class="@(result.HasPotentialSideBias ? "warning" : string.Empty)"><span>Position balance</span><strong>@result.LeftSelectionRate.ToString("P0")</strong><i><b style="width:@(result.LeftSelectionRate * 100)%"></b></i><small>@(result.HasPotentialSideBias ? "Có dấu hiệu thiên vị vị trí" : "Không thấy side bias đáng kể")</small></article>
    </section>

    <section class="dna-result-layout">
        <div class="dna-result-main">
            <div class="dna-section-heading compact">
                <div><span class="dna-kicker">PREFERENCE MAP</span><h2>Các trục nổi bật</h2></div>
                <span>Marker càng xa giữa, sở thích càng rõ</span>
            </div>

            @if (StrongestDimensions.Count == 0)
            {
                <div class="dna-empty-state compact">
                    <span class="material-symbols-outlined">balance</span>
                    <h3>Chưa có hướng ưu tiên rõ</h3>
                    <p>Các lựa chọn hiện tại chủ yếu ở vùng trung tính. Design brief sẽ không tự gán một cực dương tùy ý.</p>
                </div>
            }
            else
            {
                <div class="dna-dimension-list">
                    @foreach (var item in StrongestDimensions)
                    {
                        <article class="dna-dimension-row">
                            <div class="dna-dimension-meta">
                                <span>@item.Group</span>
                                <strong>@PreferredPole(item)</strong>
                                <small class="@item.ConfidenceLevel">@ConfidenceText(item.ConfidenceLevel)</small>
                            </div>
                            <div class="dna-dimension-scale">
                                <span>@item.NegativePole</span>
                                <div><i></i><b style="left:@Marker(item.Weight)%"></b></div>
                                <span>@item.PositivePole</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="dna-result-aside">
            <span class="dna-kicker">INTERPRETATION</span>
            <h2>Design brief sơ bộ</h2>
            <div class="dna-narrative">@NarrativeHtml</div>
            <div class="dna-result-note">
                <span class="material-symbols-outlined">verified_user</span>
                <p>Sở thích cá nhân không được phép vượt accessibility, nghiệp vụ hoặc PPJ/GTAS product constraints.</p>
            </div>
        </aside>
    </section>

    <section class="dna-result-actions">
        <RadzenButton Text="Về DesignDNA Studio" Icon="home" Click="GoHome" ButtonStyle="ButtonStyle.Light" />
        <a class="dna-export-button" href="@ExportUrl">
            <span class="material-symbols-outlined">download</span>
            Xuất JSON kèm evidence
        </a>
        <small>Hồ sơ này là đầu vào cho Synthesis Studio và các màn hình Figma tiếp theo.</small>
    </section>
}

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private AssessmentResult? result;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private static readonly MarkdownPipeline NarrativePipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .Build();

    private MarkupString NarrativeHtml => new(Markdown.ToHtml(result?.NarrativeMarkdown ?? string.Empty, NarrativePipeline));
    private string ExportUrl => $"/studio/export/{SessionId}";

    private IReadOnlyList<DimensionResult> StrongestDimensions => result?.Dimensions
        .Where(item => item.Confidence >= 0.12d && Math.Abs(item.Weight) >= 0.05d)
        .OrderByDescending(item => Math.Abs(item.Weight) * Math.Max(0.1d, item.Confidence))
        .Take(12)
        .ToArray() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            result = await AssessmentService.GetResultAsync(SessionId);
            if (result is null)
            {
                errorMessage = "Phiên khảo sát không tồn tại hoặc chưa có dữ liệu.";
            }
        }
        catch (Exception exception)
        {
            result = null;
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static double Marker(double weight) => 50d + Math.Tanh(weight / 2d) * 46d;

    private static string PreferredPole(DimensionResult item) => item.Weight switch
    {
        > 0.05d => item.PositivePole,
        < -0.05d => item.NegativePole,
        _ => "Chưa xác định"
    };

    private static string ConfidenceText(string value) => value switch
    {
        "stable" => "Ổn định",
        "moderate" => "Khá chắc chắn",
        _ => "Đang khám phá"
    };

    private static string MaturityText(string value) => value switch
    {
        "stable" => "Các hướng ưu tiên chính đã đủ ổn định để dùng làm đầu vào cho art direction.",
        "developing" => "Hồ sơ đã có cấu trúc rõ nhưng một số trục vẫn cần kiểm chứng bằng màn hình GTAS thật.",
        "calibrating" => "Dữ liệu hiện tại mới ở giai đoạn hiệu chuẩn, chưa nên khóa phong cách.",
        _ => "Hồ sơ đang khám phá các vùng sở thích ban đầu."
    };

    private void GoHome() => Navigation.NavigateTo("/");
}
