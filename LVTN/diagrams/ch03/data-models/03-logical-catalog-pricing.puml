@startuml
top to bottom direction
skinparam backgroundColor white
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 38
skinparam classAttributeIconSize 0
hide methods

entity "Nhóm danh mục\nLookupCategories" as LookupCategory {
  * Id <<PK>>
  --
  Code
}

entity "Giá trị danh mục\nLookupValues" as LookupValue {
  * Id <<PK>>
  --
  LookupCategoryId <<FK>>
  Code
}

entity "Loại văn phòng phẩm\nVppCategories" as Category {
  * Id <<PK>>
  --
  VppCategoryCode
}

entity "Văn phòng phẩm\nVppItems" as Item {
  * Id <<PK>>
  --
  VppCategoryId <<FK>>
  UomId <<FK>>
  VppCode
}

entity "Nhà cung cấp\nSuppliers" as Supplier {
  * Id <<PK>>
  --
  SupplierName
}

entity "Bảng giá\nPriceLists" as PriceList {
  * Id <<PK>>
  --
  SupplierId <<FK>>
  PriceListCode
  Version
  Status
}

entity "Đơn giá vật tư\nSupplierProductMappings" as PriceItem {
  * Id <<PK>>
  --
  PriceListId <<FK>>
  SupplierId <<FK>>
  VppItemId <<FK>>
  NetPrice
  VatRate
}

LookupCategory ||--o{ LookupValue
LookupValue ||--o{ Item
Category ||--o{ Item
Supplier |o--o{ PriceList
Supplier ||--o{ PriceItem
PriceList ||--o{ PriceItem
Item ||--o{ PriceItem

LookupCategory -[hidden]right- Category
Category -[hidden]right- Supplier
LookupValue -[hidden]right- Item
Item -[hidden]right- PriceList
@enduml
