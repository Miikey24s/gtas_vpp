@startuml
top to bottom direction
skinparam backgroundColor white
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 42
skinparam classAttributeIconSize 0
hide methods

entity "Kỳ yêu cầu\nPeriods" as Period {
  * Id <<PK>>
  --
  Year
  Month
  State
}

entity "Kết quả chốt kỳ\nSettlements" as Settlement {
  * Id <<PK>>
  --
  PeriodId <<FK>>
  SupersedesSettlementId <<FK>>
  RevisionNumber
  IsCurrentRevision
  GrandTotal
}

entity "Dòng kết quả\nSettlementItems" as Item {
  * Id <<PK>>
  --
  SettlementId <<FK>>
  VppId
  Quantity
  NetUnitPrice
}

entity "Chi phí\nSettlementCharges" as Charge {
  * Id <<PK>>
  --
  SettlementId <<FK>>
  ChargeType
  Amount
}

entity "Dữ liệu phân bổ\nSettlementAllocations" as Allocation {
  * Id <<PK>>
  --
  SettlementId <<FK>>
  SettlementItemId <<FK>>
  RequestDetailId <<FK>>
  DepartmentCode
  GrossAmount
}

Period ||--o{ Settlement
Settlement |o--o{ Settlement
Settlement ||--o{ Item
Settlement ||--o{ Charge
Settlement ||--o{ Allocation
Item ||--o{ Allocation

Item -[hidden]right- Charge
Charge -[hidden]right- Allocation
@enduml
