@startuml
top to bottom direction
skinparam backgroundColor white
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 36
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide methods

package "Bảng Identity" {
  entity "Tài khoản\nAspNetUsers" as User {
    * Id <<PK>>
    --
    UserName
    AccountStatus
  }
  entity "Thông tin claim\nAspNetUserClaims" as Claims {
    * Id <<PK>>
    --
    UserId <<FK>>
  }
  entity "Đăng nhập ngoài\nAspNetUserLogins" as Logins {
    * LoginProvider <<PK>>
    * ProviderKey <<PK>>
    --
    UserId <<FK>>
  }
  entity "Mã xác thực\nAspNetUserTokens" as Tokens {
    * UserId <<PK, FK>>
    * LoginProvider <<PK>>
    * Name <<PK>>
  }
}

package "Đối tượng chỉ đọc" {
  entity "Người dùng tổng hợp\nv_Users" as UsersView <<view, keyless>>
  entity "Thông tin công ty\nv_WFXCompany" as CompanyView <<view, keyless>>
}

package "Bảng kỹ thuật độc lập" {
  entity "Nhật ký bảo mật\nSecurityAudits" as Audit
  entity "Thông báo\nNotifications" as Notification
  entity "Hàng đợi gửi thư\nEmailOutboxMessages" as Outbox
}

User ||--o{ Claims
User ||--o{ Logins
User ||--o{ Tokens
Claims -[hidden]right- Logins
Logins -[hidden]right- Tokens
UsersView -[hidden]right- CompanyView
Audit -[hidden]right- Notification
Notification -[hidden]right- Outbox
User -[hidden]down- UsersView
UsersView -[hidden]down- Notification

legend bottom
  View chỉ đọc và bảng kỹ thuật không tạo quan hệ khóa ngoại với nhóm Identity.
endlegend
@enduml
