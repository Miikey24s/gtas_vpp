@startuml
top to bottom direction
skinparam backgroundColor white
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 36
skinparam classAttributeIconSize 0
hide methods

entity "Tài khoản\nAspNetUsers" as User {
  * Id <<PK>>
  --
  UserName
  AccountStatus
}

entity "Phòng ban\nDepartments" as Department {
  * Id <<PK>>
  --
  ParentDepartmentId <<FK>>
  Code
}

entity "Phân công người dùng\nUserGroupMemberships" as Membership {
  * Id <<PK>>
  --
  AccountId <<FK>>
  DepartmentId <<FK>>
  PermissionGroupId <<FK>>
}

entity "Nhóm quyền\nPermissionGroups" as Group {
  * Id <<PK>>
  --
  GroupCode
  ParentGroupId
}

entity "Trang chức năng\nPermissionPages" as Page {
  * Id <<PK>>
  --
  PageCode
}

entity "Thành phần thao tác\nPermissionComponents" as Component {
  * Id <<PK>>
  --
  ComponentCode
}

entity "Ánh xạ trang - thao tác\nPageComponentMappings" as PageMap {
  * Id <<PK>>
  --
  PermissionPageId <<FK>>
  PermissionComponentId <<FK>>
}

entity "Quyền của nhóm\nGroupPageComponentMappings" as GroupMap {
  * PermissionGroupId <<PK, FK>>
  * PageComponentMappingId <<PK, FK>>
  --
  IsVisible
  IsEnable
}

User ||--o{ Membership
Department ||--o{ Membership
Group ||--o{ Membership
Page ||--o{ PageMap
Component ||--o{ PageMap
PageMap ||--o{ GroupMap
Group ||--o{ GroupMap
Department |o--o{ Department

User -[hidden]right- Department
Department -[hidden]right- Group
Page -[hidden]right- Component
Membership -[hidden]down- PageMap
@enduml
