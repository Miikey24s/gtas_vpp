@startuml
top to bottom direction
skinparam backgroundColor white
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 42
skinparam classAttributeIconSize 0
hide methods

entity "Kỳ yêu cầu\nPeriods" as Period {
  * Id <<PK>>
  --
  Year
  Month
  State
}

entity "Đơn yêu cầu\nRequests" as Request {
  * Id <<PK>>
  --
  PeriodId <<FK>>
  RequestSeriesId
  RevisionNumber
  IsCurrentRevision
  IsAdditionalOrder
  Status
}

entity "Chi tiết đơn\nRequestDetails" as Detail {
  * Id <<PK>>
  --
  RequestId <<FK>>
  VppId <<FK>>
  Qty
}

entity "Nhật ký đơn\nRequestLogs" as Log {
  * Id <<PK>>
  --
  RequestId <<FK>>
  RevisionNumber
  Action
  LogDate
}

entity "Văn phòng phẩm\nVppItems" as Item {
  * Id <<PK>>
  --
  VppCode
}

Period ||--o{ Request
Request ||--o{ Detail
Request ||--o{ Log
Item ||--o{ Detail

Period -[hidden]down- Request
Detail -[hidden]right- Log

note right of Request
  RequestSeriesId và RevisionNumber
  liên kết các phiên bản của cùng một đơn.
  IsAdditionalOrder phân biệt đơn bổ sung.
end note
@enduml
