@startuml
!include ../common/activity-style.puml
title QUY TRÌNH XỬ LÝ ĐƠN BỔ SUNG

start
:Nhân viên chọn kỳ, vật tư và nhập lý do;
:Hệ thống kiểm tra thời hạn bổ sung;
if (Đủ điều kiện tạo đơn?) then (Không)
  :Thông báo lý do không thể tạo đơn;
  stop
else (Có)
  :Lưu đơn ở trạng thái chờ duyệt;
  :Thông báo đã gửi đơn bổ sung;
endif
:Quản lý mở danh sách chờ duyệt;
:Quản lý xem chi tiết và chọn xử lý;
if (Duyệt đơn?) then (Có)
  :Hệ thống chuyển trạng thái sang đã duyệt;
  :Ghi người duyệt, thời điểm và nhật ký;
else (Từ chối)
  :Quản lý nhập lý do từ chối;
  :Hệ thống chuyển trạng thái sang từ chối;
  :Ghi người xử lý, lý do và nhật ký;
endif
:Nhân viên xem kết quả trong lịch sử đơn;
stop
@enduml
