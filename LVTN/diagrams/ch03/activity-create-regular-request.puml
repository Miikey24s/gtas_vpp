@startuml
!include ../common/activity-style.puml
title QUY TRÌNH TẠO ĐƠN YÊU CẦU THÔNG THƯỜNG

start
:Nhân viên mở chức năng tạo đơn;
:Hệ thống xác định kỳ hiện tại;
if (Kỳ đang nhận đơn?) then (Có)
  :Nhân viên chọn vật tư và nhập số lượng;
  :Nhân viên xác nhận gửi đơn;
  :Hệ thống kiểm tra dữ liệu và vật tư;
  if (Đã có đơn thường trong kỳ?) then (Có)
    :Thông báo đơn đã tồn tại;
  else (Không)
    :Lưu đơn, chi tiết và nhật ký tạo đơn;
    :Thông báo tạo đơn thành công;
  endif
else (Không)
  :Thông báo đã hết thời hạn nhận đơn;
endif
stop
@enduml
