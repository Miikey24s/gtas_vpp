@startuml
!include ../common/sequence-style.puml
title SET-002 — Preview, immutable settlement close and correction

actor "Procurement admin" as Admin
boundary "PeriodSettlementPanel\n(Blazor/Radzen)" as FE
control "PeriodSettlementController" as API
control "PeriodSettlementService" as Service
database "VPPContext /\nSQL Server" as DB

Admin -> FE : Select period and price book
FE -> API : POST /api/PeriodSettlement/preview
API -> Service : PreviewAsync(Y, M, PriceAsOfUtc, selection)
Service -> DB : Aggregate current regular + approved supplement rows
Service -> DB : Compare effective supplier price books
DB --> Service : Coverage, net/VAT, commercial terms, blockers
Service --> API : Preview + stable InputHash
API --> FE : 200 OK
FE --> Admin : Show supplier, coverage, VND total and hash

alt Blocker or stale basket
  Admin -> FE : Change inputs / run preview again
else Confirm current Pricing period
  Admin -> FE : Confirm after preview
  FE -> API : POST /api/PeriodSettlement/confirm
  API -> Service : ConfirmAsync(InputHash, IdempotencyKey)
  Service -> DB : Verify hash, current revision and period Pricing
  Service -> DB : Begin short transaction
  Service -> DB : Snapshot VPP04 header revision
  loop Each aggregated VPP item
    Service -> DB : Snapshot VPP05 net/VAT/MOQ/lead/SKU
    Service -> DB : Snapshot VPP07 request-detail allocation
  end
  Service -> DB : Snapshot VPP06 charges and reconcile totals
  Service -> DB : Pricing -> Settled
  Service -> DB : Commit
  Service --> API : Revision summary + GrandTotal
  API --> FE : 200 OK
  FE --> Admin : Show settled revision and reconciliation
else Correct current Settled revision
  Admin -> FE : Fresh preview + reason
  FE -> API : POST /api/PeriodSettlement/{id}/correct
  API -> Service : CorrectAsync(id, reason, InputHash)
  Service -> DB : Require current revision and four-eyes actor
  Service -> DB : Begin short transaction
  Service -> DB : Mark prior revision not current (snapshots unchanged)
  Service -> DB : Insert new VPP04/VPP05/VPP06/VPP07 revision
  Service -> DB : Keep period Settled and commit
  Service --> API : New revision summary
  API --> FE : 200 OK
  FE --> Admin : Show correction revision lineage
end
@enduml
