@startuml
!include ../common/usecase-style.puml
title TẠO ĐƠN YÊU CẦU THÔNG THƯỜNG

actor "Nhân viên" as Employee

rectangle "Hệ thống GTAS VPP" {
  usecase "Tạo đơn yêu cầu\nthông thường" as Create #E6E6E6
  usecase "Xác định kỳ\nhiện tại" as Period
  usecase "Chọn vật tư và\nnhập số lượng" as Items
  usecase "Kiểm tra hạn ngày 5,\nđơn trùng và chi tiết" as Validate
  usecase "Lưu đơn ở trạng thái\nđã gửi" as Persist
  usecase "Ghi nhật ký\nthao tác" as Log

  Create -[hidden]right- Period
  Create .> Period : <<include>>
  Create .> Items : <<include>>
  Create .> Validate : <<include>>
  Create .> Persist : <<include>>
  Create .> Log : <<include>>

  Period -[hidden]down- Items
  Items -[hidden]down- Validate
  Validate -[hidden]down- Persist
  Persist -[hidden]down- Log
}

Employee --> Create
@enduml
