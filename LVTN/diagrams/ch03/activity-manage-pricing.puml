@startuml
!include ../common/activity-style.puml
title QUY TRÌNH QUẢN LÝ BẢNG GIÁ

start
:Quản lý chọn nhà cung cấp;
:Tạo hoặc mở bảng giá;
:Nhập phiên bản, giá và thuế;
:Hệ thống kiểm tra dữ liệu bắt buộc;
if (Dữ liệu hợp lệ?) then (Không)
  :Giữ dữ liệu và hiển thị lỗi;
else (Có)
  :Lưu bảng giá có hiệu lực và các dòng giá;
  if (Đặt làm mặc định?) then (Có)
    :Bỏ mặc định cũ và đặt bảng giá được chọn;
  else (Không)
    if (Thay đổi trạng thái sử dụng?) then (Có)
      :Vô hiệu hóa hoặc khôi phục bảng giá;
    endif
  endif
  :Ghi lịch sử và tải lại dữ liệu;
endif
stop
@enduml
