@startuml
!include ../common/activity-style.puml
title QUY TRÌNH QUẢN LÝ BẢNG GIÁ

|Quản trị viên|
start
:Chọn bảng giá và nhà cung cấp;
:Chọn vật tư cần thêm hoặc sửa giá;
:Nhập giá, mô tả và cờ mặc định;
|Hệ thống|
:Kiểm tra giá không âm;
:Kiểm tra vật tư, nhà cung cấp và bảng giá tồn tại;
if (Dữ liệu hợp lệ?) then (Không)
  :Trả lỗi và giữ dữ liệu nhập;
  |Quản trị viên|
  :Điều chỉnh thông tin;
  stop
else (Có)
  :Bắt đầu transaction;
  if (Đặt làm giá mặc định?) then (Có)
    :Hạ cờ mặc định của giá cũ cùng vật tư/bảng giá;
  endif
  :Thêm hoặc cập nhật ánh xạ giá;
  if (Vi phạm ràng buộc duy nhất?) then (Có)
    :Rollback và trả lỗi xung đột;
    stop
  else (Không)
    :Commit;
    :Đọc lại dữ liệu hiển thị;
    |Quản trị viên|
    :Xem lưới giá đã cập nhật;
    stop
  endif
endif
@enduml

