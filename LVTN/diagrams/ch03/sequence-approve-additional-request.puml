@startuml
!include ../common/sequence-style.puml
title DUYỆT HOẶC TỪ CHỐI ĐƠN BỔ SUNG

actor "Quản trị viên" as Admin
boundary "Tab_AdminApproval\n(Blazor)" as FE
control "VPPRequestController" as API
control "VPPRequestService" as Service
database "VPPContext /\nSQL Server" as DB

Admin -> FE : Mở danh sách đơn bổ sung chờ duyệt
FE -> API : GET /additional-orders/pending
API -> Service : GetPendingAdditionalOrdersAsync()
Service -> DB : Đọc các đơn IsAdditional và Pending
DB --> FE : Danh sách chờ duyệt
Admin -> FE : Chọn duyệt hoặc từ chối và xác nhận

alt Duyệt đơn
  FE -> API : POST /additional-orders/{id}/approve
  API -> Service : ApproveAdditionalOrderAsync(id, AdminID)
  Service -> DB : Begin transaction và tải header + details
  Service -> Service : State machine: Pending -> Approved
  Service -> DB : Cập nhật ApprovedBy/ApprovedAt + log APPROVE
else Từ chối đơn
  FE -> API : POST /additional-orders/{id}/reject
  API -> Service : RejectAdditionalOrderAsync(id, AdminID, reason)
  Service -> DB : Begin transaction và tải header + details
  Service -> Service : State machine: Pending -> Rejected
  Service -> DB : Cập nhật RejectedBy/RejectedAt + log REJECT
end

alt Đơn không tồn tại hoặc không còn Pending
  Service -> DB : Rollback
  API --> FE : 400/404/409 + lý do
  FE --> Admin : Hiển thị lỗi
else Cập nhật thành công
  Service -> DB : Commit
  API --> FE : 200 OK
  FE -> API : Tải lại danh sách Pending
  FE --> Admin : Thông báo kết quả
end
@enduml

