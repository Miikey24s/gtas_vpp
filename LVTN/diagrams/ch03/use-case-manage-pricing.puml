@startuml
!include ../common/usecase-style.puml
title QUẢN LÝ BẢNG GIÁ

actor "Quản lý" as Procurement

rectangle "Hệ thống GTAS VPP" {
  usecase "Quản lý\nbảng giá" as PriceList #E6E6E6
  usecase "Tạo hoặc cập nhật\nbảng giá có hiệu lực" as SaveList
  usecase "Khai báo nhà cung cấp,\nphiên bản và thuế" as Commercial
  usecase "Quản lý giá theo\nvăn phòng phẩm" as Price
  usecase "Đặt làm\nmặc định" as Default
  usecase "Sao chép\nbảng giá" as Clone
  usecase "Vô hiệu hóa\nhoặc khôi phục" as Toggle
  usecase "Kiểm tra giá, VAT\nvà dữ liệu liên kết" as Validate

  PriceList -[hidden]right- SaveList
  PriceList .> SaveList : <<include>>
  PriceList .> Commercial : <<include>>
  PriceList .> Price : <<include>>
  Default .> PriceList : <<extend>>
  Clone .> PriceList : <<extend>>
  Toggle .> PriceList : <<extend>>
  SaveList .> Validate : <<include>>
  Commercial .> Validate : <<include>>
  Default .> Validate : <<include>>

  SaveList -[hidden]down- Commercial
  Commercial -[hidden]down- Price
  Price -[hidden]down- Default
  Default -[hidden]down- Clone
  Clone -[hidden]down- Toggle
  Toggle -[hidden]down- Validate
}

Procurement --> PriceList
@enduml
