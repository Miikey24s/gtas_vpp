@startuml
!include ../common/usecase-style.puml
title QUẢN LÝ BẢNG GIÁ

actor "Chuyên viên quản lý\nvăn phòng phẩm" as Procurement

rectangle "Hệ thống GTAS VPP" {
  usecase "Quản lý\nbảng giá" as PriceList #E6E6E6
  usecase "Tạo hoặc cập nhật\nphiên bản nháp" as SaveList
  usecase "Khai báo nhà cung cấp,\nhiệu lực và thuế" as Commercial
  usecase "Quản lý giá theo\nvăn phòng phẩm" as Price
  usecase "Công bố\nbảng giá" as Publish
  usecase "Đánh dấu\nhết hiệu lực" as Expire
  usecase "Kiểm tra giá, thời gian\nvà khoảng hiệu lực chồng lấn" as Validate

  PriceList -[hidden]right- SaveList
  PriceList .> SaveList : <<include>>
  PriceList .> Commercial : <<include>>
  PriceList .> Price : <<include>>
  Publish .> PriceList : <<extend>>
  Expire .> PriceList : <<extend>>
  SaveList .> Validate : <<include>>
  Commercial .> Validate : <<include>>
  Publish .> Validate : <<include>>

  SaveList -[hidden]down- Commercial
  Commercial -[hidden]down- Price
  Price -[hidden]down- Publish
  Publish -[hidden]down- Expire
  Expire -[hidden]down- Validate
}

Procurement --> PriceList
@enduml
