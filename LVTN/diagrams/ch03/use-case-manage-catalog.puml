@startuml
!include ../common/usecase-style.puml
title QUẢN LÝ DANH MỤC VĂN PHÒNG PHẨM

left to right direction
actor "Quản lý" as Admin

rectangle "Hệ thống GTAS VPP" {
  usecase "Quản lý danh mục" as Catalog
  usecase "Quản lý loại\nvăn phòng phẩm" as Category
  usecase "Quản lý\nvăn phòng phẩm" as Item
  usecase "Quản lý\nđơn vị tính" as Uom
  usecase "Quản lý\nnhà cung cấp" as Supplier
  usecase "Kiểm tra dữ liệu\nvà ràng buộc" as Validate

  Category -[hidden]down- Item
  Item -[hidden]down- Uom
  Uom -[hidden]down- Supplier
  Catalog -[hidden]right- Item

  Catalog .> Category : <<include>>
  Catalog .> Item : <<include>>
  Catalog .> Uom : <<include>>
  Catalog .> Supplier : <<include>>
  Catalog .> Validate : <<include>>
}

Admin --> Catalog
@enduml
