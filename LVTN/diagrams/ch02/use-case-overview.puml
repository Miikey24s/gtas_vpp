@startuml
!include ../common/style.puml

' Semantic source for Hình 2-3.
' The fixed A4 layout is rendered by use-case-overview-layout.py.
left to right direction
skinparam dpi 160
skinparam defaultFontSize 16
skinparam actorFontSize 16
skinparam titleFontSize 20
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 24
skinparam ranksep 32

title Sơ đồ use case tổng quát hệ thống GTAS VPP

actor "Nhân viên" as Employee
actor "Quản lý" as Manager
actor "Quản trị\nhệ thống" as Admin

rectangle "Hệ thống GTAS VPP" {
  usecase "Đăng nhập và tải quyền" as UC_Login
  usecase "Xem danh mục\nvăn phòng phẩm" as UC_Catalog
  usecase "Tạo, sao chép, chỉnh sửa\nhoặc hủy đơn của mình" as UC_Request
  usecase "Tạo và theo dõi\nđơn bổ sung" as UC_Additional
  usecase "Tra cứu lịch sử, báo cáo cá nhân\nvà nhận thông báo" as UC_EmployeeTracking

  usecase "Xem đơn phòng ban\nvà toàn công ty" as UC_Orders
  usecase "Phê duyệt hoặc từ chối\nđơn bổ sung" as UC_AdditionalApproval
  usecase "Quản lý danh mục, nhà cung cấp\nvà bảng giá" as UC_Library
  usecase "Rà soát và chốt kỳ" as UC_Settle
  usecase "Xem và xuất báo cáo\ntheo phạm vi được cấp" as UC_Report

  usecase "Quản lý người dùng\nvà nhóm quyền" as UC_UserManage
  usecase "Quản lý quyền truy cập\nhệ thống" as UC_Permission
  usecase "Kiểm tra nhật ký\nbảo mật" as UC_Audit

  UC_Login -[hidden]down- UC_Catalog
  UC_Catalog -[hidden]down- UC_Request
  UC_Request -[hidden]down- UC_Additional
  UC_Additional -[hidden]down- UC_EmployeeTracking

  UC_Orders -[hidden]down- UC_AdditionalApproval
  UC_AdditionalApproval -[hidden]down- UC_Library
  UC_Library -[hidden]down- UC_Settle
  UC_Settle -[hidden]down- UC_Report

  UC_UserManage -[hidden]down- UC_Permission
  UC_Permission -[hidden]down- UC_Audit
}

Employee -- UC_Login
Employee -- UC_Catalog
Employee -- UC_Request
Employee -- UC_Additional
Employee -- UC_EmployeeTracking

Manager --|> Employee
Manager -- UC_Orders
Manager -- UC_AdditionalApproval
Manager -- UC_Library
Manager -- UC_Settle
Manager -- UC_Report

Admin --|> Employee
Admin -- UC_UserManage
Admin -- UC_Permission
Admin -- UC_Audit

Employee -[hidden]down- Manager
Manager -[hidden]down- Admin

@enduml
