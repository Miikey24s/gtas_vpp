' Common black-and-white style for GTAS VPP sequence diagrams.
!include style.puml

skinparam dpi 160
skinparam defaultFontSize 14
skinparam maxMessageSize 110
skinparam sequence {
  ArrowColor #000000
  ArrowThickness 1.1
  LifeLineBorderColor #000000
  LifeLineBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  ParticipantBackgroundColor #FFFFFF
  ParticipantFontColor #000000
  ActorBorderColor #000000
  ActorBackgroundColor #FFFFFF
  ActorFontColor #000000
  GroupBorderColor #000000
  GroupBackgroundColor #F2F2F2
  GroupHeaderFontColor #000000
  DividerBorderColor #000000
  DividerBackgroundColor #F2F2F2
  DividerFontColor #000000
  ReferenceBorderColor #000000
  ReferenceBackgroundColor #F2F2F2
  ReferenceFontColor #000000
  BoxBorderColor #000000
  BoxBackgroundColor #FFFFFF
  MessageAlign center
  MessageSpacing 0
  ParticipantPadding 28
  BoxPadding 10
}
hide footbox
