root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{cs,razor}]
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.ps1]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
