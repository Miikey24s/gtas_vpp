{
  "description": "Read-only GTAS VPP task recovery reminder.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/session-resume-check.ps1\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$((git rev-parse --show-toplevel).Trim())\\.codex\\hooks\\session-resume-check.ps1\"",
            "timeout": 5,
            "statusMessage": "Recovering unfinished GTAS VPP task"
          }
        ]
      }
    ]
  }
}
