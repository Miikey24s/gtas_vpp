# Optional when running Vite without Aspire. Prefer a same-origin reverse proxy in production.
GTAS_API_PROXY_TARGET=https://localhost:7008

# Optional absolute API base URL. Leave empty when using the Vite /api proxy.
VITE_API_BASE_URL=

# Required only by `npm run api:generate`.
GTAS_OPENAPI_URL=https://localhost:7008/swagger/v1/swagger.json
