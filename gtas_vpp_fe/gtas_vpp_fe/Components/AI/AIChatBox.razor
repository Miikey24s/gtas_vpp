@rendermode InteractiveServer

@if (!_isOpen)
{
    <RadzenButton class="ai-fab"
                  Icon="chat"
                  ButtonStyle="ButtonStyle.Primary"
                  Size="ButtonSize.Large"
                  Click="@ToggleChat"
                  Title="AI Trợ lý VPP"
                  aria-label="AI Trợ lý VPP" />
}
else
{
    <section class="ai-chat-panel" aria-label="AI Trợ lý VPP">
        <header class="ai-chat-header">
            <div class="ai-chat-title">
                <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                <span>AI Trợ lý VPP</span>
            </div>
            <RadzenButton class="ai-close-button"
                          Icon="close"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@ToggleChat"
                          Title="Đóng"
                          aria-label="Đóng" />
        </header>

        <div class="ai-chat-messages" @ref="_messagesContainer">
            @if (_messages.Count == 0)
            {
                <div class="ai-empty-state">Bạn cần tìm văn phòng phẩm nào?</div>
            }

            @foreach (var message in _messages)
            {
                <AIChatMessage Role="@message.Role"
                               Content="@message.Content"
                               SuggestedItems="@message.SuggestedItems"
                               Timestamp="@message.Timestamp" />
            }

            @if (_isLoading)
            {
                <div class="ai-typing-indicator">
                    <span>AI đang suy nghĩ</span>
                    <i></i>
                    <i></i>
                    <i></i>
                </div>
            }
        </div>

        <div class="ai-chat-input-row">
            <input class="ai-chat-input"
                   @bind="_userInput"
                   @bind:event="oninput"
                   @onkeydown="HandleInputKeyDown"
                   disabled="@_isLoading"
                   placeholder="Nhập yêu cầu VPP..."
                   aria-label="Nhập yêu cầu VPP" />
            <RadzenButton class="ai-send-button"
                          Icon="send"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Medium"
                          Click="@SendMessage"
                          Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_userInput))"
                          Title="Gửi"
                          aria-label="Gửi" />
        </div>
    </section>
}
