@using gtas_vpp_shared.DTOs.AI

<div class="ai-message-row @Role">
    <div class="ai-message-bubble">
        <div class="ai-message-content">@Content</div>

        @if (SuggestedItems?.Count > 0)
        {
            <div class="ai-suggested-list">
                @foreach (var item in SuggestedItems)
                {
                    <div class="ai-suggested-item">
                        <div class="ai-suggested-code">@item.VPPCode</div>
                        <div class="ai-suggested-name">@item.VPPName</div>
                        <div class="ai-suggested-meta">@item.CategoryName · @item.UOMName · @item.SimilarityScore.ToString("0.000")</div>
                    </div>
                }
            </div>
        }

        <div class="ai-message-time">@Timestamp.ToString("HH:mm")</div>
    </div>
</div>

@code {
    [Parameter] public string Role { get; set; } = string.Empty;
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public List<AISuggestedItemDTO>? SuggestedItems { get; set; }
    [Parameter] public DateTime Timestamp { get; set; }
}
