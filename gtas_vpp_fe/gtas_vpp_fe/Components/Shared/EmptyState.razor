<div class="vpp-empty-state">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="vpp-empty-state-icon material-symbols-outlined">@Icon</span>
    }
    <h3 class="vpp-empty-state-title">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="vpp-empty-state-desc">@Description</p>
    }
    @if (ActionLabel != null && OnAction.HasDelegate)
    {
        <button class="vpp-empty-state-action" @onclick="() => OnAction.InvokeAsync()">
            @ActionLabel
        </button>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
