@using System.Globalization

<div class="vpp-header-controls">
    @* Language Toggle *@
    <button class="vpp-ctrl-btn" @onclick="OnLanguageToggle" title="@LanguageToggleTitle" aria-label="@LanguageToggleTitle">
        <span class="vpp-ctrl-lang">
            @LanguageToggleCode
        </span>
    </button>

    @* Dark Mode Toggle *@
    <button class="vpp-ctrl-btn" @onclick="OnThemeToggle" title="@ThemeToggleTitle" aria-label="@ThemeToggleTitle">
        <span class="material-symbols-outlined vpp-ctrl-icon">
            @ThemeToggleIcon
        </span>
    </button>
</div>

@code {
    [Parameter] public bool IsLightTheme { get; set; } = true;
    [Parameter] public EventCallback<bool> IsLightThemeChanged { get; set; }
    [Parameter] public EventCallback OnThemeToggle { get; set; }
    [Parameter] public EventCallback OnLanguageToggle { get; set; }

    private bool IsEnglishUi => CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    private string LanguageToggleCode => IsEnglishUi ? "VI" : "EN";

    private string LanguageToggleTitle => IsEnglishUi ? Loc["SwitchToVietnamese"] : Loc["SwitchToEnglish"];

    private string ThemeToggleTitle => IsLightTheme ? Loc["SwitchToDarkMode"] : Loc["SwitchToLightMode"];

    private string ThemeToggleIcon => IsLightTheme ? "dark_mode" : "light_mode";
}
