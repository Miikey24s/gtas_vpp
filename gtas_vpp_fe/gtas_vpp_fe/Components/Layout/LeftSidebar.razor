@inject AuthenticationStateProvider AuthenticationStateProvider
@using Radzen.Blazor.Rendering
@using System.Globalization
@using gtas_vpp_shared.Constants
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@* @inject Radzen.ThemeService ThemeService *@
@inject gtas_vpp_shared.DTOs.Share.GlobalClass glb
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStore
@rendermode InteractiveServer

<PageTitle>GTAS VPP</PageTitle>

<RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Visible=@glb.isBusyPage AriaLabel="Loading progress" Style="position:absolute; top: 0; left: 0; width: 100vw; z-index:99" />

<RadzenHeader Style="position:static;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="mr-2" Style="width:100%;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
            <RadzenSidebarToggle class="customburger" Click="@(() => _sideBarExpanded = !_sideBarExpanded)" />
            <RadzenImage Style="width: 100px;" Path="./logoppj-new.png" />
            <RadzenText Text="@("GTAS VPP (SERVER " + claims.FirstOrDefault(x => x.Type == "Server")?.Value?.ToUpper() + ")")" TextStyle="TextStyle.DisplayH5" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.75rem">
            @* Language toggle (placeholder - not yet implemented) *@
            <RadzenButton Text="@(CultureInfo.CurrentCulture.Name.StartsWith("en") ? "VI" : "EN")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0; font-size:0.75rem; font-weight:700;" Click="@(async () => await ToggleLanguage())" Title="@Loc["Language"]" />
            <RadzenButton Icon="@(LightTheme ? "dark_mode" : "light_mode")" Click="ThemeOnChange" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0;" Title="Toggle theme" />
            @* Notification bell (placeholder - not yet implemented) *@
            <div style="position:relative;">
                <RadzenButton Icon="notifications" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0;" Disabled="true" Title="Notifications (coming soon)" />
                @* Badge dot placeholder *@
                <span style="position:absolute; top:2px; right:2px; width:8px; height:8px; background:var(--rz-danger); border-radius:50%; border:2px solid var(--rz-header-background-color, #fff);"></span>
            </div>
            <div style="position:relative;">
                <div class="user-avatar" @onclick="@(() => _userMenuOpen = !_userMenuOpen)" title="@glb.UserInfo.FullName">
                    @GetUserInitials()
                </div>
                @if (_userMenuOpen)
                {
                    <div class="user-dropdown">
                        <div class="user-dropdown-header">
                            <div class="user-avatar-lg">@GetUserInitials()</div>
                            <div>
                                <div style="font-weight:600;">@glb.UserInfo.FullName</div>
                                <div style="font-size:0.8rem; color:var(--rz-base-600);">@glb.UserInfo.DepartmentCode</div>
                            </div>
                        </div>
                        <div class="user-dropdown-divider"></div>
                        <div class="user-dropdown-info">
                            <RadzenIcon Icon="apartment" Style="font-size:1rem; color:var(--rz-base-600);" />
                            <span>@glb.UserInfo.DepartmentCode</span>
                        </div>
                        @* <div class="user-dropdown-info">
                            <RadzenIcon Icon="business" Style="font-size:1rem; color:var(--rz-base-600);" />
                            <span>@glb.UserInfo.MemberCompanyName</span>
                        </div> *@
                        <div class="user-dropdown-divider"></div>
                        <a href="/logoutprocess" class="user-dropdown-logout">
                            <RadzenIcon Icon="logout" Style="font-size:1rem;" />
                            <span>Logout</span>
                        </a>
                    </div>
                    <div class="user-dropdown-backdrop" @onclick="@(() => _userMenuOpen = false)"></div>
                }
            </div>
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="true" class="@(!_sideBarExpanded ? "sidebar-collapsed" : "")" Style="@(_sideBarExpanded ? "width: max-content" : "width: 60px;")">
    <RadzenPanelMenu DisplayStyle="@(_sideBarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false">
        <AuthorizeView Policy="@Permissions.MenuDashboard" Context="dashboardMenuAuth">
            <RadzenPanelMenuItem Text="@Loc["Dashboard"]" Icon="home" class="ppjsidebarmenu">
                <AuthorizeView Policy="@Permissions.RequestOrder" Context="requestOrderMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["MyOrders"]" Path="/dashboard?tab=0" class="ppjsidebarmenu submenu" Icon="shopping_cart" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.RequestHistory" Context="requestHistoryMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["History"]" Path="/dashboard?tab=1" class="ppjsidebarmenu submenu" Icon="history" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.RequestProductCatalog" Context="requestProductCatalogMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["ProductCatalog"]" Path="/dashboard?tab=2" class="ppjsidebarmenu submenu" Icon="inventory_2" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.RequestDepartmentSummary" Context="requestDepartmentSummaryMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["DepartmentSummary"]" Path="/dashboard?tab=3" class="ppjsidebarmenu submenu" Icon="corporate_fare" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.RequestAllOrdersSummary" Context="requestAllOrdersSummaryMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["AllOrdersSummary"]" Path="/dashboard?tab=4" class="ppjsidebarmenu submenu" Icon="view_list" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.RequestAdminApproval" Context="requestAdminApprovalMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["AdminApproval"]" Path="/dashboard?tab=5" class="ppjsidebarmenu submenu" Icon="fact_check" />
                </AuthorizeView>
            </RadzenPanelMenuItem>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.MenuLibrary" Context="libraryMenuAuth">
            <RadzenPanelMenuItem Text="@Loc["Library"]" Icon="library_books" class="ppjsidebarmenu">
                <AuthorizeView Policy="@Permissions.LibraryClass" Context="libraryClassMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["ClassDefinitions"]" Path="/library?tab=0" class="ppjsidebarmenu submenu" Icon="class" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.LibraryCategory" Context="libraryCategoryMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["OperationCategories"]" Path="/library?tab=1" class="ppjsidebarmenu submenu" Icon="category" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.LibraryItem" Context="libraryItemMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["Operations"]" Path="/library?tab=2" class="ppjsidebarmenu submenu" Icon="inventory" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.LibrarySupplier" Context="librarySupplierMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["Suppliers"]" Path="/library?tab=3" class="ppjsidebarmenu submenu" Icon="local_shipping" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.LibraryDepartment" Context="libraryDepartmentMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["Departments"]" Path="/library?tab=4" class="ppjsidebarmenu submenu" Icon="apartment" />
                </AuthorizeView>
            </RadzenPanelMenuItem>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.MenuReport" Context="reportMenuAuth">
            <RadzenPanelMenuItem Text="@Loc["Reports"]" Icon="analytics" class="ppjsidebarmenu" Path="/report" />
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.MenuPermission" Context="permissionMenuAuth">
            <RadzenPanelMenuItem Text="@Loc["Permissions"]" Icon="settings" class="ppjsidebarmenu">
                <AuthorizeView Policy="@Permissions.PermissionUser" Context="permissionUserMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["User"]" Icon="account_circle" class="ppjsidebarmenu submenu" Path="/permission?tab=0" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.PermissionComponent" Context="permissionComponentMenuAuth">
                    <RadzenPanelMenuItem Text="@Loc["Page"]" Icon="layers" class="ppjsidebarmenu submenu" Path="/permission?tab=1" />
                </AuthorizeView>
            </RadzenPanelMenuItem>
        </AuthorizeView>
        <AuthorizeView Policy="@Permissions.MenuAI" Context="aiMenuAuth">
            <RadzenPanelMenuItem Text="@Loc["AIManagement"]" Icon="smart_toy" class="ppjsidebarmenu">
                <AuthorizeView Policy="@Permissions.RequestAIChat" Context="aiChatAuth">
                    <RadzenPanelMenuItem Text="@Loc["AIChat"]" Icon="forum" class="ppjsidebarmenu submenu" Path="/ai/chat" />
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.RequestAIVppChat" Context="aiVppChatAuth">
                    <RadzenPanelMenuItem Text="@Loc["VPPChat"]" Icon="inventory_2" class="ppjsidebarmenu submenu" Path="/ai/vpp-chat" />
                </AuthorizeView>
            </RadzenPanelMenuItem>
        </AuthorizeView>
        <hr />
        <RadzenPanelMenuItem Text="@Loc["Logout"]" Icon="logout" class="ppjsidebarmenu" Path="/logoutprocess" />
        <RadzenStack JustifyContent="JustifyContent.Center" class="rz-mt-3" Gap="0rem">
            <h6 class="text-center">@currentTime.ToString("dd-MM-yyyy")</h6>
            <h6 class="text-center">@currentTime.ToString("HH:mm")</h6>
        </RadzenStack>
    </RadzenPanelMenu>
</RadzenSidebar>