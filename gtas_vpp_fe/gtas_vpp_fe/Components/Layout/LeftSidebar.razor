@inject AuthenticationStateProvider AuthenticationStateProvider
@using Radzen.Blazor.Rendering
@using System.Globalization
@using gtas_vpp_shared.Constants
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@* @inject Radzen.ThemeService ThemeService *@
@inject gtas_vpp_shared.DTOs.Share.GlobalClass glb
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStore
@rendermode InteractiveServer

<PageTitle>GTAS VPP</PageTitle>

<RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Visible=@glb.isBusyPage AriaLabel="Loading progress" Style="position:absolute; top: 0; left: 0; width: 100vw; z-index:99" />

<RadzenHeader class="vpp-header-glass vpp-layout-header" Style="position:static;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="mr-2" Style="width:100%;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
            <RadzenSidebarToggle class="customburger" Click="@(() => _sideBarExpanded = !_sideBarExpanded)" />
            <RadzenImage Style="width: 100px;" Path="./logoppj-new.png" />
            <RadzenText Text="@("GTAS VPP (SERVER " + claims.FirstOrDefault(x => x.Type == "Server")?.Value?.ToUpper() + ")")" TextStyle="TextStyle.DisplayH5" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.75rem">
            <HeaderControls IsLightTheme="@LightTheme"
                            IsLightThemeChanged="@(isLight => LightTheme = isLight)"
                            OnThemeToggle="ThemeOnChange"
                            OnLanguageToggle="ToggleLanguage" />
            @* Notification bell *@
            <div style="position:relative;">
                <RadzenButton Icon="notifications" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0;" Disabled="true" Title="Notifications (coming soon)" />
                <span style="position:absolute; top:2px; right:2px; width:8px; height:8px; background:var(--rz-danger); border-radius:50%; border:2px solid var(--rz-header-background-color, #fff);"></span>
            </div>
            <UserMenu UserFullName="@glb.UserInfo.FullName" Department="@glb.UserInfo.DepartmentCode" />
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="true" class="@GetSidebarClass()" Style="@(_sideBarExpanded ? "width: max-content" : "width: 60px;")">
    <RadzenPanelMenu DisplayStyle="@(_sideBarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false" Click="@OnMenuItemClick">
        @if (CanViewDashboardMenu)
        {
            <RadzenPanelMenuItem Text="@Loc["Dashboard"]" Icon="assignment" class="ppjsidebarmenu">
                @if (CanViewDashboardItem(Permissions.RequestOrder))
                {
                    <RadzenPanelMenuItem Text="@Loc["MyOrders"]" Path="/dashboard?tab=0" class="ppjsidebarmenu submenu" Icon="shopping_cart" />
                }
                @if (CanViewDashboardItem(Permissions.RequestHistory))
                {
                    <RadzenPanelMenuItem Text="@Loc["History"]" Path="/dashboard?tab=1" class="ppjsidebarmenu submenu" Icon="history" />
                }
                @if (CanViewDashboardItem(Permissions.RequestProductCatalog))
                {
                    <RadzenPanelMenuItem Text="@Loc["Catalog"]" Path="/dashboard?tab=2" class="ppjsidebarmenu submenu" Icon="inventory_2" />
                }
                @if (CanViewDashboardItem(Permissions.RequestDepartmentSummary) && CanViewDashboardItem(Permissions.RequestAllOrdersSummary))
                {
                    <RadzenPanelMenuItem Text="@Loc["Management"]" class="ppjsidebarmenu submenu" Icon="manage_accounts">
                        <RadzenPanelMenuItem Text="@Loc["DepartmentSummary"]" Path="@("/dashboard?tab=3&managementTab=department")" class="ppjsidebarmenu submenu" Icon="corporate_fare" />
                        <RadzenPanelMenuItem Text="@Loc["AllOrdersSummary"]" Path="@("/dashboard?tab=3&managementTab=all")" class="ppjsidebarmenu submenu" Icon="view_list" />
                    </RadzenPanelMenuItem>
                }
                else if (CanViewDashboardItem(Permissions.RequestDepartmentSummary))
                {
                    <RadzenPanelMenuItem Text="@Loc["DepartmentSummary"]" Path="@("/dashboard?tab=3&managementTab=department")" class="ppjsidebarmenu submenu" Icon="corporate_fare" />
                }
                else if (CanViewDashboardItem(Permissions.RequestAllOrdersSummary))
                {
                    <RadzenPanelMenuItem Text="@Loc["AllOrdersSummary"]" Path="@("/dashboard?tab=3&managementTab=all")" class="ppjsidebarmenu submenu" Icon="view_list" />
                }
                @if (CanViewDashboardItem(Permissions.RequestAdminApproval) || CanViewDashboardItem(Permissions.PeriodSettle))
                {
                    <RadzenPanelMenuItem Text="@Loc["PeriodOperations"]" Path="/dashboard?tab=5" class="ppjsidebarmenu submenu" Icon="summarize" />
                }
            </RadzenPanelMenuItem>
        }
        @if (CanViewLibraryMenu)
        {
            <RadzenPanelMenuItem Text="@Loc["Library"]" Icon="library_books" class="ppjsidebarmenu">
                @if (CanViewLibraryItem(Permissions.LibraryClass))
                {
                    <RadzenPanelMenuItem Text="@Loc["ClassDefinitions"]" Path="/library?tab=0" class="ppjsidebarmenu submenu" Icon="class" />
                }
                @if (CanViewLibraryItem(Permissions.LibraryCategory))
                {
                    <RadzenPanelMenuItem Text="@Loc["OperationCategories"]" Path="/library?tab=1" class="ppjsidebarmenu submenu" Icon="category" />
                }
                @if (CanViewLibraryItem(Permissions.LibraryItem))
                {
                    <RadzenPanelMenuItem Text="@Loc["Operations"]" Path="/library?tab=2" class="ppjsidebarmenu submenu" Icon="inventory" />
                }
                @if (CanViewLibraryItem(Permissions.LibrarySupplier))
                {
                    <RadzenPanelMenuItem Text="@Loc["Suppliers"]" Path="/library?tab=3" class="ppjsidebarmenu submenu" Icon="local_shipping" />
                }
                @if (CanViewLibraryItem(Permissions.LibraryPriceList) || CanViewLibraryItem(Permissions.LibraryPrice))
                {
                    <RadzenPanelMenuItem Text="@Loc["Pricing"]" class="ppjsidebarmenu submenu" Icon="payments">
                        @if (CanViewLibraryItem(Permissions.LibraryPriceList))
                        {
                            <RadzenPanelMenuItem Text="@Loc["PriceLists"]" Path="@("/library?tab=6&pricingTab=price-lists")" class="ppjsidebarmenu submenu" Icon="list_alt" />
                        }
                        @if (CanViewLibraryItem(Permissions.LibraryPrice))
                        {
                            <RadzenPanelMenuItem Text="@Loc["Prices"]" Path="@("/library?tab=6&pricingTab=prices")" class="ppjsidebarmenu submenu" Icon="payments" />
                        }
                    </RadzenPanelMenuItem>
                }
                @if (CanViewLibraryItem(Permissions.LibraryDepartment))
                {
                    <RadzenPanelMenuItem Text="@Loc["Departments"]" Path="/library?tab=5" class="ppjsidebarmenu submenu" Icon="apartment" />
                }
            </RadzenPanelMenuItem>
        }
        @if (CanViewReportMenu)
        {
            <RadzenPanelMenuItem Text="@Loc["Reports"]" Icon="analytics" class="ppjsidebarmenu" Path="/report" />
        }
        @if (CanViewPermissionMenu)
        {
            <RadzenPanelMenuItem Text="@Loc["Permissions"]" Icon="settings" class="ppjsidebarmenu">
                @if (CanViewPermissionItem(Permissions.PermissionUser))
                {
                    <RadzenPanelMenuItem Text="@Loc["User"]" Icon="account_circle" class="ppjsidebarmenu submenu" Path="/permission?tab=0" />
                }
                @if (CanViewPermissionItem(Permissions.PermissionComponent))
                {
                    <RadzenPanelMenuItem Text="@Loc["Page"]" Icon="layers" class="ppjsidebarmenu submenu" Path="/permission?tab=1" />
                }
            </RadzenPanelMenuItem>
        }
        <RadzenPanelMenuItem Text="@Loc["Logout"]" Icon="logout" class="ppjsidebarmenu" Path="/logoutprocess" />
        <RadzenStack JustifyContent="JustifyContent.Center" class="rz-mt-3" Gap="0rem">
            <h6 class="text-center">@currentTime.ToString("dd-MM-yyyy")</h6>
            <h6 class="text-center">@currentTime.ToString("HH:mm")</h6>
        </RadzenStack>
    </RadzenPanelMenu>
</RadzenSidebar>
