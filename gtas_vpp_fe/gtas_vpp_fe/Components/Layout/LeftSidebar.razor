@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Radzen.Blazor.Rendering
@using System.Globalization
@* @inject Radzen.ThemeService ThemeService *@
@inject gtas_vpp_shared.DTOs.Share.GlobalClass glb
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStore
@rendermode InteractiveServer

<PageTitle>GTAS VPP</PageTitle>

<RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Visible=@glb.isBusyPage AriaLabel="Loading progress" Style="position:absolute; top: 0; left: 0; width: 100vw; z-index:99" />

<RadzenHeader Style="position:static;">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="mr-2" Style="width:100%;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
            <RadzenSidebarToggle class="customburger" Click="@(() => _sideBarExpanded = !_sideBarExpanded)" />
            <RadzenImage Style="width: 100px;" Path="./logoppj-new.png" />
            <RadzenText Text="@("GTAS VPP (SERVER " + claims.FirstOrDefault(x => x.Type == "Server")?.Value?.ToUpper() + ")")" TextStyle="TextStyle.DisplayH5" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.75rem">
            @* Language toggle (placeholder - not yet implemented) *@
            <RadzenButton Text="EN" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0; font-size:0.75rem; font-weight:700;" Disabled="true" Title="Language switch (coming soon)" />
            <RadzenButton Icon="@(LightTheme ? "dark_mode" : "light_mode")" Click="ThemeOnChange" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0;" Title="Toggle theme" />
            @* Notification bell (placeholder - not yet implemented) *@
            <div style="position:relative;">
                <RadzenButton Icon="notifications" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Style="border-radius:50%; width:36px; height:36px; padding:0;" Disabled="true" Title="Notifications (coming soon)" />
                @* Badge dot placeholder *@
                <span style="position:absolute; top:2px; right:2px; width:8px; height:8px; background:var(--rz-danger); border-radius:50%; border:2px solid var(--rz-header-background-color, #fff);"></span>
            </div>
            <div style="position:relative;">
                <div class="user-avatar" @onclick="@(() => _userMenuOpen = !_userMenuOpen)" title="@glb.UserInfo.FullName">
                    @GetUserInitials()
                </div>
                @if (_userMenuOpen)
                {
                    <div class="user-dropdown">
                        <div class="user-dropdown-header">
                            <div class="user-avatar-lg">@GetUserInitials()</div>
                            <div>
                                <div style="font-weight:600;">@glb.UserInfo.FullName</div>
                                <div style="font-size:0.8rem; color:var(--rz-base-600);">@glb.UserInfo.DepartmentCode</div>
                            </div>
                        </div>
                        <div class="user-dropdown-divider"></div>
                        <div class="user-dropdown-info">
                            <RadzenIcon Icon="apartment" Style="font-size:1rem; color:var(--rz-base-600);" />
                            <span>@glb.UserInfo.DepartmentCode</span>
                        </div>
                        <div class="user-dropdown-info">
                            <RadzenIcon Icon="business" Style="font-size:1rem; color:var(--rz-base-600);" />
                            <span>@glb.UserInfo.MemberCompanyName</span>
                        </div>
                        <div class="user-dropdown-divider"></div>
                        <a href="/logoutprocess" class="user-dropdown-logout">
                            <RadzenIcon Icon="logout" Style="font-size:1rem;" />
                            <span>Logout</span>
                        </a>
                    </div>
                    <div class="user-dropdown-backdrop" @onclick="@(() => _userMenuOpen = false)"></div>
                }
            </div>
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="true" class="@(!_sideBarExpanded ? "sidebar-collapsed" : "")" Style="@(_sideBarExpanded ? "width: max-content" : "width: 60px;")">
    <RadzenPanelMenu DisplayStyle="@(_sideBarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)" ShowArrow="false">
        <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => (x.ComponentCode == "0001_HD" || (x.ComponentCode?.Contains("0003_RQ") ?? false)) && x.IsVisible)" Text="Dashboard" Icon="home" class="ppjsidebarmenu">
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0003_RQ_O" && x.IsVisible)" Text="Orders" Path="/dashboard/orders" class="ppjsidebarmenu submenu" Icon="shopping_cart" />
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0003_RQ_H" && x.IsVisible)" Text="History" Path="/dashboard/history" class="ppjsidebarmenu submenu" Icon="history" />
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0003_RQ_PC" && x.IsVisible)" Text="Product Catalog" Path="/dashboard/products" class="ppjsidebarmenu submenu" Icon="inventory_2" />
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0003_RQ_DS" && x.IsVisible)" Text="Department Summary" Path="/dashboard/departments" class="ppjsidebarmenu submenu" Icon="corporate_fare" />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => (x.ComponentCode?.Contains("0001_LIB") ?? false) && x.IsVisible)" Text="Library" Icon="library_books" class="ppjsidebarmenu">
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0001_LIB_C" && x.IsVisible)" Text="Class Definitions" Path="/library/class" class="ppjsidebarmenu submenu" Icon="menu_book" />
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0001_LIB_OC" && x.IsVisible)" Text="Operation Categories" Path="/library/operationcat" class="ppjsidebarmenu submenu" Icon="menu_book" />
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0001_LIB_O" && x.IsVisible)" Text="Operations" Path="/library/operation" class="ppjsidebarmenu submenu" Icon="menu_book" />
            <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0001_LIB_SUP" && x.IsVisible)" Text="Suppliers" Path="/library/supplier" class="ppjsidebarmenu submenu" Icon="menu_book" />
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0001_R" && x.IsVisible)" Text="Report" Icon="analytics" class="ppjsidebarmenu" Path="/Report" />
        <RadzenPanelMenuItem Visible="@sp_Authentication_GetPermissionSinglePage.List_Component.Any(x => x.ComponentCode == "0001_S" && x.IsVisible)" Text="Permission" Icon="settings" class="ppjsidebarmenu">
            <RadzenPanelMenuItem Text="User" Icon="account_circle" class="ppjsidebarmenu submenu" Path="/permission/user" />
            <RadzenPanelMenuItem Text="Page" Icon="layers" class="ppjsidebarmenu submenu" Path="/permission/pagepermission" />
            <RadzenPanelMenuItem Text="Department" Icon="apartment" class="ppjsidebarmenu submenu" Path="/permission/department" />
        </RadzenPanelMenuItem>
        <hr />
        <RadzenPanelMenuItem Text="Logout" Icon="logout" class="ppjsidebarmenu" Path="/logoutprocess" />
        <RadzenStack JustifyContent="JustifyContent.Center" class="rz-mt-3" Gap="0rem">
            <h6 class="text-center">@currentTime.ToString("dd-MM-yyyy")</h6>
            <h6 class="text-center">@currentTime.ToString("HH:mm")</h6>
        </RadzenStack>
    </RadzenPanelMenu>
</RadzenSidebar>

@code {
    public bool LightTheme { get; set; } = true;
    private bool _userMenuOpen = false;
    private DateTime currentTime = DateTime.Now;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        timer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private string GetUserInitials()
    {
        var name = glb.UserInfo.FullName ?? "";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return "U";
    }

    private void ToggleLanguage()
    {
        var currentCulture = CultureInfo.CurrentCulture.Name;
        var newCulture = currentCulture == "en" ? "vi" : "en";
        CultureInfo.CurrentCulture = new CultureInfo(newCulture);
        CultureInfo.CurrentUICulture = new CultureInfo(newCulture);
        StateHasChanged();
    }
}
