@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_fe.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject NotificationService NotificationService
@inject IJSRuntime js

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (isLoadingL01)
{
    <SkeletonGrid Rows="8" Cols="3" />
}
else
{
<RadzenSplitter class="vpp-admin-split vpp-admin-class-split">
    <RadzenSplitterPane Size="42%" Min="32%" Max="58%">
        <RadzenStack Gap="1rem">
            <RadzenDataGrid @ref="gridL01" TItem="L01_ClassResDTO" 
                            Data="@classListL01"
                            Count="@countL01"
                            LoadData="@LoadDataL01"
                            LoadColumnFilterData="@LoadColumnFilterDataL01"
                            IsLoading="@isLoadingL01"
                            AllowFiltering="true" 
                            AllowColumnResize="true" 
                            AllowColumnPicking="true"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            AllowSorting="true" 
                            AllowPaging="true" 
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 20, 50, 100 })"
                            Density="Density.Compact"
                            SelectionMode="DataGridSelectionMode.Single" 
                            @bind-Value="@selectedClassesL01"
                            RowSelect="@OnRowSelectL01"
                            RowRender="@OnRowRenderL01"
                            GridLines="DataGridGridLines.Horizontal"
                            class="auto-fit-grid vpp-admin-grid"
                            ColumnWidth="132px"
                            Style="--vpp-admin-grid-min-width: 860px; height: min(680px, calc(100vh - 210px));">
                <Columns>
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Title="#" Width="48px" MinWidth="48px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="data">
                            @(currentSkipL01 + classListL01.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="118px" MinWidth="118px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                        <Template Context="data">
                            <div class="vpp-admin-is-deleted-cell">
                                <span class="@(data.IsDeleted ? "vpp-admin-status-badge is-true" : "vpp-admin-status-badge is-false")">
                                    @(data.IsDeleted ? "True" : "False")
                                </span>
                                <RadzenSwitch @bind-Value="@data.IsDeleted"
                                              Change="@(async (bool value) => await ToggleDeleteL01(data, value))"
                                              class="isDeleteSwitch"
                                              Style="transform: scale(0.75);" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="ClassCode" Title="@Loc["ClassCode"]" Width="120px" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="ClassName" Title="@Loc["ClassName"]" Width="170px" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="ClassModul" Title="@Loc["ClassModule"]" Width="130px" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="Description" Title="@Loc["Description"]" Width="170px" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="CreateUserId" Title="Create User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="CreateDate" Title="Create Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="UpdateUserId" Title="Update User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="UpdateDate" Title="Update Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Title="@Loc["Actions"]" Width="58px" MinWidth="58px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Pickable="false" CssClass="rz-col-actions rz-col-actions-tight" HeaderCssClass="rz-col-actions rz-col-actions-tight">
                        <Template Context="data">
                            <div class="vpp-admin-actions">
                                <RadzenButton Icon="delete_forever"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              title="@Loc["HardDelete"]"
                                              Click="@(() => HardDeleteL01(data))"
                                              @onclick:stopPropagation="true" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenSplitterPane>
    
    <RadzenSplitterPane>
        <RadzenStack Gap="1rem">
            <RadzenDataGrid @ref="gridL02" TItem="L02_ClassDetailResDTO"
                            Data="@classDetailListL02"
                            Count="@countL02"
                            LoadData="@LoadDataL02"
                            LoadColumnFilterData="@LoadColumnFilterDataL02"
                            IsLoading="@isLoadingL02"
                            AllowFiltering="true" 
                            AllowColumnResize="true" 
                            AllowColumnPicking="true"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            AllowSorting="true" 
                            AllowPaging="true" 
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 20, 50, 100 })"
                            Density="Density.Compact"
                            EmptyText="@(selectedClassL01 == null ? "Please select a class from the left panel" : "No class details found")"
                            RowRender="@OnRowRenderL02"
                            GridLines="DataGridGridLines.Horizontal"
                            class="auto-fit-grid vpp-admin-grid"
                            ColumnWidth="132px"
                            Style="--vpp-admin-grid-min-width: 1020px; height: min(680px, calc(100vh - 210px));">
                <Columns>
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Title="#" Width="48px" MinWidth="48px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="data">
                            @(currentSkipL02 + classDetailListL02.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="118px" MinWidth="118px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                        <Template Context="data">
                            <div class="vpp-admin-is-deleted-cell">
                                <span class="@(data.IsDeleted ? "vpp-admin-status-badge is-true" : "vpp-admin-status-badge is-false")">
                                    @(data.IsDeleted ? "True" : "False")
                                </span>
                                <RadzenSwitch @bind-Value="@data.IsDeleted"
                                              Change="@(async (bool value) => await ToggleDeleteL02(data, value))"
                                              class="isDeleteSwitch"
                                              Style="transform: scale(0.75);" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ClassDetailCode" Title="@Loc["Code"]" Width="120px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ClassDetailValue" Title="@Loc["Value"]" Width="140px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="Sort" Title="@Loc["SortOrder"]" Width="74px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ExtraField1" Title="Extra 1" Width="100px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ExtraField2" Title="Extra 2" Width="100px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ExtraField3" Title="Extra 3" Width="100px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="Description" Title="@Loc["Description"]" Width="180px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ClassId" Title="Class ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="CreateUserId" Title="Create User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="CreateDate" Title="Create Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="UpdateUserId" Title="Update User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="UpdateDate" Title="Update Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Title="@Loc["Actions"]" Width="58px" MinWidth="58px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Pickable="false" CssClass="rz-col-actions rz-col-actions-tight" HeaderCssClass="rz-col-actions rz-col-actions-tight">
                        <Template Context="data">
                            <div class="vpp-admin-actions">
                                <RadzenButton Icon="delete_forever"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              title="@Loc["HardDelete"]"
                                              Click="@(() => HardDeleteL02(data))"
                                              @onclick:stopPropagation="true" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenSplitterPane>
</RadzenSplitter>
}
