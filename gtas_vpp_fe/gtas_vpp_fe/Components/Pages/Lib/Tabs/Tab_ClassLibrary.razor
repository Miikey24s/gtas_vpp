@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_fe.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject NotificationService NotificationService
@inject IJSRuntime js

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<style>
    .auto-fit-grid .rz-grid-table {
        table-layout: auto !important;
        width: 100% !important;
    }
    
    .auto-fit-grid .col-tight {
        width: 1% !important;
        white-space: nowrap !important;
    }

    .auto-fit-grid .col-greedy {
        width: 100% !important;
    }
    
    .auto-fit-grid .rz-datatable-data td {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }
</style>

<RadzenSplitter>
    <RadzenSplitterPane Size="50%" Min="30%" Max="70%">
        <RadzenStack Gap="1rem">
            <RadzenDataGrid @ref="gridL01" TItem="L01_ClassResDTO" 
                            Data="@classListL01"
                            Count="@countL01"
                            LoadData="@LoadDataL01"
                            LoadColumnFilterData="@LoadColumnFilterDataL01"
                            IsLoading="@isLoadingL01"
                            AllowFiltering="true" 
                            AllowColumnResize="true" 
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            AllowSorting="true" 
                            AllowPaging="true" 
                            PageSize="20"
                            Density="Density.Compact"
                            SelectionMode="DataGridSelectionMode.Single" 
                            @bind-Value="@selectedClassesL01"
                            RowSelect="@OnRowSelectL01"
                            GridLines="DataGridGridLines.Horizontal"
                            class="auto-fit-grid"
                            ColumnWidth="200px"
                            Style="height: calc(100vh - 200px);">
                <Columns>
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Title="#" Width="60px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="col-tight">
                        <Template Context="data">
                            @(classListL01.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="ClassCode" Title="Class Code" Width="120px" CssClass="col-tight" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="ClassName" Title="Class Name" Width="200px" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="ClassModul" Title="Class Module" Width="150px" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="Description" Title="Description" Width="200px" CssClass="col-greedy" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="CreateUserId" Title="Create User" Width="100px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="CreateDate" Title="Create Date" Width="150px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="UpdateUserId" Title="Update User" Width="100px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="UpdateDate" Title="Update Date" Width="150px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                    <RadzenDataGridColumn TItem="L01_ClassResDTO" Property="IsDeleted" Title="IsDeleted" Width="100px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="data">
                            <RadzenSwitch @bind-Value="@data.IsDeleted" Change="@(async (bool value) => await ToggleDeleteL01(data, value))" 
                                          Style="transform: scale(0.8);" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenSplitterPane>
    
    <RadzenSplitterPane>
        <RadzenStack Gap="1rem">
            <RadzenDataGrid @ref="gridL02" TItem="L02_ClassDetailResDTO"
                            Data="@classDetailListL02"
                            Count="@countL02"
                            LoadData="@LoadDataL02"
                            LoadColumnFilterData="@LoadColumnFilterDataL02"
                            IsLoading="@isLoadingL02"
                            AllowFiltering="true" 
                            AllowColumnResize="true" 
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            AllowSorting="true" 
                            AllowPaging="true" 
                            PageSize="20"
                            Density="Density.Compact"
                            EmptyText="@(selectedClassL01 == null ? "Please select a class from the left panel" : "No class details found")"
                            GridLines="DataGridGridLines.Horizontal"
                            class="auto-fit-grid"
                            ColumnWidth="200px"
                            Style="height: calc(100vh - 200px);">
                <Columns>
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Title="#" Width="60px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="col-tight">
                        <Template Context="data">
                            @(classDetailListL02.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ClassId" Title="Class ID" Width="250px" CssClass="col-tight" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ClassDetailCode" Title="Code" Width="120px" CssClass="col-tight" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ClassDetailValue" Title="Value" Width="150px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ExtraField1" Title="Extra 1" Width="100px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ExtraField2" Title="Extra 2" Width="100px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="ExtraField3" Title="Extra 3" Width="100px" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="Sort" Title="Sort" Width="80px" TextAlign="TextAlign.Center" CssClass="col-tight" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="Description" Title="Description" Width="200px" CssClass="col-greedy" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="CreateUserId" Title="Create User" Width="100px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="CreateDate" Title="Create Date" Width="150px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="UpdateUserId" Title="Update User" Width="100px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="UpdateDate" Title="Update Date" Width="150px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                    <RadzenDataGridColumn TItem="L02_ClassDetailResDTO" Property="IsDeleted" Title="IsDeleted" Width="100px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="data">
                            <RadzenSwitch @bind-Value="@data.IsDeleted" Change="@(async (bool value) => await ToggleDeleteL02(data, value))" 
                                          Style="transform: scale(0.8);" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenSplitterPane>
</RadzenSplitter>
