@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Share
@inject DialogService DialogService
@inject IAPIServices _apiServices
@inject ICustomNotificationService _notificationService
@inject GlobalClass glb

<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Class Detail Code *" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@Model.ClassDetailCode" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Class Detail Value *" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@Model.ClassDetailValue" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="Extra Field 1" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@Model.ExtraField1" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="Extra Field 2" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@Model.ExtraField2" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="4">
            <RadzenFormField Text="Extra Field 3" Variant="Variant.Outlined">
                <RadzenTextBox @bind-Value="@Model.ExtraField3" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenFormField Text="Sort Order" Variant="Variant.Outlined">
                <RadzenNumeric @bind-Value="@Model.Sort" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenFormField Text="Description" Variant="Variant.Outlined">
                <RadzenTextArea @bind-Value="@Model.Description" Style="width: 100%;" Rows="3" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenRow>
        <RadzenColumn Size="12" class="rz-text-align-end">
            <RadzenButton Text="Cancel" Click="@Cancel" ButtonStyle="ButtonStyle.Light" Style="margin-right: 8px;" />
            <RadzenButton Text="Save" Click="@Save" ButtonStyle="ButtonStyle.Primary" IsBusy="@isBusy" Disabled="@isBusy" />
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code {
    [Parameter] public L02_ClassDetailResDTO Model { get; set; } = new() { ClassDetailCode = "", ClassDetailValue = "" };
    [Parameter] public bool IsCreate { get; set; }
    
    private bool isBusy = false;

    private void Cancel()
    {
        DialogService.Close(null);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Model.ClassDetailCode) || string.IsNullOrWhiteSpace(Model.ClassDetailValue))
        {
            _notificationService.CustomContentNotification(NotificationSeverity.Warning, "Validation", "Class Detail Code and Value are required", 5000, false);
            return;
        }

        isBusy = true;
        try
        {
            Model.UpdateDate = DateTime.Now;
            Model.UpdateUserId = glb.UserInfo.UserID;

            L02_ClassDetailResDTO? result;
            if (IsCreate)
            {
                Model.Id = Guid.NewGuid();
                Model.CreateDate = DateTime.Now;
                Model.CreateUserId = glb.UserInfo.UserID;
                result = await _apiServices.PostFromApiAsync<L02_ClassDetailResDTO>(Config.LibraryApi.L02_ClassDetail, Model);
            }
            else
            {
                result = await _apiServices.PutFromApiAsync<L02_ClassDetailResDTO>(Config.LibraryApi.L02_ClassDetail, Model);
            }

            if (result != null)
            {
                _notificationService.CustomContentNotification(NotificationSeverity.Success, "Success", 
                    IsCreate ? "Class detail created successfully" : "Class detail updated successfully", 5000, false);
                DialogService.Close(result);
            }
            else
            {
                _notificationService.CustomContentNotification(NotificationSeverity.Error, "Error", "Failed to save class detail", 5000, true);
            }
        }
        catch (Exception ex)
        {
            _notificationService.CustomContentNotification(NotificationSeverity.Error, "Error", $"Error saving class detail: {ex.Message}", 15000, true);
        }
        finally
        {
            isBusy = false;
        }
    }
}
