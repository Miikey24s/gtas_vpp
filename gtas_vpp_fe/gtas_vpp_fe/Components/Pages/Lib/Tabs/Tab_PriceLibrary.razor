@using gtas_vpp_shared.DTOs.Res.Library

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
        <RadzenFormField Text="@Loc["PriceList"]" Style="min-width:280px;">
            <RadzenDropDown TValue="Guid?"
                            Data="@priceLists"
                            TextProperty="PriceListName"
                            ValueProperty="Id"
                            @bind-Value="selectedPriceListId"
                            Change="@(async _ => await OnPriceListChangedAsync())"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@(!HasPriceLists)"
                            Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="@Loc["Supplier"]" Style="min-width:320px;">
            <RadzenDropDown TValue="Guid?"
                            Data="@suppliers"
                            TextProperty="SupplierName"
                            ValueProperty="Id"
                            @bind-Value="selectedSupplierId"
                            Change="@(async _ => await OnSupplierChangedAsync())"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@(!HasPriceListSelected)"
                            Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="@Loc["Search"]" Style="min-width:240px;">
            <RadzenTextBox @bind-Value="searchText"
                           @oninput="@(args => OnSearchInput(args.Value?.ToString()))"
                           Placeholder="@Loc["Search"]"
                           Style="width:100%" />
        </RadzenFormField>
    </RadzenStack>

    @if (!HasPriceLists)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
            @Loc["NoPriceListAvailable"]
        </RadzenAlert>
    }

    <RadzenDataGrid @ref="grid"
                    TItem="VppItemPriceDisplayModel"
                    Data="@filteredDisplayItems"
                    IsLoading="@isLoading"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="20"
                    PageSizeOptions="@(new int[] { 20, 50, 100 })"
                    Density="Density.Compact"
                    EmptyText="@GridEmptyText"
                    GridLines="DataGridGridLines.Horizontal"
                    AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    Style="height: calc(100vh - 230px);">
        <Columns>
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="VPPCode" Title="@Loc["ProductCode"]" Width="140px" />
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="VPPName" Title="@Loc["ProductName"]" />
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="CategoryName" Title="@Loc["Category"]" Width="180px" />
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="UOMName" Title="@Loc["UOM"]" Width="100px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="Price" Title="@Loc["Price"]" Width="140px" TextAlign="TextAlign.Right" FormatString="{0:N0}">
                <Template Context="row">
                    @if (row.Price.HasValue)
                    {
                        <span>@row.Price.Value.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="text-muted" style="font-style: italic;">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="IsDefault" Title="@Loc["DefaultPrice"]" Width="130px" TextAlign="TextAlign.Center">
                <Template Context="row">
                    <RadzenSwitch TValue="bool" Value="@row.IsDefault" Disabled="true" Style="transform: scale(0.8);" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Property="Description" Title="@Loc["Description"]" />
            <RadzenDataGridColumn TItem="VppItemPriceDisplayModel" Title="@Loc["Actions"]" Width="260px" Sortable="false" Filterable="false">
                <Template Context="row">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" JustifyContent="JustifyContent.End">
                        <RadzenButton Icon="edit" 
                                      Text="@(row.PriceMappingId.HasValue ? Loc["Edit"] : Loc["Create"])" 
                                      Size="ButtonSize.Small" 
                                      ButtonStyle="ButtonStyle.Light" 
                                      Click="@(() => EditPriceAsync(row))" />
                        <RadzenButton Icon="star" 
                                      Text="@Loc["SetDefault"]" 
                                      Size="ButtonSize.Small" 
                                      ButtonStyle="ButtonStyle.Info" 
                                      Disabled="@(!row.PriceMappingId.HasValue || row.IsDefault)" 
                                      Click="@(() => SetDefaultAsync(row))" />
                        <RadzenButton Icon="delete" 
                                      Text="@Loc["Delete"]" 
                                      Size="ButtonSize.Small" 
                                      ButtonStyle="ButtonStyle.Danger" 
                                      Disabled="@(!row.PriceMappingId.HasValue)" 
                                      Click="@(() => DeletePriceAsync(row))" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>
