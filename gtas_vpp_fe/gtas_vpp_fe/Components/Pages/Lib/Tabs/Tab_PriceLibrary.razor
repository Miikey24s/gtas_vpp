@using gtas_vpp_shared.DTOs.Res.Library

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<RadzenStack Gap="0.75rem" class="vpp-admin-workspace vpp-price-workspace">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap" class="vpp-admin-filterbar vpp-price-filterbar">
        <RadzenFormField Text="@Loc["PriceList"]" Style="min-width:280px;">
            <RadzenDropDown TValue="Guid?"
                            Data="@priceLists"
                            TextProperty="PriceListName"
                            ValueProperty="Id"
                            @bind-Value="selectedPriceListId"
                            Change="@(async _ => await OnPriceListChangedAsync())"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@(!HasPriceLists)"
                            Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="@Loc["Supplier"]" Style="min-width:320px;">
            <RadzenDropDown TValue="Guid?"
                            Data="@suppliers"
                            TextProperty="SupplierName"
                            ValueProperty="Id"
                            @bind-Value="selectedSupplierId"
                            Change="@(async _ => await OnSupplierChangedAsync())"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@(!HasPriceListSelected)"
                            Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="@Loc["Search"]" Style="min-width:240px;">
            <RadzenTextBox @bind-Value="searchText"
                           @oninput="@(async args => await OnSearchInputAsync(args.Value?.ToString()))"
                           Placeholder="@Loc["Search"]"
                           aria-label="@Loc["Search"]"
                           Style="width:100%" />
        </RadzenFormField>
        <RadzenButton Icon="refresh"
                      Text="@Loc["Reload"]"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Light"
                      class="vpp-library-refresh-action"
                      Title="@Loc["Reload"]"
                      aria-label="@Loc["Reload"]"
                      Click="@LoadPricesAsync"
                      Disabled="@(!HasPriceListSelected)" />
        <VppColumnPicker TItem="L06_VPPItemPriceResDTO" GridAccessor="@(() => grid)" />
    </RadzenStack>

    @if (!HasPriceLists)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
            @Loc["NoPriceListAvailable"]
        </RadzenAlert>
    }

    <RadzenDataGrid @ref="grid"
                    TItem="L06_VPPItemPriceResDTO"
                    Data="@displayItems"
                    Count="@priceCount"
                    LoadData="@LoadPriceRowsAsync"
                    LoadColumnFilterData="@LoadPriceFilterDataAsync"
                    IsLoading="@isLoading"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="20"
                    PageSizeOptions="@(new int[] { 20, 50, 100 })"
                    Density="Density.Compact"
                    EmptyText="@GridEmptyText"
                    GridLines="DataGridGridLines.Horizontal"
                    AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    AllowColumnResize="true"
                    AllowColumnPicking="false"
                    AllowPickAllColumns="true"
                    ColumnsPickerAllowFiltering="true"
                    RowRender="@OnRowRenderPrice"
                    class="vpp-admin-grid vpp-admin-page-grid vpp-price-grid"
                    ColumnWidth="150px"
                    Style="--vpp-admin-grid-min-width: 1380px;">
        <Columns>
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Title="#" Width="52px" MinWidth="52px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                <Template Context="row">
                    @(currentSkip + displayItems.IndexOf(row) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="VPPCode" Title="@Loc["ProductCode"]" Width="124px" />
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="VPPName" Title="@Loc["ProductName"]" Width="220px" />
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="CategoryName" Title="@Loc["Category"]" Width="165px" />
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="UOMName" Title="@Loc["UOM"]" Width="78px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="Price" Title="@Loc["Price"]" Width="112px" TextAlign="TextAlign.Right" FormatString="{0:N0}">
                <Template Context="row">
                    @if (row.Price.HasValue)
                    {
                        <span>@row.Price.Value.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="text-muted" style="font-style: italic;">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="IsDefault" Title="@Loc["DefaultPrice"]" Width="126px" TextAlign="TextAlign.Center">
                <Template Context="row">
                    <RadzenSwitch TValue="bool" Value="@row.IsDefault" Disabled="true" Style="transform: scale(0.8);" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="90px" MinWidth="90px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                <Template Context="row">
                    @if (row.PriceMappingId.HasValue)
                    {
                        <div class="vpp-admin-is-deleted-cell">
                            <RadzenSwitch TValue="bool"
                                          Value="@row.IsDeleted"
                                          Change="@(async (bool value) => await SetDeletedPriceAsync(row, value))"
                                          class="isDeleteSwitch"
                                          Style="transform: scale(0.75);" />
                        </div>
                    }
                    else
                    {
                        <span class="vpp-admin-inline-note">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" />
            <RadzenDataGridColumn TItem="L06_VPPItemPriceResDTO" Title="@Loc["Actions"]" Width="128px" MinWidth="128px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-medium" HeaderCssClass="rz-col-actions rz-col-actions-medium">
                <Template Context="row">
                    <div class="vpp-admin-actions">
                        <RadzenButton Icon="edit"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      title="@GetEditPriceActionTitle(row)"
                                      Disabled="@row.IsDeleted"
                                      Click="@(() => EditPriceAsync(row))" />
                        <RadzenButton Icon="star"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Info"
                                      title="@Loc["SetDefault"]"
                                      Disabled="@(!row.PriceMappingId.HasValue || row.IsDefault || row.IsDeleted)"
                                      Click="@(() => SetDefaultAsync(row))" />
                        <RadzenButton Icon="delete_forever"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Danger"
                                      title="@Loc["HardDelete"]"
                                      Disabled="@(!row.PriceMappingId.HasValue)"
                                      Click="@(() => HardDeletePriceAsync(row))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>
