@using gtas_vpp_fe.Components.Pages.Lib.Tabs
@using gtas_vpp_shared.DTOs.Res.Library
@inject gtas_vpp_shared.DTOs.Share.GlobalClass glb
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<style>
    ul[role=tablist] {
        flex-wrap: wrap;
    }
</style>
@if (sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.ComponentCode.Equals("0001_HD") && y.IsVisible))
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="librariestab"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            <RadzenTabsItem Text="Class Definitions">
                @if (SelectedIndex == 0)
                {
                    <Tab_ClassLibrary claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Operation Categories">
                @if (SelectedIndex == 1)
                {
                    <Component_ShareGrid TType=L03_VPPCategoryResDTO @bind-Data="@operationCategories" Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Operations">
                @if (SelectedIndex == 2)
                {
                    <Component_ShareGrid TType=L04_VPPResDTO @bind-Data=@operations DicDropdownData=@CategoryDropdownDatas Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Suppliers">
                @if (SelectedIndex == 3)
                {
                    <Component_ShareGrid TType=L05_VPPSupplierResDTO @bind-Data=@suppliers Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Departments">
                @if (SelectedIndex == 4)
                {
                    <Component_ShareGrid TType=LEX02_CompanyDepartmentLocationResDTO @bind-Data=@departments Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}