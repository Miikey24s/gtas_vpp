@page "/library/{Lib?}"
@* @page "/library" *@
@layout MainLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject NotificationService NotificationService
@inject IJSRuntime js
@inject GlobalClass glb
@using gtas_vpp_shared.DTOs.Share

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>GTAS VPP - Library</PageTitle>

@if (sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.IsVisible))
{
    <Component_Library claims="@claims" Lib="@Lib" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage"/>
}
