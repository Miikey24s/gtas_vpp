@page "/report"
@layout MainLayout
@implements IDisposable
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Share
@inject PermissionState PermissionState

@rendermode InteractiveServer

<PageTitle>GTAS VPP - Report</PageTitle>

@if (CanViewReport)
{
        <RadzenStack Gap="1.5rem" class="rz-p-0 rz-p-md-3">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                <RadzenText Text="@Loc["Reports"]" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 700; color: var(--vpp-ocean-primary-dark);" />
                <RadzenButton Icon="file_download" Text="Export Report" ButtonStyle="ButtonStyle.Primary" class="ocean-btn" Disabled="true" />
            </RadzenStack>

            <RadzenRow Gap="1rem" AlignItems="AlignItems.Stretch">
                <RadzenColumn Size="12" SizeSM="6" SizeLG="4">
                    <RadzenCard class="rz-border-none rz-shadow-1 rz-p-3 stat-card">
                        <RadzenText Text="Total Orders" TextStyle="TextStyle.Overline" Style="font-weight: 700; color: var(--vpp-ocean-primary-dark);" />
                        <RadzenText Text="-" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 800;" />
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="6" SizeLG="4">
                    <RadzenCard class="rz-border-none rz-shadow-1 rz-p-3 stat-card">
                        <RadzenText Text="Total Quantity" TextStyle="TextStyle.Overline" Style="font-weight: 700; color: var(--vpp-ocean-primary-dark);" />
                        <RadzenText Text="-" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 800;" />
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="6" SizeLG="4">
                    <RadzenCard class="rz-border-none rz-shadow-1 rz-p-3 stat-card">
                        <RadzenText Text="Departments" TextStyle="TextStyle.Overline" Style="font-weight: 700; color: var(--vpp-ocean-primary-dark);" />
                        <RadzenText Text="-" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 800;" />
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" AllowClose="false" Style="border-radius: 8px;">
                Report content has not been configured yet. Export functionality coming soon.
            </RadzenAlert>
        </RadzenStack>
}
else
{
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" AllowClose="false">
            You do not have permission to view reports.
        </RadzenAlert>
}

@code {
    private bool CanViewReport => PermissionState.HasPageAccess(Config.Page_ComponentCode.PageCode.Report);

    protected override async Task OnInitializedAsync()
    {
        PermissionState.Changed += OnPermissionStateChanged;
        await PermissionState.EnsureLoadedAsync();
    }

    private void OnPermissionStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PermissionState.Changed -= OnPermissionStateChanged;
    }
}
