@using System.Security.Claims
@using gtas_vpp_fe.Components.Pages.AI.Tabs
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@inject NavigationManager NavigationManager
@inject gtas_vpp_shared.DTOs.Share.GlobalClass glb

@if (sp_Authentication_GetPermissionSinglePage != null && sp_Authentication_GetPermissionSinglePage.List_Component != null)
{
    <RadzenTabs @bind-SelectedIndex="selectedTab" Change="OnChange" RenderMode="TabRenderMode.Client">
        <Tabs>
            @foreach (var tab in TabPermissions)
            {
                <RadzenTabsItem Text="@tab.Title" Icon="@tab.Icon">
                    @switch (tab.ComponentCode)
                    {
                        case Permissions.RequestAIChat:
                            <Tab_AIChat claims="claims" sp_Authentication_GetPermissionSinglePage="sp_Authentication_GetPermissionSinglePage" />
                            break;
                        case Permissions.RequestAIVppChat:
                            <Tab_AIVPPChat claims="claims" sp_Authentication_GetPermissionSinglePage="sp_Authentication_GetPermissionSinglePage" />
                            break;
                    }
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
