@using gtas_vpp_shared.DTOs.Res.Auth
@using System.Security.Claims

<div class="ai-chat-panel" style="position:relative; height:600px; display:flex; flex-direction:column; border:1px solid var(--rz-border-color); border-radius:8px; overflow:hidden;">
    <div class="ai-chat-messages" @ref="_messagesContainer" style="flex:1; overflow-y:auto; padding:1rem;">
        @if (_messages.Count == 0)
        {
            <div class="ai-empty-state" style="color:var(--rz-text-secondary-color); text-align:center; margin-top:2rem;">Hỏi AI để tìm và gợi ý VPP phù hợp.</div>
        }
        @foreach (var msg in _messages)
        {
            <AIChatMessage Role="@msg.Role" Content="@msg.Content" SuggestedItems="@msg.SuggestedItems" Timestamp="@msg.Timestamp" />
        }
        @if (_isLoading)
        {
            <div class="ai-typing-indicator"><span>AI đang suy nghĩ</span><i></i><i></i><i></i></div>
        }
    </div>
    <div class="ai-chat-input-row" style="display:flex; gap:0.5rem; padding:0.75rem; border-top:1px solid var(--rz-border-color);">
        <input class="ai-chat-input" style="flex:1;"
               @bind="_userInput" @bind:event="oninput"
               @onkeydown="HandleKey"
               disabled="@_isLoading"
               placeholder="Nhập yêu cầu về VPP..." />
        <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium"
                      Click="@Send" Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_userInput))" />
    </div>
</div>