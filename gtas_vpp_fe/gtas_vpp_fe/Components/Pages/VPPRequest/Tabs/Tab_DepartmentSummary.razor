@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Share
@inject GlobalClass glb
@inject NotificationService NotificationService

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<style>
    .librarypagegrid .rz-grid-table > tbody > tr > td:first-child {
        width: 40px !important;
        min-width: 40px !important;
        max-width: 40px !important;
    }
</style>

@if (CanView)
{
    <RadzenStack Gap="0.75rem">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
            <RadzenFormField Text="Year" AllowFloatingLabel="false" Variant="Variant.Outlined">
                <RadzenDropDown TValue="int?" Data="@YearOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="YearFilter" Style="width:120px" />
            </RadzenFormField>
            <RadzenFormField Text="Month" AllowFloatingLabel="false" Variant="Variant.Outlined">
                <RadzenDropDown TValue="int?" Data="@MonthOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="MonthFilter" Style="width:120px" />
            </RadzenFormField>
            <RadzenFormField Text="Status" AllowFloatingLabel="false" Variant="Variant.Outlined">
                <RadzenDropDown TValue="int?" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value" @bind-Value="StatusFilter" Style="width:160px" />
            </RadzenFormField>
            <RadzenButton Icon="search" Text="Search" Size="ButtonSize.Small" Click="LoadOrdersAsync" Disabled="@IsLoading" />
            <RadzenButton Icon="refresh" Text="Reload" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="ReloadAsync" Disabled="@IsLoading" />
        </RadzenStack>

        <RadzenDataGrid TItem="VPP01_RequestHeaderResDTO" Data="@Orders" AllowPaging="true" PageSize="20" AllowVirtualization="true" AllowSorting="true" AllowColumnResize="false" ExpandMode="DataGridExpandMode.Single" IsLoading="@IsLoading" Density="Density.Compact" class="librarypagegrid">
            <Columns>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="#" Width="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                    <Template Context="row">@(Orders.IndexOf(row) + 1)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="DepartmentCode" Title="Department" Width="120px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="User Name" Width="150px" TextAlign="TextAlign.Left">
                    <Template Context="row">@glb.UserInfo?.FullName</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="VPPCode" Title="Order Code" Width="180px" TextAlign="TextAlign.Left" />
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Period" Width="100px" TextAlign="TextAlign.Center">
                    <Template Context="row">@($"{row.Y}/{row.M:00}")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Status" Width="120px" TextAlign="TextAlign.Center">
                    <Template Context="row">@GetStatusText(row.Status)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Total Line Items" Width="150px" TextAlign="TextAlign.Center">
                    <Template Context="row">@(row.TotalLines)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Total Quantity" Width="150px" TextAlign="TextAlign.Center">
                    <Template Context="row">@(row.TotalQty)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="SubmittedDate" Title="Submitted Date" Width="170px" TextAlign="TextAlign.Center" FormatString="{0:HH:mm dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="Description" Title="Note" TextAlign="TextAlign.Left" />
            </Columns>
            <Template Context="row">
                <div style="padding: 1rem; background-color: #f8f9fa;">
                    <RadzenText Text="Order Items" TextStyle="TextStyle.Subtitle2" Style="font-weight: 600; margin-bottom: 0.5rem; color: var(--rz-text-color);" />
                    <RadzenDataGrid TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Data="@(row.Items ?? new())" 
                                    AllowPaging="false" AllowVirtualization="false" AllowSorting="false" 
                                    Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                    Style="background: white; border-radius: 6px; overflow: hidden;">
                        <Columns>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                <Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPCode" Title="Item Code" Width="150px" TextAlign="TextAlign.Left" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPName" Title="Item Name" Width="350px" TextAlign="TextAlign.Left" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Qty" Title="Quantity" Width="100px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="UOMName" Title="Unit of Measure" Width="150px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Description" Title="Note" TextAlign="TextAlign.Left" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </Template>
        </RadzenDataGrid>
    </RadzenStack>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">No permission to view this tab.</RadzenAlert>
}