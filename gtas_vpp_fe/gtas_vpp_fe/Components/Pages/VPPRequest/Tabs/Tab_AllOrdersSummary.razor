@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Share
@inject GlobalClass glb
@inject NotificationService NotificationService

@rendermode InteractiveServer

<PageTitle>GTAS VPP - All Orders Summary</PageTitle>

<RadzenDialog />
<RadzenNotification />

<style>
    .librarypagegrid .rz-grid-table > tbody > tr > td:first-child {
        width: 40px !important;
        min-width: 40px !important;
        max-width: 40px !important;
    }
</style>

@if (CanView)
{
    <RadzenStack Gap="1.5rem" class="rz-p-0 rz-p-md-2">
        <div style="font-size: 1.5rem; font-weight: 700; color: var(--vpp-ocean-primary-dark); margin-bottom: 1rem;">All Orders Summary (All Departments)</div>

        <RadzenDataGrid TItem="VPP01_RequestHeaderResDTO" Data="@Orders" AllowPaging="true" PageSize="20" AllowVirtualization="true" AllowSorting="true" AllowColumnResize="false" ExpandMode="DataGridExpandMode.Single" IsLoading="@IsLoading" RowExpand="OnRowExpandAsync" Density="Density.Compact" class="librarypagegrid"
                        AllowFiltering="true"
                        AllowMultiColumnSorting="true"
                        AllowGrouping="true"
                        ColumnsPickerAllowFiltering="true"
                        AllowColumnPicking="true"
                        AllowPickAllColumns="true"
                        ShowMultiColumnSortingIndex="true"
                        AllowColumnReorder="true"
                        FilterMode="FilterMode.CheckBoxList"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand">
            <Columns>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="#" Width="60px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                    <Template Context="row">@(Orders.IndexOf(row) + 1)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.DepartmentCode)" Title="Department" Width="120px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.RequesterName)" Title="User Name" Width="150px" TextAlign="TextAlign.Left">
                    <Template Context="row">@row.RequesterName</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.VPPCode)" Title="Order Code" Width="180px" TextAlign="TextAlign.Left" />
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.Period)" Title="Period" Width="100px" TextAlign="TextAlign.Center">
                    <Template Context="row">@row.Period</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.Status)" Title="Status" Width="120px" TextAlign="TextAlign.Center">
                    <Template Context="row">@GetStatusText(row.Status)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.TotalLines)" Title="Total Line Items" Width="150px" TextAlign="TextAlign.Center">
                    <Template Context="row">@(row.TotalLines)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.TotalQty)" Title="Total Quantity" Width="150px" TextAlign="TextAlign.Center">
                    <Template Context="row">@(row.TotalQty)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.SubmittedDate)" Title="Submitted Date" Width="170px" TextAlign="TextAlign.Center" FormatString="{0:HH:mm dd/MM/yyyy}" />
                <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.Description)" Title="Note" TextAlign="TextAlign.Left" />
            </Columns>
            <Template Context="row">
                <div style="padding: 1rem; background-color: #f8f9fa;">
                    <RadzenText Text="Order Items" TextStyle="TextStyle.Subtitle2" Style="font-weight: 600; margin-bottom: 0.5rem; color: var(--rz-text-color);" />
                    @if (IsRowDetailLoading(row.Id))
                    {
                        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                    }
                    <RadzenDataGrid TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Data="@(row.Items ?? new())" 
                                    AllowPaging="false" AllowVirtualization="false" AllowSorting="false" 
                                    Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                    Style="background: white; border-radius: 6px; overflow: hidden;">
                        <Columns>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                <Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPCode" Title="Item Code" Width="150px" TextAlign="TextAlign.Left" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPName" Title="Item Name" Width="350px" TextAlign="TextAlign.Left" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Qty" Title="Quantity" Width="100px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="UOMName" Title="Unit of Measure" Width="150px" TextAlign="TextAlign.Center" />
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Description" Title="Note" TextAlign="TextAlign.Left" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </Template>
        </RadzenDataGrid>
    </RadzenStack>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">No permission to view this tab.</RadzenAlert>
}
