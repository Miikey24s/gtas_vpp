@inherits gtas_vpp_fe.Components.Pages.VPPRequest.Tabs.BaseOrderTab
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.UI
@using gtas_vpp_fe.Helpers

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (CanView)
{
    @if (IsLoading)
    {
        <SkeletonStatCards Cards="3" />
        <SkeletonGrid Rows="8" Cols="6" />
    }
    else
    {
        <RadzenStack Gap="1rem" class="rz-p-0 rz-p-md-2">

            @* ── Filter Bar ─────────────────────────────────────── *@
            <div class="vpp-filter-bar">
                <div class="vpp-filter-group">
                    <RadzenLabel Text="@Loc["Year"]" class="vpp-filter-label" />
                    <RadzenDropDown TValue="IEnumerable<int>" Data="@YearOptions" TextProperty="Text" ValueProperty="Value"
                                    @bind-Value="YearFilter" Multiple="true" Placeholder="All Years"
                                    Style="min-width: 140px;" Change="@(async _ => await OnFilterChanged())" />
                </div>
                <div class="vpp-filter-group">
                    <RadzenLabel Text="@Loc["Month"]" class="vpp-filter-label" />
                    <RadzenDropDown TValue="IEnumerable<int>" Data="@MonthOptions" TextProperty="Text" ValueProperty="Value"
                                    @bind-Value="MonthFilter" Multiple="true" Placeholder="All Months"
                                    Style="min-width: 140px;" Change="@(async _ => await OnFilterChanged())" />
                </div>
                <div class="vpp-filter-group">
                    <RadzenLabel Text="Status" class="vpp-filter-label" />
                    <RadzenDropDown TValue="IEnumerable<int>" Data="@StatusOptions" TextProperty="Text" ValueProperty="Value"
                                    @bind-Value="StatusFilter" Multiple="true" Placeholder="All"
                                    Style="min-width: 160px;" Change="@(async _ => await OnFilterChanged())" />
                </div>
                <RadzenButton Icon="refresh" Text="@Loc["Reload"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                              Click="@(async _ => await ReloadAsync())" class="vpp-filter-reload" />
            </div>

            @* ── KPI Summary ────────────────────────────────────── *@
            <div class="kpi-grid" style="--kpi-cols: 3;">
                <div class="kpi-card kpi-blue">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["TotalOrders"]</span>
                            <span class="kpi-card-icon rzi rzi-receipt-long"></span>
                        </div>
                        <div class="kpi-card-value">@TotalCount</div>
                    </div>
                </div>
                <div class="kpi-card kpi-emerald">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["TotalLineItems"]</span>
                            <span class="kpi-card-icon rzi rzi-format-list-numbered"></span>
                        </div>
                        <div class="kpi-card-value">@TotalLines</div>
                    </div>
                </div>
                <div class="kpi-card kpi-amber">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["TotalQuantity"]</span>
                            <span class="kpi-card-icon rzi rzi-inventory-2"></span>
                        </div>
                        <div class="kpi-card-value">@TotalQty</div>
                    </div>
                </div>
            </div>

            @* ── History DataGrid ───────────────────────────────── *@
            @if (TotalCount == 0 && !IsGridLoading)
            {
                <div class="vpp-empty-state">
                    <span class="vpp-empty-state-icon rzi rzi-history"></span>
                    <div class="vpp-empty-state-title">No order history</div>
                    <div class="vpp-empty-state-desc">No orders match the selected filters.</div>
                </div>
            }
            else
            {
                <div class="vpp-data-card" style="padding: 0; overflow: hidden;">
                    <RadzenDataGrid TItem="VPP01_RequestHeaderResDTO" Data="@Orders"
                                    Count="@TotalCount" LoadData="@OnLoadData"
                                    AllowPaging="true" PageSize="@PageSize"
                                    PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                                    PageSizeText="items per page"
                                    ShowPagingSummary="true"
                                    PagerHorizontalAlign="HorizontalAlign.Left"
                                    AllowSorting="true" AllowAlternatingRows="true"
                                    AllowColumnResize="true" ExpandMode="DataGridExpandMode.Single"
                                    IsLoading="@IsGridLoading" RowExpand="OnRowExpandAsync"
                                    Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                    class="vpp-order-grid"
                                    Style="border: none;">
                        <Columns>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                <Template Context="row">@(Orders.IndexOf(row) + 1)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.VPPCode)" Title="@Loc["OrderCode"]" MinWidth="160px">
                                <Template Context="row">
                                    <span class="vpp-link-text">@row.VPPCode</span>
                                    @if (row.IsAdditionalOrder)
                                    {
                                        <RadzenBadge Text="@Loc["Additional"]" BadgeStyle="BadgeStyle.Warning" IsPill="true" Style="margin-left: 6px; font-size: 0.65rem;" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.Period)" Title="@Loc["Period"]" MinWidth="90px" TextAlign="TextAlign.Center">
                                <Template Context="row">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@row.Period" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.TotalLines)" Title="@Loc["TotalLineItems"]" MinWidth="100px" TextAlign="TextAlign.Center">
                                <Template Context="row">
                                    <strong>@row.TotalLines</strong>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.TotalQty)" Title="@Loc["TotalQuantity"]" MinWidth="100px" TextAlign="TextAlign.Center">
                                <Template Context="row">
                                    <strong>@row.TotalQty</strong>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="StatusText" Title="Status" MinWidth="100px" TextAlign="TextAlign.Center" Sortable="true">
                                <Template Context="row">
                                    <span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@StatusDisplay.GetText(row.Status)</span>
                                </Template>
                            </RadzenDataGridColumn>
                            @* F-29: route through DateFormatter so the culture (vi-VN) is enforced consistently with the rest of the order tabs. *@
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.SubmittedDate)" Title="@Loc["SubmittedDate"]" MinWidth="140px" TextAlign="TextAlign.Center">
                                <Template Context="row">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="@nameof(VPP01_RequestHeaderResDTO.Description)" Title="Note" TextAlign="TextAlign.Left" />
                        </Columns>
                        <Template Context="row">
                            <div class="vpp-expand-detail">
                                <div class="vpp-expand-detail-header">
                                    <span class="rzi rzi-list-alt"></span>
                                    @Loc["OrderDetails"]
                                </div>
                                @if (IsRowDetailLoading(row.Id))
                                {
                                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height: 3px;" />
                                }
                                <RadzenDataGrid TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Data="@(row.Items ?? new())"
                                                AllowPaging="true" PageSize="10" AllowVirtualization="true"
                                                AllowSorting="false" Density="Density.Compact"
                                                GridLines="DataGridGridLines.Horizontal"
                                                class="vpp-order-grid"
                                                Style="border: 1px solid var(--vpp-border-default); border-radius: var(--vpp-radius-md);">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false">
                                            <Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPCode" Title="@Loc["ItemCode"]" Width="130px" />
                                        <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPName" Title="@Loc["ItemName"]" />
                                        <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Qty" Title="@Loc["Quantity"]" Width="90px" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="UOMName" Title="@Loc["UOM"]" Width="120px" TextAlign="TextAlign.Center" />
                                        <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Description" Title="Note" />
                                    </Columns>
                                </RadzenDataGrid>
                            </div>
                        </Template>
                    </RadzenDataGrid>
                </div>
            }
        </RadzenStack>
    }
}
else
{
    <div class="vpp-empty-state" style="padding: var(--vpp-space-8);">
        <span class="vpp-empty-state-icon rzi rzi-lock"></span>
        <div class="vpp-empty-state-title">Access Denied</div>
        <div class="vpp-empty-state-desc">You do not have permission to view the History tab.</div>
    </div>
}