@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_fe.Helpers
@inject DialogService DialogService
@inject GlobalClass glb
@inject NotificationService NotificationService

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (CanView)
{
    <RadzenStack Gap="1.5rem" class="rz-p-0 rz-p-md-4" Style="max-width: 1400px; margin: 0 auto;">
        
        <RadzenRow Gap="1rem" AlignItems="AlignItems.Stretch">
            <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                <RadzenCard class="rz-shadow-1 rz-border-radius-2 rz-background-color-primary-lighter rz-p-4 h-100 rz-border-none">
                    <RadzenText Text="Order Period" TextStyle="TextStyle.Overline" class="rz-color-primary-dark rz-mb-1" Style="font-weight: 700;" />
                    <RadzenText Text="@CurrentOrderPeriodText" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 800;" />
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                <RadzenCard class="rz-shadow-1 rz-border-radius-2 rz-background-color-warning-lighter rz-p-4 h-100 rz-border-none">
                    <RadzenText Text="Deadline" TextStyle="TextStyle.Overline" class="rz-color-warning-dark rz-mb-1" Style="font-weight: 700;" />
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenText Text="@CurrentDeadlineText" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 800;" />
                        <RadzenBadge Text="@RemainingDeadlineText" BadgeStyle="@(RemainingDeadlineDays <= 2 ? BadgeStyle.Danger : BadgeStyle.Warning)" IsPill="true" />
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                <RadzenCard class="rz-shadow-1 rz-border-radius-2 rz-background-color-base-200 rz-p-4 h-100 rz-border-none">
                    <RadzenText Text="Total Orders" TextStyle="TextStyle.Overline" class="rz-color-base-600 rz-mb-1" Style="font-weight: 700;" />
                    <RadzenText Text="@Orders.Count.ToString()" TextStyle="TextStyle.H4" class="rz-color-base-900 rz-m-0" Style="font-weight: 800;" />
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeSM="6" SizeLG="3">
                <RadzenCard class="rz-shadow-1 rz-border-radius-2 rz-background-color-success-lighter rz-p-4 h-100 rz-border-none">
                    <RadzenText Text="Total Items" TextStyle="TextStyle.Overline" class="rz-color-success-dark rz-mb-1" Style="font-weight: 700;" />
                    <RadzenText Text="@Orders.Sum(o => o.Items?.Count ?? 0).ToString()" TextStyle="TextStyle.H4" class="rz-m-0" Style="font-weight: 800;" />
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText Text="Orders List" TextStyle="TextStyle.H5" class="rz-m-0" Style="font-weight: 700; color: var(--rz-text-color);" />
            
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                @if (LastDeletedOrderId != null)
                {
                    <RadzenButton Icon="undo" Text="Undo" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" class="rz-border-radius-2" Click="@(async _ => await UndoLastDeleteAsync())" Disabled="@IsLoading" />
                }
                <RadzenButton Icon="add" Text="New Order" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" class="rz-border-radius-2 rz-px-4" Click="OpenCreateDialogAsync" Disabled="@IsLoading" />
            </RadzenStack>
        </RadzenStack>

        @if (EditorVisible)
        {
           }

        <RadzenCard class="rz-shadow-1 rz-border-radius-2 rz-p-0 rz-border-none" Style="overflow: hidden;">
            <RadzenDataGrid @ref="ordersGrid"
                            TItem="VPP01_RequestHeaderResDTO"
                            Data="@Orders"
                            AllowPaging="true"
                            PageSize="12"
                            AllowSorting="true"
                            ExpandMode="DataGridExpandMode.Multiple"
                            IsLoading="@IsLoading"
                            EmptyText="No orders found."
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.None" 
                            class="custom-minimal-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false">
                        <Template Context="row">@(Orders.IndexOf(row) + 1)</Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="VPPCode" Title="Order Code" Width="200px" >
                        <Template Context="row">
                            <span style="font-weight: 600;">@row.VPPCode</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Items" Width="100px" TextAlign="TextAlign.Center">
                        <Template Context="row">@(row.Items?.Count ?? 0)</Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Total Qty" Width="100px" TextAlign="TextAlign.Center">
                        <Template Context="row">@(row.Items?.Sum(i => i.Qty) ?? 0)</Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Status" Width="140px" TextAlign="TextAlign.Center">
                        <Template Context="row">
                            <RadzenBadge Text="@GetStatusText(row.Status)" BadgeStyle="@GetStatusBadgeStyle(row.Status)" IsPill="true" class="rz-px-3" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Property="UpdateDate" Title="Updated" Width="150px" FormatString="{0:MMM dd, yyyy HH:mm}" />

                    <RadzenDataGridColumn TItem="VPP01_RequestHeaderResDTO" Title="Action" Width="120px" TextAlign="TextAlign.Center" Sortable="false">
                        <Template Context="row">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0" JustifyContent="JustifyContent.Center">
                                @if (CanEditOrDelete(row))
                                {
                                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="@(async _ => await OpenEditDialogAsync(row))" Disabled="@IsLoading" />
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(async _ => await DeleteOrderAsync(row))" Disabled="@IsLoading" />
                                }
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>

                <Template Context="row">
                    <div class="rz-p-3 rz-background-color-base-100" style="border-radius: 8px; margin: 4px 16px 16px 16px; border: 1px solid var(--rz-base-300);">
                        <RadzenDataGrid TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO"
                                        Data="@(row.Items ?? new())"
                                        AllowPaging="false"
                                        AllowSorting="false"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal">
                            <Columns>
                                <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center">
                                    <Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPCode" Title="Code" Width="120px" />
                                <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="VPPName" Title="Name" />
                                <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="Qty" Title="Qty" Width="90px" TextAlign="TextAlign.Center" />
                                <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VPP02_RequestDetailResDTO" Property="UOMCode" Title="UOM" Width="90px" TextAlign="TextAlign.Center" />
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </Template>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenStack>
}