@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Share
@inject NotificationService NotificationService

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (CanView)
{
    <RadzenStack Gap="1rem" class="rz-p-0 rz-p-md-2">

        @* ── KPI Summary ────────────────────────────────────── *@
        @if (IsFirstLoading)
        {
            <SkeletonPage Cards="3" Rows="6" Cols="5" />
        }
        else
        {
            <div class="kpi-grid" style="--kpi-cols: 2;">
                <div class="kpi-card kpi-blue">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["TotalProducts"]</span>
                            <span class="kpi-card-icon rzi rzi-inventory-2"></span>
                        </div>
                        <div class="kpi-card-value">@ProductCount</div>
                    </div>
                </div>
                <div class="kpi-card kpi-purple">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["Categories"]</span>
                            <span class="kpi-card-icon rzi rzi-category"></span>
                        </div>
                        <div class="kpi-card-value">@(CategoryOptions.Count > 1 ? CategoryOptions.Count - 1 : 0)</div>
                    </div>
                </div>
            </div>
        }

        @* ── DataGrid Section ── *@
        @if (!IsFirstLoading && ProductCount == 0 && !IsGridLoading)
        {
            <VppEmptyState Icon="inventory_2"
                           Title="@Loc["NoData"]"
                           Description="@Loc["NoCatalogProductsMatchQuery"]"
                           PrimaryText="@Loc["Reload"]"
                           PrimaryAction="@(async _ => await ReloadAsync())" />
        }
        else
        {
            <div class="vpp-data-card" style="padding: 0; overflow: hidden; @(IsFirstLoading ? "display: none;" : string.Empty)">
                <RadzenDataGrid @ref="productGrid" TItem="Tab_ProductCatalog.ProductItem" Data="@Products"
                                Count="@ProductCount"
                                LoadData="@LoadProductsAsync"
                                AllowPaging="true" PageSize="20"
                                PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                                PageSizeText="@Loc["ItemsPerPage"]"
                                AllowSorting="true" AllowAlternatingRows="true"
                                AllowColumnResize="true" IsLoading="@IsGridLoading"
                                AllowFiltering="true"
                                AllowMultiColumnSorting="true"
                                ShowMultiColumnSortingIndex="true"
                                AllowColumnReorder="true"
                                FilterMode="FilterMode.CheckBoxList"
                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                ShowPagingSummary="true"
                                PagerHorizontalAlign="HorizontalAlign.Left"
                                Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                class="vpp-order-grid"
                                Style="border: none;">
                    <Columns>
                        <RadzenDataGridColumn TItem="Tab_ProductCatalog.ProductItem" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="row">@(_currentSkip + Products.IndexOf(row) + 1)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Tab_ProductCatalog.ProductItem" Property="VPPCode" Title="@Loc["ProductCode"]" MinWidth="120px" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <span class="vpp-link-text">@row.VPPCode</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Tab_ProductCatalog.ProductItem" Property="VPPName" Title="@Loc["ProductName"]" MinWidth="200px" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <span style="font-weight: var(--vpp-font-weight-medium);">@row.VPPName</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Tab_ProductCatalog.ProductItem" Property="VPPCategoryName" Title="@Loc["Category"]" MinWidth="140px" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@row.VPPCategoryName" IsPill="true" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Tab_ProductCatalog.ProductItem" Property="UOMName" Title="@Loc["UOM"]" MinWidth="100px" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="Tab_ProductCatalog.ProductItem" Property="Description" Title="@Loc["Description"]" MinWidth="200px" TextAlign="TextAlign.Left" />
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    </RadzenStack>
}
else
{
    <VppEmptyState Icon="lock"
                   Title="@Loc["AccessDenied"]"
                   Description="@Loc["NoPermission"]" />
}