@using gtas_vpp_fe.Components.Pages.VPPRequest.Tabs
@rendermode @(new InteractiveServerRenderMode(prerender:false))

<style>
    ul[role=tablist] {
        flex-wrap: wrap;
    }
</style>

@if (HasAnyVisibleDashboardTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="librariestab"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            <RadzenTabsItem Text="Orders" 
                            Visible="@HasVisibleComponent(Config.Page_ComponentCode.ComponentCode.RequestOrder)">
                @if (SelectedIndex == 0)
                {
                    <Tab_Orders claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="History"
                            Visible="@HasVisibleComponent(Config.Page_ComponentCode.ComponentCode.RequestHistory)">
                @if (SelectedIndex == 1)
                {
                    <Tab_History claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Product Catalog"
                            Visible="@HasVisibleComponent(Config.Page_ComponentCode.ComponentCode.RequestProductCatalog)">
                @if (SelectedIndex == 2)
                {
                    <Tab_ProductCatalog claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Department Summary"
                            Visible="@HasVisibleComponent(Config.Page_ComponentCode.ComponentCode.RequestDepartmentSummary)">
                @if (SelectedIndex == 3)
                {
                    <Tab_DepartmentSummary claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="All Orders Summary"
                            Visible="@HasVisibleComponent(Config.Page_ComponentCode.ComponentCode.RequestAllOrdersSummary)">
                @if (SelectedIndex == 4)
                {
                    <Tab_AllOrdersSummary claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Admin Approval"
                            Visible="@HasVisibleComponent(Config.Page_ComponentCode.ComponentCode.RequestApproval)">
                @if (SelectedIndex == 5)
                {
                    <Tab_AdminApproval claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}
