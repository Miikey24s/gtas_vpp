@using gtas_vpp_fe.Components.Pages.VPPRequest.Tabs
@using gtas_vpp_shared.Constants
@rendermode @(new InteractiveServerRenderMode(prerender:false))

<style>
    ul[role=tablist] {
        flex-wrap: wrap;
    }
</style>

@if (HasAnyAuthorizedDashboardTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="librariestab"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex="@SelectedIndex">
        <Tabs>
            <AuthorizeView Policy="@Permissions.RequestOrder" Context="ordersTabAuth">
                <RadzenTabsItem Text="My Orders">
                    @if (IsActiveTab(0))
                    {
                        <Tab_Orders claims="@claims" />
                    }
                </RadzenTabsItem>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.RequestHistory" Context="historyTabAuth">
                <RadzenTabsItem Text="History">
                    @if (IsActiveTab(1))
                    {
                        <Tab_History claims="@claims" />
                    }
                </RadzenTabsItem>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.RequestProductCatalog" Context="productCatalogTabAuth">
                <RadzenTabsItem Text="Product Catalog">
                    @if (IsActiveTab(2))
                    {
                        <Tab_ProductCatalog claims="@claims" />
                    }
                </RadzenTabsItem>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.RequestDepartmentSummary" Context="departmentSummaryTabAuth">
                <RadzenTabsItem Text="Department Summary">
                    @if (IsActiveTab(3))
                    {
                        <Tab_DepartmentSummary claims="@claims" />
                    }
                </RadzenTabsItem>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.RequestAllOrdersSummary" Context="allOrdersSummaryTabAuth">
                <RadzenTabsItem Text="All Orders Summary">
                    @if (IsActiveTab(4))
                    {
                        <Tab_AllOrdersSummary claims="@claims" />
                    }
                </RadzenTabsItem>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.RequestAdminApproval" Context="adminApprovalTabAuth">
                <RadzenTabsItem Text="Admin Approval">
                    @if (IsActiveTab(5))
                    {
                        <Tab_AdminApproval claims="@claims" />
                    }
                </RadzenTabsItem>
            </AuthorizeView>
        </Tabs>
    </RadzenTabs>
}
