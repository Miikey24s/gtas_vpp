@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Share
@using Microsoft.AspNetCore.Components.Forms

<RadzenTemplateForm TItem="OrderCreateContext" EditContext="@_editContext" class="wizard-step wizard-step-setup">
    <div class="vpp-wizard-setup-grid">
        <section class="vpp-data-card vpp-wizard-context-card">
            <div class="vpp-wizard-panel-head">
                <div>
                    <div class="vpp-wizard-panel-title-row">
                        <RadzenIcon Icon="@CurrentModeIcon" Style="color: var(--vpp-primary-500);" aria-hidden="true" />
                        <span class="vpp-wizard-panel-title">Request context</span>
                    </div>
                    <p class="vpp-wizard-panel-copy">Confirm the target cycle, request type, and the note that approvers will see before you start building the cart.</p>
                </div>
                <RadzenBadge Text="@CurrentModeText" BadgeStyle="@CurrentModeBadgeStyle" IsPill="true" />
            </div>

            <div class="vpp-wizard-type-grid">
                <div class="vpp-wizard-type-pill @(GetTypeClass("new"))">
                    <RadzenIcon Icon="note_add" aria-hidden="true" />
                    <div>
                        <strong>New</strong>
                        <span>Regular monthly request for the active period.</span>
                    </div>
                </div>
                <div class="vpp-wizard-type-pill @(GetTypeClass("copy"))">
                    <RadzenIcon Icon="content_copy" aria-hidden="true" />
                    <div>
                        <strong>Copy</strong>
                        <span>Start from the latest order and adjust only what changed.</span>
                    </div>
                </div>
                <div class="vpp-wizard-type-pill @(GetTypeClass("additional"))">
                    <RadzenIcon Icon="playlist_add" aria-hidden="true" />
                    <div>
                        <strong>Additional</strong>
                        <span>Closed period request that moves through admin approval.</span>
                    </div>
                </div>
            </div>

            @if (Context.IsAdditional)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-3">
                    <span>This cycle is already closed. Provide a reason so the additional request can be routed for approval.</span>
                </RadzenAlert>
            }

            <RadzenFormField Text="@(Context.IsAdditional ? "Reason for additional order *" : "Notes for approver")" Variant="Variant.Outlined" Style="width: 100%;">
                <ChildContent>
                    <RadzenTextArea Name="Description"
                                    @bind-Value="Context.Description"
                                    Rows="4"
                                    Style="width: 100%;" />
                </ChildContent>
                <Helper>
                    @if (Context.IsAdditional)
                    {
                        <span class="vpp-wizard-field-hint">This field is required for additional orders.</span>
                    }
                    else
                    {
                        <span class="vpp-wizard-field-hint">Optional note for delivery context, department needs, or reviewer guidance.</span>
                    }
                </Helper>
            </RadzenFormField>

            <RadzenRequiredValidator Component="Description"
                                     Text="Reason is required for additional orders."
                                     Visible="@Context.IsAdditional"
                                     Style="position: absolute;" />
        </section>

        <section class="vpp-data-card vpp-wizard-brief-card">
            <div class="vpp-wizard-panel-head">
                <div>
                    <div class="vpp-wizard-panel-title-row">
                        <RadzenIcon Icon="schedule" Style="color: var(--vpp-primary-500);" aria-hidden="true" />
                        <span class="vpp-wizard-panel-title">Period window</span>
                    </div>
                    <p class="vpp-wizard-panel-copy">The backend period service already resolved the correct cycle. This request will be submitted against the window below.</p>
                </div>
            </div>

            <div class="vpp-wizard-period-window">
                <span class="vpp-wizard-summary-label">Target period</span>
                <strong>@TargetPeriodText</strong>
                <span class="vpp-wizard-summary-meta">@TargetWindowText</span>
            </div>

            <div class="vpp-wizard-brief-list">
                <div class="vpp-wizard-brief-item">
                    <span class="vpp-wizard-brief-index">1</span>
                    <div>
                        <strong>Cycle opens</strong>
                        <span>@($"00:00 on {DateFormatter.Format(TargetPeriodStartDate, DateFormatter.ShortDate)}")</span>
                    </div>
                </div>
                <div class="vpp-wizard-brief-item">
                    <span class="vpp-wizard-brief-index">2</span>
                    <div>
                        <strong>Cycle closes</strong>
                        <span>@($"23:59 on {DateFormatter.Format(TargetPeriodEndDate, DateFormatter.ShortDate)}")</span>
                    </div>
                </div>
                <div class="vpp-wizard-brief-item">
                    <span class="vpp-wizard-brief-index">3</span>
                    <div>
                        <strong>Boundary rule</strong>
                        <span>Exactly at 00:00 on day 5, the system moves into the new monthly period.</span>
                    </div>
                </div>
            </div>
        </section>
    </div>
</RadzenTemplateForm>

@code {
    [CascadingParameter] public OrderCreateContext Context { get; set; } = default!;

    [Parameter] public string TargetPeriodText { get; set; } = string.Empty;
    [Parameter] public string TargetWindowText { get; set; } = string.Empty;
    [Parameter] public DateTime TargetPeriodStartDate { get; set; }
    [Parameter] public DateTime TargetPeriodEndDate { get; set; }

    private EditContext? _editContext;
    private OrderCreateContext? _boundContext;

    private string CurrentModeIcon => Context.IsEdit
        ? "edit"
        : Context.IsCopy
            ? "content_copy"
            : Context.IsAdditional
                ? "playlist_add"
                : "note_add";

    private string CurrentModeText => Context.IsEdit
        ? "Editing existing order"
        : Context.IsCopy
            ? "Copy from previous"
            : Context.IsAdditional
                ? "Additional approval flow"
                : "Regular monthly request";

    private BadgeStyle CurrentModeBadgeStyle => Context.IsAdditional ? BadgeStyle.Warning : BadgeStyle.Primary;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_boundContext, Context))
        {
            _boundContext = Context;
            _editContext = new EditContext(Context);
        }
    }

    public bool ValidateStep()
    {
        if (_editContext is null)
        {
            return !Context.IsAdditional || !string.IsNullOrWhiteSpace(Context.Description);
        }

        return _editContext.Validate();
    }

    private string GetTypeClass(string type)
    {
        var isActive = type switch
        {
            "additional" => Context.IsAdditional,
            "copy" => Context.IsCopy,
            "new" => !Context.IsAdditional && !Context.IsCopy && !Context.IsEdit,
            _ => false
        };

        return isActive ? "is-active" : string.Empty;
    }
}
