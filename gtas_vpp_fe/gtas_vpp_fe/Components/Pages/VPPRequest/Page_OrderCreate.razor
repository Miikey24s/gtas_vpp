@page "/dashboard/order-create"
@layout MainLayout
@using gtas_vpp_fe.Helpers
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.AI

@rendermode InteractiveServer

<PageTitle>GTAS VPP - @(IsEdit ? "Edit Order" : (IsCopyFromPrevious ? "Copy Order" : (IsAdditional ? "Additional Order" : "Create Order")))</PageTitle>

<CascadingValue Value="Context">
<div class="vpp-wizard">
    <RadzenStack Gap="1rem" Style="padding: var(--vpp-space-4);">

        @* Back button *@
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenButton Icon="arrow_back" Text="@Loc["BackToOrders"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@GoBack" />
            <div class="vpp-wizard-badge-bar">
                @if (Context.SelectedItems.Count > 0)
                {
                    <RadzenBadge Text="@($"{Context.SelectedItems.Count} items")" BadgeStyle="BadgeStyle.Primary" IsPill="true" />
                    <RadzenBadge Text="@($"Total: {Context.TotalQty}")" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                }
                @if (LastDraftSavedAt.HasValue)
                {
                    <RadzenText Text="@($"Auto-saved {LastDraftSavedAt:HH:mm:ss}")" TextStyle="TextStyle.Caption" Style="color: var(--vpp-text-tertiary);" />
                }
            </div>
        </RadzenStack>

        @* 3-Step Wizard *@
        <RadzenSteps @bind-SelectedIndex="currentStep" Change="@((i) => Context.NotifyStateChanged())">
            <Steps>
                <RadzenStep Text="@Loc["OrderContext"]">
                    <OrderCreateStep1 />
                </RadzenStep>
                <RadzenStep Text="@Loc["SelectProducts"]">
                    <OrderCreateStep2 />
                </RadzenStep>
                <RadzenStep Text="@Loc["ReviewSubmit"]">
                    <OrderCreateStep3 />
                </RadzenStep>
            </Steps>
        </RadzenSteps>

        @* Navigation buttons *@
        <div class="vpp-wizard-nav">
            <div class="vpp-wizard-nav-left">
                <RadzenButton Text="@Loc["Cancel"]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@GoBack" />
            </div>
            <div class="vpp-wizard-nav-right">
                @if (currentStep > 0)
                {
                    <RadzenButton Icon="arrow_back" Text="@Loc["Previous"]" ButtonStyle="ButtonStyle.Base" Click="@(() => currentStep--)"/>
                }
                @if (currentStep < 2)
                {
                    <RadzenButton Icon="arrow_forward" Text="@Loc["Next"]" ButtonStyle="ButtonStyle.Primary" class="vpp-wizard-btn-next" 
                                  Click="@(() => currentStep++)" />
                }
                else
                {
                    <RadzenButton Icon="save" Text="@(IsAdditional ? "Submit for Approval" : (IsEdit ? "Update Order" : "Create Order"))" 
                                  ButtonStyle="ButtonStyle.Primary" class="vpp-wizard-btn-next" Disabled="@IsSaving" Click="@SubmitAsync" />
                }
            </div>
        </div>
    </RadzenStack>
</div>
</CascadingValue>