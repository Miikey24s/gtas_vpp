@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.AI
@using gtas_vpp_fe.Services

<div class="wizard-step wizard-step-products">

    @* ── Order Context (merged from Step1) ────────────────────── *@
    <div class="vpp-data-card rz-mb-3" style="padding: var(--vpp-space-4);">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
            @if (Context.IsEdit)
            {
                <RadzenIcon Icon="edit" Style="color: var(--vpp-primary-500);" />
                <RadzenText Text="Editing Order" TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="font-weight: 600;" />
            }
            else if (Context.IsAdditional)
            {
                <RadzenIcon Icon="add_circle" Style="color: var(--rz-warning);" />
                <RadzenText Text="Additional Order" TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="font-weight: 600;" />
            }
            else
            {
                <RadzenIcon Icon="note_add" Style="color: var(--vpp-primary-500);" />
                <RadzenText Text="New Order" TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="font-weight: 600;" />
            }
        </RadzenStack>

        @if (Context.IsAdditional)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-2" Style="padding: 0.5rem 0.75rem;">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                    Period closed — requires Admin approval.
                </RadzenText>
            </RadzenAlert>
        }

        <RadzenFormField Text="@(Context.IsAdditional ? "Reason *" : "Notes")" Variant="Variant.Outlined" Style="width: 100%;">
            <RadzenTextArea @bind-Value="Context.Description" Rows="2" Style="width: 100%;" />
        </RadzenFormField>
    </div>

    @* ── AI Smart Search ──────────────────────────────────────── *@
    @if (glb.IsAIEnabled)
    {
        <RadzenCard class="vpp-card-ai rz-mb-3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <RadzenStack Gap="0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="auto_awesome" Style="font-size: 1.25rem;" />
                    <RadzenText Text="@Loc["AISmartSearch"]" TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="font-weight: 700;" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenTextBox @bind-Value="AISearchText" Placeholder="@Loc["AiSearchPlaceholder"]"
                                   Style="flex: 1; background: white; color: black;"
                                   @onkeydown="@OnEnter" />
                    <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Light" Click="@OnAISearchAsync" Disabled="@IsAILoading" />
                </RadzenStack>

                @if (IsAILoading)
                {
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height: 3px;" />
                }

                @if (AISuggestions.Any())
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                        @foreach (var item in AISuggestions)
                        {
                            var isAlreadySelected = Context.SelectedItems.Any(x => x.VPPId == item.VPPId);
                            <RadzenButton Text="@($"+ {item.VPPName}")"
                                          Icon="@(isAlreadySelected ? "check" : "add")"
                                          ButtonStyle="@(isAlreadySelected ? ButtonStyle.Success : ButtonStyle.Light)"
                                          Variant="Variant.Outlined"
                                          Size="ButtonSize.Small"
                                          Disabled="@isAlreadySelected"
                                          Click="@(async _ => await AddSuggestedItemAsync(item))"
                                          Style="@(isAlreadySelected ? "opacity: 0.6;" : "")" />
                        }
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @* ── Split Layout: Catalog (left) | Selected Items (right) ── *@
    <div class="vpp-wizard-split">

        @* ── LEFT: Product Catalog ───────────────────────────── *@
        <div class="vpp-wizard-split-left">
            <div class="vpp-data-card" style="padding: 0; overflow: hidden; height: 100%; display: flex; flex-direction: column;">
                <div style="padding: var(--vpp-space-2) var(--vpp-space-3); border-bottom: 1px solid var(--vpp-border-default);">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                            <RadzenIcon Icon="inventory_2" Style="color: var(--vpp-primary-500); font-size: 1.1rem;" />
                            <RadzenText Text="Product Catalog" TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="font-weight: 600;" />
                        </RadzenStack>
                        @if (ProductCount > 0)
                        {
                            <RadzenBadge Text="@($"{ProductCount}")" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                        }
                    </RadzenStack>
                </div>

                <RadzenDataGrid @ref="productGrid"
                                TItem="ProductOption"
                                Data="@ProductOptions"
                                Count="@ProductCount"
                                LoadData="@LoadProductsAsync"
                                IsLoading="@IsLoadingProducts"
                                AllowPaging="true"
                                PageSize="20"
                                PageSizeOptions="@(new int[] { 10, 20, 50 })"
                                ShowPagingSummary="true"
                                PagerHorizontalAlign="HorizontalAlign.Left"
                                AllowSorting="true"
                                AllowFiltering="true"
                                FilterMode="FilterMode.CheckBoxList"
                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                AllowColumnResize="true"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                RowRender="@OnRowRender"
                                Style="border: none; flex: 1; min-height: 0;">
                    <Columns>
                        <RadzenDataGridColumn TItem="ProductOption" Property="VPPCode" Title="Code" MinWidth="100px" />
                        <RadzenDataGridColumn TItem="ProductOption" Property="VPPName" Title="Name" MinWidth="150px" />
                        <RadzenDataGridColumn TItem="ProductOption" Property="VPPCategoryName" Title="Category" MinWidth="110px" />
                        <RadzenDataGridColumn TItem="ProductOption" Property="UOMName" Title="UOM" MinWidth="70px" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ProductOption" Title="" Width="55px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                @{
                                    var isSelected = Context.SelectedItems.Any(x => x.VPPId == row.Id);
                                }
                                <RadzenButton Icon="@(isSelected ? "check" : "add")"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="@(isSelected ? ButtonStyle.Success : ButtonStyle.Primary)"
                                              Variant="Variant.Text"
                                              Disabled="@isSelected"
                                              Click="@(_ => AddProduct(row))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>

        @* ── RIGHT: Selected Items ───────────────────────────── *@
        <div class="vpp-wizard-split-right">
            <div class="vpp-data-card" style="padding: 0; overflow: hidden; height: 100%; display: flex; flex-direction: column;">
                <div style="padding: var(--vpp-space-2) var(--vpp-space-3); border-bottom: 1px solid var(--vpp-border-default);">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                            <RadzenIcon Icon="shopping_cart" Style="color: var(--vpp-primary-500); font-size: 1.1rem;" />
                            <RadzenText Text="Selected" TextStyle="TextStyle.Subtitle2" class="rz-m-0" Style="font-weight: 600;" />
                        </RadzenStack>
                        @if (Context.SelectedItems.Count > 0)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <RadzenBadge Text="@($"{Context.SelectedItems.Count}")" BadgeStyle="BadgeStyle.Primary" IsPill="true" />
                                <RadzenBadge Text="@($"Qty: {Context.TotalQty}")" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                </div>

                @if (Context.SelectedItems.Count == 0)
                {
                    <div class="vpp-empty-state" style="padding: var(--vpp-space-4); flex: 1;">
                        <span class="vpp-empty-state-icon rzi rzi-add-shopping-cart" style="font-size: 2rem;"></span>
                        <div class="vpp-empty-state-title" style="font-size: 0.9rem;">No items</div>
                        <div class="vpp-empty-state-desc" style="font-size: 0.8rem;">Click <strong>+</strong> to add products.</div>
                    </div>
                }
                else
                {
                    <div style="flex: 1; overflow-y: auto;">
                        <RadzenDataGrid TItem="OrderCreateContext.SelectedItem"
                                        Data="@Context.SelectedItems"
                                        AllowPaging="false"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        Style="border: none;">
                            <Columns>
                                <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Title="#" Width="35px" TextAlign="TextAlign.Center" Sortable="false">
                                    <Template Context="item">@(Context.SelectedItems.IndexOf(item) + 1)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Property="VPPCode" Title="Code" MinWidth="90px" />
                                <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Property="VPPName" Title="Name" MinWidth="120px" />
                                <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Title="Qty" Width="80px" TextAlign="TextAlign.Center" Sortable="false">
                                    <Template Context="item">
                                        <RadzenNumeric TValue="int" @bind-Value="item.Qty" Min="1" Max="9999"
                                                       Style="width: 60px;" ShowUpDown="true"
                                                       Change="@(_ => Context.NotifyStateChanged())" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Title="" Width="40px" TextAlign="TextAlign.Center" Sortable="false">
                                    <Template Context="item">
                                        <RadzenButton Icon="close" Size="ButtonSize.ExtraSmall"
                                                      ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                      Click="@(_ => RemoveItem(item))" Title="Remove" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public OrderCreateContext Context { get; set; } = default!;
    [Inject] public IAPIServices _apiServices { get; set; } = default!;
    [Inject] public GlobalClass glb { get; set; } = default!;

    public sealed class ProductOption
    {
        public Guid Id { get; set; }
        public string? VPPCode { get; set; }
        public string? VPPName { get; set; }
        public string? UOMCode { get; set; }
        public string? UOMName { get; set; }
        public string? VPPCategoryName { get; set; }
    }

    public bool IsLoadingProducts { get; set; }
    public int ProductCount { get; set; }
    public bool IsAILoading { get; set; }
    public string? AISearchText { get; set; }
    public List<AISuggestedItemDTO> AISuggestions { get; set; } = new();
    public List<ProductOption> ProductOptions { get; set; } = new();
    public RadzenDataGrid<ProductOption>? productGrid;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && productGrid != null)
            await productGrid.Reload();
    }

    private async Task LoadProductsAsync(LoadDataArgs args)
    {
        IsLoadingProducts = true;
        try
        {
            var queryParams = new List<string>();

            if (args.Skip.HasValue && args.Skip.Value > 0)
                queryParams.Add($"skip={args.Skip.Value}");
            queryParams.Add($"top={args.Top ?? 20}");

            var search = args.Filters?.FirstOrDefault()?.FilterValue?.ToString();
            if (!string.IsNullOrWhiteSpace(search))
                queryParams.Add($"search={Uri.EscapeDataString(search)}");

            var sort = args.Sorts?.FirstOrDefault();
            if (sort != null)
                queryParams.Add($"orderby={Uri.EscapeDataString($"{sort.Property} {sort.SortOrder?.ToString().ToLowerInvariant()}")}");

            var endpoint = $"/api/VPPRequest/products?{string.Join("&", queryParams)}";
            var result = await _apiServices.GetFromApiWithTotalCountAsync<List<ProductOption>>(endpoint);
            ProductOptions = result.Data ?? new();
            ProductCount = result.TotalCount;
        }
        finally
        {
            IsLoadingProducts = false;
        }
    }

    private void AddProduct(ProductOption row)
    {
        if (!Context.SelectedItems.Any(x => x.VPPId == row.Id))
        {
            Context.SelectedItems.Add(new()
            {
                VPPId = row.Id,
                VPPCode = row.VPPCode,
                VPPName = row.VPPName,
                Qty = 1
            });
            Context.NotifyStateChanged();
            StateHasChanged();
        }
    }

    private void RemoveItem(OrderCreateContext.SelectedItem item)
    {
        Context.SelectedItems.Remove(item);
        Context.NotifyStateChanged();
        StateHasChanged();
    }

    private void OnRowRender(RowRenderEventArgs<ProductOption> args)
    {
        if (Context.SelectedItems.Any(x => x.VPPId == args.Data.Id))
        {
            args.Attributes.Add("class", "vpp-wizard-row-selected");
        }
    }

    private async Task OnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnAISearchAsync();
    }

    private async Task OnAISearchAsync()
    {
        if (string.IsNullOrWhiteSpace(AISearchText)) return;
        IsAILoading = true;
        try
        {
            AISuggestions = await _apiServices.GetFromApiAsync<List<AISuggestedItemDTO>>($"VPP/ai/suggest?query={Uri.EscapeDataString(AISearchText)}") ?? new();
        }
        finally { IsAILoading = false; }
    }

    private async Task AddSuggestedItemAsync(AISuggestedItemDTO item)
    {
        if (!Context.SelectedItems.Any(x => x.VPPId == item.VPPId))
        {
            Context.SelectedItems.Add(new() { VPPId = item.VPPId, VPPCode = item.VPPCode, VPPName = item.VPPName, Qty = 1 });
            Context.NotifyStateChanged();
            await InvokeAsync(StateHasChanged);
        }
    }
}
