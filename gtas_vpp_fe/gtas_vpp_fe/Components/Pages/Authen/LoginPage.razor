@page "/Account/Login"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout LoginLayout
@inject NavigationManager UriHelper
@inject NotificationService NotificationService

<PageTitle>GTAS VPP - @Loc["Login"]</PageTitle>

<div class="vpp-login-page">
    <div class="vpp-login-shell">
        <div class="vpp-login-art" aria-hidden="true">
            <img class="vpp-login-art-image" src="@Assets["images/login-bg.jpeg"]" alt="" />
        </div>

        <section class="vpp-login-card" aria-labelledby="vpp-login-title">
            <div class="vpp-login-card-inner">
                <div class="vpp-login-header">
                    <h1 class="vpp-login-title" id="vpp-login-title">
                        @Loc["Login"]
                        <span class="vpp-login-title-accent">GTAS VPP</span>
                    </h1>
                </div>

                <RadzenTemplateForm TItem="sp_Authentication_LoginReqDTO" Data="sp_Authentication_Login" Submit="LoginSubmit" class="vpp-login-form">
                    <AntiforgeryToken></AntiforgeryToken>

                    <div class="vpp-login-field">
                        <label class="vpp-login-label">@Loc["Username"]</label>
                        <RadzenTextBox class="vpp-login-control"
                                       Name="Username"
                                       Disabled="@isLoading"
                                       @bind-Value=@sp_Authentication_Login.Username
                                       @onkeyup="@(args => LoginOnkeyup(args, sp_Authentication_Login))" />
                    </div>

                    <div class="vpp-login-field">
                        <label class="vpp-login-label">@Loc["Password"]</label>
                        <RadzenTextBox Visible="@(!isShowPass)"
                                       class="vpp-login-control"
                                       Name="PasswordText"
                                       Disabled="@isLoading"
                                       @bind-Value=@sp_Authentication_Login.Password
                                       @onkeyup="@(args => LoginOnkeyup(args, sp_Authentication_Login))" />
                        <RadzenPassword Visible="@isShowPass"
                                        class="vpp-login-control"
                                        Name="Password"
                                        Disabled="@isLoading"
                                        @bind-Value=@sp_Authentication_Login.Password
                                        @onkeyup="@(args => LoginOnkeyup(args, sp_Authentication_Login))" />
                    </div>

                    @if (isShowServer)
                    {
                        <div class="vpp-login-field">
                            <label class="vpp-login-label">@Loc["Server"]</label>
                            <RadzenDropDown Data=@Servers
                                            class="vpp-login-control"
                                            @bind-Value=@sp_Authentication_Login.selected_server />
                        </div>
                    }

                    <RadzenButton Text="@Loc["Login"]"
                                  ButtonType="ButtonType.Submit"
                                  IsBusy="@isLoading"
                                  class="vpp-login-btn" />
                </RadzenTemplateForm>
            </div>
        </section>
    </div>
</div>
