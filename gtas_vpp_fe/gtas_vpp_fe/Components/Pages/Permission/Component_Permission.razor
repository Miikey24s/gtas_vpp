@using gtas_vpp_fe.Components.Pages.Permission.Tabs
@rendermode @(new InteractiveServerRenderMode(prerender:false))

<style>
    ul[role=tablist] {
        flex-wrap: wrap;
    }
</style>

@if (HasAnyVisiblePermissionTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="librariestab"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            <RadzenTabsItem Text="User Group" Visible="@HasAdminView">
                @if (SelectedIndex == 0)
                {
                    <Tab_User claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
            <RadzenTabsItem Text="Group/Page Permission" Visible="@(HasPermissionView || HasAdminView)">
                @if (SelectedIndex == 1)
                {
                    <Tab_PagePermission claims="@claims" sp_Authentication_GetPermissionSinglePage="@sp_Authentication_GetPermissionSinglePage" />
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}
