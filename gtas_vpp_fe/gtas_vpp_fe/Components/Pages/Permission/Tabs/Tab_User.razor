@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_shared.DTOs.Share
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject NotificationService NotificationService
@inject IJSRuntime js
@using gtas_vpp_shared.DTOs.Res
@using gtas_vpp_fe.Helpers

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (sp_Authentication_GetPermissionSinglePage!.List_Component.Any(y => y.ComponentCode!.Equals(Permissions.PermissionUser) && y.IsVisible))
{
    @if (glb.isBusyPage)
    {
        <SkeletonGrid Rows="8" Cols="7" />
    }
    else
    {
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenDataGrid @ref="griduser"
                            @bind-Value=@selected_UserList
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowMultiColumnSorting="true"
                            AllowVirtualization="true"
                            AllowAlternatingRows="false"
                            AllowGrouping="false"
                            ColumnsPickerAllowFiltering=true
                            AllowColumnPicking=true
                            AllowPickAllColumns="true"
                            ShowMultiColumnSortingIndex=true
                            AllowSorting="true"
                            AllowColumnReorder="true"
                            AllowPaging="true"
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 20, 50, 100 })"
                            Count="@userCount"
                            LoadData="@LoadUsersAsync"
                            LoadColumnFilterData="@LoadUserFilterDataAsync"
                            IsLoading="@isUserLoading"
                            FilterMode="FilterMode.CheckBoxList"
                            Density="Density.Compact"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            GridLines="DataGridGridLines.Horizontal"
                            class="librarypagegrid permission-user-grid vpp-admin-grid"
                            Style="--vpp-admin-grid-min-width: 1380px; height: min(720px, calc(100vh - 175px));"
                            TItem="sp_Authentication_TabUser_UserList"
                            Data="@_sp_Authentication_TabUser_UserList"
                            ColumnWidth="150px"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            RowRender="@OnRowRenderUser"
                            RowDoubleClick="@OnRowDoubleClick">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="permission-grid-toolbar">
                        <RadzenFormField AllowFloatingLabel=true Text="@Loc["Search"]" Variant="Variant.Text" class="permission-search-field">
                            <ChildContent>
                                <RadzenTextBox Value="@SearchText"
                                               aria-label="@Loc["Search"]"
                                               Change="@(arg => TextBoxOnChange(arg))"
                                               ValueChanged="@((string value) => SearchText = value)"
                                               ValueExpression="() => SearchText"
                                               @oninput="(args => SearchText = ((ChangeEventArgs)args).Value?.ToString() ?? string.Empty)"
                                               @onkeypress=@(arg => SearchTextOnKeyUp(arg)) />
                            </ChildContent>
                            <End>
                                <RadzenStack Orientation="Orientation.Horizontal" class="rz-mb-0 rz-pb-0">
                                    <RadzenButton Size="ButtonSize.ExtraSmall" Disabled=@glb.isBusyPage ButtonStyle="ButtonStyle.Secondary" Icon="filter_alt_off" Click="ButtonOnClick_Clear" />
                                    <RadzenButton Size="ButtonSize.ExtraSmall" Disabled=@glb.isBusyPage Icon="search" Click="ButtonOnClick_SearchUser" />
                                </RadzenStack>
                            </End>
                        </RadzenFormField>
                        <RadzenButton Icon="refresh" Text="@Loc["Reload"]" Size="ButtonSize.Small" class="rz-mb-auto rz-mt-auto" Click="ButtonOnClick_Reload" />
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Width="52px" MinWidth="52px" Title="#" Reorderable="false" Filterable="false" Groupable="false" Pickable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="context">
                            @(currentUserSkip + _sp_Authentication_TabUser_UserList.IndexOf(context) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["IsDeleted"]" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted" Width="150px" MinWidth="150px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            <div class="vpp-admin-is-deleted-cell">
                                <span class="@(data.IsDeleted ? "vpp-admin-status-badge is-true" : "vpp-admin-status-badge is-false")">
                                    @(data.IsDeleted ? "True" : "False")
                                </span>
                                <RadzenSwitch @bind-Value=@data.IsDeleted Change="@(arg => SwitchOnChange_IsDelete(data))" class="isDeleteSwitch" Style="transform: scale(0.75);" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["UserLogin"]" Property="@nameof(sp_Authentication_TabUser_UserList.UserLogin)" Width="130px" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["FullName"]" Property="@nameof(sp_Authentication_TabUser_UserList.FullName)" Width="180px" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["Email"]" Property="@nameof(sp_Authentication_TabUser_UserList.Email)" Width="190px" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["Group"]" Property="@nameof(sp_Authentication_TabUser_UserList.GroupName)" Width="160px">
                        <Template Context="data">
                            <RadzenDropDown AllowClear="false"
                                            AllowVirtualization="true"
                                            AllowFiltering="true"
                                            Disabled="@data.IsDeleted"
                                            TValue="P02_GroupResDTO"
                                            Data="p02_Groups"
                                            class="w-100"
                                            TextProperty="@nameof(P02_GroupResDTO.GroupName)"
                                            Change="@(arg => DropdownOnChange_Group(data))"
                                            @bind-Value=@data.UserGroup />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["Admin"]" Property="@nameof(sp_Authentication_TabUser_UserList.IsAdmin)" Width="88px" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="data">
                            @if (data.IsAdmin)
                            {
                                <RadzenIcon Icon="check_circle" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["Department"]" Property="@nameof(sp_Authentication_TabUser_UserList.DepartmentName)" Width="150px" Visible="true" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["UserType"]" Property="@nameof(sp_Authentication_TabUser_UserList.TypeOfUser)" Width="120px" Filterable="false" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="@Loc["Description"]" Property="@nameof(sp_Authentication_TabUser_UserList.Description)" Width="210px" Visible="true" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="User Id" Property="@nameof(sp_Authentication_TabUser_UserList.UserId)" Width="90px" Filterable="false" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Id" Property="@nameof(sp_Authentication_TabUser_UserList.Id)" Width="280px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Google Email" Property="@nameof(sp_Authentication_TabUser_UserList.GoogleEmail)" Width="220px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Group Id" Property="@nameof(sp_Authentication_TabUser_UserList.GroupId)" Width="280px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Create User Id" Property="@nameof(sp_Authentication_TabUser_UserList.CreateUserId)" Width="120px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Create Date" Property="@nameof(sp_Authentication_TabUser_UserList.CreateDate)" FormatString="{0:dd/MM/yyyy HH:mm}" Width="160px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Create User Name" Property="@nameof(sp_Authentication_TabUser_UserList.CreateUserName)" Width="150px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Update User Id" Property="@nameof(sp_Authentication_TabUser_UserList.UpdateUserId)" Width="120px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Update Date" Property="@nameof(sp_Authentication_TabUser_UserList.UpdateDate)" FormatString="{0:dd/MM/yyyy HH:mm}" Width="160px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Update User Name" Property="@nameof(sp_Authentication_TabUser_UserList.UpdateUserName)" Width="150px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="sp_Authentication_TabUser_UserList" Title="Department Id" Property="@nameof(sp_Authentication_TabUser_UserList.L05_DepartmentId)" Width="280px" Visible="false" Pickable="true" />
                </Columns>
            </RadzenDataGrid>
        </RadzenColumn>
    </RadzenRow>
    }
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="m-3" Text="@Loc["NoPermission"]" />
}
