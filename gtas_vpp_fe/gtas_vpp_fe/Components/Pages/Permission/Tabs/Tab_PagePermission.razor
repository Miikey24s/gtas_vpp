@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_fe.Helpers.DTOs.Share
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject NotificationService NotificationService
@inject IJSRuntime js
@using gtas_vpp_fe.Helpers.DTOs.Res.Auth
@using gtas_vpp_fe.Helpers

@rendermode @(new InteractiveServerRenderMode(prerender: false))
<style>
    .table-cell-edited {
        position: relative;
    }

        .table-cell-edited::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            border-top: 10px solid red;
            border-left: 10px solid transparent;
        }
</style>

@if (sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.ComponentCode.Equals(Config.Page_ComponentCode.ComponentCode.AdminView) && y.IsVisible))
{
    <RadzenDataGrid @ref="grid"
                AllowFiltering="true"
                AllowColumnResize="true"
                AllowMultiColumnSorting="true"
                AllowVirtualization="true"
                AllowAlternatingRows="false"
                AllowGrouping="true"
                ColumnsPickerAllowFiltering=true
                AllowColumnPicking=true
                AllowPickAllColumns="true"
                ShowMultiColumnSortingIndex=true
                AllowSorting="true"
                AllowColumnReorder="true"
                FilterMode="FilterMode.CheckBoxList"
                Density="Density.Compact"
                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                SelectionMode="DataGridSelectionMode.Single"
                ExpandMode="DataGridExpandMode.Single"
                RowExpand="GroupRowExpand"
                RowUpdate="@OnUpdateRow"
                AllowPaging="false"
                class="librarypagegrid"
                Style="height: calc(100vh - 14.5vh);"
                TItem="P02_GroupResDTO"
                @bind-Value="selected_Group"
                Data=@list_Group
                ColumnWidth="150px"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
    <HeaderTemplate>
        <RadzenButton Icon="add_circle" Size="ButtonSize.Small" Text="Create new group" Visible="@(sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.ComponentCode.Equals(Config.Page_ComponentCode.ComponentCode.HomeDashboard) && y.IsVisible))" Disabled="@(sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.ComponentCode.Equals(Config.Page_ComponentCode.ComponentCode.PermissionViewable) && !y.IsEnable))" Click="@ShowInlineDialog" />
    </HeaderTemplate>
    <Template Context="singlerow">
        <RadzenRow>
            <RadzenColumn Size="12">
                @if (list_PermissionOfGroup.Count > 0)
                {
                    <Component_Loading isActive=@IsLoading_Child />
                    <RadzenTabs RenderMode="TabRenderMode.Client" @bind-SelectedIndex=@selectedTab>
                        <Tabs>
                            @foreach (var item in list_PermissionOfGroup)
                            {
                                <RadzenTabsItem Text="@(item.PageName + " (" + item.PageCode + ")")">
                                    <RadzenDataGrid AllowGrouping="true"
                                                    AllowFiltering="true"
                                                    AllowColumnResize="true"
                                                    AllowPickAllColumns=true
                                                    ShowPagingSummary="true"
                                                    AllowMultiColumnSorting=true
                                                    ShowMultiColumnSortingIndex=true
                                                    AllowColumnReorder=false
                                                    AllowColumnPicking=true
                                                    AllowPaging="false"
                                                    AllowSorting="true"
                                                    AllowVirtualization="true"
                                                    Style="background-color:lightgray;"
                                                    Density="Density.Compact"
                                                    FilterMode="FilterMode.CheckBoxList"
                                                    SelectionMode="DataGridSelectionMode.Single"
                                                    ColumnWidth="150px"
                                                    TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component"
                                                    Data="@item.List_Component"
                                                    @ref=@child_grid
                                                    @bind-Value=@selected_Component>
                                        <HeaderTemplate>
                                            <RadzenFormField Text="Description" AllowFloatingLabel="false" class="custom-formfield-disabled">
                                                <RadzenTextBox Value="@item.Description" Disabled="true" />
                                            </RadzenFormField>
                                            <RadzenFormField Text="Page Id" AllowFloatingLabel="false" class="custom-formfield-disabled">
                                                <RadzenTextBox Value="@item.PageId.ToString()" Disabled="true" />
                                            </RadzenFormField>
                                        </HeaderTemplate>
                                        <Columns>
                                            <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Title="#" Width="45px" HeaderCssClass="text-center" CssClass="text-center" Filterable="false" Groupable="false" Pickable="false" Reorderable="false" Sortable="false" Frozen="true">
                                                <Template Context="childdata">
                                                    @(item.List_Component.IndexOf(childdata) + 1)
                                                </Template>
                                            </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Width="100px" Property="@nameof(sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component.ComponentId)" Title="Component Id" />
                                                <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Width="100px" Property="@nameof(sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component.ComponentCode)" Title="Component Code" />
                                                <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Width="100px" Property="@nameof(sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component.ComponentName)" Title="Component Name" />
                                                <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Width="100px" Property="@nameof(sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component.Description)" Title="Desctiption" />
                                                <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Width="100px" Property="@nameof(sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component.IsEnable)" Title="Is Enable" Visible="@(!item.PageCode?.Equals("0000") ?? false)">
                                                <Template Context="comdata">
                                                    <RadzenSwitch @bind-Value=comdata.IsEnable Change="@(arg => SwitchOnChange(comdata))" Style="flex: unset" Disabled="@(!sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.ComponentCode.Equals("0004_V") && y.IsVisible))" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component" Width="100px" Property="@nameof(sp_Authen_Permission_GetPageWithComponentByGroupId_List_Component.IsVisible)" Title="Is Visible">
                                                <Template Context="comdata">
                                                    <RadzenSwitch @bind-Value=comdata.IsVisible Change="@(arg => SwitchOnChange(comdata))" Style="flex: unset" Disabled="@(!sp_Authentication_GetPermissionSinglePage.List_Component.Any(y => y.ComponentCode.Equals("0004_V") && y.IsVisible))" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>

                                </RadzenTabsItem>
                            }

                        </Tabs>
                    </RadzenTabs>
                }
                else
                {
                    <RadzenFieldset Text="N/A">
                        <RadzenText Text="This group have no permission" />
                    </RadzenFieldset>
                }
            </RadzenColumn>
        </RadzenRow>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="#" Width="45px" HeaderCssClass="text-center" CssClass="text-center" Filterable="false" Groupable="false" Pickable="false" Reorderable="false" Sortable="false" Frozen="true">
            <Template Context="data">
                @(list_Group.IndexOf(data) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Width="60px" Title="Is Delete" HeaderCssClass="text-center" CssClass="text-center" Property="@nameof(P02_GroupResDTO.IsDeleted)">
            <Template Context="data">
                <RadzenSwitch @bind-Value=data.IsDeleted Change="@(arg => SwitchOnChange(data))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Func" Width="60px" Filterable="false" Groupable="false" Pickable="false" Reorderable="false" Sortable="false" Frozen="true" HeaderCssClass="text-center" CssClass="text-center">
            <Template Context="data">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(args => EditRow(data))" @onclick:stopPropagation="true" Disabled="@isEditing" />
            </Template>
            <EditTemplate Context="data">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@((args) => SaveRow(data))" />
                <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@((args) => CancelEdit(data))" />
            </EditTemplate>
        </RadzenDataGridColumn>
        @* <RadzenDataGridColumn TItem="P02_GroupResDTOResDTO" Title="Id" Property="@nameof(P02_GroupResDTOResDTO.Id)" /> *@
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Group Name" Property="@nameof(P02_GroupResDTO.GroupName)">
            <Template Context="data">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenText Text="@data.GroupName" class="rz-mb-0" />
                </RadzenStack>
            </Template>
            <EditTemplate Context="data">
                <RadzenTextBox @bind-Value="data.GroupName" Name="GroupName" aria-label="Enter group name" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Description" Property="@nameof(P02_GroupResDTO.Description)">
            <Template Context="data">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenText Text="@data.Description" class="rz-mb-0" />
                </RadzenStack>
            </Template>
            <EditTemplate Context="data">
                <RadzenTextBox @bind-Value="data.Description" Name="Description" aria-label="Enter description" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Parent Group" Property="@nameof(P02_GroupResDTO.ParentGroupId)">
            <Template Context="data">
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenText Text="@(list_Group.FirstOrDefault(x => x.Id == data.ParentGroupId)?.GroupName)" class="rz-mb-0" />
                </RadzenStack>
            </Template>
            <EditTemplate Context="data">
                <RadzenDropDown @bind-Value="data.ParentGroupId" Data=@(list_Group.Where(x => x.Id != data.Id)) TextProperty="GroupName" ValueProperty="Id" AllowClear=true
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.StartsWith" AllowFiltering="true" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Create by" Property="@nameof(P02_GroupResDTO.CreateUserName)" />
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Create on" Property="@nameof(P02_GroupResDTO.CreateDate)" />
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Update by" Property="@nameof(P02_GroupResDTO.UpdateUserName)" />
        <RadzenDataGridColumn TItem="P02_GroupResDTO" Title="Update on" Property="@nameof(P02_GroupResDTO.UpdateDate)" />
    </Columns>
</RadzenDataGrid>
}
else
{
    @(glb.isBusyPage = true)
}


@code {
    protected async Task ShowInlineDialog()
    {
        var result = await DialogService.OpenAsync("Add new group", ds =>
    @<RadzenStack>
            <RadzenTemplateForm Data="@_P02_GroupResDTOReqDTO" Submit="@((P02_GroupResDTO arg) => { Submit(arg); })">
                <RadzenRow RowGap="1rem" Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Group Name" class="w-100" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value=@_P02_GroupResDTOReqDTO.GroupName Name="GroupName" />
                        </RadzenFormField>
                        <RadzenRequiredValidator Component="GroupName" Text="Group name is required" />
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Description" class="w-100" AllowFloatingLabel="false">
                            <RadzenTextBox @bind-Value=@_P02_GroupResDTOReqDTO.Description />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Copy from" class="w-100" AllowFloatingLabel="false">
                            <RadzenDropDown AllowClear="false"
                                            AllowVirtualization="true"
                                            AllowFiltering="true"
                                            TValue="P02_GroupResDTO"
                                            Data="list_Group"
                                            class="w-100"
                                            TextProperty="@nameof(P02_GroupResDTO.GroupName)"
                                            @bind-Value=@selected_Group_To_Copy />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" class="text-right">
                        <RadzenButton ButtonType="ButtonType.Submit" Icon="check" Text="OK" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenTemplateForm>
        </RadzenStack>);
    }
}
