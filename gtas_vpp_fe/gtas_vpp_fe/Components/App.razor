@using gtas_vpp_fe.Services
@implements IDisposable

<!DOCTYPE html>
<html lang="@_htmlLang" class="@HtmlThemeClass">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-radzen-theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-layout.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-sidebar.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-tabs.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-kpi.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-login.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-wizard.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-loading.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-datagrid.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-status-badge.css"]" />
    <link rel="stylesheet" href="@Assets["css/gtas_vpp_fe.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-toast.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-responsive.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-a11y.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-charts.css"]" />
    <link rel="stylesheet" href="@Assets["css/vpp-polish.css"]" />
    <link rel="stylesheet" href="@Assets["gtas_vpp_fe.styles.css"]" />
    <link rel="icon" type="image/x-icon" href="@Assets["PPJ-Software-Icon.ico"]" />
    @* F-31: Inter + JetBrains Mono are self-hosted via @@font-face in vpp-tokens.css.
       Material Symbols stays on the CDN because it ships an icon-font glyph set we
       don't currently bundle locally; replacing it requires a separate task. *@
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <script>
        // FOUC prevention — apply theme before paint
        (function(){
            var m = document.cookie.match(/(?:^|;\s*)VPPTheme=([^;]*)/);
            var t = m ? m[1] : 'material3';
            if (t.indexOf('dark') !== -1) document.documentElement.classList.add('rz-theme-dark');
        })();
    </script>
    <HeadOutlet />
    <RadzenTheme Theme="@ThemeState.CurrentTheme"/>
</head>

<body>
    <ThemeInitializer />
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js" integrity="sha512-RX/OFugt/bkgwRQg4B22KYE79dQhwaPp2IZaA/YyU3GMo/qY7GrXkiG6Dvvwnds6/DefCfwPTgCXnaC6nAgVYw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

</body>

</html>
@code {
    private const string BrowserThemeScript = """
        (() => {
            const match = document.cookie.match(/(?:^|;\s*)VPPTheme=([^;]*)/);
            const theme = match ? decodeURIComponent(match[1]) : 'material3';
            document.documentElement.classList.toggle('rz-theme-dark', theme.includes('dark'));
            return theme;
        })()
        """;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject]
    private ThemeService ThemeService { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private ThemeState ThemeState { get; set; } = default!;

    private string _htmlLang = "vi";

    private string HtmlThemeClass => ThemeState.IsDark ? "rz-theme-dark" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeState.Changed += OnThemeChanged;
        
        var cultureFeature = HttpContext?.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
        if (cultureFeature != null)
        {
            _htmlLang = cultureFeature.RequestCulture.UICulture.TwoLetterISOLanguageName;
        }
        
        // Đọc theme từ cookie
        if (HttpContext?.Request?.Cookies != null && HttpContext.Request.Cookies.TryGetValue("VPPTheme", out var themeCookie))
        {
            ThemeState.SetTheme(themeCookie);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var browserTheme = await GetBrowserThemeAsync();
        if (string.IsNullOrWhiteSpace(browserTheme) || string.Equals(browserTheme, ThemeState.CurrentTheme, StringComparison.Ordinal))
        {
            return;
        }

        ThemeState.SetTheme(browserTheme);
        ThemeService.SetTheme(ThemeState.CurrentTheme);
    }

    private void OnThemeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task<string?> GetBrowserThemeAsync()
    {
        try
        {
            return await JS.InvokeAsync<string>("eval", BrowserThemeScript);
        }
        catch (InvalidOperationException)
        {
            return null;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
    }

    public void Dispose()
    {
        ThemeState.Changed -= OnThemeChanged;
    }
}
