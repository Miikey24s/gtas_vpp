@using gtas_vpp_shared.DTOs.Share
@inject NavigationManager NavigationManager

<div class="vpp-user-menu" @onkeydown="HandleKeyDown">
    <button type="button"
            class="user-menu-trigger"
            aria-haspopup="dialog"
            aria-expanded="@_isOpen"
            aria-controls="user-menu-dropdown"
            aria-label="@UserFullName"
            @onclick="ToggleMenu">
        <span class="user-avatar" aria-hidden="true">
        @GetInitials()
        </span>
    </button>

    @if (_isOpen)
    {
        <section id="user-menu-dropdown" class="user-dropdown" role="dialog" aria-label="@Loc["Profile"]">
            <div class="user-dropdown-header">
                <div class="user-avatar-lg" aria-hidden="true">@GetInitials()</div>
                <div class="user-dropdown-identity">
                    <div class="user-dropdown-name">@UserFullName</div>
                    @if (!string.IsNullOrWhiteSpace(UserLogin))
                    {
                        <div class="user-dropdown-login">
                            <span>@Loc["Username"]</span>
                            <strong>@UserLogin</strong>
                        </div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(DepartmentDisplayName))
            {
                <div class="user-dropdown-context">
                    <span class="user-dropdown-context-icon" aria-hidden="true">
                        <VppIcon Name="@VppIcons.Apartment" />
                    </span>
                    <span class="user-dropdown-context-copy">
                        <small>@Loc["Department"]</small>
                        <strong class="user-dropdown-context-value">@DepartmentDisplayName</strong>
                    </span>
                    @if (ShowDepartmentCode)
                    {
                        <span class="user-dropdown-code">@DepartmentCode</span>
                    }
                </div>
            }
            <a href="/logoutprocess" class="user-dropdown-logout">
                <VppIcon Name="@VppIcons.Logout" Class="user-dropdown-icon" />
                <span>@Loc["Logout"]</span>
            </a>
        </section>
        <button type="button"
                class="user-dropdown-backdrop"
                aria-label="@Loc["Close"]"
                @onclick="CloseMenu"></button>
    }
</div>

@code {
    [Parameter] public string? UserFullName { get; set; }
    [Parameter] public string? UserLogin { get; set; }
    [Parameter] public string? DepartmentName { get; set; }
    [Parameter] public string? DepartmentCode { get; set; }

    private bool _isOpen;

    private string DepartmentDisplayName => !string.IsNullOrWhiteSpace(DepartmentName)
        ? DepartmentName.Trim()
        : DepartmentCode?.Trim() ?? string.Empty;

    private bool ShowDepartmentCode => !string.IsNullOrWhiteSpace(DepartmentCode)
        && !string.Equals(DepartmentCode.Trim(), DepartmentDisplayName, StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu() => _isOpen = !_isOpen;

    private void CloseMenu() => _isOpen = false;

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" or "Esc")
        {
            CloseMenu();
        }
    }

    private string GetInitials()
    {
        var parts = (UserFullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return "U";
    }
}
