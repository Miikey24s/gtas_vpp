@using System.Globalization
@using gtas_vpp_shared.DTOs.Share
@inject NavigationManager NavigationManager

<div class="@RootClass" @onkeydown="HandleKeyDown">
    <button type="button"
            class="user-menu-trigger"
            aria-haspopup="dialog"
            aria-expanded="@_isOpen"
            aria-controls="user-menu-dropdown"
            aria-label="@UserFullName"
            @onclick="ToggleMenu">
        <span class="user-avatar" aria-hidden="true">
        @GetInitials()
        </span>
        @if (ShowName)
        {
            <span class="user-menu-trigger-copy">
                <span class="user-menu-trigger-name">@UserFullName</span>
                @if (SidebarMode && !string.IsNullOrWhiteSpace(DepartmentDisplayName))
                {
                    <small class="user-menu-trigger-subline">@DepartmentDisplayName</small>
                }
            </span>
        }
    </button>

    @if (_isOpen)
    {
        <section id="user-menu-dropdown" class="user-dropdown" role="dialog" aria-label="@Loc["Profile"]">
            <div class="user-dropdown-profile">
                <div class="user-avatar-lg" aria-hidden="true">@GetInitials()</div>
                <div class="user-dropdown-identity">
                    <div class="user-dropdown-name">@UserFullName</div>
                    @if (!string.IsNullOrWhiteSpace(UserContact))
                    {
                        <div class="user-dropdown-email">@UserContact</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(DepartmentDisplayName))
                    {
                        <div class="user-dropdown-department" aria-label="@Loc["Department"]">
                            <span class="user-dropdown-department-name">@DepartmentDisplayName</span>
                            @if (ShowDepartmentCode)
                            {
                                <span class="user-dropdown-department-code">@DepartmentDisplayCode</span>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="user-dropdown-actions" aria-label="@Loc["Settings"]">
                <button type="button"
                        class="user-dropdown-action"
                        title="@LanguageToggleTitle"
                        aria-label="@LanguageToggleTitle"
                        aria-busy="@_isLanguageSwitching"
                        disabled="@_isLanguageSwitching"
                        @onclick="HandleLanguageToggleAsync">
                    <VppIcon Name="@VppIcons.Language" />
                    <span class="user-dropdown-action-label">@Loc["Language"]</span>
                    <span class="user-dropdown-action-trailing">@Loc[IsEnglishUi ? "LanguageEnglish" : "LanguageVietnamese"]</span>
                </button>
                <button type="button"
                        class="user-dropdown-action"
                        title="@ThemeToggleTitle"
                        aria-label="@ThemeToggleTitle"
                        aria-pressed="@(!IsLightTheme)"
                        disabled="@_isThemeSwitching"
                        @onclick="HandleThemeToggleAsync">
                    <VppIcon Name="@(IsLightTheme ? VppIcons.LightMode : VppIcons.DarkMode)" />
                    <span class="user-dropdown-action-label">@Loc["Theme"]</span>
                    <span class="user-dropdown-action-trailing">@Loc[IsLightTheme ? "LightMode" : "DarkMode"]</span>
                </button>
                <NotificationCenter MenuMode="true" />
                <div class="user-dropdown-action-divider" role="separator"></div>
                <a href="/logoutprocess" class="user-dropdown-action user-dropdown-logout">
                    <VppIcon Name="@VppIcons.Logout" Class="user-dropdown-icon" />
                    <span class="user-dropdown-action-label">@Loc["Logout"]</span>
                </a>
            </div>
        </section>
        <button type="button"
                class="user-dropdown-backdrop"
                aria-label="@Loc["Close"]"
                @onclick="CloseMenu"></button>
    }
</div>

@code {
    [Parameter] public string? UserFullName { get; set; }
    [Parameter] public string? UserLogin { get; set; }
    [Parameter] public string? UserEmail { get; set; }
    [Parameter] public string? DepartmentName { get; set; }
    [Parameter] public string? DepartmentCode { get; set; }
    [Parameter] public bool IsLightTheme { get; set; } = true;
    [Parameter] public EventCallback<bool> IsLightThemeChanged { get; set; }
    [Parameter] public EventCallback OnThemeToggle { get; set; }
    [Parameter] public EventCallback OnLanguageToggle { get; set; }
    [Parameter] public bool ShowName { get; set; }
    [Parameter] public bool SidebarMode { get; set; }

    private bool _isOpen;
    private bool _isLanguageSwitching;
    private bool _isThemeSwitching;

    private bool IsEnglishUi => CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    private string LanguageToggleTitle => IsEnglishUi ? Loc["SwitchToVietnamese"] : Loc["SwitchToEnglish"];

    private string ThemeToggleTitle => IsLightTheme ? Loc["SwitchToDarkMode"] : Loc["SwitchToLightMode"];

    private string RootClass => SidebarMode
        ? "vpp-user-menu vpp-sidebar-user-menu"
        : "vpp-user-menu";

    private string DepartmentDisplayName => !string.IsNullOrWhiteSpace(DepartmentName)
        ? DepartmentName.Trim()
        : DepartmentCode?.Trim() ?? string.Empty;

    private string DepartmentDisplayCode => DepartmentCode?.Trim() ?? string.Empty;

    private bool ShowDepartmentCode => !string.IsNullOrWhiteSpace(DepartmentDisplayCode)
        && !string.Equals(DepartmentDisplayCode, DepartmentDisplayName, StringComparison.OrdinalIgnoreCase);

    private string UserContact => !string.IsNullOrWhiteSpace(UserEmail)
        ? UserEmail.Trim()
        : UserLogin?.Trim() ?? string.Empty;

    private void ToggleMenu() => _isOpen = !_isOpen;

    private void CloseMenu() => _isOpen = false;

    private async Task HandleLanguageToggleAsync()
    {
        if (_isLanguageSwitching)
        {
            return;
        }

        _isLanguageSwitching = true;
        try
        {
            await OnLanguageToggle.InvokeAsync();
        }
        finally
        {
            _isLanguageSwitching = false;
        }
    }

    private async Task HandleThemeToggleAsync()
    {
        if (_isThemeSwitching)
        {
            return;
        }

        _isThemeSwitching = true;
        try
        {
            await OnThemeToggle.InvokeAsync();
            await Task.Delay(180);
        }
        finally
        {
            _isThemeSwitching = false;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" or "Esc")
        {
            CloseMenu();
        }
    }

    private string GetInitials()
    {
        var parts = (UserFullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        if (parts.Length == 1)
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return "U";
    }
}
