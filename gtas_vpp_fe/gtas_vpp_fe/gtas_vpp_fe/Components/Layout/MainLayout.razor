@attribute [Authorize]
@inherits LayoutComponentBase
@using gtas_vpp_fe.Services
@inject PermissionRealtimeService PermissionRealtime
@inject NotificationInboxState NotificationInbox
@inject ILogger<MainLayout> Logger

<RadzenComponents />

<a class="vpp-skip-link" href="#main-content">@Loc["SkipToContent"]</a>
<RadzenLayout class="vpp-layout">
    <LeftSidebar />
    <RadzenBody class="vpp-layout-body">
        <div id="main-content" class="vpp-content" role="main" tabindex="-1">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <VppStatePanel State="error"
                                   Icon="error_outline"
                                   Title="@Loc["ErrorPageTitle"]"
                                   Description="@Loc["ErrorPageDescription"]" />
                    <div class="vpp-system-page-actions">
                        <a class="vpp-empty-state-link" href="/" data-enhance-nav="false">
                            @Loc["BackToDashboard"]
                        </a>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await PermissionRealtime.StartAsync();
        }
        catch (Exception ex)
        {
            // Backend authorization still evaluates every API call. Realtime is
            // only an immediate UI refresh enhancement, so a temporary hub
            // outage must not break the page.
            Logger.LogWarning(ex, "Permission realtime connection is unavailable.");
        }

        try
        {
            await NotificationInbox.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Notification inbox could not be initialized.");
        }
    }
}

