@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.UI

@if (Items is not null && Items.Any())
{
    <div class="vpp-mobile-card-list @Class">
        @foreach (var item in Items)
        {
            <article class="vpp-mobile-card">
                <div class="vpp-mobile-card-head">
                    <div>
                        <div class="vpp-mobile-card-title">
                            <span class="vpp-link-text">@item.VPPCode</span>
                            @if (item.IsAdditionalOrder)
                            {
                                <RadzenBadge Text="@Loc["Additional"]" BadgeStyle="BadgeStyle.Warning" IsPill="true" class="rz-ml-2" />
                            }
                        </div>
                        <div class="vpp-mobile-card-subtitle">@item.Period</div>
                    </div>
                    <div>
                        <span class="vpp-badge @StatusDisplay.GetCssClass(item.Status)">@Loc[StatusDisplay.GetResourceKey(item.Status, item.IsDeadlinePassed, item.IsAdditionalOrder)]</span>
                        @if (item.SettledAt.HasValue)
                        {
                            <span class="vpp-badge-settled" title="@($"{Loc["Settled"]}: {DateFormatter.Format(item.SettledAt, DateFormatter.LongDate)} - {item.SettledByPriceListName}")">
                                @Loc["Settled"]
                            </span>
                        }
                    </div>
                </div>

                <dl class="vpp-mobile-card-grid">
                    @if (!string.IsNullOrWhiteSpace(item.DepartmentCode))
                    {
                        <div>
                            <dt>@Loc["Department"]</dt>
                            <dd>@item.DepartmentCode</dd>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.RequesterName))
                    {
                        <div>
                            <dt>@Loc["Username"]</dt>
                            <dd>@item.RequesterName</dd>
                        </div>
                    }

                    <div>
                        <dt>@Loc["TotalLineItems"]</dt>
                        <dd>@item.TotalLines</dd>
                    </div>

                    <div>
                        <dt>@Loc["TotalQuantity"]</dt>
                        <dd>@item.TotalQty</dd>
                    </div>

                    @if (item.SubmittedDate.HasValue)
                    {
                        <div>
                            <dt>@Loc["SubmittedDate"]</dt>
                            <dd>@DateFormatter.Format(item.SubmittedDate, DateFormatter.LongDate)</dd>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <div class="vpp-mobile-card-full-row">
                            <dt>@Loc["Description"]</dt>
                            <dd>@item.Description</dd>
                        </div>
                    }
                </dl>

                @if (Actions is not null)
                {
                    <div class="vpp-mobile-card-actions">
                        @Actions(item)
                    </div>
                }
            </article>
        }
    </div>
}

@code {
    [Parameter] public IEnumerable<VPP01_RequestHeaderResDTO>? Items { get; set; }
    [Parameter] public RenderFragment<VPP01_RequestHeaderResDTO>? Actions { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
}
