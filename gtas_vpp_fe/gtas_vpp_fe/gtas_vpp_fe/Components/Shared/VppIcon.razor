@if (!string.IsNullOrWhiteSpace(Name))
{
    @if (string.IsNullOrWhiteSpace(AriaLabel))
    {
        <span class="@CssClass" aria-hidden="true">@Name</span>
    }
    else
    {
        <span class="@CssClass" role="img" aria-label="@AriaLabel">@Name</span>
    }
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "material-symbols-outlined vpp-icon"
        : $"material-symbols-outlined vpp-icon {Class}";
}
