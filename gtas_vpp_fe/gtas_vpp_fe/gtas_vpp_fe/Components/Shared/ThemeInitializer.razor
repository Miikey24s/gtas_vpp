@inject IJSRuntime JS

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
(function(){
    var theme = document.cookie.split('; ').find(row => row.startsWith('VPPTheme='));
    var themeVal = theme ? theme.split('=')[1] : 'material3';
    if (themeVal.includes('dark')) {
        document.documentElement.classList.add('rz-theme-dark');
    } else {
        document.documentElement.classList.remove('rz-theme-dark');
    }
})()");
        }
    }
}
