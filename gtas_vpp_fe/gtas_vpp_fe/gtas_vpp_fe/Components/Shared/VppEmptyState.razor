@using Microsoft.AspNetCore.Components.Web

<div class="vpp-empty-state vpp-empty-state-shell @Class">
    <VppIcon Name="@Icon" Class="vpp-empty-state-icon" />
    <div class="vpp-empty-state-title">@Title</div>
    <div class="vpp-empty-state-desc">@Description</div>

    @if (HasActions)
    {
        <div class="vpp-empty-state-actions">
            @if (!string.IsNullOrWhiteSpace(PrimaryText) && PrimaryAction.HasDelegate)
            {
                <RadzenButton Text="@PrimaryText"
                              ButtonStyle="@PrimaryButtonStyle"
                              Click="@PrimaryAction"
                              class="vpp-empty-state-primary" />
            }

            @if (!string.IsNullOrWhiteSpace(SecondaryText) && SecondaryAction.HasDelegate)
            {
                <RadzenLink Click="@SecondaryAction" class="vpp-empty-state-link">@SecondaryText</RadzenLink>
            }
            else if (!string.IsNullOrWhiteSpace(SecondaryText) && !string.IsNullOrWhiteSpace(SecondaryHref))
            {
                <a class="vpp-empty-state-link" href="@SecondaryHref">
                    <VppIcon Name="@VppIcons.ArrowBack" />
                    @SecondaryText
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = VppIcons.Inbox;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string PrimaryText { get; set; } = string.Empty;
    [Parameter] public EventCallback<MouseEventArgs> PrimaryAction { get; set; }
    [Parameter] public ButtonStyle PrimaryButtonStyle { get; set; } = ButtonStyle.Primary;
    [Parameter] public string SecondaryText { get; set; } = string.Empty;
    [Parameter] public EventCallback<MouseEventArgs> SecondaryAction { get; set; }
    [Parameter] public string? SecondaryHref { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private bool HasActions => PrimaryAction.HasDelegate
        || SecondaryAction.HasDelegate
        || (!string.IsNullOrWhiteSpace(SecondaryText) && !string.IsNullOrWhiteSpace(SecondaryHref));
}
