<span class="vpp-badge @GetBadgeClass()">@Text</span>

@code {
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";

    private string GetBadgeClass() => Status?.ToLower() switch
    {
        "approved" or "đã duyệt" => "vpp-badge-success",
        "rejected" or "từ chối" => "vpp-badge-danger",
        "pending" or "chờ duyệt" or "submitted" or "đã gửi" => "vpp-badge-warning",
        "draft" or "nháp" => "vpp-badge-secondary",
        _ => "vpp-badge-info"
    };
}
