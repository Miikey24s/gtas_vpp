@using Microsoft.AspNetCore.Components.Web

<VppEmptyState Icon="@Icon"
               Title="@Title"
               Description="@Description"
               PrimaryText="@(ActionLabel ?? string.Empty)"
               PrimaryAction="@HandleActionAsync" />

@code {
    [Parameter] public string Icon { get; set; } = VppIcons.Inbox;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }

    private Task HandleActionAsync(MouseEventArgs _) => OnAction.InvokeAsync();
}
