@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_fe.Helpers
@inject DialogService DialogService
@inject GlobalClass glb
@inject IToastService Toast


@if (CanView)
{
    <div class="vpp-orders-workspace order-page">
        @if (IsLoading)
        {
            <SkeletonPage Cards="3" Rows="5" Cols="4" />
        }
        else
        {
            <section class="vpp-orders-story" aria-labelledby="orders-story-title">
                <div class="vpp-orders-story-main">
                    <div class="vpp-orders-eyebrow">
                        <VppIcon Name="@VppIcons.Calendar" />
                        <span>@Loc["ActiveOrderPeriod"]</span>
                        <strong>@CurrentOrderPeriodText</strong>
                    </div>

                    <div class="vpp-orders-story-heading">
                        <div>
                            <h2 id="orders-story-title">@OrdersStoryTitle</h2>
                            <p>@OrdersStoryDescription</p>
                        </div>
                        <span class="vpp-orders-state @SubmissionStateCss">
                            <VppIcon Name="@SubmissionStateIcon" />
                            @SubmissionStateText
                        </span>
                    </div>

                    @if (PeriodInfo is not null)
                    {
                        <div class="vpp-orders-facts">
                            <div class="vpp-orders-fact">
                                <VppIcon Name="@VppIcons.Schedule" />
                                <span>
                                    <small>@Loc["SubmissionDeadline"]</small>
                                    <strong>@CurrentDeadlineText</strong>
                                </span>
                            </div>
                            <div class="vpp-orders-fact">
                                <VppIcon Name="@VppIcons.Supplement" />
                                <span>
                                    <small>@Loc["SupplementCapacity"]</small>
                                    <strong>@Loc["SupplementQuotaSummary", PeriodInfo.RemainingApprovedSupplementQuota, PeriodInfo.MaxAdditionalOrders]</strong>
                                </span>
                            </div>
                        </div>
                    }
                </div>

                @if (CanCreate && HasAvailableStoryAction)
                {
                    <div class="vpp-orders-story-actions" aria-label="@Loc["Actions"]">
                        @if (CanCreateRegular)
                        {
                            <RadzenButton Icon="@VppIcons.Add"
                                          Text="@Loc["NewOrder"]"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@(async _ => await GoToCreatePage(false))" />
                        }
                        @if (CanCopyPrevious)
                        {
                            <RadzenButton Icon="@VppIcons.Copy"
                                          Text="@Loc["CopyPreviousOrder"]"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Outlined"
                                          Click="@(async _ => await CopyPreviousAsync())" />
                        }
                        @if (ShowSupplementAction)
                        {
                            <RadzenButton Icon="@VppIcons.Supplement"
                                          Text="@Loc["RequestAdditional"]"
                                          ButtonStyle="ButtonStyle.Secondary"
                                          Variant="Variant.Outlined"
                                          Click="@(async _ => await GoToCreatePage(true))"
                                          Disabled="@(!CanCreateSupplement)"
                                          Title="@SupplementActionHint"
                                          data-testid="create-supplement" />
                        }
                    </div>
                }
            </section>

            <div class="vpp-orders-metrics" role="group" aria-label="@Loc["CurrentOrderMetrics"]">
                <article class="vpp-orders-metric">
                    <VppIcon Name="@VppIcons.Orders" />
                    <span>@Loc["OrdersInCurrentPeriod"]</span>
                    <strong>@TotalOrdersText</strong>
                </article>
                <article class="vpp-orders-metric">
                    <VppIcon Name="@VppIcons.Columns" />
                    <span>@Loc["TotalLineItems"]</span>
                    <strong>@TotalLinesText</strong>
                </article>
                <article class="vpp-orders-metric">
                    <VppIcon Name="@VppIcons.Catalog" />
                    <span>@Loc["TotalQuantity"]</span>
                    <strong>@TotalQtyText</strong>
                </article>
            </div>

            <section class="vpp-orders-section" aria-labelledby="current-orders-title">
                <header class="vpp-orders-section-header">
                    <div>
                        <span class="vpp-orders-section-kicker">@CurrentOrderPeriodText</span>
                        <h3 id="current-orders-title">@Loc["RegularOrdersCurrentPeriod"]</h3>
                    </div>
                    <span class="vpp-orders-count">@ActiveOrders.Count</span>
                </header>

            @if (ActiveOrders == null || !ActiveOrders.Any())
            {
                    <VppEmptyState Icon="@VppIcons.Orders"
                                   Title="@Loc["NoCurrentRegularOrders"]"
                                   Description="@EmptyCurrentOrdersDescription"
                                   Class="vpp-orders-empty" />
            }
            else
            {
                    <RadzenStack Gap="1rem" class="vpp-orders-card-list">
                    @foreach (var order in ActiveOrders)
                    {
                        @RenderOrderCard(order)
                    }
                </RadzenStack>
            }
            </section>

            @if (CurrentPeriodAdditionalOrders.Count > 0)
            {
                <section class="vpp-orders-section" aria-labelledby="additional-orders-title">
                    <header class="vpp-orders-section-header">
                        <div>
                            <span class="vpp-orders-section-kicker">@CurrentOrderPeriodText</span>
                            <h3 id="additional-orders-title">@Loc["AdditionalOrders"]</h3>
                        </div>
                        <span class="vpp-orders-count">@CurrentPeriodAdditionalOrders.Count</span>
                    </header>
                    <RadzenStack Gap="1rem" class="vpp-orders-card-list">
                    @foreach (var order in CurrentPeriodAdditionalOrders)
                    {
                        @RenderOrderCard(order)
                    }
                </RadzenStack>
                </section>
            }

            @if (PreviousOrders.Count > 0)
            {
                <details class="vpp-orders-archive">
                    <summary>
                        <span class="vpp-orders-archive-icon"><VppIcon Name="@VppIcons.History" /></span>
                        <span>
                            <strong>@Loc["PreviousOrderPeriod"] · @PreviousOrderPeriodText</strong>
                            <small>@string.Format(Loc["PreviousOrderCountFormat"].Value, PreviousOrders.Count)</small>
                        </span>
                        <VppIcon Name="@VppIcons.ExpandMore" Class="vpp-orders-archive-chevron" />
                    </summary>
                    <RadzenStack Gap="1rem" class="vpp-orders-archive-content">
                        @foreach (var order in PreviousOrders)
                        {
                            @RenderOrderCard(order)
                        }
                    </RadzenStack>
                </details>
            }
            else
            {
                <div class="vpp-orders-archive vpp-orders-archive-empty">
                    <span class="vpp-orders-archive-icon"><VppIcon Name="@VppIcons.History" /></span>
                    <span>
                        <strong>@Loc["PreviousOrderPeriod"] · @PreviousOrderPeriodText</strong>
                        <small>@Loc["NoRegularOrdersFoundPreviousCycle"]</small>
                    </span>
                    <span class="vpp-orders-count">0</span>
                </div>
            }
        }
    </div>
}

@code {
    private RenderFragment<VppRequestResDTO> RenderOrderCard => order => __builder =>
    {
        <div class="vpp-data-card vpp-data-card-grid-shell">
            <div class="vpp-data-card-header">
                <div>
                    <div class="vpp-data-card-summary">
                        <span class="vpp-data-card-label">@Loc["OrderCodeLabel"]</span>
                        <div class="vpp-data-card-value-row vpp-order-code-cell">
                            <span class="vpp-data-card-value vpp-link-text vpp-order-code-link vpp-order-code-trigger" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" title="@order.VppCode" style="cursor: pointer; text-decoration: underline dotted var(--vpp-border-strong); user-select: all;">
                                @GetShortCode(order)
                            </span>
                            <div class="vpp-order-code-popover">
                                <span class="vpp-order-code-popover-text">@order.VppCode</span>
                                <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="width: 24px; height: 24px; padding: 0; min-width: 24px;" Click="@(async _ => await CopyToClipboard(order.VppCode))" Title="@Loc["Copy"]" />
                            </div>
                            @if (order.IsAdditionalOrder)
                            {
                                <RadzenBadge Text="@Loc["Additional"]" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                            }
                        </div>
                        <span class="vpp-data-card-label">@Loc["SubmittedLabel"]</span>
                        <span class="vpp-data-card-value">@DateFormatter.Format(order.SubmittedDate, DateFormatter.LongDate)</span>
                    </div>
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem" class="vpp-data-card-actions">
                    <span class="vpp-badge @StatusDisplay.GetCssClass(order.Status)">@Loc[StatusDisplay.GetResourceKey(order.Status, order.IsDeadlinePassed, order.IsAdditionalOrder)]</span>
                    @if (order.SettledAt.HasValue)
                    {
                        <span class="vpp-badge-settled" title="@($"{Loc["Settled"]}: {DateFormatter.Format(order.SettledAt, DateFormatter.LongDate)} - {order.SettledByPriceListName}")">
                            @Loc["Settled"]
                        </span>
                    }
                    @if (CanUpdate(order) || CanReplace(order))
                    {
                        @* F-28: icon-only buttons need a visible tooltip + screen-reader label. The aria-label
                           includes the order code so screen-reader users hear context (e.g. "Edit order VPP-202604-..."). *@
                        <RadzenButton Icon="@(order.CanReplace ? "restart_alt" : "edit")"
                                      Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                      Click="@(async _ => await GoToEditPage(order))"
                                      Title="@(order.CanReplace ? Loc["ReplaceOrder"] : Loc["Edit"])"
                                      aria-label="@string.Format(order.CanReplace ? Loc["ReplaceOrderAria"] : Loc["EditOrderAria"], order.VppCode)" />
                    }
                    <RadzenButton Icon="history" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(async _ => await OpenHistoryAsync(order))" Title="@Loc["ViewRequestHistory"]" aria-label="@string.Format(Loc["ViewRequestHistoryAria"], order.VppCode)" />
                    @if (CanCancel(order))
                    {
                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(async _ => await CancelOrderAsync(order))" Title="@Loc["Cancel"]" aria-label="@string.Format(Loc["CancelOrderAria"], order.VppCode)" Disabled="@IsCancelling(order.Id)" IsBusy="@IsCancelling(order.Id)" />
                    }
                </RadzenStack>
            </div>

            <RadzenDataGrid TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO"
                            Data="@(order.Items ?? new())"
                            AllowPaging="true" PageSize="10"
                            AllowVirtualization="true"
                            AllowFiltering="false"
                            AllowSorting="false"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal"
                            class="vpp-order-grid vpp-order-grid-embedded">
                <Columns>
                    <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center">
                        <Template Context="item">@((order.Items?.IndexOf(item) ?? -1) + 1)</Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO" Property="VppCode" Title="@Loc["ItemCode"]" Width="130px" TextAlign="TextAlign.Left" />

                    <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO" Property="VppName" Title="@Loc["ItemName"]" Width="280px" TextAlign="TextAlign.Left" />

                    <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO" Property="Qty" Title="@Loc["Quantity"]" Width="90px" TextAlign="TextAlign.Center" />

<RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO" Property="UomName" Title="@Loc["UOM"]" Width="90px" TextAlign="TextAlign.Center" />

                    <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.VPP.VppRequestDetailResDTO" Property="Description" Title="@Loc["Note"]" Width="180px" TextAlign="TextAlign.Left">
                        <Template Context="item">
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%;" title="@item.Description">
                                @item.Description
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    };
}
