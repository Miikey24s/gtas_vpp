@* Atlas supply-allocation: bước 3 "Chọn nguồn cung" (D4). Thứ tự nghiệp vụ: chọn nhà
   cung cấp chính TRƯỚC → bảng giá còn hiệu lực là kết quả dẫn xuất (read-only) →
   độ phủ → ngoại lệ bắt buộc lý do. Kết quả xem trước được giữ trong
   PeriodSettlementState cho bước Chốt kỳ xác nhận đúng snapshot (InputHash). *@
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Res.VPP

<RadzenStack Gap="1rem">
    <div class="vpp-data-card">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
            <RadzenFormField Text="@Loc["TargetPeriod"]" Style="width: 150px">
                <RadzenTextBox Value="@($"{selectedMonth:D2}/{selectedYear}")" ReadOnly="true" Style="width:100%" />
            </RadzenFormField>
            <RadzenFormField Text="@Loc["SupplyPrimarySupplier"]" Style="width: 260px">
                <RadzenDropDown TValue="Guid?"
                                Data="@suppliers"
                                TextProperty="SupplierName"
                                ValueProperty="Id"
                                Value="@selectedSupplierId"
                                ValueChanged="@OnSupplierChangedAsync"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="@Loc["SupplyAutoRank"]"
                                Disabled="@isBusy"
                                Style="width:100%" />
            </RadzenFormField>
            @* Bảng giá là dẫn xuất từ NCC đã chọn — không cho chọn tay (Atlas: is-readonly + lock). *@
            <RadzenFormField Text="@Loc["SupplyEffectivePriceList"]" Style="width: 260px">
                <div class="vpp-supply-pricelist-lock" title="@Loc["SupplyPriceListDerivedHint"]">
                    <span class="rzi rzi-lock" aria-hidden="true"></span>
                    <RadzenTextBox Value="@EffectivePriceListLabel" ReadOnly="true" Style="width:100%" aria-label="@Loc["SupplyEffectivePriceList"]" />
                </div>
            </RadzenFormField>
            <RadzenButton Icon="fact_check"
                          Text="@Loc["SupplyRunPreview"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Disabled="@isBusy"
                          Click="@(async () => await RunPreviewAsync())" />
        </RadzenStack>
        <div class="vpp-settle-hint vpp-supply-order-hint">
            <span class="rzi rzi-info"></span>
            <span>@Loc["SupplySelectionOrderHint"]</span>
        </div>
    </div>

    @if (isBusy && State.Preview is null)
    {
        <SkeletonPage Cards="2" Rows="6" Cols="5" />
    }

    @if (State.Preview is not null)
    {
        var preview = State.Preview;
        var primary = preview.PrimaryQuote;

        @* Atlas source-coverage: khối "Độ phủ bảng giá" riêng, bind field thật của quote chính. *@
        <div class="vpp-supply-coverage-card @(primary is null ? "is-blocked" : primary.MissingVppIds.Count > 0 ? "is-partial" : "is-full")">
            <div class="vpp-supply-coverage-main">
                <span class="vpp-supply-coverage-label">@Loc["SupplyCoverageLabel"]</span>
                <strong data-source-coverage>@(primary is null ? "—" : $"{primary.CoveredItemCount}/{primary.RequestedItemCount}")</strong>
                <span class="vpp-supply-coverage-meta">
                    @(primary is null
                        ? Loc["SupplyCoverageNoPrimary"]
                        : primary.MissingVppIds.Count > 0
                            ? string.Format(Loc["SupplyCoverageMissingFormat"].Value, primary.MissingVppIds.Count)
                            : Loc["SupplyCoverageFull"])
                </span>
            </div>
            @if (primary is not null)
            {
                <div class="vpp-supply-coverage-side">
                    <div><span>@Loc["SettleQuoteTotal"]</span><strong>@FormatMoney(primary.GrandTotal)</strong></div>
                    <div><span>@Loc["SettleQuoteLeadTime"]</span><strong>@string.Format(Loc["SettleQuoteLeadTimeDays"].Value, primary.MaximumLeadTimeDays)</strong></div>
                    <div><span>@Loc["SettleInputHashTitle"]</span><code>@ShortInputHash</code></div>
                </div>
            }
        </div>

        @if (preview.Blockers.Count > 0)
        {
            <div class="vpp-settlement-blockers">
                <h4><span class="rzi rzi-warning" aria-hidden="true"></span> @Loc["SettleBlockersHeading"]</h4>
                <ul>
                    @foreach (var blocker in preview.Blockers)
                    {
                        <li>@PeriodSettlementSupport.DescribeBlocker(blocker)</li>
                    }
                </ul>
            </div>
        }

        @* Atlas exception panel: NCC thay thế + lý do bắt buộc cho từng mặt hàng thiếu giá. *@
        @if (primary is not null && (primary.MissingVppIds.Count > 0 || State.Exceptions.Count > 0))
        {
            <section class="vpp-supply-exceptions" aria-labelledby="supply-exceptions-title">
                <div class="vpp-supply-exceptions-heading">
                    <div>
                        <h4 id="supply-exceptions-title">@Loc["SupplyExceptionsTitle"]</h4>
                        <p>@Loc["SupplyExceptionsHint"]</p>
                    </div>
                    <span class="vpp-badge @(PendingExceptionCount > 0 ? "vpp-badge-warning" : "vpp-badge-success")">
                        @string.Format(Loc["SupplyExceptionsCountFormat"].Value, State.Exceptions.Count, primary.MissingVppIds.Count)
                    </span>
                </div>
                @foreach (var vppId in primary.MissingVppIds)
                {
                    var row = GetOrCreateExceptionRow(vppId);
                    var resolved = preview.Exceptions.FirstOrDefault(x => x.VppId == vppId);
                    <div class="vpp-supply-exception-row @(resolved?.IsValid == true ? "is-valid" : null)">
                        <div class="vpp-supply-exception-item">
                            <strong title="@GetItemName(vppId)">@GetItemName(vppId)</strong>
                            @if (resolved is not null && resolved.IsValid)
                            {
                                <small>@string.Format(Loc["SupplyExceptionResolvedFormat"].Value, FormatMoney(resolved.GrossAmount))</small>
                            }
                            else if (resolved?.Blocker is not null)
                            {
                                <small class="is-error">@PeriodSettlementSupport.DescribeBlocker(resolved.Blocker)</small>
                            }
                        </div>
                        <RadzenDropDown TValue="Guid?"
                                        Data="@AlternativeSuppliers"
                                        TextProperty="SupplierName"
                                        ValueProperty="Id"
                                        Value="@row.SupplierId"
                                        ValueChanged="@(value => OnExceptionSupplierChanged(vppId, value))"
                                        AllowClear="true"
                                        Placeholder="@Loc["SupplyExceptionSupplierPlaceholder"]"
                                        aria-label="@Loc["SupplyExceptionSupplierPlaceholder"]"
                                        Style="width: 220px" />
                        <RadzenTextBox Value="@row.Reason"
                                       Change="@(value => OnExceptionReasonChanged(vppId, value))"
                                       MaxLength="500"
                                       Placeholder="@Loc["SupplyExceptionReasonPlaceholder"]"
                                       aria-label="@Loc["SupplyExceptionReasonPlaceholder"]"
                                       Style="flex: 1 1 240px" />
                    </div>
                }
                <div class="vpp-supply-exception-actions">
                    <span class="vpp-supply-exception-audit">
                        <span class="rzi rzi-history" aria-hidden="true"></span>
                        @Loc["SupplyExceptionAuditHint"]
                    </span>
                    <RadzenButton Icon="refresh"
                                  Text="@Loc["SupplyReRunWithExceptions"]"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Disabled="@(isBusy || PendingExceptionCount == primary.MissingVppIds.Count && State.Exceptions.Count == 0)"
                                  Click="@(async () => await RunPreviewAsync())" />
                </div>
            </section>
        }

        @if (preview.Quotes.Count > 0)
        {
            <div class="vpp-settlement-quotes">
                <div class="vpp-settlement-quotes-header">
                    <h4>@Loc["SettleQuotesHeading"]</h4>
                    <span>@Loc["SettleQuotesSubtitle"]</span>
                </div>
                <div class="vpp-settlement-quote-table" role="table" aria-label="@Loc["SettleQuotesHeading"]">
                    <div class="vpp-settlement-quote-row is-header" role="row">
                        <span role="columnheader">@Loc["SettleQuoteRank"]</span>
                        <span role="columnheader">@Loc["SettleQuoteSupplier"]</span>
                        <span role="columnheader">@Loc["SettleQuoteCoverage"]</span>
                        <span role="columnheader">@Loc["SettleQuoteTotal"]</span>
                        <span role="columnheader">@Loc["SettleQuoteLeadTime"]</span>
                    </div>
                    @foreach (var quote in preview.Quotes.OrderBy(item => item.Rank))
                    {
                        <div class="vpp-settlement-quote-row @(quote.PriceListId == preview.PrimaryPriceListId ? "is-primary" : null)" role="row">
                            <span role="cell">#@quote.Rank</span>
                            <span role="cell"><strong>@quote.SupplierName</strong><small>@quote.PriceListCode · v@quote.Version</small></span>
                            <span role="cell">@quote.CoveredItemCount/@quote.RequestedItemCount (@quote.CoveragePercent.ToString("N0")%)</span>
                            <span role="cell">@FormatMoney(quote.GrandTotal)</span>
                            <span role="cell">@string.Format(Loc["SettleQuoteLeadTimeDays"].Value, quote.MaximumLeadTimeDays)</span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (preview.Blockers.Count == 0 && primary is not null)
        {
            <div class="vpp-supply-continue">
                <span class="rzi rzi-check-circle" aria-hidden="true"></span>
                <span>@Loc["SupplyReadyMessage"]</span>
                <RadzenButton Icon="arrow_forward"
                              Text="@Loc["SupplyContinueToSettle"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@ContinueToSettle" />
            </div>
        }
    }
</RadzenStack>
