@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.VPP
@using Radzen

<RadzenStack Gap="2rem" class="rz-p-0 rz-p-md-2">
    <div class="vpp-section">
        <RadzenStack Gap="1rem">
            @if (IsLoading)
            {
                <SkeletonPage Cards="3" Rows="6" Cols="8" />
            }
            else
            {
                <div class="kpi-grid" style="--kpi-cols: 3;">
                    <div class="kpi-card kpi-amber">
                        <div class="kpi-card-shine"></div>
                        <div class="kpi-card-content">
                            <div class="kpi-card-header">
                                <span class="kpi-card-label">@Loc["PendingOrders"]</span>
                                <span class="kpi-card-icon rzi rzi-pending-actions"></span>
                            </div>
                            <div class="kpi-card-value">@TotalCount</div>
                        </div>
                    </div>
                    <div class="kpi-card kpi-blue">
                        <div class="kpi-card-shine"></div>
                        <div class="kpi-card-content">
                            <div class="kpi-card-header">
                                <span class="kpi-card-label">@Loc["TotalLineItems"]</span>
                                <span class="kpi-card-icon rzi rzi-format-list-numbered"></span>
                            </div>
                            <div class="kpi-card-value">@TotalLines</div>
                        </div>
                    </div>
                    <div class="kpi-card kpi-emerald">
                        <div class="kpi-card-shine"></div>
                        <div class="kpi-card-content">
                            <div class="kpi-card-header">
                                <span class="kpi-card-label">@Loc["TotalQuantity"]</span>
                                <span class="kpi-card-icon rzi rzi-inventory-2"></span>
                            </div>
                            <div class="kpi-card-value">@TotalQuantity</div>
                        </div>
                    </div>
                </div>
            }

            @if (TotalCount == 0 && !IsGridLoading && !IsLoading)
            {
                <VppEmptyState Icon="check_circle"
                               Title="@Loc["AllClear"]"
                               Description="@Loc["NoPendingAdditionalOrders"]"
                               PrimaryText="@Loc["RefreshQueue"]"
                               PrimaryAction="@(_ => ReloadRequested.InvokeAsync())" />
            }
            else
            {
                <div class="vpp-atlas-order-workspace vpp-atlas-approval-workspace">
                    <div class="vpp-atlas-order-collection">
                        <div class="vpp-mobile-cards">
                            <VppMobileCard Items="@Orders" Actions="@RenderMobileActions" />
                        </div>

                        <div class="vpp-data-card vpp-datagrid" style="padding: 0; overflow: hidden;">
                            <RadzenDataGrid TItem="VppRequestResDTO" Data="@Orders"
                                            Count="@TotalCount" LoadData="@LoadDataRequested"
                                            AllowPaging="true" PageSize="@PageSize"
                                            PageSizeOptions="@(new int[] { 10, 20, 50 })"
                                            PageSizeText="@Loc["ItemsPerPage"]"
                                            ShowPagingSummary="true"
                                            PagerHorizontalAlign="HorizontalAlign.Left"
                                            AllowSorting="true" AllowAlternatingRows="true"
                                            AllowColumnResize="true" ExpandMode="DataGridExpandMode.Single"
                                            RowExpand="@RowExpandRequested"
                                            RowSelect="@OrderSelected"
                                            SelectionMode="DataGridSelectionMode.Single"
                                            IsLoading="@IsGridLoading"
                                            AllowFiltering="true"
                                            AllowMultiColumnSorting="true"
                                            ShowMultiColumnSortingIndex="true"
                                            AllowColumnReorder="false"
                                            FilterMode="FilterMode.CheckBoxList"
                                            LoadColumnFilterData="@ColumnFilterDataRequested"
                                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                            Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                            class="vpp-order-grid"
                                            Style="border: none; --vpp-grid-min-width: 1460px;">
                                <Columns>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                        <Template Context="row">@(CurrentSkip + Orders.IndexOf(row) + 1)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["OrderCode"]" Width="220px" TextAlign="TextAlign.Left">
                                        <Template Context="row">
                                            <div class="vpp-order-code-cell">
                                                <span class="vpp-link-text vpp-order-code-link vpp-order-code-trigger" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" title="@row.VppCode" style="cursor: pointer; text-decoration: underline dotted var(--vpp-border-strong); user-select: all;">
                                                    @ShortCode(row)
                                                </span>
                                                <div class="vpp-order-code-popover">
                                                    <span class="vpp-order-code-popover-text">@row.VppCode</span>
                                                    <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="width: 24px; height: 24px; padding: 0; min-width: 24px;" Click="@(_ => CopyRequested.InvokeAsync(row.VppCode))" Title="@Loc["Copy"]" />
                                                </div>
                                                @if (row.IsAdditionalOrder)
                                                {
                                                    <RadzenBadge Text="@Loc["Additional"]" BadgeStyle="BadgeStyle.Warning" IsPill="true" Style="font-size: 0.65rem;" />
                                                }
                                            </div>
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.Period)" Title="@Loc["Period"]" Width="105px" TextAlign="TextAlign.Center">
                                        <Template Context="row"><RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@row.Period" /></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="StatusText" Title="@Loc["Status"]" Width="130px" TextAlign="TextAlign.Center" Sortable="true">
                                        <Template Context="row">
                                            <span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@row.StatusText</span>
                                            @if (row.SettledAt.HasValue)
                                            {
                                                <span class="vpp-badge-settled" title="@($"{Loc["Settled"]}: {DateFormatter.Format(row.SettledAt, DateFormatter.LongDate)} - {row.SettledByPriceListName}")">@Loc["Settled"]</span>
                                            }
                                        </Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.DepartmentCode)" Title="@Loc["Department"]" Width="105px" TextAlign="TextAlign.Center" />
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.RequesterName)" Title="@Loc["HistoryRequester"]" Width="150px" TextAlign="TextAlign.Left">
                                        <Template Context="row"><span style="font-weight: var(--vpp-font-weight-medium);">@row.RequesterName</span></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalLines)" Title="@Loc["TotalLineItems"]" Width="125px" TextAlign="TextAlign.Center">
                                        <Template Context="row"><strong>@row.TotalLines</strong></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalQty)" Title="@Loc["TotalQuantity"]" Width="125px" TextAlign="TextAlign.Center">
                                        <Template Context="row"><strong>@row.TotalQty</strong></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.SubmittedDate)" FilterProperty="@nameof(VppRequestResDTO.SubmittedDateText)" Title="@Loc["SubmittedDate"]" Width="160px" TextAlign="TextAlign.Center" FormatString="{0:HH:mm dd/MM/yyyy}">
                                        <Template Context="row">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.Description)" Title="@Loc["Description"]" Width="190px" TextAlign="TextAlign.Left" />
                                    <RadzenDataGridColumn TItem="VppRequestResDTO" Title="@Loc["Actions"]" Width="110px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                        <Template Context="order">@RenderDecisionActions(order)</Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                                <Template Context="row">
                                    <div class="vpp-expand-detail">
                                        <div class="vpp-expand-detail-header"><span class="rzi rzi-list-alt"></span>@Loc["OrderDetails"]</div>
                                        @if (DetailLoading(row.Id))
                                        {
                                            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height: 3px;" />
                                        }
                                        <RadzenDataGrid TItem="VppRequestDetailResDTO" Data="@(row.Items ?? new())"
                                                        AllowPaging="false" AllowFiltering="false" AllowSorting="false"
                                                        Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                                        class="vpp-order-grid" Style="border: none;">
                                            <Columns>
                                                <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                                    <Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template>
                                                </RadzenDataGridColumn>
                                                <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="VppCode" Title="@Loc["ProductCode"]" Width="130px" TextAlign="TextAlign.Left" />
                                                <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="VppName" Title="@Loc["ProductName"]" Width="280px" TextAlign="TextAlign.Left" />
                                                <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="Qty" Title="@Loc["Quantity"]" Width="90px" TextAlign="TextAlign.Center" />
                                                <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="UomName" Title="@Loc["UOM"]" Width="100px" TextAlign="TextAlign.Center" />
                                                <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="Description" Title="@Loc["Note"]" Width="180px" TextAlign="TextAlign.Left" />
                                            </Columns>
                                        </RadzenDataGrid>
                                    </div>
                                </Template>
                            </RadzenDataGrid>
                        </div>
                    </div>

                    <aside class="vpp-atlas-order-detail" aria-live="polite">
                        @if (SelectedOrder is null)
                        {
                            <div class="vpp-atlas-order-detail-empty">
                                <span class="rzi rzi-approval" aria-hidden="true"></span>
                                <strong>@Loc["ApprovalSelectOrder"]</strong>
                                <span>@Loc["ApprovalSelectOrderDescription"]</span>
                            </div>
                        }
                        else
                        {
                            <header class="vpp-atlas-sheet-header">
                                <div>
                                    <span class="vpp-atlas-sheet-kicker">@Loc["HistoryDetailSheetTitle"]</span>
                                    <div class="vpp-atlas-sheet-code">
                                        <strong>@SelectedOrder.VppCode</strong>
                                        <span class="vpp-badge @StatusDisplay.GetCssClass(SelectedOrder.Status)">@SelectedOrder.StatusText</span>
                                    </div>
                                    @if (SelectedOrder.SubmittedDate.HasValue)
                                    {
                                        <p class="vpp-atlas-sheet-meta">@string.Format(Loc["SubmittedAtInlineFormat"].Value, DateFormatter.Format(SelectedOrder.SubmittedDate, DateFormatter.LongDate))</p>
                                    }
                                </div>
                                <div class="vpp-atlas-sheet-actions">
                                    <RadzenButton Icon="picture_as_pdf" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                  Click="@(_ => ExportPdfRequested.InvokeAsync(SelectedOrder))" Title="@Loc["ExportPdf"]"
                                                  aria-label="@string.Format(Loc["ExportOrderPdfAria"], SelectedOrder.VppCode)" Disabled="@IsExporting" />
                                    <RadzenButton Icon="table_view" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                  Click="@(_ => ExportExcelRequested.InvokeAsync(SelectedOrder))" Title="@Loc["ExportExcel"]"
                                                  aria-label="@string.Format(Loc["ExportOrderExcelAria"], SelectedOrder.VppCode)" Disabled="@IsExporting" />
                                </div>
                            </header>
                            <dl class="vpp-atlas-order-facts">
                                <div><dt>@Loc["HistoryRequester"]</dt><dd title="@SelectedOrder.RequesterName">@SelectedOrder.RequesterName</dd></div>
                                <div><dt>@Loc["Department"]</dt><dd>@SelectedOrder.DepartmentCode</dd></div>
                                <div><dt>@Loc["Period"]</dt><dd>@SelectedOrder.Period</dd></div>
                                <div><dt>@Loc["TotalQuantity"]</dt><dd>@SelectedOrder.TotalQty</dd></div>
                            </dl>
                            <div class="vpp-atlas-approval-reason">
                                <span>@Loc["SupplementReason"]</span>
                                <p>@(string.IsNullOrWhiteSpace(SelectedOrder.SupplementReason) ? Loc["ApprovalNoReason"] : SelectedOrder.SupplementReason)</p>
                            </div>
                            <div class="vpp-atlas-order-items">
                                <div class="vpp-atlas-sheet-items-heading">
                                    <h3>@Loc["ApprovalItemsHeading"]</h3>
                                    <span class="vpp-badge vpp-badge-info">@Loc["ItemsCount", SelectedOrder.Items?.Count ?? 0]</span>
                                </div>
                                @if (DetailLoading(SelectedOrder.Id))
                                {
                                    <SkeletonPage Cards="0" Rows="5" Cols="3" />
                                }
                                else
                                {
                                    @foreach (var item in SelectedOrder.Items ?? new())
                                    {
                                        <div class="vpp-atlas-order-item">
                                            <span>
                                                <strong title="@item.VppName">@item.VppName</strong>
                                                <small>@item.VppCode · @item.CategoryName · @item.UomName</small>
                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <small class="vpp-atlas-item-note" title="@item.Description">@item.Description</small>
                                                }
                                            </span>
                                            <b>@item.Qty</b>
                                        </div>
                                    }
                                }
                            </div>
                            <footer class="vpp-atlas-approval-actions">
                                @if (CanReject)
                                {
                                    <RadzenButton Icon="cancel" Text="@Loc["Reject"]" ButtonStyle="ButtonStyle.Danger"
                                                  Disabled="@Processing(SelectedOrder.Id)" Click="@(_ => RejectRequested.InvokeAsync(SelectedOrder))" />
                                }
                                @if (CanApprove)
                                {
                                    <RadzenButton Icon="check_circle" Text="@Loc["Approval"]" ButtonStyle="ButtonStyle.Primary"
                                                  Disabled="@Processing(SelectedOrder.Id)" Click="@(_ => ApproveRequested.InvokeAsync(SelectedOrder))" />
                                }
                            </footer>
                        }
                    </aside>
                </div>
            }
        </RadzenStack>
    </div>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public List<VppRequestResDTO> Orders { get; set; } = [];
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalLines { get; set; }
    [Parameter] public int TotalQuantity { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int CurrentSkip { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsGridLoading { get; set; }
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public bool CanReject { get; set; }
    [Parameter] public bool IsExporting { get; set; }
    [Parameter] public VppRequestResDTO? SelectedOrder { get; set; }
    [Parameter, EditorRequired] public Func<Guid, bool> Processing { get; set; } = _ => false;
    [Parameter, EditorRequired] public Func<Guid, bool> DetailLoading { get; set; } = _ => false;
    [Parameter, EditorRequired] public Func<VppRequestResDTO, string> ShortCode { get; set; } = _ => string.Empty;
    [Parameter] public EventCallback ReloadRequested { get; set; }
    [Parameter] public EventCallback<LoadDataArgs> LoadDataRequested { get; set; }
    [Parameter] public EventCallback<DataGridLoadColumnFilterDataEventArgs<VppRequestResDTO>> ColumnFilterDataRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> RowExpandRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> OrderSelected { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ApproveRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> RejectRequested { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ExportPdfRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ExportExcelRequested { get; set; }

    private RenderFragment<VppRequestResDTO> RenderMobileActions => order => @<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        @RenderDecisionActions(order)
    </RadzenStack>;

    private RenderFragment RenderDecisionActions(VppRequestResDTO order) => @<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.25rem">
        @if (CanApprove)
        {
            <RadzenButton Icon="check_circle" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                          Click="@(() => ApproveRequested.InvokeAsync(order))" Title="@Loc["Approve"]"
                          aria-label="@string.Format(Loc["ApproveOrderAria"], order.VppCode)"
                          Disabled="@Processing(order.Id)" IsBusy="@Processing(order.Id)" />
        }
        @if (CanReject)
        {
            <RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                          Click="@(() => RejectRequested.InvokeAsync(order))" Title="@Loc["Reject"]"
                          aria-label="@string.Format(Loc["RejectOrderAria"], order.VppCode)"
                          Disabled="@Processing(order.Id)" IsBusy="@Processing(order.Id)" />
        }
    </RadzenStack>;
}
