@using gtas_vpp_shared.DTOs.Res.Library


<div class="vpp-settle-container">
    <!-- Left Pane: Parameter Configuration -->
    <div class="vpp-settle-params">
        <h4 class="vpp-settle-sub-title">@Loc["Parameters"]</h4>
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="@Loc["TargetPeriod"]" Style="width: 100%">
                <RadzenTextBox Value="@($"{selectedMonth:D2}/{selectedYear}")"
                               ReadOnly="true"
                               Style="width:100%" />
            </RadzenFormField>

            <RadzenFormField Text="@Loc["PriceList"]" Style="width: 100%">
                <RadzenDropDown TValue="Guid?"
                                Data="@priceLists"
                                TextProperty="PriceListName"
                                ValueProperty="Id"
                                Value="@selectedPriceListId"
                                ValueChanged="@OnPriceListChangedAsync"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="@Loc["PriceList_UseDefault"]"
                                Disabled="@isLoading"
                                Style="width:100%" />
            </RadzenFormField>

            @if (canCorrect)
            {
                <RadzenFormField Text="Lý do hiệu chỉnh" Style="width: 100%">
                    <RadzenTextArea @bind-Value="correctionReason"
                                    Name="CorrectionReason"
                                    Rows="3"
                                    MaxLength="500"
                                    Placeholder="Nhập lý do hiệu chỉnh (5–500 ký tự)"
                                    Disabled="@isLoading"
                                    Style="width:100%" />
                    <div class="vpp-settle-hint">Lý do là bắt buộc; người xác nhận phải khác người đã xác nhận phiên bản trước.</div>
                </RadzenFormField>
            }

            <div class="vpp-settle-hint">
                <span class="rzi rzi-info"></span>
                <span>@Loc["Hint_AutoTargetsClosedPeriod"]</span>
            </div>
        </RadzenStack>
    </div>

    <!-- Right Pane: Status & Settle Actions -->
    <div class="vpp-settle-status-card @StatusCardClass">
        <div class="vpp-settle-status-header">
            <span class="vpp-settle-status-title">@Loc["PeriodStatus"]</span>
            <span class="vpp-settle-period-badge">@selectedMonth.ToString("D2")/@selectedYear</span>
        </div>
        
        <div class="vpp-settle-status-body">
            @if (isLoading)
            {
                <div class="vpp-settle-loading">
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height: 4px; width: 100%;" />
                    <span class="vpp-settle-status-desc">@Loc["CheckingPeriodStatus"]</span>
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(alertMessage))
                {
                    <div class="vpp-settle-alert vpp-alert-@alertStyle.ToString().ToLower()">
                        <span class="vpp-settle-alert-icon rzi @(alertStyle == AlertStyle.Danger ? "rzi-error" : alertStyle == AlertStyle.Warning ? "rzi-warning" : "rzi-info")"></span>
                        <div class="vpp-settle-alert-content">
                            @alertMessage
                        </div>
                    </div>
                }
                else
                {
                    <div class="vpp-settle-status-ready">
                        <span class="vpp-settle-ready-icon rzi rzi-check-circle"></span>
                        <span class="vpp-settle-status-desc">@Loc["PeriodReadyToSettle"]</span>
                    </div>
                }
            }
        </div>
        
        <div class="vpp-settle-actions">
            <RadzenButton Icon="fact_check"
                          Text="Xem trước"
                          ButtonStyle="ButtonStyle.Light"
                          Disabled="@(!canPreview || isLoading || isPreviewing || isSettling)"
                          Click="@PreviewAsync"
                          class="vpp-settle-btn" />
            <span class="vpp-disabled-action-help vpp-settle-btn" title="@SettlePeriodTitle">
                <RadzenButton Icon="lock"
                              Text="@Loc["SettlePeriod"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(!canSettle || isLoading || isSettling)"
                              Click="@SettleAsync"
                              class="vpp-settle-btn" />
            </span>
            @if (canCorrect)
            {
                <RadzenButton Icon="edit_note"
                              Text="Tạo phiên bản hiệu chỉnh"
                              ButtonStyle="ButtonStyle.Warning"
                              Disabled="@(!canCorrect || !canSettlePreview || isLoading || isCorrecting)"
                              Click="@CorrectAsync"
                              class="vpp-settle-btn" />
            }
        </div>
    </div>
</div>

@if (preview is not null)
{
    <section class="vpp-settlement-preview" aria-label="Kết quả xem trước chốt kỳ">
        <div class="vpp-settlement-preview-heading">
            <div>
                <span>Kết quả xem trước</span>
                <h3>Độ phủ nguồn cung và tổng giá trị</h3>
            </div>
            <code title="Mã kiểm tra dữ liệu đầu vào">@ShortInputHash</code>
        </div>

        <div class="vpp-settlement-preview-kpis">
            <article><span>Mặt hàng yêu cầu</span><strong>@preview.RequestedItemCount</strong></article>
            <article><span>Dòng nhu cầu</span><strong>@preview.RequestedLineCount</strong></article>
            <article><span>Đơn bổ sung chờ duyệt</span><strong>@preview.PendingAdditionalCount</strong></article>
            <article><span>Điều kiện ngăn chốt</span><strong>@preview.Blockers.Count</strong></article>
        </div>

        @if (preview.Blockers.Count > 0)
        {
            <div class="vpp-settlement-blockers">
                <h4><span class="rzi rzi-warning" aria-hidden="true"></span> Cần xử lý trước khi chốt</h4>
                <ul>
                    @foreach (var blocker in preview.Blockers)
                    {
                        <li>@DescribeBlocker(blocker)</li>
                    }
                </ul>
            </div>
        }

        @if (preview.Quotes.Count > 0)
        {
            <div class="vpp-settlement-quotes">
                <div class="vpp-settlement-quotes-header">
                    <h4>Xếp hạng nguồn cung</h4>
                    <span>Ưu tiên độ phủ đầy đủ, sau đó so sánh tổng giá trị và thời gian giao.</span>
                </div>
                <div class="vpp-settlement-quote-table" role="table" aria-label="Xếp hạng nguồn cung">
                    <div class="vpp-settlement-quote-row is-header" role="row">
                        <span role="columnheader">Hạng</span>
                        <span role="columnheader">Nhà cung cấp / bảng giá</span>
                        <span role="columnheader">Độ phủ</span>
                        <span role="columnheader">Tổng giá trị</span>
                        <span role="columnheader">Giao hàng</span>
                    </div>
                    @foreach (var quote in preview.Quotes.OrderBy(item => item.Rank))
                    {
                        <div class="vpp-settlement-quote-row @(quote.PriceListId == preview.PrimaryPriceListId ? "is-primary" : null)" role="row">
                            <span role="cell">#@quote.Rank</span>
                            <span role="cell"><strong>@quote.SupplierName</strong><small>@quote.PriceListCode · v@quote.Version</small></span>
                            <span role="cell">@quote.CoveredItemCount/@quote.RequestedItemCount (@quote.CoveragePercent.ToString("N0")%)</span>
                            <span role="cell">@FormatMoney(quote.GrandTotal)</span>
                            <span role="cell">@quote.MaximumLeadTimeDays ngày</span>
                        </div>
                    }
                </div>
            </div>
        }
    </section>
}
