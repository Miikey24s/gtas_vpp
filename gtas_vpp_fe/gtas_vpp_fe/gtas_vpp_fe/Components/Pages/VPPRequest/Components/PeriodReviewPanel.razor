@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Res.VPP

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<RadzenStack Gap="1rem">
    <div class="vpp-data-card">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
            <RadzenFormField Text="@Loc["Year"]" Style="width: 160px">
                <RadzenNumeric TValue="int"
                               Value="@selectedYear"
                               ValueChanged="@OnYearChangedAsync"
                               Min="2024"
                               Max="2030"
                               InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = Loc["Year"].Value })"
                               Disabled="@(isLoading || isSettling)"
                               Style="width:100%" />
            </RadzenFormField>

            <RadzenFormField Text="@Loc["Month"]" Style="width: 160px">
                <RadzenDropDown TValue="int"
                                Data="@months"
                                Value="@selectedMonth"
                                ValueChanged="@OnMonthChangedAsync"
                                Disabled="@(isLoading || isSettling)"
                                Style="width:100%" />
            </RadzenFormField>

            <RadzenFormField Text="@Loc["PriceList"]" Style="min-width: 260px">
                <RadzenDropDown TValue="Guid?"
                                Data="@priceLists"
                                TextProperty="PriceListName"
                                ValueProperty="Id"
                                Value="@selectedPriceListId"
                                ValueChanged="@OnPriceListChangedAsync"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="@Loc["PriceList_UseDefault"]"
                                Disabled="@(isLoading || isSettling)"
                                Style="width:100%" />
            </RadzenFormField>

            <RadzenButton Icon="refresh"
                          Text="@Loc["Reload"]"
                          ButtonStyle="ButtonStyle.Light"
                          Disabled="@(isLoading || isSettling)"
                          Click="@ReloadPeriodAsync" />

            <span class="vpp-disabled-action-help" title="@SettlePeriodTitle">
                <RadzenButton Icon="lock"
                              Text="@Loc["SettlePeriod"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(!canSettle || isLoading || isSettling)"
                              Click="@SettleAsync" />
            </span>
        </RadzenStack>
    </div>

    @if (!string.IsNullOrWhiteSpace(alertMessage))
    {
        <div class="vpp-settle-alert vpp-alert-@alertStyle.ToString().ToLower()">
            <span class="vpp-settle-alert-icon rzi @(alertStyle == AlertStyle.Danger ? "rzi-error" : alertStyle == AlertStyle.Warning ? "rzi-warning" : "rzi-info")"></span>
            <div class="vpp-settle-alert-content">@alertMessage</div>
        </div>
    }

    @if (isLoading)
    {
        <SkeletonPage Cards="4" Rows="6" Cols="8" />
    }
    else
    {
        <div class="kpi-grid" style="--kpi-cols: 4;">
            <div class="kpi-card kpi-blue">
                <div class="kpi-card-shine"></div>
                <div class="kpi-card-content">
                    <div class="kpi-card-header">
                        <span class="kpi-card-label">@Loc["TotalOrders"]</span>
                        <span class="kpi-card-icon rzi rzi-receipt-long"></span>
                    </div>
                    <div class="kpi-card-value">@totalCount</div>
                </div>
            </div>
            <div class="kpi-card kpi-emerald">
                <div class="kpi-card-shine"></div>
                <div class="kpi-card-content">
                    <div class="kpi-card-header">
                        <span class="kpi-card-label">@Loc["TotalLineItems"]</span>
                        <span class="kpi-card-icon rzi rzi-format-list-numbered"></span>
                    </div>
                    <div class="kpi-card-value">@totalLines</div>
                </div>
            </div>
            <div class="kpi-card kpi-amber">
                <div class="kpi-card-shine"></div>
                <div class="kpi-card-content">
                    <div class="kpi-card-header">
                        <span class="kpi-card-label">@Loc["TotalQuantity"]</span>
                        <span class="kpi-card-icon rzi rzi-inventory-2"></span>
                    </div>
                    <div class="kpi-card-value">@totalQty</div>
                </div>
            </div>
            <div class="kpi-card kpi-purple">
                <div class="kpi-card-shine"></div>
                <div class="kpi-card-content">
                    <div class="kpi-card-header">
                        <span class="kpi-card-label">@Loc["Amount"]</span>
                        <span class="kpi-card-icon rzi rzi-payments"></span>
                    </div>
                    <div class="kpi-card-value">@FormatMoney(totalAmount)</div>
                </div>
            </div>
        </div>

        @if (totalCount == 0 && !isGridLoading)
        {
            <VppEmptyState Icon="business"
                           Title="@Loc["NoData"]"
                           Description="@Loc["NoOrdersMatchSelectedFilters"]"
                           PrimaryText="@Loc["Reload"]"
                           PrimaryAction="@(async _ => await ReloadPeriodAsync())" />
        }
        else
        {
            <div class="vpp-data-card vpp-datagrid" style="padding: 0; overflow: hidden;">
                <RadzenDataGrid TItem="VppRequestResDTO" Data="@orders"
                                Count="@totalCount" LoadData="@OnLoadData"
                                AllowPaging="true" PageSize="@pageSize"
                                PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                                PageSizeText="@Loc["ItemsPerPage"]"
                                ShowPagingSummary="true"
                                PagerHorizontalAlign="HorizontalAlign.Left"
                                AllowSorting="true" AllowAlternatingRows="true"
                                AllowColumnResize="true" ExpandMode="DataGridExpandMode.Single"
                                RowExpand="OnRowExpandAsync"
                                IsLoading="@isGridLoading"
                                AllowFiltering="true"
                                AllowMultiColumnSorting="true"
                                ShowMultiColumnSortingIndex="true"
                                AllowColumnReorder="false"
                                FilterMode="FilterMode.CheckBoxList"
                                LoadColumnFilterData="@OnLoadColumnFilterData"
                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                class="vpp-order-grid"
                                Style="border: none; --vpp-grid-min-width: 1420px;">
                    <Columns>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="row">@(currentSkip + orders.IndexOf(row) + 1)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.DepartmentCode)" Title="@Loc["Department"]" Width="105px" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.RequesterName)" Title="@Loc["Username"]" Width="150px" TextAlign="TextAlign.Left" />
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["OrderCode"]" Width="220px" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <div class="vpp-order-code-cell">
                                    <span class="vpp-link-text vpp-order-code-link vpp-order-code-trigger" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" title="@row.VppCode" style="cursor: pointer; text-decoration: underline dotted var(--vpp-border-strong); user-select: all;">
                                        @GetShortCode(row)
                                    </span>
                                    <div class="vpp-order-code-popover">
                                        <span class="vpp-order-code-popover-text">@row.VppCode</span>
                                        <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="width: 24px; height: 24px; padding: 0; min-width: 24px;" Click="@(async _ => await CopyToClipboard(row.VppCode))" Title="@Loc["Copy"]" />
                                    </div>
                                    @if (row.IsAdditionalOrder)
                                    {
                                        <RadzenBadge Text="@Loc["Additional"]" BadgeStyle="BadgeStyle.Warning" IsPill="true" Style="font-size: 0.65rem;" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="StatusText" Title="@Loc["Status"]" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                <span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@row.StatusText</span>
                                @if (row.SettledAt.HasValue)
                                {
                                    <span class="vpp-badge-settled" title="@($"{Loc["Settled"]}: {DateFormatter.Format(row.SettledAt, DateFormatter.LongDate)} - {row.SettledByPriceListName}")">
                                        @Loc["Settled"]
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalLines)" Title="@Loc["TotalLineItems"]" Width="125px" TextAlign="TextAlign.Center">
                            <Template Context="row"><strong>@row.TotalLines</strong></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalQty)" Title="@Loc["TotalQuantity"]" Width="125px" TextAlign="TextAlign.Center">
                            <Template Context="row"><strong>@row.TotalQty</strong></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalAmount)" Title="@Loc["Amount"]" Width="130px" TextAlign="TextAlign.Right" Filterable="false">
                            <Template Context="row"><strong>@FormatMoney(row.TotalAmount)</strong></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.SubmittedDate)" FilterProperty="@nameof(VppRequestResDTO.SubmittedDateText)" Title="@Loc["SubmittedDate"]" Width="160px" TextAlign="TextAlign.Center" FormatString="{0:HH:mm dd/MM/yyyy}">
                            <Template Context="row">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.Description)" Title="@Loc["Note"]" Width="190px" TextAlign="TextAlign.Left" />
                    </Columns>
                    <Template Context="row">
                        <div class="vpp-expand-detail">
                            <div class="vpp-expand-detail-header">
                                <span class="rzi rzi-list-alt"></span>
                                @Loc["OrderDetails"]
                            </div>
                            @if (IsRowDetailLoading(row.Id))
                            {
                                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height: 3px;" />
                            }
                            <RadzenDataGrid TItem="VppRequestDetailResDTO" Data="@(row.Items ?? new())"
                                            AllowPaging="false" AllowFiltering="false" AllowSorting="false"
                                            Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                            class="vpp-order-grid"
                                            Style="border: none;">
                                <Columns>
                                    <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                                        <Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="VppCode" Title="@Loc["ProductCode"]" Width="130px" TextAlign="TextAlign.Left" />
                                    <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="VppName" Title="@Loc["ProductName"]" Width="280px" TextAlign="TextAlign.Left" />
                                    <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="Qty" Title="@Loc["Quantity"]" Width="90px" TextAlign="TextAlign.Center" />
<RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="UomName" Title="@Loc["UOM"]" Width="100px" TextAlign="TextAlign.Center" />
                                    <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="CurrentSinglePrice" Title="@Loc["Price"]" Width="120px" TextAlign="TextAlign.Right">
                                        <Template Context="item">@FormatMoney(item.CurrentSinglePrice)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="TotalPrice" Title="@Loc["Total"]" Width="120px" TextAlign="TextAlign.Right">
                                        <Template Context="item"><strong>@FormatMoney(item.TotalPrice)</strong></Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </div>
                    </Template>
                </RadzenDataGrid>
            </div>
        }
    }
</RadzenStack>
