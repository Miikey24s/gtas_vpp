<div class="wizard-step wizard-step-review">
    <section class="vpp-order-review-panel" aria-labelledby="order-review-title">
        <header class="vpp-order-review-header">
            <div>
                <h2 id="order-review-title">@Loc["ReviewOrderBeforeSubmit"]</h2>
                <p>@Loc["ReviewOrderBeforeSubmitDescription"]</p>
            </div>
            <div class="vpp-order-draft-badges">
                <span class="vpp-badge status-info">@Loc["ItemsCount", Context.SelectedItems.Count]</span>
                @if (Context.IsAdditional)
                {
                    <span class="vpp-badge status-warning">@Loc["AdditionalOrder"]</span>
                }
            </div>
        </header>

        <dl class="vpp-order-review-summary">
            <div><dt>@Loc["TotalLineItems"]</dt><dd>@Context.SelectedItems.Count</dd></div>
            <div><dt>@Loc["TotalQuantity"]</dt><dd>@Context.TotalQty</dd></div>
            <div><dt>@(Context.IsAdditional ? Loc["SupplementReason"] : Loc["OrderNote"])</dt><dd>@OrderNote</dd></div>
        </dl>

        @if (Context.SelectedItems.Count == 0)
        {
            <VppStatePanel State="empty"
                           Icon="remove_shopping_cart"
                           Title="@Loc["WizardNoItemsToSubmit"]"
                           Description="@Loc["WizardNoItemsToSubmitDesc"]" />
        }
        else
        {
            <div class="vpp-order-review-grid-frame">
                <RadzenDataGrid TItem="OrderCreateContext.SelectedItem"
                                Data="@Context.SelectedItems"
                                AllowVirtualization="true"
                                VirtualizationOverscanCount="4"
                                AllowPaging="false"
                                AllowSorting="false"
                                AllowFiltering="false"
                                AllowAlternatingRows="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                class="vpp-order-review-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Title="#" Width="56px" TextAlign="TextAlign.Center">
                            <Template Context="item">@(Context.SelectedItems.IndexOf(item) + 1)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Property="VppName" Title="@Loc["ItemName"]">
                            <Template Context="item">
                                <div class="vpp-order-builder-item-cell">
                                    <strong>@item.VppName</strong>
                                    <small>@item.VppCode</small>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Property="Qty" Title="@Loc["Quantity"]" Width="130px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Property="UomName" Title="@Loc["UOM"]" Width="120px" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Property="Description" Title="@Loc["ItemNote"]" Width="320px">
                            <Template Context="item">@(string.IsNullOrWhiteSpace(item.Description) ? "–" : item.Description)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OrderCreateContext.SelectedItem" Title="" Width="56px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <button type="button"
                                        class="vpp-order-draft-remove"
                                        title="@Loc["RemoveItemFromOrder"]"
                                        aria-label="@Loc["RemoveItemFromOrder"]"
                                        @onclick="() => RemoveItem(item)">
                                    <VppIcon Name="close" />
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
            <footer class="vpp-order-builder-data-footer">@Loc["SelectedItemsSummary", Context.SelectedItems.Count, Context.TotalQty]</footer>
        }
    </section>
</div>

@code {
    [CascadingParameter] public OrderCreateContext Context { get; set; } = default!;

    private string OrderNote => Context.IsAdditional
        ? Context.SupplementReason ?? "–"
        : Context.Description ?? "–";

    private void RemoveItem(OrderCreateContext.SelectedItem item)
    {
        Context.SelectedItems.Remove(item);
        Context.NotifyStateChanged();
    }
}
