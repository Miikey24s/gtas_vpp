@page "/report"
@layout MainLayout
@inherits ReportBase
@using gtas_vpp_shared.DTOs.Res.Reports


<PageTitle>GTAS VPP - @Loc["Reports"]</PageTitle>

@if (!RendererInfo.IsInteractive)
{
    <main class="vpp-report-page" aria-busy="true">
        <SkeletonPage Cards="3" Rows="8" Cols="5" />
    </main>
}
else if (!CanViewReport)
{
    <VppEmptyState Icon="lock"
                   Title="@Loc["AccessDenied"]"
                   Description="@Loc["NoPermission"]" />
}
else
{
    <main class="vpp-report-page">
        <header class="vpp-report-header">
            <div>
                <h1 class="vpp-report-heading">@Loc["Reports"]</h1>
                <p class="vpp-report-description">@Loc["ReportPageDescription"]</p>
                @if (Summary is not null)
                {
                    <p>@string.Format(Loc["GeneratedAt"], FormatGeneratedAt(Summary.GeneratedAt))</p>
                }
            </div>
            <div class="vpp-report-actions">
                @if (Summary is { TotalOrders: > 0 })
                {
                    <RadzenButton Icon="auto_awesome"
                                  Text="@Loc["GenerateInsights"]"
                                  BusyText="@Loc["GeneratingInsights"]"
                                  IsBusy="@IsLoadingInsights"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="GenerateInsightsAsync"
                                  Disabled="@(IsLoading || IsExporting)" />
                }
                @if (CanExport)
                {
                    <RadzenButton Icon="file_download"
                                  Text="@Loc["ExportReport"]"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="ExportAsync"
                                  Disabled="@(IsLoading || IsExporting || Summary is null)" />
                }
            </div>
        </header>

        <section class="vpp-report-filters" aria-label="@Loc["ReportFilters"]">
            <label>
                <span>@Loc["ReportScope"]</span>
                <select @bind="SelectedScope">
                    @foreach (var option in ScopeOptions)
                    {
                        <option value="@option.Value">@Loc[option.ResourceKey]</option>
                    }
                </select>
            </label>
            <label>
                <span>@Loc["Year"]</span>
                <select @bind="SelectedYear">
                    <option value="">@Loc["AllYears"]</option>
                    @foreach (var year in AvailableYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </label>
            <label>
                <span>@Loc["Month"]</span>
                <select @bind="SelectedMonth">
                    <option value="">@Loc["AllMonths"]</option>
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@month.ToString("00")</option>
                    }
                </select>
            </label>
            <RadzenButton Icon="filter_alt"
                          Text="@Loc["ApplyFilters"]"
                          ButtonStyle="ButtonStyle.Light"
                          Click="LoadAsync"
                          Disabled="@IsLoading" />
        </section>

        @if (IsLoading && Summary is null)
        {
            <SkeletonPage Cards="5" Rows="6" Cols="4" />
        }
        else if (Summary is null || Summary.TotalOrders == 0)
        {
            <VppEmptyState Icon="analytics"
                           Title="@Loc["NoReportData"]"
                           Description="@Loc["NoReportDataDescription"]"
                           PrimaryText="@Loc["Refresh"]"
                           PrimaryAction="@(async _ => await LoadAsync())" />
        }
        else
        {
            <section class="vpp-report-kpis" aria-label="@Loc["ReportSummary"]">
                @Kpi("receipt_long", Loc["TotalOrders"], Summary.TotalOrders.ToString("N0"))
                @Kpi("format_list_numbered", Loc["TotalLineItems"], Summary.TotalLines.ToString("N0"))
                @Kpi("inventory_2", Loc["TotalQuantity"], Summary.TotalQuantity.ToString("N0"))
                @Kpi("payments", Loc["TotalAmount"], FormatAmount(Summary.TotalAmount))
                @Kpi("groups", Loc["Requesters"], Summary.TotalRequesters.ToString("N0"))
            </section>

            @if (Insight is not null)
            {
                <section class="vpp-report-insight" aria-live="polite" aria-label="@Loc["ReportInsights"]">
                    <header>
                        <div>
                            <h2><span class="rzi rzi-auto_awesome" aria-hidden="true"></span>@Loc["ReportInsights"]</h2>
                            <p>@Insight.Summary</p>
                        </div>
                        <span class="vpp-report-insight-source">
                            @(Insight.IsAiGenerated ? Loc["AiGenerated"] : Loc["RulesGenerated"])
                        </span>
                    </header>
                    <div class="vpp-report-insight-grid">
                        @InsightList(Loc["Highlights"], "trending_up", Insight.Highlights)
                        @InsightList(Loc["Risks"], "warning", Insight.Risks)
                        @InsightList(Loc["Recommendations"], "task_alt", Insight.Recommendations)
                    </div>
                    <small>@Loc["AiInsightDisclaimer"]</small>
                </section>
            }

            <section class="vpp-report-grid">
                <article class="vpp-report-card">
                    <h2>@Loc["ReportTrend"]</h2>
                    <p>@Loc["ReportTrendDescription"]</p>
                    <RadzenChart Style="height: 320px;">
                        <RadzenColumnSeries Data="@Summary.PeriodTrend"
                                            CategoryProperty="Period"
                                            ValueProperty="TotalQuantity"
                                            Title="@Loc["TotalQuantity"]" />
                        <RadzenCategoryAxis />
                        <RadzenValueAxis />
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </article>

                <article class="vpp-report-card">
                    <h2>@Loc["ReportStatus"]</h2>
                    <p>@Loc["ReportStatusDescription"]</p>
                    <RadzenChart Style="height: 320px;">
                        <RadzenDonutSeries Data="@StatusChartData"
                                           CategoryProperty="Label"
                                           ValueProperty="OrderCount" />
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </article>

                @if (Summary.DepartmentBreakdown.Count > 0)
                {
                    <article class="vpp-report-card vpp-report-card-wide">
                        <h2>@Loc["ReportDepartments"]</h2>
                        <p>@Loc["ReportDepartmentsDescription"]</p>
                        <RadzenChart Style="height: 340px;">
                            <RadzenColumnSeries Data="@Summary.DepartmentBreakdown"
                                                CategoryProperty="Code"
                                                ValueProperty="OrderCount"
                                                Title="@Loc["TotalOrders"]" />
                            <RadzenCategoryAxis />
                            <RadzenValueAxis />
                        </RadzenChart>
                    </article>
                }

                <article class="vpp-report-card vpp-report-card-wide">
                    <h2>@Loc["TopProducts"]</h2>
                    <p>@Loc["TopProductsDescription"]</p>
                    <RadzenDataGrid TItem="ReportProductPointResDTO"
                                    Data="@Summary.TopProducts"
                                    AllowPaging="false"
                                    AllowSorting="true"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Horizontal">
                        <Columns>
                            <RadzenDataGridColumn TItem="ReportProductPointResDTO" Property="ProductCode" Title="@Loc["ProductCode"]" />
                            <RadzenDataGridColumn TItem="ReportProductPointResDTO" Property="ProductName" Title="@Loc["ProductName"]" />
                            <RadzenDataGridColumn TItem="ReportProductPointResDTO" Property="TotalQuantity" Title="@Loc["TotalQuantity"]" TextAlign="TextAlign.Right">
                                <Template Context="item">@item.TotalQuantity.ToString("N0")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ReportProductPointResDTO" Property="TotalAmount" Title="@Loc["TotalAmount"]" TextAlign="TextAlign.Right">
                                <Template Context="item">@FormatAmount(item.TotalAmount)</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </article>
            </section>
        }
    </main>
}
