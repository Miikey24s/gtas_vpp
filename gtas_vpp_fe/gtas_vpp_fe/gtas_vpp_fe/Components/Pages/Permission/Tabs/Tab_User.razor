@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Req.Account
@using gtas_vpp_shared.DTOs.Res.Account
@using gtas_vpp_fe.Helpers
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject IToastService Toast

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (PermissionState.HasPermission(Permissions.PermissionView))
{
    <RadzenDataGrid @ref="userGrid"
                    TItem="UserAdministrationResDTO"
                    Data="@users"
                    Count="@userCount"
                    LoadData="@LoadUsersAsync"
                    LoadColumnFilterData="@LoadUserFilterDataAsync"
                    IsLoading="@(isUserLoading || isUserLookupLoading)"
                    @bind-Value="selectedUsers"
                    AllowFiltering="true"
                    AllowColumnResize="true"
                    AllowMultiColumnSorting="true"
                    AllowSorting="true"
                    AllowPaging="true"
                    AllowGrouping="false"
                    AllowVirtualization="false"
                    AllowAlternatingRows="false"
                    AllowColumnReorder="true"
                    AllowColumnPicking="false"
                    AllowPickAllColumns="true"
                    ColumnsPickerAllowFiltering="true"
                    ShowMultiColumnSortingIndex="true"
                    ShowPagingSummary="true"
                    PageSize="20"
                    PageSizeOptions="@(new[] { 20, 50, 100 })"
                    FilterMode="FilterMode.CheckBoxList"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    Density="Density.Compact"
                    GridLines="DataGridGridLines.Horizontal"
                    SelectionMode="DataGridSelectionMode.Single"
                    RowDoubleClick="@OnRowDoubleClick"
                    class="permission-user-grid vpp-admin-page-grid vpp-admin-grid"
                    Style="--vpp-admin-grid-min-width: 1420px;">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         Gap="0.5rem"
                         Wrap="FlexWrap.Wrap"
                         class="vpp-admin-grid-toolbar permission-grid-toolbar">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.5rem"
                             Wrap="FlexWrap.Wrap"
                             class="vpp-admin-toolbar-main">
                    <RadzenFormField AllowFloatingLabel="true" Text="@Loc["Search"]" Variant="Variant.Text" class="permission-search-field">
                        <ChildContent>
                            <RadzenTextBox Value="@SearchText"
                                           aria-label="@Loc["Search"]"
                                           Change="@(arg => TextBoxOnChange(arg))"
                                           ValueChanged="@((string value) => SearchText = value)"
                                           ValueExpression="@(() => SearchText)"
                                           @onkeypress="@(arg => SearchTextOnKeyUp(arg))" />
                        </ChildContent>
                        <End>
                            <RadzenStack Orientation="Orientation.Horizontal" class="rz-mb-0 rz-pb-0">
                                <RadzenButton Size="ButtonSize.ExtraSmall"
                                              Disabled="@(isUserLoading || isUserLookupLoading)"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Icon="filter_alt_off"
                                              title="@Loc["Reset"]"
                                              aria-label="@Loc["Reset"]"
                                              Click="@ButtonOnClick_Clear" />
                                <RadzenButton Size="ButtonSize.ExtraSmall"
                                              Disabled="@(isUserLoading || isUserLookupLoading)"
                                              Icon="search"
                                              title="@Loc["Search"]"
                                              aria-label="@Loc["Search"]"
                                              Click="@ButtonOnClick_SearchUser" />
                            </RadzenStack>
                        </End>
                    </RadzenFormField>
                    <RadzenButton Icon="refresh"
                                  Text="@Loc["Reload"]"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  class="vpp-library-refresh-action"
                                  Click="@ButtonOnClick_Reload" />
                </RadzenStack>
                <VppColumnPicker TItem="UserAdministrationResDTO" GridAccessor="@(() => userGrid)" />
            </RadzenStack>
        </HeaderTemplate>

        <Columns>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Width="52px"
                                  MinWidth="52px"
                                  Title="#"
                                  Reorderable="false"
                                  Filterable="false"
                                  Groupable="false"
                                  Pickable="false"
                                  Sortable="false"
                                  TextAlign="TextAlign.Center">
                <Template Context="user">
                    @(currentUserSkip + users.IndexOf(user) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="Trạng thái"
                                  Width="150px"
                                  Property="@nameof(UserAdministrationResDTO.AccountStatus)"
                                  Filterable="false">
                <Template Context="user">
                    <RadzenBadge Text="@GetAccountStatusLabel(user)"
                                 BadgeStyle="@(user.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["UserLogin"]"
                                  Property="@nameof(UserAdministrationResDTO.UserLogin)"
                                  Width="150px" />
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["FullName"]"
                                  Property="@nameof(UserAdministrationResDTO.FullName)"
                                  Width="190px" />
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["Email"]"
                                  Property="@nameof(UserAdministrationResDTO.Email)"
                                  Width="220px" />
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["Group"]"
                                  Property="@nameof(UserAdministrationResDTO.GroupName)"
                                  Width="190px">
                <Template Context="user">
                    <RadzenDropDown TValue="PermissionGroupResDTO"
                                    Data="@permissionGroups"
                                    TextProperty="@nameof(PermissionGroupResDTO.GroupName)"
                                    @bind-Value="user.UserGroup"
                                    AllowClear="false"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Disabled="@(!CanEditMembership(user) && !CanPrepareActivation(user) || isUserLoading)"
                                    Change="@(_ => DropdownOnChange_Group(user))"
                                    Style="width: 100%;" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["Department"]"
                                  Property="@nameof(UserAdministrationResDTO.DepartmentName)"
                                  Width="210px">
                <Template Context="user">
                    <RadzenDropDown TValue="Guid?"
                                    Data="@departments"
                                    TextProperty="@nameof(DepartmentResDTO.Name)"
                                    ValueProperty="@nameof(DepartmentResDTO.Id)"
                                    @bind-Value="user.DepartmentId"
                                    AllowClear="false"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Disabled="@(!CanEditMembership(user) && !CanPrepareActivation(user) || isUserLoading)"
                                    Change="@(_ => DropdownOnChange_Department(user))"
                                    Style="width: 100%;" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["Admin"]"
                                  Property="@nameof(UserAdministrationResDTO.IsAdmin)"
                                  Width="92px"
                                  Filterable="false"
                                  TextAlign="TextAlign.Center">
                <Template Context="user">
                    @if (user.IsAdmin)
                    {
                        <RadzenIcon Icon="check_circle" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="Kích hoạt"
                                  Width="120px"
                                  Filterable="false"
                                  Sortable="false"
                                  TextAlign="TextAlign.Center">
                <Template Context="user">
                    <RadzenSwitch Value="@user.IsActive"
                                  Change="@(_ => DeactivateMembershipAsync(user))"
                                  Disabled="@(!CanDeactivateMembership(user) || isUserLoading)"
                                  title="@(CanDeactivateMembership(user) ? "Deactivate membership" : "Protected or inactive")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="Quản trị tài khoản"
                                  Width="190px"
                                  Filterable="false"
                                  Sortable="false"
                                  TextAlign="TextAlign.Center">
                <Template Context="user">
                    @if (CanPrepareActivation(user))
                    {
                        <RadzenButton Icon="person_add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Text="Kích hoạt"
                                      Click="@(_ => ActivateAccountAsync(user))"
                                      Disabled="@isUserLoading"
                                      title="Kích hoạt tài khoản sau khi chọn nhóm quyền và phòng ban" />
                    }
                    else if (CanResetPassword(user))
                    {
                        <RadzenButton Icon="lock_reset"
                                      ButtonStyle="ButtonStyle.Light"
                                      Size="ButtonSize.Small"
                                      Text="Reset mật khẩu"
                                      Click="@(_ => ResetPasswordAsync(user))"
                                      Disabled="@isUserLoading"
                                      title="Đặt mật khẩu tạm thời và buộc đổi ở lần đăng nhập tiếp theo" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="@Loc["Description"]"
                                  Property="@nameof(UserAdministrationResDTO.Description)"
                                  Width="220px"
                                  Visible="true"
                                  Pickable="true" />
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="Account Id"
                                  Property="@nameof(UserAdministrationResDTO.UserId)"
                                  Width="110px"
                                  Visible="false"
                                  Pickable="true" />
            <RadzenDataGridColumn TItem="UserAdministrationResDTO"
                                  Title="Row version"
                                  Property="@nameof(UserAdministrationResDTO.RowVersion)"
                                  Width="220px"
                                  Visible="false"
                                  Pickable="true" />
        </Columns>
    </RadzenDataGrid>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="m-3" Text="@Loc["NoPermission"]" />
}
