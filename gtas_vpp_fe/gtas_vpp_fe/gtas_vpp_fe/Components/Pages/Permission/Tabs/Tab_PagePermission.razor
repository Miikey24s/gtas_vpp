@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_fe.Helpers
@using PermissionGroupDto = gtas_vpp_shared.DTOs.Res.Permission.PermissionGroupResDTO
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject IToastService Toast


@if (PermissionState.HasPermission(Permissions.PermissionView))
{
    <RadzenStack Gap="0.75rem">
        <RadzenAlert AlertStyle="AlertStyle.Info"
                     Variant="Variant.Flat"
                     Text="@Loc["PermissionReferenceAlert"]" />

        <section class="vpp-permission-matrix-card" aria-labelledby="permission-matrix-title">
            <header class="vpp-permission-matrix-header">
                <div>
                    <h2 id="permission-matrix-title">@Loc["PermissionMatrixTitle"]</h2>
                    <p>@Loc["PermissionMatrixDescription"]</p>
                </div>
                <span class="vpp-permission-matrix-badge">@Loc["ReadOnlyReference"]</span>
            </header>
            <div class="vpp-permission-matrix-scroll"
                 role="region"
                 tabindex="0"
                 aria-label="@Loc["PermissionMatrixTitle"]">
                <table class="vpp-permission-matrix">
                    <thead>
                        <tr>
                            <th scope="col">@Loc["PermissionActionColumn"]</th>
                            @foreach (var persona in CanonicalRbac.Personas)
                            {
                                <th scope="col" class="@(IsDevPersona(persona) ? "is-dev" : null)">
                                    <strong>@persona.GroupCode</strong>
                                    <span>@GetRoleDisplayName(persona.GroupCode)</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var action in CanonicalRbac.Actions)
                        {
                            <tr>
                                <th scope="row">
                                    <strong>@GetActionDisplayName(action.PermissionCode)</strong>
                                    <span>@action.PermissionCode</span>
                                </th>
                                @foreach (var persona in CanonicalRbac.Personas)
                                {
                                    var granted = CanonicalRbac.HasAction(persona.GroupId, action.PermissionCode);
                                    <td class="@(IsDevPersona(persona) ? "is-dev" : null)">
                                        @if (granted)
                                        {
                                            <span class="vpp-permission-granted"
                                                  role="img"
                                                  aria-label="@Loc["PermissionGranted"]">
                                                <VppIcon Name="check" />
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="vpp-permission-not-granted"
                                                  aria-label="@Loc["PermissionNotGranted"]">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <footer>@Loc["PermissionMatrixSummary", CanonicalRbac.Actions.Count, CanonicalRbac.Personas.Count]</footer>
        </section>

        <div class="permission-ui-admin-heading">
            <h2>@Loc["PermissionUiAdministrationTitle"]</h2>
            <p>@Loc["PermissionUiAdministrationDescription"]</p>
        </div>

        <RadzenDataGrid @ref="grid"
                        TItem="PermissionGroupDto"
                        Data="@list_Group"
                        Count="@groupCount"
                        LoadData="@LoadGroupsAsync"
                        LoadColumnFilterData="@LoadGroupFilterDataAsync"
                        IsLoading="@IsLoading"
                        @bind-Value="selected_Group"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        AllowMultiColumnSorting="true"
                        AllowSorting="true"
                        AllowPaging="true"
                        AllowGrouping="false"
                        AllowVirtualization="false"
                        AllowAlternatingRows="false"
                        AllowColumnReorder="true"
                        AllowColumnPicking="false"
                        AllowPickAllColumns="true"
                        ColumnsPickerAllowFiltering="true"
                        ShowMultiColumnSortingIndex="true"
                        ShowPagingSummary="true"
                        PageSize="20"
                        PageSizeOptions="@(new[] { 20, 50, 100 })"
                        FilterMode="FilterMode.CheckBoxList"
                        FilterPopupRenderMode="PopupRenderMode.OnDemand"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Horizontal"
                        SelectionMode="DataGridSelectionMode.Single"
                        ExpandMode="DataGridExpandMode.Single"
                        RowExpand="@GroupRowExpand"
                        RowDoubleClick="@OnGroupRowDoubleClick"
                        class="permission-group-grid vpp-admin-page-grid vpp-admin-grid vpp-admin-grid-single-page"
                        Style="--vpp-admin-grid-min-width: 760px;">
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Gap="0.5rem"
                             Wrap="FlexWrap.Wrap"
                             class="vpp-admin-grid-toolbar">
                    <RadzenButton Icon="refresh"
                                  Size="ButtonSize.Small"
                                  Text="@Loc["Reload"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  class="vpp-library-refresh-action"
                                  Disabled="@IsLoading"
                                  Click="@LoadBaseData" />
                    <VppColumnPicker TItem="PermissionGroupDto" GridAccessor="@(() => grid)" />
                </RadzenStack>
            </HeaderTemplate>

            <Template Context="group">
                <div class="permission-group-detail">
                    @if (IsLoading_Child)
                    {
                        <SkeletonGrid Rows="6" Cols="6" />
                    }
                    else if (groupPermissions.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-p-4 rz-text-align-center">
                            @Loc["NoPermissionMappings"]
                        </RadzenText>
                    }
                    else
                    {
                        <RadzenTabs RenderMode="TabRenderMode.Server"
                                    class="vpp-secondary-tabs permission-component-tabs"
                                    @bind-SelectedIndex="selectedTab">
                            <Tabs>
                                @foreach (var page in groupPermissions)
                                {
                                    var components = page.Components ?? [];

                                    <RadzenTabsItem Text="@(page.PageName + " (" + page.PageCode + ")")">
                                        <RadzenStack Gap="0.75rem" class="permission-component-panel">
                                            <div class="permission-component-summary-row">
                                                <div class="permission-page-description">
                                                    <span>@Loc["Description"]</span>
                                                    <strong>@(!string.IsNullOrWhiteSpace(page.Description) ? page.Description : "-")</strong>
                                                </div>
                                                <VppColumnPicker TItem="PermissionComponentAccessResDTO"
                                                                 GridAccessor="@(() => componentGrid)" />
                                            </div>

                                            <RadzenDataGrid @ref="componentGrid"
                                                            TItem="PermissionComponentAccessResDTO"
                                                            Data="@components"
                                                            @bind-Value="selectedComponents"
                                                            AllowFiltering="true"
                                                            AllowColumnResize="true"
                                                            AllowMultiColumnSorting="true"
                                                            AllowSorting="true"
                                                            AllowPaging="true"
                                                            AllowGrouping="false"
                                                            AllowVirtualization="false"
                                                            AllowColumnReorder="false"
                                                            AllowColumnPicking="false"
                                                            AllowPickAllColumns="true"
                                                            ShowMultiColumnSortingIndex="true"
                                                            ShowPagingSummary="true"
                                                            PageSize="20"
                                                            PageSizeOptions="@(new[] { 20, 50, 100 })"
                                                            FilterMode="FilterMode.CheckBoxList"
                                                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                                            Density="Density.Compact"
                                                            GridLines="DataGridGridLines.Horizontal"
                                                            SelectionMode="DataGridSelectionMode.Single"
                                                            RowDoubleClick="@OnComponentRowDoubleClick"
                                                            class="permission-component-grid vpp-admin-page-grid vpp-admin-grid"
                                                            Style="--vpp-admin-grid-min-width: 980px;">
                                                <Columns>
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Title="#"
                                                                          Width="52px"
                                                                          MinWidth="52px"
                                                                          Filterable="false"
                                                                          Groupable="false"
                                                                          Pickable="false"
                                                                          Reorderable="false"
                                                                          Sortable="false"
                                                                          TextAlign="TextAlign.Center">
                                                        <Template Context="component">
                                                            @(components.IndexOf(component) + 1)
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Property="@nameof(PermissionComponentAccessResDTO.ComponentCode)"
                                                                          Title="@Loc["ComponentCode"]"
                                                                          Width="190px" />
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Property="@nameof(PermissionComponentAccessResDTO.ComponentName)"
                                                                          Title="@Loc["ComponentName"]"
                                                                          Width="190px" />
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Property="@nameof(PermissionComponentAccessResDTO.Description)"
                                                                          Title="@Loc["Description"]"
                                                                          Width="240px" />
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Title="@Loc["PermissionType"]"
                                                                          Width="135px"
                                                                          Filterable="false"
                                                                          Sortable="false">
                                                        <Template Context="component">
                                                            <span>@GetPermissionKind(component)</span>
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Property="@nameof(PermissionComponentAccessResDTO.IsVisible)"
                                                                          Title="@Loc["Visible"]"
                                                                          Width="112px"
                                                                          HeaderCssClass="text-center"
                                                                          CssClass="text-center">
                                                        <Template Context="component">
                                                            <RadzenSwitch @bind-Value="component.IsVisible"
                                                                          Change="@(_ => SetComponentVisibilityAsync(component))"
                                                                          Disabled="@(!CanToggleComponent(component) || IsLoading_Child)"
                                                                          Style="flex: unset" />
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Property="@nameof(PermissionComponentAccessResDTO.IsEnable)"
                                                                          Title="@Loc["Enable"]"
                                                                          Width="112px"
                                                                          HeaderCssClass="text-center"
                                                                          CssClass="text-center">
                                                        <Template Context="component">
                                                            <RadzenSwitch @bind-Value="component.IsEnable"
                                                                          Change="@(_ => SetComponentEnabledAsync(component))"
                                                                          Disabled="@(!CanToggleComponent(component) || IsLoading_Child)"
                                                                          Style="flex: unset" />
                                                        </Template>
                                                    </RadzenDataGridColumn>
                                                    <RadzenDataGridColumn TItem="PermissionComponentAccessResDTO"
                                                                          Property="@nameof(PermissionComponentAccessResDTO.GroupPageComponentMappingId)"
                                                                          Title="@Loc["MappingId"]"
                                                                          Width="280px"
                                                                          Visible="false"
                                                                          Pickable="true" />
                                                </Columns>
                                            </RadzenDataGrid>
                                        </RadzenStack>
                                    </RadzenTabsItem>
                                }
                            </Tabs>
                        </RadzenTabs>
                    }
                </div>
            </Template>

            <Columns>
                <RadzenDataGridColumn TItem="PermissionGroupDto"
                                      Title="#"
                                      Width="52px"
                                      MinWidth="52px"
                                      Filterable="false"
                                      Groupable="false"
                                      Pickable="false"
                                      Reorderable="false"
                                      Sortable="false"
                                      TextAlign="TextAlign.Center">
                    <Template Context="group">
                        @(currentGroupSkip + list_Group.IndexOf(group) + 1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PermissionGroupDto"
                                      Property="@nameof(PermissionGroupDto.GroupName)"
                                      Title="@Loc["GroupName"]"
                                      Width="220px">
                    <Template Context="group">
                        <div class="permission-group-identity">
                            <strong>@GetGroupDisplayName(group)</strong>
                            <small>@GetGroupCode(group)</small>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PermissionGroupDto"
                                      Property="@nameof(PermissionGroupDto.Description)"
                                      Title="@Loc["Description"]"
                                      Width="360px" />
                <RadzenDataGridColumn TItem="PermissionGroupDto"
                                      Title="@Loc["PermissionModel"]"
                                      Width="160px"
                                      Filterable="false"
                                      Sortable="false">
                    <Template Context="group">
                        <span>@Loc["CanonicalRoleReadOnly"]</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PermissionGroupDto"
                                      Property="@nameof(PermissionGroupDto.Id)"
                                      Title="@Loc["Identifier"]"
                                      Width="280px"
                                      Visible="false"
                                      Pickable="true" />
            </Columns>
        </RadzenDataGrid>
    </RadzenStack>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="m-3" Text="@Loc["NoPermission"]" />
}
