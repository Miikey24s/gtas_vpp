@page "/Account/Register"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["RegisterTitle"]</PageTitle>

<VppAccountShell Title="@Loc["RegisterTitle"]"
                 Accent="GTAS VPP"
                 Description="@Loc["RegisterDescription"]"
                 TitleId="register-title"
                 ShowArtwork="true"
                 ShowBrand="false"
                 Scrollable="true">
    <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />

    <EditForm Model="Model" OnValidSubmit="SubmitAsync" class="vpp-login-form">
                    <DataAnnotationsValidator />
                    <div class="vpp-login-field">
                        <RadzenLabel Text="@Loc["Username"]" Component="Username" class="vpp-login-label" />
                        <RadzenTextBox Name="Username" @bind-Value="Model.Username" Disabled="@IsLoading" autocomplete="username" class="vpp-login-control" />
                        <ValidationMessage For="@(() => Model.Username)" />
                    </div>
                    <div class="vpp-login-field">
                        <RadzenLabel Text="@Loc["FullName"]" Component="FullName" class="vpp-login-label" />
                        <RadzenTextBox Name="FullName" @bind-Value="Model.FullName" Disabled="@IsLoading" class="vpp-login-control" />
                        <ValidationMessage For="@(() => Model.FullName)" />
                    </div>
                    <div class="vpp-login-field">
                        <RadzenLabel Text="@Loc["InternalEmail"]" Component="Email" class="vpp-login-label" />
                        <RadzenTextBox Name="Email" @bind-Value="Model.Email" Disabled="@IsLoading" autocomplete="email" class="vpp-login-control" />
                        <ValidationMessage For="@(() => Model.Email)" />
                    </div>
                    <div class="vpp-login-field">
                        <RadzenLabel Text="@Loc["EmployeeCodeOptional"]" Component="EmployeeCode" class="vpp-login-label" />
                        <RadzenTextBox Name="EmployeeCode" @bind-Value="Model.EmployeeCode" Disabled="@IsLoading" class="vpp-login-control" />
                    </div>
                    <VppPasswordField Name="Password"
                                      Label="@Loc["Password"]"
                                      @bind-Value="Model.Password"
                                      Disabled="@IsLoading"
                                      Hint="@Loc["PasswordRequirementHint"]" />
                    <VppPasswordField Name="ConfirmPassword"
                                      Label="@Loc["ConfirmNewPassword"]"
                                      @bind-Value="Model.ConfirmPassword"
                                      Disabled="@IsLoading" />

                    <RadzenButton Text="@Loc["RegisterAction"]"
                                  ButtonType="ButtonType.Submit"
                                  IsBusy="@IsLoading"
                                  class="vpp-login-btn" />
    </EditForm>

    <div class="vpp-login-links vpp-login-links-single">
        <a class="vpp-account-back-link" href="/Account/Login">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@Loc["BackToLogin"]</span>
        </a>
    </div>
</VppAccountShell>
