@page "/Account/Login"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout LoginLayout
@inject NavigationManager UriHelper
@inject IToastService Toast

<PageTitle>GTAS VPP - @Loc["Login"]</PageTitle>

<div class="vpp-login-page">
    <div class="vpp-login-shell">
        <div class="vpp-login-art" aria-hidden="true">
            <img class="vpp-login-art-image"
                 src="@Assets["images/login-bg-gtas.png"]"
                 width="1678"
                 height="937"
                 loading="eager"
                 fetchpriority="high"
                 decoding="async"
                 alt="" />
        </div>

        <section class="vpp-login-card" aria-labelledby="vpp-login-title">
            <div class="vpp-login-card-inner">
                <div class="vpp-login-header">
                    <h1 class="vpp-login-title" id="vpp-login-title">
                        @Loc["Login"]
                        <span class="vpp-login-title-accent">GTAS VPP</span>
                    </h1>
                </div>

                <RadzenTemplateForm TItem="LoginFormModel" Data="loginForm" Submit="LoginSubmit" class="vpp-login-form">
                    <AntiforgeryToken></AntiforgeryToken>

                    <div class="@(HasUsernameValidation ? "vpp-login-field vpp-login-field--invalid" : "vpp-login-field")">
                        <RadzenLabel class="vpp-login-label" Text="@Loc["Username"]" Component="Username" />
                        <RadzenTextBox class="vpp-login-control"
                                       Name="Username"
                                       Disabled="@isLoading"
                                       @bind-Value=@loginForm.Username
                                       @oninput="HandleUsernameInput"
                                       @onblur="HandleUsernameBlur"
                                       @onkeyup="@(args => LoginOnkeyup(args, loginForm))" />

                        @if (HasUsernameValidation)
                        {
                            <div class="vpp-login-validation" role="alert">@UsernameValidationMessage</div>
                        }
                    </div>

                    <div class="@(HasPasswordValidation ? "vpp-login-field vpp-login-field--invalid" : "vpp-login-field")">
                        <RadzenLabel class="vpp-login-label"
                                     Text="@Loc["Password"]"
                                     Component="@(isShowPass ? "Password" : "PasswordText")" />
                        <div class="vpp-login-password-wrapper">
                            <RadzenTextBox Visible="@(!isShowPass)"
                                           class="vpp-login-control"
                                           Name="PasswordText"
                                           Disabled="@isLoading"
                                           @bind-Value=@loginForm.Password
                                           @oninput="HandlePasswordInput"
                                           @onblur="HandlePasswordBlur"
                                           @onkeyup="@(args => LoginOnkeyup(args, loginForm))" />
                            <RadzenPassword Visible="@isShowPass"
                                            class="vpp-login-control"
                                            Name="Password"
                                            Disabled="@isLoading"
                                            @bind-Value=@loginForm.Password
                                            @oninput="HandlePasswordInput"
                                            @onblur="HandlePasswordBlur"
                                            @onkeyup="@(args => LoginOnkeyup(args, loginForm))" />
                            <button type="button"
                                    class="vpp-password-toggle-btn"
                                    title="@(isShowPass ? Loc["HidePassword"] : Loc["ShowPassword"])"
                                    aria-label="@(isShowPass ? Loc["HidePassword"] : Loc["ShowPassword"])"
                                    aria-pressed="@isShowPass"
                                    @onclick="TogglePasswordVisibility">
                                <span class="material-symbols-outlined" aria-hidden="true">
                                    @(isShowPass ? "visibility_off" : "visibility")
                                </span>
                            </button>
                        </div>

                        @if (HasPasswordValidation)
                        {
                            <div class="vpp-login-validation" role="alert">@PasswordValidationMessage</div>
                        }
                    </div>

                    <RadzenButton Text="@Loc["Login"]"
                                  ButtonType="ButtonType.Submit"
                                  IsBusy="@isLoading"
                                  class="vpp-login-btn" />
                </RadzenTemplateForm>

                <div class="vpp-login-links" role="navigation" aria-label="Account access">
                    <a href="/Account/ForgotPassword">Quên mật khẩu?</a>
                    <span aria-hidden="true">·</span>
                    <a href="/Account/Register">Đăng ký tài khoản</a>
                </div>
            </div>
        </section>
    </div>
</div>
