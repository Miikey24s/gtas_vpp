@page "/logoutprocess"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using gtas_vpp_fe.Components.Layout
@layout LoginLayout
@inject NavigationManager UriHelper
@inject IJSRuntime JS
@inject ILogger<Logout> Logger

<PageTitle>GTAS VPP - @Loc["Logout"]</PageTitle>

<main class="vpp-login-page">
    <div class="vpp-login-shell">
        <div class="vpp-login-art" aria-hidden="true">
            <img class="vpp-login-art-image"
                 src="@Assets["images/login-bg-gtas.png"]"
                 width="1678"
                 height="937"
                 loading="eager"
                 decoding="async"
                 alt="" />
        </div>

        <section class="vpp-login-card" aria-live="polite" aria-busy="true">
            <div class="vpp-login-card-inner">
                <div class="vpp-login-header">
                    <h1 class="vpp-login-title">
                        @Loc["SigningOut"]
                        <span class="vpp-login-title-accent">GTAS VPP</span>
                    </h1>
                </div>

                <div class="d-flex align-items-center gap-3 text-secondary" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>@Loc["LogoutRedirectMessage"]</span>
                </div>
            </div>
        </section>
    </div>
</main>

@code {
    private bool _logoutStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _logoutStarted)
        {
            return;
        }

        _logoutStarted = true;
        try
        {
            using var cleanupTimeout = new CancellationTokenSource(TimeSpan.FromSeconds(2));
            await JS.InvokeVoidAsync("vppDrafts.clearAll", cleanupTimeout.Token);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Browser draft cleanup failed during logout; session revocation will continue.");
        }
        finally
        {
            UriHelper.NavigateTo(Config.PerformLogoutPath, true);
        }
    }
}
