@page "/Account/ChangePassword"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout LoginLayout

<PageTitle>GTAS VPP - Đổi mật khẩu</PageTitle>

<div class="vpp-login-page">
    <div class="vpp-login-shell">
    <section class="vpp-login-card" aria-labelledby="change-password-title">
        <div class="vpp-login-card-inner">
        <div class="vpp-login-header">
            <h1 id="change-password-title">Đổi mật khẩu</h1>
            @if (Required)
            {
                <p role="alert">Bạn cần đổi mật khẩu tạm thời trước khi tiếp tục sử dụng hệ thống.</p>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="vpp-login-validation" role="alert">@ErrorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="vpp-login-validation" role="status">@SuccessMessage</div>
        }

        <EditForm Model="Model" OnValidSubmit="SubmitAsync" class="vpp-login-form">
            <DataAnnotationsValidator />
            <div class="vpp-login-field">
                <RadzenLabel Text="Mật khẩu hiện tại" Component="CurrentPassword" />
                <RadzenPassword Name="CurrentPassword" @bind-Value="Model.CurrentPassword" Disabled="@IsLoading" />
                <ValidationMessage For="@(() => Model.CurrentPassword)" />
            </div>
            <div class="vpp-login-field">
                <RadzenLabel Text="Mật khẩu mới" Component="NewPassword" />
                <RadzenPassword Name="NewPassword" @bind-Value="Model.NewPassword" Disabled="@IsLoading" />
                <ValidationMessage For="@(() => Model.NewPassword)" />
            </div>
            <div class="vpp-login-field">
                <RadzenLabel Text="Nhập lại mật khẩu mới" Component="ConfirmPassword" />
                <RadzenPassword Name="ConfirmPassword" @bind-Value="Model.ConfirmPassword" Disabled="@IsLoading" />
                <ValidationMessage For="@(() => Model.ConfirmPassword)" />
            </div>
            <RadzenButton Text="Lưu mật khẩu mới"
                          ButtonType="ButtonType.Submit"
                          IsBusy="@IsLoading"
                          class="vpp-login-btn" />
        </EditForm>
        </div>
    </section>
    </div>
</div>
