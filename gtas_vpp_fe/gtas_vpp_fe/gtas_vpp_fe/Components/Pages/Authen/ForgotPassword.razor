@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - Khôi phục mật khẩu</PageTitle>

<div class="vpp-login-page">
    <div class="vpp-login-shell">
        <section class="vpp-login-card" aria-labelledby="forgot-password-title">
            <div class="vpp-login-card-inner">
                <div class="vpp-login-header">
                    <h1 class="vpp-login-title" id="forgot-password-title">
                        Khôi phục <span class="vpp-login-title-accent">mật khẩu</span>
                    </h1>
                    <p>Nhập email đã đăng ký. Hệ thống luôn trả về cùng một thông báo để bảo vệ tài khoản.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="vpp-login-validation" role="alert">@ErrorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                {
                    <div class="vpp-login-validation" role="status">@SuccessMessage</div>
                }

                <EditForm Model="Model" OnValidSubmit="SubmitAsync" class="vpp-login-form">
                    <DataAnnotationsValidator />
                    <div class="vpp-login-field">
                        <RadzenLabel Text="Email" Component="Email" class="vpp-login-label" />
                        <RadzenTextBox Name="Email" @bind-Value="Model.Email" Disabled="@IsLoading" class="vpp-login-control" />
                        <ValidationMessage For="@(() => Model.Email)" />
                    </div>
                    <RadzenButton Text="Gửi hướng dẫn khôi phục"
                                  ButtonType="ButtonType.Submit"
                                  IsBusy="@IsLoading"
                                  class="vpp-login-btn" />
                </EditForm>

                <div class="vpp-login-links">
                    <a href="/Account/Login">Quay lại đăng nhập</a>
                </div>
            </div>
        </section>
    </div>
</div>
