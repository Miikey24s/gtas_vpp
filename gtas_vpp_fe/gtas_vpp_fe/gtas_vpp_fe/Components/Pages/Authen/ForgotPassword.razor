@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["ForgotPasswordTitle"] @Loc["ForgotPasswordAccent"]</PageTitle>

<VppAccountShell Title="@Loc["ForgotPasswordTitle"]"
                 Accent="@Loc["ForgotPasswordAccent"]"
                 Description="@Loc["ForgotPasswordDescription"]"
                 TitleId="forgot-password-title"
                 Compact="true">
    <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />

    <EditForm Model="Model" OnValidSubmit="SubmitAsync" class="vpp-login-form">
        <DataAnnotationsValidator />
        <div class="vpp-login-field">
            <RadzenLabel Text="@Loc["Email"]" Component="Email" class="vpp-login-label" />
            <RadzenTextBox Name="Email"
                           @bind-Value="Model.Email"
                           Disabled="@IsLoading"
                           autocomplete="email"
                           class="vpp-login-control" />
            <ValidationMessage For="@(() => Model.Email)" />
        </div>
        <RadzenButton Text="@Loc["SendRecoveryInstructions"]"
                      ButtonType="ButtonType.Submit"
                      IsBusy="@IsLoading"
                      class="vpp-login-btn" />
    </EditForm>

    <div class="vpp-login-links vpp-login-links-single">
        <a class="vpp-account-back-link" href="/Account/Login">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@Loc["BackToLogin"]</span>
        </a>
    </div>
</VppAccountShell>
