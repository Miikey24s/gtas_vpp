@page "/Account/ResetPassword"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - Đặt lại mật khẩu</PageTitle>

<div class="vpp-login-page">
    <div class="vpp-login-shell">
        <section class="vpp-login-card" aria-labelledby="reset-password-title">
            <div class="vpp-login-card-inner">
                <div class="vpp-login-header">
                    <h1 class="vpp-login-title" id="reset-password-title">
                        Đặt lại <span class="vpp-login-title-accent">mật khẩu</span>
                    </h1>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="vpp-login-validation" role="alert">@ErrorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                {
                    <div class="vpp-login-validation" role="status">@SuccessMessage</div>
                }

                <EditForm Model="Model" OnValidSubmit="SubmitAsync" class="vpp-login-form">
                    <DataAnnotationsValidator />
                    <div class="vpp-login-field">
                        <RadzenLabel Text="Mật khẩu mới" Component="NewPassword" class="vpp-login-label" />
                        <RadzenPassword Name="NewPassword" @bind-Value="Model.NewPassword" Disabled="@IsLoading" class="vpp-login-control" />
                        <ValidationMessage For="@(() => Model.NewPassword)" />
                    </div>
                    <div class="vpp-login-field">
                        <RadzenLabel Text="Nhập lại mật khẩu mới" Component="ConfirmPassword" class="vpp-login-label" />
                        <RadzenPassword Name="ConfirmPassword" @bind-Value="Model.ConfirmPassword" Disabled="@IsLoading" class="vpp-login-control" />
                        <ValidationMessage For="@(() => Model.ConfirmPassword)" />
                    </div>
                    <RadzenButton Text="Đặt lại mật khẩu"
                                  ButtonType="ButtonType.Submit"
                                  IsBusy="@IsLoading"
                                  class="vpp-login-btn" />
                </EditForm>

                <div class="vpp-login-links">
                    <a href="/Account/Login">Quay lại đăng nhập</a>
                </div>
            </div>
        </section>
    </div>
</div>
