@page "/not-found"
@layout MainLayout

<PageTitle>GTAS VPP - @Loc["PageNotFound"]</PageTitle>

<main class="vpp-system-page">
    <VppPageHeader Title="@Loc["PageNotFound"]"
                   Description="@Loc["PageNotFoundDescription"]"
                   HeadingId="not-found-heading" />
    <VppStatePanel State="empty"
                   Icon="search_off"
                   Title="@Loc["PageNotFound"]"
                   Description="@Loc["PageNotFoundDescription"]" />
    <div class="vpp-system-page-actions">
        <RadzenButton Text="@Loc["BackToDashboard"]"
                      Icon="dashboard"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="GoToDashboard" />
    </div>
</main>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void GoToDashboard() => Navigation.NavigateTo("/");
}
