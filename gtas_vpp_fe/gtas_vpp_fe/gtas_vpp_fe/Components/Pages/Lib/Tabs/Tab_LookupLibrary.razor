@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_fe.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject IToastService Toast
@inject IJSRuntime js


@if (isCategoryLoading)
{
    <SkeletonGrid Rows="8" Cols="3" />
}
else
{
<RadzenSplitter class="vpp-admin-split vpp-admin-class-split">
    <RadzenSplitterPane Size="31%" Min="24%" Max="38%">
        <RadzenStack Gap="0.75rem">
            <RadzenDataGrid @ref="categoryGrid" TItem="LookupCategoryResDTO"
                            Data="@lookupCategories"
                            Count="@categoryCount"
                            LoadData="@LoadCategories"
                            LoadColumnFilterData="@LoadCategoryFilterData"
                            IsLoading="@isCategoryLoading"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 20, 50, 100 })"
                            Density="Density.Compact"
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value="@selectedLookupCategories"
                            RowSelect="@OnCategorySelected"
                            RowRender="@OnCategoryRowRender"
                            GridLines="DataGridGridLines.Horizontal"
                            class="@($"auto-fit-grid vpp-admin-grid vpp-class-master-grid {(categoryCount <= 20 ? "vpp-admin-grid-single-page" : string.Empty)}")"
                            ColumnWidth="150px"
                            Style="--vpp-admin-grid-min-width: 380px;">
                <HeaderTemplate>
                    @* Atlas library-classes: nút thêm mang danh từ riêng, nối dialog sẵn có. *@
                    <div class="vpp-admin-grid-toolbar">
                        <RadzenButton Icon="add"
                                      Text="@Loc["AddClass"]"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      class="vpp-library-primary-action"
                                      Click="@OpenAddCategoryAsync" />
                        <VppColumnPicker TItem="LookupCategoryResDTO" GridAccessor="@(() => categoryGrid)" />
                    </div>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Title="#" Width="48px" MinWidth="48px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="data">
                            @(currentCategorySkip + lookupCategories.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Name" Title="@Loc["LookupCategoryName"]" Width="260px">
                        <Template Context="data">
                            <div class="vpp-class-master-cell">
                                <div class="vpp-class-master-primary">
                                    <strong>@data.Code</strong>
                                    <span>@data.Name</span>
                                </div>
                                <div class="vpp-class-master-meta">
                                    <span class="vpp-class-module">@data.ModuleName</span>
                                    <span @onclick:stopPropagation="true">
                                        <RadzenSwitch @bind-Value="@data.IsDeleted"
                                                      Change="@(async (bool value) => await ToggleCategoryDeleted(data, value))"
                                                      class="isDeleteSwitch"
                                                      Style="transform: scale(0.7);" />
                                    </span>
                                </div>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="126px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Code" Title="@Loc["LookupCategoryCode"]" Width="120px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="ModuleName" Title="@Loc["ModuleName"]" Width="120px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="CreatedByUserId" Title="Create User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="CreatedAtUtc" Title="Create Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="UpdatedByUserId" Title="Update User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="UpdatedAtUtc" Title="Update Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Title="@Loc["Actions"]" Width="72px" MinWidth="72px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Pickable="false" CssClass="rz-col-actions rz-col-actions-tight" HeaderCssClass="rz-col-actions rz-col-actions-tight">
                        <Template Context="data">
                            <div class="vpp-admin-actions">
                                <RadzenButton Icon="delete_forever"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              title="@Loc["HardDelete"]"
                                              Click="@(() => HardDeleteCategory(data))"
                                              @onclick:stopPropagation="true" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenSplitterPane>

    <RadzenSplitterPane>
        <RadzenStack Gap="0.75rem">
            <RadzenDataGrid @ref="valueGrid" TItem="LookupValueResDTO"
                            Data="@lookupValues"
                            Count="@valueCount"
                            LoadData="@LoadValues"
                            LoadColumnFilterData="@LoadValueFilterData"
                            IsLoading="@isValueLoading"
                            AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            AllowSorting="true"
                            AllowPaging="true"
                            PageSize="20"
                            PageSizeOptions="@(new int[] { 20, 50, 100 })"
                            Density="Density.Compact"
                            EmptyText="@(selectedLookupCategory == null ? Loc["LookupSelectCategoryPrompt"].Value : Loc["LookupNoValues"].Value)"
                            RowRender="@OnValueRowRender"
                            GridLines="DataGridGridLines.Horizontal"
                            class="@($"auto-fit-grid vpp-admin-grid vpp-class-detail-grid {(valueCount <= 20 ? "vpp-admin-grid-single-page" : string.Empty)}")"
                            ColumnWidth="150px"
                            Style="--vpp-admin-grid-min-width: 800px; --vpp-admin-isdeleted-width: 90px;">
                <HeaderTemplate>
                    <div class="vpp-admin-grid-toolbar">
                        <RadzenButton Icon="add"
                                      Text="@Loc["AddLookupValue"]"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      class="vpp-library-primary-action"
                                      Disabled="@(selectedLookupCategory is null)"
                                      Click="@OpenAddValueAsync" />
                        <VppColumnPicker TItem="LookupValueResDTO" GridAccessor="@(() => valueGrid)" />
                    </div>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="data">
                            @(currentValueSkip + lookupValues.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="90px" MinWidth="90px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                        <Template Context="data">
                            <div class="vpp-admin-is-deleted-cell">
                                <RadzenSwitch @bind-Value="@data.IsDeleted"
                                              Change="@(async (bool value) => await ToggleValueDeleted(data, value))"
                                              class="isDeleteSwitch"
                                              Style="transform: scale(0.75);" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Code" Title="@Loc["Code"]" Width="125px" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Value" Title="@Loc["Value"]" Width="170px" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Sort" Title="@Loc["SortOrder"]" Width="80px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="ExtraField1" Title="Extra 1" Width="150px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="ExtraField2" Title="Extra 2" Width="150px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="ExtraField3" Title="Extra 3" Width="150px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Description" Title="@Loc["Description"]" Width="180px" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="LookupCategoryId" Title="Lookup category ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="CreatedByUserId" Title="Create User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="CreatedAtUtc" Title="Create Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="UpdatedByUserId" Title="Update User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="UpdatedAtUtc" Title="Update Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Title="@Loc["Actions"]" Width="72px" MinWidth="72px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Pickable="false" CssClass="rz-col-actions rz-col-actions-tight" HeaderCssClass="rz-col-actions rz-col-actions-tight">
                        <Template Context="data">
                            <div class="vpp-admin-actions">
                                <RadzenButton Icon="delete_forever"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              title="@Loc["HardDelete"]"
                                              Click="@(() => HardDeleteValue(data))"
                                              @onclick:stopPropagation="true" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>
    </RadzenSplitterPane>
</RadzenSplitter>
}
