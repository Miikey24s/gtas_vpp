@using System.Reflection
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Share
@typeparam TItem

<section class="vpp-record-inspector" aria-label="Chi tiết bản ghi">
    <header class="vpp-record-inspector-header">
        <span class="vpp-record-inspector-badge">@Loc["Selected"]</span>
        <h2>@RecordTitle</h2>
        @if (!string.IsNullOrWhiteSpace(RecordCode))
        {
            <p>@RecordCode</p>
        }
    </header>

    <RadzenTabs RenderMode="TabRenderMode.Client" class="vpp-record-inspector-tabs">
        <Tabs>
            <RadzenTabsItem Text="Thông tin chung">
                <div class="vpp-record-inspector-body">
                    @if (CoreProperties.Count == 0)
                    {
                        <VppEmptyState Icon="info" Title="Chưa có thông tin mô tả" />
                    }
                    else
                    {
                        <dl class="vpp-record-property-list">
                            @foreach (var prop in CoreProperties)
                            {
                                @RenderProperty(prop)
                            }
                        </dl>
                    }
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Nhật ký">
                <div class="vpp-record-inspector-body">
                    @if (AuditProperties.Count == 0)
                    {
                        <VppEmptyState Icon="history" Title="Chưa có dữ liệu nhật ký" />
                    }
                    else
                    {
                        <dl class="vpp-record-property-list">
                            @foreach (var prop in AuditProperties)
                            {
                                @RenderProperty(prop)
                            }
                        </dl>
                    }
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Kỹ thuật">
                <div class="vpp-record-inspector-body">
                    @if (SystemProperties.Count == 0)
                    {
                        <VppEmptyState Icon="key" Title="Không có định danh kỹ thuật" />
                    }
                    else
                    {
                        <dl class="vpp-record-property-list is-technical">
                            @foreach (var prop in SystemProperties)
                            {
                                @RenderProperty(prop)
                            }
                        </dl>
                    }
                </div>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    @if (CanEdit || CanToggleStatus)
    {
        <footer class="vpp-record-inspector-actions">
            @if (CanEdit)
            {
                <RadzenButton Icon="edit"
                              Text="@Loc["Edit"]"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@(_ => EditRequested.InvokeAsync(Record))" />
            }
            @if (CanToggleStatus)
            {
                <RadzenButton Icon="@(IsInactive ? "restore" : "block")"
                              Text="@(IsInactive ? Loc["Restore"] : Loc["Deactivate"])"
                              ButtonStyle="@(IsInactive ? ButtonStyle.Secondary : ButtonStyle.Danger)"
                              Click="@(_ => ToggleStatusRequested.InvokeAsync(Record))" />
            }
        </footer>
    }
</section>

@code {
    [Parameter, EditorRequired] public TItem Record { get; set; } = default!;
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanToggleStatus { get; set; }
    [Parameter] public bool IsInactive { get; set; }
    [Parameter] public EventCallback<TItem> EditRequested { get; set; }
    [Parameter] public EventCallback<TItem> ToggleStatusRequested { get; set; }

    private readonly List<PropertyInfo> CoreProperties = [];
    private readonly List<PropertyInfo> AuditProperties = [];
    private readonly List<PropertyInfo> SystemProperties = [];

    private string RecordTitle => GetFirstValue(
        "VppName", "VppCategoryName", "PriceListName", "SupplierName", "DepartmentName", "FullName", "GroupName", "Name")
        ?? "Chi tiết bản ghi";

    private string? RecordCode => GetFirstValue(
        "VppCode", "VppCategoryCode", "PriceListCode", "SupplierShortName", "SupplierCode", "DepartmentCode", "UserLogin", "GroupCode", "Code");

    protected override void OnParametersSet()
    {
        CoreProperties.Clear();
        AuditProperties.Clear();
        SystemProperties.Clear();

        if (Record is null)
        {
            return;
        }

        foreach (var prop in typeof(TItem).GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (IsSensitiveProperty(prop.Name) || !CanDisplay(prop))
            {
                continue;
            }

            if (IsAuditProperty(prop.Name))
            {
                AuditProperties.Add(prop);
            }
            else if (IsTechnicalProperty(prop.Name))
            {
                SystemProperties.Add(prop);
            }
            else
            {
                CoreProperties.Add(prop);
            }
        }
    }

    private RenderFragment RenderProperty(PropertyInfo prop) => builder =>
    {
        var metadata = GridColumnMetadataRegistry.Get(typeof(TItem), prop.Name);
        var label = GetDisplayLabel(prop.Name, metadata?.DisplayName);
        var value = prop.GetValue(Record);

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "vpp-record-property");
        builder.OpenElement(2, "dt");
        builder.AddContent(3, label);
        builder.CloseElement();
        builder.OpenElement(4, "dd");
        if (value is bool boolean)
        {
            // IsDeleted mang semantics đảo: true = đã vô hiệu (badge cảnh báo "Ngừng áp dụng"),
            // false = "Hoạt động" — khớp copy trạng thái soft-delete của Atlas (W-E).
            var isDeletedFlag = string.Equals(prop.Name, "IsDeleted", StringComparison.Ordinal);
            var positive = isDeletedFlag ? !boolean : boolean;
            var text = isDeletedFlag
                ? (boolean ? Loc["LibraryStatusInactive"].Value : Loc["LibraryStatusActive"].Value)
                : (boolean ? "Có" : "Không");
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", $"vpp-admin-status-badge {(positive ? "is-active" : "is-inactive")}");
            builder.AddContent(7, text);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(8, FormatValue(prop.Name, value));
        }
        builder.CloseElement();
        builder.CloseElement();
    };

    private string? GetFirstValue(params string[] names)
    {
        foreach (var name in names)
        {
            var value = typeof(TItem).GetProperty(name)?.GetValue(Record)?.ToString();
            if (!string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    private static bool CanDisplay(PropertyInfo prop)
    {
        var type = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        return type.IsEnum
               || type.IsPrimitive
               || type == typeof(string)
               || type == typeof(decimal)
               || type == typeof(DateTime)
               || type == typeof(DateTimeOffset)
               || type == typeof(Guid)
               || type == typeof(byte[]);
    }

    private static bool IsAuditProperty(string name) =>
        name is "CreatedByUserId" or "CreatedAtUtc" or "CreatedByUserName"
            or "UpdatedByUserId" or "UpdatedAtUtc" or "UpdatedByUserName"
            or "PublishedAtUtc" or "PublishedByUserId" or "ExpiredAtUtc" or "ExpiredByUserId";

    private static bool IsSensitiveProperty(string name) =>
        name is "SessionVersion" or "PasswordHash" or "SecurityStamp" or "ConcurrencyStamp"
        || name.EndsWith("Token", StringComparison.OrdinalIgnoreCase)
        || name.EndsWith("TokenHash", StringComparison.OrdinalIgnoreCase);

    private static bool IsTechnicalProperty(string name) =>
        name is "Id" or "RowVersion"
        or "OriginalLanguageCode" or "ResolvedLanguageCode" or "IsTranslationFallback"
        or "DisplayName" or "DisplayDescription"
        or "LegacyBackfillStatus"
        || name.EndsWith("Id", StringComparison.Ordinal)
        || name.EndsWith("Ids", StringComparison.Ordinal)
        || name.Contains("Hash", StringComparison.OrdinalIgnoreCase);

    private static string GetDisplayLabel(string propertyName, string? configured) => propertyName switch
    {
        "VppCode" => "Mã mặt hàng",
        "VppName" => "Tên mặt hàng",
        "VppCategoryCode" => "Mã danh mục",
        "VppCategoryName" => "Danh mục",
        "UomCode" => "Mã đơn vị",
        "UomName" => "Đơn vị",
        "DefaultSupplierName" => "Nhà cung cấp mặc định",
        "DefaultPrice" => "Giá mặc định",
        "DefaultVatRate" => "Thuế suất VAT",
        "SupplierCount" => "Số nhà cung cấp",
        "PriceListCode" => "Mã bảng giá",
        "PriceListName" => "Tên bảng giá",
        "SupplierName" => "Nhà cung cấp",
        "SupplierShortName" => "Tên viết tắt",
        "Address1" => "Địa chỉ 1",
        "Address2" => "Địa chỉ 2",
        "Address3" => "Địa chỉ 3",
        "Ward" => "Phường/Xã",
        "City" => "Tỉnh/Thành phố",
        "Version" => "Phiên bản",
        "Status" => "Trạng thái",
        "EffectiveFromUtc" => "Hiệu lực từ",
        "EffectiveToUtc" => "Hiệu lực đến",
        "ItemCount" => "Số mặt hàng",
        "IsDefault" => "Bảng giá mặc định",
        "CurrencyCode" => "Tiền tệ",
        "VatPolicy" => "Chính sách thuế VAT",
        "ContractCode" => "Mã hợp đồng",
        "DiscountRate" => "Tỷ lệ chiết khấu",
        "RebateAmount" => "Khoản hoàn lại",
        "FeeAmount" => "Phí bổ sung",
        "ShippingAmount" => "Phí vận chuyển",
        "StatusReason" => "Lý do trạng thái",
        "UserLogin" => "Tài khoản",
        "FullName" => "Họ tên",
        "Email" => "Email",
        "GroupName" => "Nhóm quyền",
        "GroupCode" => "Mã nhóm quyền",
        "DepartmentName" => "Phòng ban",
        "AccountStatus" => "Trạng thái tài khoản",
        "IsAdmin" => "Quản trị viên",
        "IsActive" => "Hoạt động",
        "UserType" => "Loại người dùng",
        "Description" => "Mô tả",
        "IsDeleted" => "Trạng thái",
        "OriginalLanguageCode" => "Ngôn ngữ gốc",
        "ResolvedLanguageCode" => "Ngôn ngữ hiển thị",
        "DisplayName" => "Tên hiển thị",
        "DisplayDescription" => "Mô tả hiển thị",
        "IsTranslationFallback" => "Dùng bản dịch dự phòng",
        _ => configured ?? Humanize(propertyName)
    };

    private string FormatValue(string propertyName, object? value)
    {
        if (value is string text)
        {
            if (propertyName == "GroupName" && text.Equals("DEV", StringComparison.OrdinalIgnoreCase))
            {
                return "Quản trị hệ thống (DEV)";
            }

            return text switch
            {
                "Draft" => "Bản nháp",
                "Published" => "Đã công bố",
                "Expired" => "Hết hiệu lực",
                "Active" => Loc["LibraryStatusActive"].Value,
                "PendingApproval" => "Chờ duyệt",
                "Inactive" => "Ngừng hoạt động",
                "Active application account" => "Tài khoản ứng dụng đang hoạt động",
                "item-rate" => "Theo thuế suất từng mặt hàng",
                _ => text
            };
        }

        return value switch
        {
            null => "—",
            DateTime dateTime => dateTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
            DateTimeOffset dateTimeOffset => dateTimeOffset.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
            byte[] bytes => Convert.ToBase64String(bytes),
            decimal number => number.ToString("N0"),
            _ => value.ToString() ?? "—"
        };
    }

    private static string Humanize(string name) =>
        System.Text.RegularExpressions.Regex.Replace(name, "([a-z0-9])([A-Z])", "$1 $2");
}
