@using gtas_vpp_fe.Components.Pages.Lib.Tabs
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Library
@inject GlobalClass glb

<PageTitle>GTAS VPP - Library</PageTitle>



@if (HasAnyVisibleLibraryTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="librariestab vpp-admin-tabs"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            @if (CanViewLibraryTab(Permissions.LibraryClass))
            {
                <RadzenTabsItem Text="@Loc["ClassDefinitions"]">
                    @if (IsActiveTab(0))
                    {
                        <Tab_LookupLibrary claims="@claims" PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryCategory))
            {
                <RadzenTabsItem Text="@Loc["OperationCategories"]">
                    @if (IsActiveTab(1))
                    {
                        <Component_ShareGrid TType=VppCategoryResDTO @bind-Data="@operationCategories" Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddCategory"]" SearchPlaceholder="@Loc["LibrarySearchCategories"]" SearchFields="@(new[] { "VppCategoryCode", "VppCategoryName" })" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryItem))
            {
                <RadzenTabsItem Text="@Loc["Operations"]">
                    @if (IsActiveTab(2))
                    {
                        <Component_ShareGrid TType=VppItemResDTO @bind-Data=@operations DicDropdownData=@CategoryDropdownDatas Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync SetStatus=@ApiSetStatusAsync DataEndpoint="@Config.ApiCatalogItems" AllowHardDelete="false" PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddItem"]" SearchPlaceholder="@Loc["LibrarySearchItems"]" SearchFields="@(new[] { "VppCode", "VppName" })" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibrarySupplier))
            {
                <RadzenTabsItem Text="@Loc["Suppliers"]">
                    @if (IsActiveTab(3))
                    {
                        <Component_ShareGrid TType=SupplierResDTO @bind-Data=@suppliers Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddSupplier"]" SearchPlaceholder="@Loc["LibrarySearchSuppliers"]" SearchFields="@(new[] { "SupplierShortName", "SupplierName" })" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryPriceList, Permissions.LibraryPrice))
            {
                <RadzenTabsItem Text="@Loc["Pricing"]">
                    @if (IsActiveTab(6))
                    {
                        @if (CanShowPricingTabs)
                        {
                            <RadzenTabs Change="@PricingTabOnChange"
                                        RenderMode="TabRenderMode.Client"
                                        class="vpp-secondary-tabs"
                                        @bind-SelectedIndex="@PricingSelectedIndex">
                                <Tabs>
                                    @if (CanShowPriceLists)
                                    {
                                        <RadzenTabsItem Text="@Loc["PriceLists"]">
                                            @if (IsActivePricingTab(6))
                                            {
                                                <Tab_PriceListLibrary claims="@claims"
                                                                      PagePermissionResDTO="@PagePermissionResDTO" />
                                            }
                                        </RadzenTabsItem>
                                    }
                                    @if (CanShowPrices)
                                    {
                                        <RadzenTabsItem Text="@Loc["Prices"]">
                                            @if (IsActivePricingTab(4))
                                            {
                                                <Tab_PriceLibrary claims="@claims"
                                                                  PagePermissionResDTO="@PagePermissionResDTO" />
                                            }
                                        </RadzenTabsItem>
                                    }
                                </Tabs>
                            </RadzenTabs>
                        }
                        else if (CanShowPriceLists)
                        {
                            <Tab_PriceListLibrary claims="@claims"
                                                  PagePermissionResDTO="@PagePermissionResDTO" />
                        }
                        else if (CanShowPrices)
                        {
                            <Tab_PriceLibrary claims="@claims"
                                              PagePermissionResDTO="@PagePermissionResDTO" />
                        }
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryDepartment))
            {
                <RadzenTabsItem Text="@Loc["Departments"]">
                    @if (IsActiveTab(5))
                    {
                        <Component_ShareGrid TType=DepartmentResDTO @bind-Data=@departments Add=@ApiAddAsync Update=@ApiUpdateAsync Delete=@ApiDeleteAsync PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddDepartment"]" SearchPlaceholder="@Loc["LibrarySearchDepartments"]" SearchFields="@(new[] { "Code", "Name" })" />
                    }
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
