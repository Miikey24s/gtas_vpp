@using System.Globalization
@inject NavigationManager Navigation

<VppSegmentedSelector TValue="string"
                      Value="@CurrentCulture"
                      Options="@LanguageOptions"
                      ValueChanged="@SetCultureAsync"
                      AriaLabel="@ToggleTitle"
                      IsBusy="@_isSwitching"
                      Class="vpp-account-language-switch" />

@code {
    private bool _isSwitching;
    private bool IsEnglishUi => CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
    private string CurrentCulture => IsEnglishUi ? "en" : "vi";
    private string ToggleTitle => IsEnglishUi ? Loc["SwitchToVietnamese"] : Loc["SwitchToEnglish"];
    private IReadOnlyList<VppSegmentedOption<string>> LanguageOptions =>
    [
        new("vi", "VI", IsEnabled: !_isSwitching),
        new("en", "EN", IsEnabled: !_isSwitching)
    ];

    private Task SetCultureAsync(string culture)
    {
        if (_isSwitching || string.Equals(culture, CurrentCulture, StringComparison.OrdinalIgnoreCase))
        {
            return Task.CompletedTask;
        }

        _isSwitching = true;
        var returnUrl = $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
        Navigation.NavigateTo(
            $"/set-language?culture={culture}&returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: true);
        return Task.CompletedTask;
    }
}
