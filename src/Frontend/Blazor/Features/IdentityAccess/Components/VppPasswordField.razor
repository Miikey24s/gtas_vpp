@using System.Linq.Expressions

<div class="vpp-login-field @(Invalid ? "vpp-login-field--invalid" : string.Empty)">
    <RadzenLabel Text="@Label" Component="@Name" class="vpp-login-label" />
    <div class="vpp-login-password-wrapper">
        @if (_isVisible)
        {
            <RadzenTextBox Name="@Name"
                           Value="@Value"
                           ValueChanged="@ValueChanged"
                           ValueExpression="@ValueExpression"
                           Disabled="@Disabled"
                           autocomplete="@AutoComplete"
                           class="vpp-login-control"
                           @oninput="OnInput"
                           @onblur="OnBlur" />
        }
        else
        {
            <RadzenPassword Name="@Name"
                            Value="@Value"
                            ValueChanged="@ValueChanged"
                            ValueExpression="@ValueExpression"
                            Disabled="@Disabled"
                            autocomplete="@AutoComplete"
                            class="vpp-login-control"
                            @oninput="OnInput"
                            @onblur="OnBlur" />
        }
        <button type="button"
                class="vpp-password-toggle-btn"
                title="@ToggleLabel"
                aria-label="@ToggleLabel"
                aria-pressed="@_isVisible"
                disabled="@Disabled"
                @onclick="ToggleVisibility">
            <VppIcon Name="@(_isVisible ? VppIcons.VisibilityOff : VppIcons.Visibility)" />
        </button>
    </div>
    <div class="vpp-validation-slot @(!string.IsNullOrWhiteSpace(Hint) ? "has-hint" : string.Empty)">
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <span class="vpp-account-field-hint">@Hint</span>
        }
        @if (ValidationContent is not null)
        {
            @ValidationContent
        }
        else if (ValueExpression is not null)
        {
            <ValidationMessage For="@ValueExpression" />
        }
    </div>
</div>

@code {
    private bool _isVisible;

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string>>? ValueExpression { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Invalid { get; set; }

    [Parameter]
    public string AutoComplete { get; set; } = "new-password";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnInput { get; set; }

    [Parameter]
    public EventCallback<FocusEventArgs> OnBlur { get; set; }

    [Parameter]
    public RenderFragment? ValidationContent { get; set; }

    private string ToggleLabel => _isVisible ? Loc["HidePassword"] : Loc["ShowPassword"];

    private void ToggleVisibility() => _isVisible = !_isVisible;
}
