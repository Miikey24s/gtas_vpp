@page "/Error"
@using System.Diagnostics
@inject NavigationManager Navigation

<PageTitle>GTAS VPP - @Loc["ErrorPageTitle"]</PageTitle>

<main class="vpp-system-page">
    <VppPageHeader Title="@Loc["ErrorPageTitle"]"
                   Description="@Loc["ErrorPageDescription"]"
                   HeadingId="error-heading" />
    <VppContentState State="VppContentStateKind.Error"
                     Icon="error_outline"
                     Title="@Loc["ErrorPageTitle"]"
                     Description="@Loc["ErrorPageDescription"]"
                     PrimaryActionText="@Loc["Retry"]"
                     PrimaryActionIcon="@VppIcons.Refresh"
                     PrimaryAction="@Reload"
                     SecondaryActionText="@Loc["BackToDashboard"]"
                     SecondaryActionHref="/" />
    @if (ShowRequestId)
    {
        <p class="vpp-system-trace">
            <span>@Loc["TraceId"]:</span>
            <code>@RequestId</code>
        </p>
    }
</main>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.TraceId.ToString() ?? HttpContext?.TraceIdentifier;

    private void Reload() => Navigation.Refresh(forceReload: true);
}
