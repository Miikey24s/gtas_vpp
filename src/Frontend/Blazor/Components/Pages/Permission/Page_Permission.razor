@page "/permission"
@layout MainLayout
@inherits gtas_vpp_fe.Components.Pages.PermissionAwarePageBase
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject IJSRuntime js


<PageTitle>GTAS VPP - @Loc["Permissions"]</PageTitle>

@if (!RendererInfo.IsInteractive)
{
    <section class="vpp-admin-page" aria-busy="true">
        <SkeletonPage Cards="0" Rows="8" Cols="5" />
    </section>
}
else
{
    <section class="vpp-admin-page">
        <Component_Permission PagePermissionResDTO="@PagePermissionResDTO" />
    </section>
}
