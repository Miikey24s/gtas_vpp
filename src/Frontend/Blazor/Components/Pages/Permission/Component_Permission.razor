@using gtas_vpp_fe.Components.Pages.Permission.Tabs
@using gtas_vpp_shared.Constants




@if (HasAnyVisiblePermissionTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="vpp-admin-tabs vpp-bounded-shell"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            @if (CanViewPermissionTab(Permissions.PermissionUser))
            {
                <RadzenTabsItem Text="@Loc["Users"]">
                    @if (IsActiveTab(0))
                    {
                        <Tab_User claims="@claims" PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewPermissionTab(Permissions.PermissionComponent))
            {
                <RadzenTabsItem Text="@Loc["GroupsAndPermissions"]">
                    @if (IsActiveTab(1))
                    {
                        <Tab_PagePermission claims="@claims" PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewPermissionTab(Permissions.PermissionManage))
            {
                <RadzenTabsItem Text="@Loc["SecurityAudit"]">
                    @if (IsActiveTab(2))
                    {
                        <Tab_SecurityAudit />
                    }
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
