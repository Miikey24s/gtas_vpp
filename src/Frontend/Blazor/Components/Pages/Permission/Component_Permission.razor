@* PAGE: Permission/Component_Permission.razor *@
@using gtas_vpp_fe.Components.Pages.Permission.Tabs
@using gtas_vpp_shared.Constants




@if (HasAnyVisiblePermissionTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="vpp-admin-tabs vpp-bounded-shell"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            @if (HasAuthorizedPermissionTab(0))
            {
                <RadzenTabsItem Text="@Loc["Users"]">
                    @if (IsActiveTab(0))
                    {
                        <Tab_User />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedPermissionTab(1))
            {
                <RadzenTabsItem Text="@Loc["GroupsAndPermissions"]">
                    @if (IsActiveTab(1))
                    {
                        <Tab_PagePermission PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedPermissionTab(2))
            {
                <RadzenTabsItem Text="@Loc["SecurityAudit"]">
                    @if (IsActiveTab(2))
                    {
                        <Tab_SecurityAudit />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedPermissionTab(3))
            {
                <RadzenTabsItem Text="@Loc["OrderPeriodSettings"]">
                    @if (IsActiveTab(3))
                    {
                        <Tab_OrderPeriodSettings />
                    }
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
