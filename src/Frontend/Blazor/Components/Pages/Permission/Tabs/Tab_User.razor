@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Req.Account
@using gtas_vpp_shared.DTOs.Res.Account
@using gtas_vpp_fe.Helpers
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject IToastService Toast

@if (PermissionState.HasPermission(Permissions.PermissionView))
{
    <VppCollectionWorkspace FillAvailableSpace="true" Class="vpp-permission-user-page vpp-admin-workspace">
        <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                             Density="VppDataDensity.Compact"
                             AriaLabel="@Loc["UserManagementTitle"]"
                             TestId="permission-users-data-surface"
                             Class="vpp-admin-data-surface">
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["UserFilters"]" Class="vpp-admin-grid-toolbar vpp-permission-user-filters">
                    <VppFilterSearch Value="@SearchText" Input="@SearchTextOnInput" Placeholder="@Loc["UserSearchPlaceholder"]" AriaLabel="@Loc["UserSearchPlaceholder"]" />
                    <VppFilterSelect TValue="string" Value="@(SelectedAccountStatus ?? string.Empty)" Options="@AccountStatusOptions" ValueChanged="@OnAccountStatusChangedAsync" Placeholder="@Loc["AllAccountStatuses"]" AriaLabel="@Loc["AllAccountStatuses"]" />
                    <VppFilterSelect TValue="Guid?" Value="@SelectedGroupId" Options="@GroupFilterOptions" ValueChanged="@OnGroupFilterChangedAsync" Placeholder="@Loc["PermissionGroup"]" AriaLabel="@Loc["PermissionGroup"]" />
                    <VppFilterSelect TValue="Guid?" Value="@SelectedDepartmentId" Options="@DepartmentFilterOptions" ValueChanged="@OnDepartmentFilterChangedAsync" Placeholder="@Loc["Department"]" AriaLabel="@Loc["Department"]" />
                    <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasUserFilters" Clicked="@ButtonOnClick_Clear" />
                    <div class="vpp-admin-toolbar-actions vpp-permission-user-actions">
                        <RadzenButton Icon="person_add" Text="Thêm người dùng" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" class="vpp-library-primary-action" Disabled="@(!CanInviteUsers)" Click="@OpenInvitationAsync" title="@InvitationCapabilityMessage" />
                        <VppColumnPicker TItem="UserAdministrationResDTO" GridAccessor="@(() => userGrid)" />
                    </div>
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
                <RadzenDataGrid @ref="userGrid"
                                data-vpp-grid-region="true"
                                aria-label="@Loc["UserManagementTitle"]"
                                TItem="UserAdministrationResDTO"
                                Data="@users"
                                Count="@userCount"
                                LoadData="@LoadUsersAsync"
                                LoadColumnFilterData="@LoadUserFilterDataAsync"
                                IsLoading="@(isUserLoading || isUserLookupLoading)"
                                AllowFiltering="true"
                                AllowColumnResize="true"
                                AllowMultiColumnSorting="false"
                                AllowSorting="true"
                                AllowPaging="true"
                                PagerAlwaysVisible="true"
                                GotoFirstPageOnSort="true"
                                AllowGrouping="false"
                                AllowVirtualization="false"
                                AllowAlternatingRows="false"
                                AllowColumnReorder="true"
                                AllowColumnPicking="false"
                                AllowPickAllColumns="true"
                                ColumnsPickerAllowFiltering="true"
                                ShowMultiColumnSortingIndex="false"
                                PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                FilterMode="FilterMode.CheckBoxList"
                                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                LogicalFilterOperator="LogicalFilterOperator.And"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                class="permission-user-grid vpp-admin-page-grid vpp-admin-grid vpp-data-grid vpp-data-density-compact"
                                Style="--vpp-admin-grid-min-width: 1420px;">
                    <Columns>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Width="52px" MinWidth="52px" Title="#" Reorderable="false" Filterable="false" Pickable="false" Sortable="false" TextAlign="TextAlign.Center"><Template Context="user">@(currentUserSkip + users.IndexOf(user) + 1)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["AccountStatus"]" Width="145px" Property="@nameof(UserAdministrationResDTO.AccountStatus)" Filterable="false"><Template Context="user"><RadzenBadge Text="@GetAccountStatusLabel(user)" BadgeStyle="@(user.IsActive ? BadgeStyle.Success : BadgeStyle.Light)" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="Người dùng" Property="@nameof(UserAdministrationResDTO.FullName)" Width="220px"><Template Context="user"><div class="vpp-admin-two-line-cell"><strong>@(user.FullName ?? "–")</strong><small>@(user.UserLogin ?? "–")</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Email"]" Property="@nameof(UserAdministrationResDTO.Email)" Width="250px"><Template Context="user"><div class="vpp-admin-two-line-cell"><strong>@(user.Email ?? "–")</strong><small>@(user.EmployeeCode ?? "–")</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["PermissionGroup"]" Property="@nameof(UserAdministrationResDTO.GroupName)" Width="190px"><Template Context="user">@(string.IsNullOrWhiteSpace(user.GroupName) ? "–" : user.GroupName)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Department"]" Property="@nameof(UserAdministrationResDTO.DepartmentName)" Width="200px"><Template Context="user">@(string.IsNullOrWhiteSpace(user.DepartmentName) ? "–" : user.DepartmentName)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="Trạng thái lời mời" Width="155px" Filterable="false" Sortable="false"><Template Context="user"><RadzenBadge Text="@GetInvitationStatusLabel(user)" BadgeStyle="@GetInvitationBadgeStyle(user)" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Admin"]" Property="@nameof(UserAdministrationResDTO.IsAdmin)" Width="82px" Filterable="false" TextAlign="TextAlign.Center"><Template Context="user">@if (user.IsAdmin) { <VppIcon Name="@VppIcons.Approved" /> }</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Actions"]" Width="150px" MinWidth="150px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center"><Template Context="user"><div class="vpp-admin-actions"><RadzenButton Icon="manage_accounts" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Disabled="@(!CanEditMembership(user) && !CanPrepareActivation(user))" Click="@(() => OpenMembershipEditorAsync(user))" title="@Loc["PermissionGroup"]" /><RadzenButton Icon="mark_email_unread" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Disabled="@(!CanSendPasswordLink(user))" Click="@(() => SendPasswordResetLinkAsync(user))" title="Gửi liên kết đặt lại mật khẩu" /><RadzenButton Icon="person_off" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="@(!CanDeactivateMembership(user))" Click="@(() => DeactivateMembershipAsync(user))" title="@Loc["DeactivateMembership"]" /></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Description"]" Property="@nameof(UserAdministrationResDTO.Description)" Width="220px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="Account Id" Property="@nameof(UserAdministrationResDTO.UserId)" Width="110px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="Row version" Property="@nameof(UserAdministrationResDTO.RowVersion)" Width="220px" Visible="false" Pickable="true" />
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </VppDataSurfaceFrame>
    </VppCollectionWorkspace>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="m-3" Text="@Loc["NoPermission"]" />
}
