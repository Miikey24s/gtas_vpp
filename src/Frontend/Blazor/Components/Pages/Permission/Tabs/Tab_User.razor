@* PAGE: Permission/Tabs/Tab_User.razor *@
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Req.Account
@using gtas_vpp_shared.DTOs.Res.Account
@using gtas_vpp_fe.Helpers
@inject DialogService DialogService
@inject IToastService Toast

@if (PermissionState.HasPermission(Permissions.PermissionView))
{
    <VppCollectionWorkspace FillAvailableSpace="true" Class="vpp-permission-user-page vpp-admin-workspace">
        <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                             Density="VppDataDensity.Compact"
                             IsBusy="@(isUserLoading || isUserLookupLoading)"
                             State="@(isUserLoading || isUserLookupLoading ? VppDataSurfaceState.Loading : userCount == 0 ? HasUserFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty : VppDataSurfaceState.Populated)"
                             AriaLabel="@Loc["UserManagementTitle"]"
                             TestId="permission-users-data-surface"
                             Class="vpp-admin-data-surface">
            <Header>
                <VppCollectionHeader Title="@Loc["UserManagementTitle"]"
                                     Summary="@Loc["RecordsCount", userCount]"
                                     AddText="@Loc["AddUser"]"
                                     CompactAddText="@Loc["Add"]"
                                     ShowAddAction="@CanManageUsers"
                                     Disabled="@(!CanInviteUsers)"
                                     DisabledReason="@InvitationCapabilityMessage"
                                     AddClicked="@OpenInvitationAsync" />
            </Header>
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["UserFilters"]" Class="vpp-admin-grid-toolbar vpp-permission-user-filters">
                    <VppFilterSearch Value="@SearchText" Input="@SearchTextOnInput" Placeholder="@Loc["UserSearchPlaceholder"]" AriaLabel="@Loc["UserSearchPlaceholder"]" />
                    <VppFilterSelect TValue="string" Value="@(SelectedAccountStatus ?? string.Empty)" Options="@AccountStatusOptions" ValueChanged="@OnAccountStatusChangedAsync" Placeholder="@Loc["AllAccountStatuses"]" AriaLabel="@Loc["AllAccountStatuses"]" />
                    <VppFilterSelect TValue="Guid?" Value="@SelectedGroupId" Options="@GroupFilterOptions" ValueChanged="@OnGroupFilterChangedAsync" Placeholder="@Loc["PermissionGroup"]" AriaLabel="@Loc["PermissionGroup"]" />
                    <VppFilterSelect TValue="Guid?" Value="@SelectedDepartmentId" Options="@DepartmentFilterOptions" ValueChanged="@OnDepartmentFilterChangedAsync" Placeholder="@Loc["Department"]" AriaLabel="@Loc["Department"]" />
                    <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasUserFilters" Clicked="@ButtonOnClick_Clear" />
                    <div class="vpp-admin-toolbar-actions vpp-permission-user-actions">
                        <VppColumnPicker TItem="UserAdministrationResDTO" GridAccessor="@(() => userGrid)" />
                    </div>
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
                <RadzenDataGrid @ref="userGrid"
                                data-vpp-grid-region="true"
                                aria-label="@Loc["UserManagementTitle"]"
                                TItem="UserAdministrationResDTO"
                                Data="@users"
                                Count="@userCount"
                                LoadData="@LoadUsersAsync"
                                IsLoading="@(isUserLoading || isUserLookupLoading)"
                                AllowFiltering="false"
                                AllowColumnResize="true"
                                AllowMultiColumnSorting="false"
                                AllowSorting="true"
                                AllowPaging="true"
                                PagerAlwaysVisible="true"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                GotoFirstPageOnSort="true"
                                AllowGrouping="false"
                                AllowVirtualization="false"
                                AllowAlternatingRows="false"
                                AllowColumnReorder="true"
                                AllowColumnPicking="false"
                                AllowPickAllColumns="true"
                                ColumnsPickerAllowFiltering="true"
                                ShowMultiColumnSortingIndex="false"
                                PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                LogicalFilterOperator="LogicalFilterOperator.And"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                class="permission-user-grid vpp-admin-page-grid vpp-admin-grid vpp-data-grid vpp-data-density-compact"
                                Style="--vpp-admin-grid-min-width: 1460px;">
                    <EmptyTemplate>
                        <VppDataGridEmptyState State="@(HasUserFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                               Title="@(HasUserFilters ? Loc["NoOrdersMatchSelectedFilters"] : Loc["NoData"])"
                                               Description="@(HasUserFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
                    </EmptyTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Width="52px" MinWidth="52px" Title="#" Reorderable="false" Filterable="false" Pickable="false" Sortable="false" TextAlign="TextAlign.Center"><Template Context="user">@(currentUserSkip + users.IndexOf(user) + 1)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["User"]" Property="@nameof(UserAdministrationResDTO.FullName)" Width="220px"><Template Context="user"><div class="vpp-admin-two-line-cell"><strong>@(user.FullName ?? "–") @if (IsCurrentUser(user)) { <span class="vpp-admin-current-account">@Loc["CurrentAccount"]</span> }</strong><small>@(user.UserLogin ?? "–")</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Email"]" Property="@nameof(UserAdministrationResDTO.Email)" Width="250px" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["EmployeeCode"]" Property="@nameof(UserAdministrationResDTO.EmployeeCode)" Width="140px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["AccountStatus"]" Width="145px" Property="@nameof(UserAdministrationResDTO.AccountStatus)" Filterable="false"><Template Context="user"><VppStatusBadge Text="@GetAccountStatusLabel(user)" Tone="@GetAccountStatusTone(user)" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["PermissionGroup"]" Property="@nameof(UserAdministrationResDTO.GroupName)" Width="210px">
                            <Template Context="user">
                                <span class="vpp-admin-inline-select-shell" title="@GetAssignmentTitle(user)">
                                    <RadzenDropDown TValue="Guid?"
                                                    Data="@permissionGroups"
                                                    TextProperty="GroupName"
                                                    ValueProperty="Id"
                                                    Value="@GetSelectedGroupId(user)"
                                                    Change="@((object value) => OnGroupAssignmentChangedAsync(user, ConvertToNullableGuid(value)))"
                                                    AllowFiltering="false"
                                                    Placeholder="@Loc["PermissionGroup"]"
                                                    Disabled="@(!CanAssignMembership(user))"
                                                    class="vpp-admin-inline-select" />
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Department"]" Property="@nameof(UserAdministrationResDTO.DepartmentName)" Width="220px">
                            <Template Context="user">
                                <span class="vpp-admin-inline-select-shell" title="@GetAssignmentTitle(user)">
                                    <RadzenDropDown TValue="Guid?"
                                                    Data="@departments"
                                                    TextProperty="Name"
                                                    ValueProperty="Id"
                                                    Value="@GetSelectedDepartmentId(user)"
                                                    Change="@((object value) => OnDepartmentAssignmentChangedAsync(user, ConvertToNullableGuid(value)))"
                                                    AllowFiltering="false"
                                                    Placeholder="@Loc["Department"]"
                                                    Disabled="@(!CanAssignMembership(user))"
                                                    class="vpp-admin-inline-select" />
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Invitation"]" Width="125px" Filterable="false" Sortable="false"><Template Context="user"><VppStatusBadge Text="@GetInvitationStatusLabel(user)" Tone="@GetInvitationTone(user)" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Admin"]" Property="@nameof(UserAdministrationResDTO.IsAdmin)" Width="82px" Filterable="false" TextAlign="TextAlign.Center"><Template Context="user">@if (user.IsAdmin) { <VppIcon Name="@VppIcons.Approved" /> }</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Description"]" Property="@nameof(UserAdministrationResDTO.Description)" Width="220px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["CreatedBy"]" Property="@nameof(UserAdministrationResDTO.CreatedByUserName)" Width="160px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["CreatedAt"]" Property="@nameof(UserAdministrationResDTO.CreatedAtUtc)" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["UpdatedBy"]" Property="@nameof(UserAdministrationResDTO.UpdatedByUserName)" Width="160px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["UpdatedAt"]" Property="@nameof(UserAdministrationResDTO.UpdatedAtUtc)" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="UserAdministrationResDTO" Title="@Loc["Actions"]" Width="154px" MinWidth="154px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" Visible="@CanManageUsers">
                            <Template Context="user">
                                <div class="vpp-admin-actions">
                                    @if (CanManageUsers && IsPendingApproval(user))
                                    {
                                        <span class="vpp-admin-action-shell" title="@GetApprovalActionTitle(user)">
                                            <RadzenButton Icon="how_to_reg"
                                                          Text="@Loc["Approve"]"
                                                          ButtonStyle="ButtonStyle.Success"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@(!CanApproveAccount(user))"
                                                          Click="@(() => ApproveAccountAsync(user))"
                                                          class="vpp-admin-action-label"
                                                          aria-label="@GetApprovalActionTitle(user)" />
                                        </span>
                                    }
                                    else if (CanManageUsers)
                                    {
                                        <VppAdminActiveToggle IsActive="@user.IsActive"
                                                              Title="@GetAccessToggleTitle(user)"
                                                              Changed="@((bool isActive) => ToggleUserAccessAsync(user, isActive))"
                                                              Disabled="@(!CanToggleUserAccess(user))"
                                                              Class="vpp-admin-user-access-switch" />
                                    }
                                    @if (CanManageUsers)
                                    {
                                        <VppAdminActionMenu Title="@Loc["MoreActions"]"
                                                            Items="@UserSecondaryActions(user)"
                                                            AllowOpenWhenAllDisabled="true"
                                                            TestId="user-row-more-actions" />
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </VppDataSurfaceFrame>
    </VppCollectionWorkspace>
}
else
{
    <VppContentState State="VppContentStateKind.Denied"
                     FillAvailable="true"
                     Icon="@VppIcons.Lock"
                     Title="@Loc["NoPermission"]"
                     Class="m-3" />
}
