@* PAGE: Permission/Tabs/Tab_SecurityAudit.razor *@
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Permission

@if (PermissionState.HasPermission(Permissions.PermissionManage))
{
    <VppCollectionWorkspace FillAvailableSpace="true" Class="vpp-security-audit-page vpp-admin-workspace">
        <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                             Density="VppDataDensity.Compact"
                             IsBusy="@(isLoading || isLoadingOptions)"
                             State="@(isLoading || isLoadingOptions ? VppDataSurfaceState.Loading : auditCount == 0 ? HasFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty : VppDataSurfaceState.Populated)"
                             AriaLabel="@Loc["SecurityAudit"]"
                             TestId="security-audit-data-surface"
                             Class="vpp-admin-data-surface">
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["SecurityAuditFilters"]" Class="vpp-admin-grid-toolbar vpp-security-audit-filters">
                    <VppFilterSearch Value="@SearchText" Input="@SearchTextOnInput" Placeholder="@Loc["SecurityAuditSearchPlaceholder"]" AriaLabel="@Loc["SecurityAuditSearchPlaceholder"]" />
                    <VppFilterSelect TValue="string" Value="@(SelectedAction ?? string.Empty)" Options="@ActionOptions" ValueChanged="@OnActionChangedAsync" Placeholder="@Loc["AllAuditActions"]" AriaLabel="@Loc["AllAuditActions"]" />
                    <VppFilterSelect TValue="string" Value="@(SelectedOutcome ?? string.Empty)" Options="@OutcomeOptions" ValueChanged="@OnOutcomeChangedAsync" Placeholder="@Loc["AllAuditOutcomes"]" AriaLabel="@Loc["AllAuditOutcomes"]" />
                    <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                    <VppColumnPicker TItem="SecurityAuditResDTO" GridAccessor="@(() => auditGrid)" />
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
                <RadzenDataGrid @ref="auditGrid"
                                data-vpp-grid-region="true"
                                aria-label="@Loc["SecurityAudit"]"
                                TItem="SecurityAuditResDTO"
                                Data="@audits"
                                Count="@auditCount"
                                LoadData="@LoadAuditsAsync"
                                IsLoading="@(isLoading || isLoadingOptions)"
                                AllowFiltering="false"
                                AllowColumnResize="true"
                                AllowMultiColumnSorting="false"
                                AllowSorting="true"
                                AllowPaging="true"
                                PagerAlwaysVisible="true"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                GotoFirstPageOnSort="true"
                                AllowGrouping="false"
                                AllowVirtualization="false"
                                AllowAlternatingRows="false"
                                AllowColumnReorder="true"
                                AllowColumnPicking="false"
                                AllowPickAllColumns="true"
                                ColumnsPickerAllowFiltering="true"
                                ShowMultiColumnSortingIndex="false"
                                PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                class="security-audit-grid vpp-admin-page-grid vpp-admin-grid vpp-data-grid vpp-data-density-compact"
                                Style="--vpp-admin-grid-min-width: 1680px;">
                    <EmptyTemplate>
                        <VppDataGridEmptyState State="@(HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                               Title="@(HasFilters ? Loc["NoOrdersMatchSelectedFilters"] : Loc["NoData"])"
                                               Description="@(HasFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
                    </EmptyTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Title="#" Width="52px" MinWidth="52px" Reorderable="false" Pickable="false" Sortable="false" TextAlign="TextAlign.Center"><Template Context="audit">@(currentSkip + audits.IndexOf(audit) + 1)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.OccurredAtUtc)" Title="@Loc["AuditTime"]" Width="170px"><Template Context="audit">@audit.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.ActorFullName)" Title="@Loc["AuditActor"]" Width="220px"><Template Context="audit"><div class="vpp-admin-two-line-cell"><strong>@GetActorLabel(audit)</strong><small>@GetActorSecondaryLabel(audit)</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.Action)" Title="@Loc["AuditAction"]" Width="230px"><Template Context="audit"><div class="vpp-admin-two-line-cell"><strong>@GetActionLabel(audit.Action)</strong><small>@audit.Action</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.Outcome)" Title="@Loc["AuditOutcome"]" Width="120px"><Template Context="audit"><VppStatusBadge Text="@GetOutcomeLabel(audit.Outcome)" Tone="@GetOutcomeTone(audit.Outcome)" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.TargetFullName)" Title="@Loc["AuditTarget"]" Width="220px"><Template Context="audit"><div class="vpp-admin-two-line-cell"><strong>@GetTargetLabel(audit)</strong><small>@GetTargetSecondaryLabel(audit)</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.ResourceType)" Title="@Loc["AuditResource"]" Width="220px"><Template Context="audit"><div class="vpp-admin-two-line-cell"><strong>@audit.ResourceType</strong><small>@(audit.ResourceId ?? "—")</small></div></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.Summary)" Title="@Loc["AuditSummary"]" Width="330px" />
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Title="@Loc["Actions"]" Width="76px" MinWidth="76px" Sortable="false" Filterable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center"><Template Context="audit"><VppAdminIconAction Icon="visibility" Title="@Loc["Details"]" Click="@(() => OpenAuditDetailAsync(audit))" /></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.Reason)" Title="@Loc["Reason"]" Width="300px" Visible="false" Pickable="true" />
                        <RadzenDataGridColumn TItem="SecurityAuditResDTO" Property="@nameof(SecurityAuditResDTO.CorrelationId)" Title="@Loc["AuditCorrelationId"]" Width="240px" Visible="false" Pickable="true" />
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </VppDataSurfaceFrame>
    </VppCollectionWorkspace>
}
else
{
    <VppContentState State="VppContentStateKind.Denied"
                     FillAvailable="true"
                     Icon="@VppIcons.Lock"
                     Title="@Loc["NoPermission"]"
                     Class="m-3" />
}
