@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_fe.Helpers
@using PermissionGroupDto = gtas_vpp_shared.DTOs.Res.Permission.PermissionGroupResDTO
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject GlobalClass glb
@inject NavigationManager NavigationManager
@inject IToastService Toast

@if (PermissionState.HasPermission(Permissions.PermissionView))
{
    <VppCollectionWorkspace FillAvailableSpace="true"
                            Gap="VppWorkspaceGap.Compact"
                            Class="vpp-permission-admin-page">
        <Header>
            <div class="vpp-permission-view-switcher">
                <VppSegmentedSelector TValue="int"
                                      Value="@selectedPermissionView"
                                      Options="@PermissionViewOptions"
                                      ValueChanged="@SelectPermissionViewAsync"
                                      AriaLabel="@Loc["PermissionView"]" />
            </div>
        </Header>
        <ChildContent>
            @if (selectedPermissionView == 0)
            {
                <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                                     Density="VppDataDensity.Compact"
                                     AriaLabel="@Loc["GroupName"]"
                                     TestId="permission-groups-data-surface"
                                     Class="vpp-admin-data-surface vpp-permission-group-surface">
                    <Header>
                        <VppCollectionHeader Title="@Loc["GroupName"]"
                                             Summary="@Loc["CanonicalRoleCount", groupCount]" />
                    </Header>
                    <Toolbar>
                        <VppDataToolbar AriaLabel="@Loc["GroupName"]" Class="vpp-admin-grid-toolbar">
                            <VppFilterSearch Value="@groupSearchText"
                                             Input="@OnGroupSearchInputAsync"
                                             Placeholder="@Loc["Search"]"
                                             AriaLabel="@Loc["Search"]" />
                            <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                                   IsActive="@(!string.IsNullOrWhiteSpace(groupSearchText))"
                                                   Clicked="@ClearGroupFiltersAsync" />
                            <VppColumnPicker TItem="PermissionGroupDto" GridAccessor="@(() => grid)" />
                        </VppDataToolbar>
                    </Toolbar>
                    <ChildContent>
                        <RadzenDataGrid @ref="grid"
                                        data-vpp-grid-region="true"
                                        aria-label="@Loc["GroupName"]"
                                        TItem="PermissionGroupDto"
                                        Data="@list_Group"
                                        Count="@groupCount"
                                        LoadData="@LoadGroupsAsync"
                                        IsLoading="@IsLoading"
                                        AllowFiltering="false"
                                        AllowColumnResize="true"
                                        AllowMultiColumnSorting="false"
                                        AllowSorting="true"
                                        AllowPaging="true"
                                        PagerAlwaysVisible="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        GotoFirstPageOnSort="true"
                                        AllowGrouping="false"
                                        AllowVirtualization="false"
                                        AllowAlternatingRows="false"
                                        AllowColumnReorder="false"
                                        AllowColumnPicking="false"
                                        AllowPickAllColumns="true"
                                        ColumnsPickerAllowFiltering="true"
                                        ShowMultiColumnSortingIndex="false"
                                        PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                        PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="permission-group-grid vpp-admin-grid vpp-admin-page-grid vpp-data-grid vpp-data-density-compact"
                                        Style="--vpp-admin-grid-min-width: 760px;">
                            <Columns>
                                <RadzenDataGridColumn TItem="PermissionGroupDto" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                                    <Template Context="group">@(currentGroupSkip + list_Group.IndexOf(group) + 1)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PermissionGroupDto" Property="@nameof(PermissionGroupDto.GroupName)" Title="@Loc["GroupName"]" Width="260px">
                                    <Template Context="group"><div class="permission-group-identity"><strong>@GetGroupDisplayName(group)</strong><small>@GetGroupCode(group)</small></div></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PermissionGroupDto" Property="@nameof(PermissionGroupDto.UserCount)" Title="@Loc["Users"]" Width="100px" TextAlign="TextAlign.Center" Filterable="false" />
                                <RadzenDataGridColumn TItem="PermissionGroupDto" Property="@nameof(PermissionGroupDto.Description)" Title="@Loc["Description"]" Width="420px" Pickable="true" />
                                <RadzenDataGridColumn TItem="PermissionGroupDto" Title="@Loc["Actions"]" Width="96px" MinWidth="96px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                                    <Template Context="group"><div class="vpp-admin-actions"><VppAdminIconAction Icon="tune" Title="@Loc["ConfigureUiPermissions"]" Disabled="@(!PermissionState.HasPermission(Permissions.PermissionManage))" Click="@(() => OpenPermissionEditorForGroupAsync(group))" /></div></Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </ChildContent>
                </VppDataSurfaceFrame>
            }
            else
            {
                <section class="vpp-permission-matrix-card" aria-labelledby="permission-matrix-title">
                    <header class="vpp-permission-matrix-header">
                        <div>
                            <h2 id="permission-matrix-title">@Loc["PermissionMatrixTitle"]</h2>
                            <p>@Loc["PermissionMatrixDescription"]</p>
                        </div>
                        <span class="vpp-permission-matrix-badge">@Loc["ReadOnlyReference"]</span>
                    </header>
                    <div class="vpp-permission-matrix-scroll" role="region" tabindex="0" aria-label="@Loc["PermissionMatrixTitle"]">
                        <table class="vpp-permission-matrix">
                            <thead>
                                <tr>
                                    <th scope="col">@Loc["PermissionActionColumn"]</th>
                                    @foreach (var persona in CanonicalRbac.Personas)
                                    {
                                        <th scope="col" class="@(IsDevPersona(persona) ? "is-dev" : null)">
                                            <strong>@persona.GroupCode</strong>
                                            <span>@GetRoleDisplayName(persona.GroupCode)</span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var action in CanonicalRbac.Actions)
                                {
                                    <tr>
                                        <th scope="row">
                                            <strong>@GetActionDisplayName(action.PermissionCode)</strong>
                                            <span>@action.PermissionCode</span>
                                        </th>
                                        @foreach (var persona in CanonicalRbac.Personas)
                                        {
                                            var granted = CanonicalRbac.HasAction(persona.GroupId, action.PermissionCode);
                                            <td class="@(IsDevPersona(persona) ? "is-dev" : null)">
                                                @if (granted)
                                                {
                                                    <span class="vpp-permission-granted" role="img" aria-label="@Loc["PermissionGranted"]"><VppIcon Name="check" /></span>
                                                }
                                                else
                                                {
                                                    <span class="vpp-permission-not-granted" aria-label="@Loc["PermissionNotGranted"]">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <footer>@Loc["PermissionMatrixSummary", CanonicalRbac.Actions.Count, CanonicalRbac.Personas.Count]</footer>
                </section>
            }
        </ChildContent>
    </VppCollectionWorkspace>
}
else
{
    <VppContentState State="VppContentStateKind.Denied"
                     Icon="@VppIcons.Lock"
                     Title="@Loc["NoPermission"]"
                     Class="m-3" />
}
