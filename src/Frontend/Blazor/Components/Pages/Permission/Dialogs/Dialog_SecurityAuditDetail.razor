@* PAGE: Permission/Dialogs/Dialog_SecurityAuditDetail.razor *@
@using gtas_vpp_shared.DTOs.Res.Permission
@inject DialogService DialogService

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Standard"
                        TestId="security-audit-detail"
                        Class="vpp-security-audit-detail">
    <Intro>
        <div class="vpp-security-audit-detail-heading">
            <div>
                <strong>@ActionLabel</strong>
                <span>@Audit.Action · @Audit.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>
            <VppStatusBadge Text="@OutcomeLabel" Tone="@OutcomeTone" />
        </div>
    </Intro>
    <ChildContent>
        <dl class="vpp-security-audit-detail-grid">
            <div><dt>@Loc["AuditActor"]</dt><dd>@ActorLabel</dd></div>
            <div><dt>@Loc["AuditTarget"]</dt><dd>@TargetLabel</dd></div>
            <div><dt>@Loc["AuditResource"]</dt><dd>@ResourceLabel</dd></div>
            <div><dt>@Loc["AuditCorrelationId"]</dt><dd>@(Audit.CorrelationId ?? "—")</dd></div>
            <div class="is-wide"><dt>@Loc["AuditSummary"]</dt><dd>@(Audit.Summary ?? "—")</dd></div>
            <div class="is-wide"><dt>@Loc["Reason"]</dt><dd>@(Audit.Reason ?? "—")</dd></div>
        </dl>
    </ChildContent>
    <Footer>
        <VppDialogActions CancelText="@Loc["Close"]"
                          ShowPrimary="false"
                          CancelClick="@CloseAsync" />
    </Footer>
</VppAdaptiveDialogShell>

@code {
    [Parameter, EditorRequired] public SecurityAuditResDTO Audit { get; set; } = new();
    [Parameter, EditorRequired] public string ActionLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string OutcomeLabel { get; set; } = string.Empty;
    [Parameter] public VppStatusTone OutcomeTone { get; set; } = VppStatusTone.Neutral;
    [Parameter] public string ActorLabel { get; set; } = "—";
    [Parameter] public string TargetLabel { get; set; } = "—";
    [Parameter] public string ResourceLabel { get; set; } = "—";

    private Task CloseAsync() => DialogService.TryCloseAsync(null);
}
