@* PAGE: Permission/Dialogs/Dialog_UserInvitationEditor.razor *@
@using gtas_vpp_shared.DTOs.Req.Account
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_shared.DTOs.Res.Library
@inject DialogService DialogService
@inject IToastService ToastService

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Standard" TestId="user-invitation-editor">
    <ChildContent>
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["Username"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.Username" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="Email" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.Email" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["FullNameLong"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.FullName" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["EmployeeCode"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.EmployeeCode" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["PermissionGroup"]" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid" Data="@Groups" TextProperty="GroupName" ValueProperty="Id" @bind-Value="Model.GroupId" AllowFiltering="true" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["Department"]" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid" Data="@Departments" TextProperty="Name" ValueProperty="Id" @bind-Value="Model.PrimaryDepartmentId" AllowFiltering="true" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            <RadzenFormField Text="@Loc["Reason"]" Variant="Variant.Outlined"><RadzenTextArea @bind-Value="Model.Reason" Rows="3" Style="width:100%" /></RadzenFormField>
            <VppInlineNotice Tone="VppStatusTone.Info">@Loc["UserInvitationPasswordlessHint"]</VppInlineNotice>
        </RadzenStack>
    </ChildContent>
    <Footer><VppDialogActions CancelText="@Loc["Cancel"]" PrimaryText="@Loc["SendInvitation"]" PrimaryIcon="mail" CancelClick="@CancelAsync" PrimaryClick="@SaveAsync" /></Footer>
</VppAdaptiveDialogShell>

@code {
    [Parameter] public AdminAccountInvitationReqDTO Model { get; set; } = new();
    [Parameter] public IReadOnlyList<PermissionGroupResDTO> Groups { get; set; } = [];
    [Parameter] public IReadOnlyList<DepartmentResDTO> Departments { get; set; } = [];

    private async Task CancelAsync() => await DialogService.TryCloseAsync(null);
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Model.Username) || string.IsNullOrWhiteSpace(Model.Email)
            || string.IsNullOrWhiteSpace(Model.FullName) || Model.GroupId == Guid.Empty
            || Model.PrimaryDepartmentId == Guid.Empty)
        {
            ToastService.Show(NotificationSeverity.Warning, Loc["ValidationTitle"], Loc["RequiredFieldsValidation"], 4000, false);
            return;
        }

        await DialogService.TryCloseAsync(Model);
    }
}
