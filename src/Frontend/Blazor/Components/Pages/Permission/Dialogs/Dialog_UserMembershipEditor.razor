@using gtas_vpp_fe.Components.Pages.Permission.Models
@using gtas_vpp_shared.DTOs.Res.Auth
@using gtas_vpp_shared.DTOs.Res.Library
@inject DialogService DialogService
@inject IToastService ToastService

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Compact" TestId="user-membership-editor">
    <ChildContent>
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="@Loc["PermissionGroup"]" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid" Data="@Groups" TextProperty="GroupName" ValueProperty="Id" @bind-Value="Model.GroupId" AllowFiltering="true" Style="width:100%" /></RadzenFormField>
            <RadzenFormField Text="@Loc["Department"]" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid" Data="@Departments" TextProperty="Name" ValueProperty="Id" @bind-Value="Model.PrimaryDepartmentId" AllowFiltering="true" Style="width:100%" /></RadzenFormField>
            <RadzenFormField Text="Lý do thay đổi" Variant="Variant.Outlined"><RadzenTextArea @bind-Value="Model.Reason" Rows="3" Style="width:100%" /></RadzenFormField>
        </RadzenStack>
    </ChildContent>
    <Footer><div class="vpp-adaptive-dialog-actions"><RadzenButton Text="@Loc["Cancel"]" Click="@CancelAsync" ButtonStyle="ButtonStyle.Light" /><RadzenButton Text="@Loc["Save"]" Click="@SaveAsync" ButtonStyle="ButtonStyle.Primary" /></div></Footer>
</VppAdaptiveDialogShell>

@code {
    [Parameter] public UserMembershipEditModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<PermissionGroupResDTO> Groups { get; set; } = [];
    [Parameter] public IReadOnlyList<DepartmentResDTO> Departments { get; set; } = [];
    private async Task CancelAsync() => await DialogService.TryCloseAsync(null);
    private async Task SaveAsync()
    {
        if (Model.GroupId == Guid.Empty || Model.PrimaryDepartmentId == Guid.Empty)
        {
            ToastService.Show(NotificationSeverity.Warning, Loc["ValidationTitle"], "Vui lòng chọn nhóm quyền và phòng ban.", 4000, false);
            return;
        }
        await DialogService.TryCloseAsync(Model);
    }
}
