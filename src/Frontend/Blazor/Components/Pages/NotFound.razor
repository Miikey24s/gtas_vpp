@* PAGE: NotFound.razor *@
@page "/not-found"
@layout MainLayout

<PageTitle>GTAS VPP - @Loc["PageNotFound"]</PageTitle>

<main class="vpp-system-page">
    <VppPageHeader Title="@Loc["PageNotFound"]"
                   Description="@Loc["PageNotFoundDescription"]"
                   HeadingId="not-found-heading" />
    <VppContentState State="VppContentStateKind.Empty"
                     FillAvailable="true"
                     Icon="search_off"
                     Title="@Loc["PageNotFound"]"
                     Description="@Loc["PageNotFoundDescription"]"
                     PrimaryActionText="@Loc["BackToDashboard"]"
                     PrimaryActionIcon="dashboard"
                     PrimaryAction="@(_ => GoToDashboard())"
                     PrimaryButtonStyle="ButtonStyle.Primary" />
</main>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void GoToDashboard() => Navigation.NavigateTo("/");
}
