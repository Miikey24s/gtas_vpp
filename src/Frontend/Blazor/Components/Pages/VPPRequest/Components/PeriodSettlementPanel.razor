@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Res.VPP

<div class="vpp-period-settlement-root">
<HistoryWorkspaceShell IsBusy="@isLoading"
                       IsGridRefreshing="@isGridLoading"
                       Class="@SettlementPageClass">
    <div class="vpp-settlement-selector-row">
        <div class="vpp-settlement-selector-groups">
            <VppSegmentedSelector TValue="string"
                                  Value="@periodScope"
                                  Options="@PeriodScopeOptions"
                                  ValueChanged="@OnPeriodScopeChangedAsync"
                                  AriaLabel="@Loc["TargetPeriod"]" />
            <VppSegmentedSelector TValue="string"
                                  Value="@viewMode"
                                  Options="@ViewModeOptions"
                                  ValueChanged="@OnViewModeChangedAsync"
                                  AriaLabel="@Loc["SettlementViewMode"]" />
        </div>

        <div class="vpp-settlement-period-target">
            @if (periodScope == CustomPeriodScope)
            {
                <VppFilterSelect TValue="int"
                                 Value="@Year"
                                 Options="@YearOptions"
                                 ValueChanged="@OnYearChangedAsync"
                                 Placeholder="@Loc["Year"]"
                                 AriaLabel="@Loc["Year"]" />
                <VppFilterSelect TValue="int"
                                 Value="@Month"
                                 Options="@MonthOptions"
                                 ValueChanged="@OnMonthChangedAsync"
                                 Placeholder="@Loc["Month"]"
                                 AriaLabel="@Loc["Month"]" />
            }
            <span>@Loc["Period"] <strong>@Month.ToString("00")/@Year</strong></span>
        </div>
    </div>

    <section class="vpp-settlement-decision-strip" aria-label="@Loc["SettlementSupplierDecision"]">
        <dl>
            <div>
                <dt>@Loc["SupplyPrimarySupplier"]</dt>
                <dd>@PrimarySupplierName</dd>
            </div>
            <div>
                <dt>@Loc["SupplyEffectivePriceList"]</dt>
                <dd>@PrimaryPriceListLabel</dd>
            </div>
            <div class="vpp-settlement-decision-total">
                <dt>@Loc["SettleQuoteTotal"]</dt>
                <dd>@FormatMoney(Preview?.PrimaryQuote?.GrandTotal ?? status?.GrandTotal ?? 0)</dd>
            </div>
        </dl>
        <div class="vpp-settlement-decision-actions">
            <RadzenButton Icon="compare_arrows"
                          Text="@Loc["SettlementCompareOptions"]"
                          ButtonStyle="ButtonStyle.Base"
                          Variant="Variant.Text"
                          Disabled="@(isPreviewLoading || Preview?.Quotes.Count == 0)"
                          Click="@OpenSupplierDialog" />
            <RadzenButton Icon="edit"
                          Text="@Loc["SettlementChangeSupplier"]"
                          ButtonStyle="ButtonStyle.Light"
                          Disabled="@(isPreviewLoading || Preview?.Quotes.Count == 0)"
                          Click="@OpenSupplierDialog" />
        </div>
    </section>

    @if (HasPeriodBlockers)
    {
        <div class="vpp-settlement-blocker-bar" role="status" aria-live="polite">
            <VppIcon Name="@VppIcons.Warning" />
            <span>@FooterConditionText</span>
        </div>
    }

    <VppDataSurfaceFrame DataSourceMode="@(viewMode == OrdersView ? VppDataSourceMode.ServerPaging : VppDataSourceMode.ClientSnapshotPaged)"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["PeriodSettlement"]"
                         TestId="period-settlement-data-surface"
                         Class="vpp-period-data-frame vpp-settlement-orders-frame">
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["PeriodSettlement"]" Class="vpp-period-data-toolbar vpp-settlement-data-toolbar">
                <div class="vpp-period-filters">
                    <VppFilterSearch Value="@searchText"
                                     Input="@OnSearchInputAsync"
                                     Placeholder="@Loc["HistorySearchOrderOrNote"]"
                                     AriaLabel="@Loc["HistorySearchOrderOrNote"]" />
                    <VppFilterSelect TValue="string"
                                     Value="@selectedOrderType"
                                     Options="@OrderTypeOptions"
                                     ValueChanged="@OnOrderTypeChangedAsync"
                                     Placeholder="@Loc["HistoryAllOrderTypes"]"
                                     AriaLabel="@Loc["HistoryOrderType"]" />
                    <VppFilterSelect TValue="int?"
                                     Value="@selectedStatus"
                                     Options="@StatusOptions"
                                     ValueChanged="@OnStatusChangedAsync"
                                     Placeholder="@Loc["HistoryAllStatuses"]"
                                     AriaLabel="@Loc["Status"]" />
                    <VppFilterSelect TValue="string"
                                     Value="@selectedDepartment"
                                     Options="@DepartmentOptions"
                                     ValueChanged="@OnDepartmentChangedAsync"
                                     Placeholder="@Loc["SettlementAllDepartments"]"
                                     AriaLabel="@Loc["Department"]" />
                    <VppClearFiltersButton Text="@Loc["HistoryClearFilters"]"
                                           IsActive="@HasFilters"
                                           Clicked="@ClearFiltersAsync" />
                </div>
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            @if (isLoading)
            {
                <SkeletonPage Cards="0" Rows="8" Cols="9" />
            }
            else if (!string.IsNullOrWhiteSpace(alertMessage))
            {
                <VppContentState State="VppContentStateKind.Error"
                                 Icon="@VppIcons.Error"
                                 Title="@Loc["HistoryLoadFailed"]"
                                 Description="@alertMessage"
                                 PrimaryActionText="@Loc["Retry"]"
                                 PrimaryActionIcon="@VppIcons.Refresh"
                                 PrimaryAction="@(_ => ReloadPeriodAsync())" />
            }
            else if (viewMode == OrdersView)
            {
                @if (totalCount == 0 && !isGridLoading)
                {
                    <VppContentState State="VppContentStateKind.FilteredEmpty"
                                     Icon="search_off"
                                     Title="@Loc["NoOrdersMatchSelectedFilters"]"
                                     Description="@Loc["HistoryAdjustFilters"]" />
                }
                else
                {
                    <div class="vpp-period-grid-wrap">
                        <RadzenDataGrid TItem="VppRequestResDTO"
                                        Data="@orders"
                                        Count="@totalCount"
                                        LoadData="@OnLoadData"
                                        RowSelect="@OpenOrderAsync"
                                        AllowPaging="true"
                                        PageSize="@pageSize"
                                        PageSizeOptions="@VppPagingProfiles.LargeWorkingSet.PageSizeOptions"
                                        PagerAlwaysVisible="true"
                                        ShowPagingSummary="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowMultiColumnSorting="false"
                                        ShowMultiColumnSortingIndex="false"
                                        GotoFirstPageOnSort="true"
                                        AllowFiltering="false"
                                        AllowColumnResize="false"
                                        AllowAlternatingRows="false"
                                        IsLoading="@isGridLoading"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-order-grid vpp-data-grid vpp-data-density-compact vpp-settlement-order-grid">
                            <Columns>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(currentSkip + orders.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["OrderCode"]" Width="190px">
                                    <Template Context="row"><strong class="vpp-settlement-order-code">@row.VppCode</strong></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.DepartmentCode)" Title="@Loc["SettlementDepartmentRequester"]" Width="190px">
                                    <Template Context="row"><div class="vpp-order-product-cell"><strong>@DisplayDepartment(row.DepartmentCode)</strong><small>@DisplayRequester(row.RequesterName)</small></div></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Title="@Loc["HistoryOrderType"]" Width="118px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row"><span class="vpp-history-order-type @(row.IsAdditionalOrder ? "is-additional" : "is-regular")">@(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])</span></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.StatusText)" Title="@Loc["Status"]" Width="126px" TextAlign="TextAlign.Center"><Template Context="row"><span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@Loc[StatusDisplay.GetResourceKey(row.Status, row.IsDeadlinePassed, row.IsAdditionalOrder)]</span></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalLines)" Title="@Loc["TotalLineItems"]" Width="104px" TextAlign="TextAlign.Right" />
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalQty)" Title="@Loc["TotalQuantity"]" Width="112px" TextAlign="TextAlign.Right" />
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalAmount)" Title="@Loc["Amount"]" Width="150px" TextAlign="TextAlign.Right"><Template Context="row"><strong class="vpp-settlement-money">@FormatMoney(row.TotalAmount)</strong></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.SubmittedDate)" Title="@Loc["SubmittedDate"]" Width="164px" TextAlign="TextAlign.Center"><Template Context="row">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</Template></RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
            }
            else if (FilteredDepartmentRows.Count == 0)
            {
                <VppContentState State="VppContentStateKind.FilteredEmpty"
                                 Icon="search_off"
                                 Title="@Loc["NoData"]"
                                 Description="@Loc["HistoryAdjustFilters"]" />
            }
            else
            {
                <div class="vpp-period-grid-wrap">
                    <RadzenDataGrid TItem="DepartmentSettlementRow"
                                    Data="@FilteredDepartmentRows"
                                    AllowPaging="true"
                                    PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                    PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                    PagerAlwaysVisible="true"
                                    ShowPagingSummary="true"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    AllowSorting="true"
                                    AllowMultiColumnSorting="false"
                                    ShowMultiColumnSortingIndex="false"
                                    GotoFirstPageOnSort="true"
                                    AllowFiltering="false"
                                    AllowColumnResize="false"
                                    AllowAlternatingRows="false"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Horizontal"
                                    class="vpp-order-grid vpp-data-grid vpp-data-density-compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(FilteredDepartmentRows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="DepartmentCode" Title="@Loc["Department"]" />
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="OrderCount" Title="@Loc["TotalOrders"]" Width="102px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="RegularOrderCount" Title="@Loc["Regular"]" Width="108px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="AdditionalOrderCount" Title="@Loc["AdditionalOrder"]" Width="112px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="TotalLines" Title="@Loc["TotalLineItems"]" Width="104px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="TotalQuantity" Title="@Loc["TotalQuantity"]" Width="112px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="TotalAmount" Title="@Loc["Amount"]" Width="156px" TextAlign="TextAlign.Right"><Template Context="row"><strong class="vpp-settlement-money">@FormatMoney(row.TotalAmount)</strong></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Title="@Loc["Status"]" Width="130px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row"><span class="vpp-badge @row.StatusCss">@row.StatusText</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Title="@Loc["Details"]" Width="112px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row"><RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Text="@Loc["View"]" Click="@(_ => OpenDepartmentOrdersAsync(row.DepartmentCode))" /></Template></RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </ChildContent>
        <Footer>
            <div class="vpp-period-action-footer vpp-settlement-footer">
                <span>@FooterConditionText</span>
                <div class="vpp-settle-footer-actions">
                    <RadzenButton Icon="preview"
                                  Text="@Loc["SettlementViewPreview"]"
                                  ButtonStyle="ButtonStyle.Light"
                                  Disabled="@(isPreviewLoading || Preview is null)"
                                  Click="@OpenSupplierDialog" />
                    @if (canCorrect)
                    {
                        <RadzenButton Icon="edit_note" Text="@Loc["CreateCorrectionRevision"]" ButtonStyle="ButtonStyle.Warning" Disabled="@(!CanConfirm || isCorrecting)" Click="@OpenCorrectionDialog" />
                    }
                    else
                    {
                        <RadzenButton Icon="lock" Text="@Loc["SettlePeriod"]" ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanConfirm || isSettling)" Click="@SettleAsync" />
                    }
                </div>
            </div>
        </Footer>
    </VppDataSurfaceFrame>

    <HistoryOrderDetailSheet @ref="detailSheet"
                             IsOpen="@isDrawerOpen"
                             IsFullscreen="@isDetailFullscreen"
                             SelectedOrder="@selectedOrder"
                             SelectedSupplierName="@PrimarySupplierName"
                             SelectedOrderAmount="@(selectedOrder?.TotalAmount ?? 0)"
                             IsDetailLoading="@isDetailLoading"
                             HasDetailError="@detailError"
                             DetailRows="@detailRows"
                             DetailCategories="@detailCategories"
                             DetailUoms="@detailUoms"
                             DetailSearch="@detailSearch"
                             DetailCategory="@detailCategory"
                             DetailUom="@detailUom"
                             ActiveDetailCodeNumber="@activeDetailCodeNumber"
                             ActiveDetailNoteNumber="@activeDetailNoteNumber"
                             HasDetailFilters="@HasDetailFilters"
                             HasTableFilters="@HasFilters"
                             TotalCount="@totalCount"
                             UnitHeaderLabel="@Loc["UOM"]"
                             IsExporting="@isExportingOrder"
                             CloseRequested="@CloseDrawer"
                             FullscreenRequested="@ToggleDetailFullscreen"
                             ExportRequested="@ExportSelectedOrderAsync"
                             RetryRequested="@RetryDetailAsync"
                             DetailSearchChanged="@OnDetailSearchInput"
                             DetailCategorySelected="@SelectDetailCategoryAsync"
                             DetailUomSelected="@SelectDetailUomAsync"
                             DetailFiltersCleared="@ClearDetailFiltersAsync"
                             DetailCodeToggled="@ToggleDetailCode"
                             DetailNoteToggled="@ToggleDetailNote"
                             CopyRequested="@CopyToClipboard" />

    @if (isSupplierDialogOpen)
    {
        <button type="button" class="vpp-settlement-dialog-backdrop" aria-label="@Loc["Close"]" @onclick="@CloseSupplierDialog"></button>
        <section class="vpp-settlement-supplier-dialog vpp-transient-surface vpp-transient-surface--center"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="settlement-supplier-dialog-title">
            <header>
                <div>
                    <h2 id="settlement-supplier-dialog-title">@Loc["SettlementChooseSupplier"]</h2>
                    <p>@Month.ToString("00")/@Year · @Loc["SettlementSupplierDialogHint"]</p>
                </div>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@CloseSupplierDialog" aria-label="@Loc["Close"]" />
            </header>
            <div class="vpp-settlement-quote-list">
                @foreach (var quote in SupplierQuotes)
                {
                    var isSelected = pendingPriceListId == quote.PriceListId;
                    <button type="button"
                            class="vpp-settlement-quote-option @(isSelected ? "is-selected" : null) @(!quote.IsEligible ? "is-unavailable" : null)"
                            aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                            disabled="@(!quote.IsEligible)"
                            @onclick="@(() => SelectSupplierQuote(quote))">
                        <span class="vpp-settlement-quote-radio" aria-hidden="true"></span>
                        <span class="vpp-settlement-quote-name"><strong>@quote.SupplierName</strong><small>@quote.PriceListCode · v@quote.Version</small></span>
                        <span class="vpp-settlement-quote-coverage">@quote.CoveredItemCount/@quote.RequestedItemCount · @quote.CoveragePercent.ToString("N0")%</span>
                        <strong class="vpp-settlement-money">@FormatMoney(quote.GrandTotal)</strong>
                        <span class="vpp-settlement-quote-state">@(quote.IsEligible ? Loc["SettlementEligibleOption"] : Loc["SettlementUnavailableOption"])</span>
                    </button>
                }
            </div>
            <footer>
                <RadzenButton Text="@Loc["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@CloseSupplierDialog" />
                <RadzenButton Icon="check" Text="@Loc["Apply"]" ButtonStyle="ButtonStyle.Primary" Disabled="@(isPreviewLoading || !pendingPriceListId.HasValue)" Click="@ApplySupplierQuoteAsync" />
            </footer>
        </section>
    }

    @if (isCorrectionDialogOpen)
    {
        <button type="button" class="vpp-settlement-dialog-backdrop" aria-label="@Loc["Close"]" @onclick="@CloseCorrectionDialog"></button>
        <section class="vpp-settlement-correction-dialog vpp-transient-surface vpp-transient-surface--center"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="settlement-correction-dialog-title">
            <header>
                <div>
                    <h2 id="settlement-correction-dialog-title">@Loc["CorrectionDialogTitle"]</h2>
                    <p>@Loc["CorrectionFourEyesHint"]</p>
                </div>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@CloseCorrectionDialog" aria-label="@Loc["Close"]" />
            </header>
            <div class="vpp-settlement-correction-body">
                <label for="period-correction-reason">@Loc["CorrectionReasonLabel"]</label>
                <RadzenTextArea id="period-correction-reason" @bind-Value="correctionReason" Rows="5" MaxLength="500" Placeholder="@Loc["CorrectionReasonPlaceholder"]" />
            </div>
            <footer>
                <RadzenButton Text="@Loc["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@CloseCorrectionDialog" />
                <RadzenButton Icon="check" Text="@Loc["CreateCorrectionRevision"]" ButtonStyle="ButtonStyle.Warning" Disabled="@isCorrecting" Click="@CorrectAsync" />
            </footer>
        </section>
    }
</HistoryWorkspaceShell>
</div>
