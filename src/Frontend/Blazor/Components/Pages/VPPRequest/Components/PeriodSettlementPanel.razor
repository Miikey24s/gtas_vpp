@* PAGE: VPPRequest/Components/PeriodSettlementPanel.razor *@
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Res.VPP

<VppOperationWorkspace Gap="VppWorkspaceGap.Compact"
                       FillAvailableSpace="true"
                       IsBusy="@(isLoading || isGridLoading)">
    @* PERIOD: Chọn kỳ và chế độ hiển thị dữ liệu chốt kỳ. *@
    @* HEADER: Chọn kỳ, chế độ xem và phạm vi dữ liệu chốt kỳ. *@
    <div class="vpp-period-settlement-root">
        <HistoryWorkspaceShell IsBusy="@isLoading"
                        IsGridRefreshing="@isGridLoading"
                        Class="@(SettlementPageClass + " vpp-history-page--overlay-detail")">
    <div class="vpp-settlement-selector-row">
        <div class="vpp-settlement-selector-groups">
            <div class="vpp-settlement-period-scope-host" @onclick:stopPropagation>
                <VppSegmentedSelector TValue="string"
                                      Value="@DisplayedPeriodScope"
                                      Options="@PeriodScopeOptions"
                                      ValueChanged="@OnPeriodScopeChangedAsync"
                                      AriaLabel="@Loc["TargetPeriod"]" />
                @if (showCustomPeriodPicker)
                {
                    <VppPeriodPickerPopover IsOpen="true"
                                            IsRange="false"
                                            Title="@Loc["SettlementCustomPeriod"]"
                                            StartLabel="@Loc["TargetPeriod"]"
                                            StartValue="@pendingCustomPeriod"
                                            StartChanged="@OnCustomPeriodChanged"
                                            ApplyText="@Loc["ApplyFilters"]"
                                            CancelText="@Loc["Cancel"]"
                                            Applied="@ApplyCustomPeriodAsync"
                                            Dismissed="@DismissCustomPeriod" />
                }
            </div>
            <VppSegmentedSelector TValue="string"
                                  Value="@viewMode"
                                  Options="@ViewModeOptions"
                                  ValueChanged="@OnViewModeChangedAsync"
                                  AriaLabel="@Loc["SettlementViewMode"]" />
        </div>

    </div>

    @* DECISION: Hai card lựa chọn và hai card xuất bản chốt dùng cùng một nhịp. *@
    <section class="vpp-settlement-decision-area" aria-label="@Loc["SettlementSupplierDecision"]">
        <div class="vpp-settlement-decision-cards">
                <VppDecisionSelect TValue="Guid?"
                                   Value="@SelectedSupplierId"
                                   Options="@SupplierOptions"
                                   ValueChanged="@OnSupplierChangedAsync"
                                   Placeholder="@Loc["SettlementSelectSupplier"]"
                                   AriaLabel="@Loc["SettlementSelectSupplier"]"
                                   Eyebrow="@Loc["SettlementSelectSupplier"]"
                                   Class="vpp-settlement-decision-card"
                                   TriggerClass="vpp-settlement-decision-trigger"
                                   Disabled="@(isPreviewLoading || SupplierOptions.Count == 0)" />
                <VppDecisionSelect TValue="Guid?"
                                   Value="@SelectedPriceListId"
                                   Options="@PriceListOptions"
                                   ValueChanged="@OnPriceListChangedAsync"
                                   Placeholder="@Loc["SettlementSelectPriceList"]"
                                   AriaLabel="@Loc["SettlementSelectPriceList"]"
                                   Eyebrow="@Loc["SettlementSelectPriceList"]"
                                   Class="vpp-settlement-decision-card"
                                   TriggerClass="vpp-settlement-decision-trigger"
                                   Disabled="@(isPreviewLoading || PriceListOptions.Count == 0)" />
                <button type="button"
                        class="vpp-settlement-export-card"
                        disabled="@(!CanExportSettlement || exportingSettlementFormat.HasValue)"
                        aria-label="PDF"
                        title="@(CanExportSettlement ? "PDF" : Loc["RequestActionUnavailable"])"
                        @onclick="@(() => ExportSettlementAsync(VppFileExportFormat.Pdf))">
                    <VppIcon Name="@VppIcons.Pdf" />
                    <strong>PDF</strong>
                </button>
                <button type="button"
                        class="vpp-settlement-export-card"
                        disabled="@(!CanExportSettlement || exportingSettlementFormat.HasValue)"
                        aria-label="Excel"
                        title="@(CanExportSettlement ? "Excel" : Loc["RequestActionUnavailable"])"
                        @onclick="@(() => ExportSettlementAsync(VppFileExportFormat.Excel))">
                    <VppIcon Name="@VppIcons.Spreadsheet" />
                    <strong>Excel</strong>
                </button>
        </div>
    </section>

    @* PREVIEW: Cảnh báo và thao tác tải lại bản xem trước trước khi submit. *@
    @if (RequiresFreshPreview)
    {
        <div class="vpp-settlement-preview-refresh" role="status" aria-live="polite" data-testid="settlement-preview-refresh">
            <div class="vpp-settlement-preview-refresh-copy">
                <VppIcon Name="@VppIcons.Review" />
                <span>@Loc["CorrectionRerunPreviewWarning"]</span>
            </div>
            <RadzenButton Icon="@VppIcons.Review"
                          Text="@Loc["CorrectionRerunPreviewAction"]"
                          ButtonStyle="ButtonStyle.Light"
                          IsBusy="@isPreviewLoading"
                          Disabled="@isPreviewLoading"
                          Click="@RefreshPreviewAsync" />
        </div>
    }
    else if (HasPeriodBlockers)
    {
        <div class="vpp-settlement-blocker-bar" role="status" aria-live="polite">
            <VppIcon Name="@VppIcons.Warning" />
            <span>@FooterConditionText</span>
        </div>
    }

    @* DATA: Bảng dữ liệu snapshot theo kỳ, bộ lọc và phân trang phía client. *@
    @* TABLE: Snapshot đơn hàng theo kỳ, bộ lọc, dòng dữ liệu và phân trang. *@
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ClientSnapshotPaged"
                         Density="VppDataDensity.Compact"
                         IsBusy="@isGridLoading"
                         State="@SettlementSurfaceState"
                         AriaLabel="@Loc["PeriodSettlement"]"
                         TestId="period-settlement-data-surface"
                         Class="vpp-period-data-frame vpp-settlement-orders-frame">
        @* HEADER: Tiêu đề kỳ, tổng tiền và trạng thái dữ liệu. *@
        <Header>
            <VppCollectionHeader Title="@($"{Loc["Period"]} {Month:00}/{Year}")"
                                 Summary="@CurrentViewLabel">
                <Actions>
                    @if (status is not null)
                    {
                        <VppStatusBadge Text="@SettlementStatusText"
                                        Tone="@SettlementStatusTone"
                                        Title="@SettlementStatusTitle"
                                        Class="vpp-settlement-period-status" />
                    }
                    @if (!string.IsNullOrWhiteSpace(SettlementVersionText))
                    {
                        <VppCategoryChip Text="@SettlementVersionText"
                                         Tone="VppCategoryTone.Neutral" />
                    }
                    @if (status?.IsSettled == true)
                    {
                        <RadzenButton Text="@Loc["SettlementHistoryAction"]"
                                      Icon="history"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      IsBusy="@isLoadingSettlementHistory"
                                      Disabled="@isLoadingSettlementHistory"
                                      Click="@OpenSettlementHistoryDialogAsync" />
                    }
                    <RadzenButton Icon="lock"
                                  Text="@(status?.IsSettled == true ? Loc["SettlementResettleAction"] : Loc["SettlePeriod"])"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary"
                                  IsBusy="@isSettling"
                                  Disabled="@(!CanOpenSettlementPreview || isSettling)"
                                  Click="@OpenSettlementPreviewDialogAsync" />
                </Actions>
            </VppCollectionHeader>
        </Header>
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["PeriodSettlement"]" Class="vpp-period-data-toolbar vpp-settlement-data-toolbar">
                <div class="vpp-period-filters @CurrentFilterClass">
                    <VppFilterSearch Value="@searchText"
                                     Input="@OnSearchInputAsync"
                                     Placeholder="@CurrentSearchPlaceholder"
                                     AriaLabel="@CurrentSearchPlaceholder" />
                    @if (viewMode == ItemsView)
                    {
                        <VppFilterSelect TValue="string"
                                         Value="@selectedItemCategory"
                                         Options="@ItemCategoryOptions"
                                         ValueChanged="@OnItemCategoryChangedAsync"
                                         Placeholder="@Loc["AllCategories"]"
                                         AriaLabel="@Loc["Category"]" />
                        <VppFilterSelect TValue="string"
                                         Value="@selectedItemUom"
                                         Options="@ItemUomOptions"
                                         ValueChanged="@OnItemUomChangedAsync"
                                         Placeholder="@Loc["AllUnits"]"
                                         AriaLabel="@Loc["UOM"]" />
                    }
                    else
                    {
                        <VppFilterSelect TValue="string"
                                         Value="@selectedDepartment"
                                         Options="@DepartmentOptions"
                                         ValueChanged="@OnDepartmentChangedAsync"
                                         Placeholder="@Loc["SettlementAllDepartments"]"
                                         AriaLabel="@Loc["Department"]"
                                         Class="vpp-settlement-filter-department" />
                        <VppFilterSelect TValue="string"
                                         Value="@selectedOrderType"
                                         Options="@OrderTypeOptions"
                                         ValueChanged="@OnOrderTypeChangedAsync"
                                         Placeholder="@Loc["HistoryAllOrderTypes"]"
                                         AriaLabel="@Loc["HistoryOrderType"]"
                                         Class="vpp-settlement-filter-order-type" />
                        <VppFilterSelect TValue="int?"
                                         Value="@selectedStatus"
                                         Options="@StatusOptions"
                                         ValueChanged="@OnStatusChangedAsync"
                                         Placeholder="@Loc["HistoryAllStatuses"]"
                                         AriaLabel="@Loc["Status"]"
                                         Class="vpp-settlement-filter-status" />
                    }
                    <VppClearFiltersButton Text="@Loc["HistoryClearFilters"]"
                                           IsActive="@HasFilters"
                                           Clicked="@ClearFiltersAsync" />
                </div>
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            @if (isGridLoading)
            {
                <SkeletonPage Cards="0" Rows="14" Cols="9" FillAvailable="true" />
            }
            else if (!string.IsNullOrWhiteSpace(alertMessage))
            {
                <VppContentState State="VppContentStateKind.Error"
                                 FillAvailable="true"
                                 Icon="@VppIcons.Error"
                                 Title="@Loc["HistoryLoadFailed"]"
                                 Description="@alertMessage"
                                 PrimaryActionText="@Loc["Retry"]"
                                 PrimaryActionIcon="@VppIcons.Reset"
                                 PrimaryAction="@(_ => ReloadPeriodAsync())" />
            }
            else if (viewMode == ItemsView)
            {
                <div class="vpp-period-grid-wrap">
                        <RadzenDataGrid TItem="AggregatedVppItemResDTO"
                                        Data="@FilteredItemRows"
                                        AllowPaging="true"
                                        PageSize="@VppPagingProfiles.LargeWorkingSet.DefaultPageSize"
                                        PageSizeOptions="@VppPagingProfiles.LargeWorkingSet.PageSizeOptions"
                                        PagerAlwaysVisible="true"
                                        ShowPagingSummary="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowMultiColumnSorting="false"
                                        ShowMultiColumnSortingIndex="false"
                                        GotoFirstPageOnSort="true"
                                        AllowFiltering="false"
                                        AllowColumnResize="false"
                                        AllowAlternatingRows="false"
                                        IsLoading="@isGridLoading"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-order-grid vpp-data-grid vpp-data-density-compact vpp-settlement-order-grid">
                            <EmptyTemplate>
                                <VppDataGridEmptyState State="@(HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                                       Title="@(HasFilters ? Loc["NoCatalogProductsMatchQuery"] : Loc["NoData"])"
                                                       Description="@(HasFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
                            </EmptyTemplate>
                            <Columns>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(FilteredItemRows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.VppName)" Title="@Loc["ItemName"]" Width="260px">
                                    <Template Context="row"><div class="vpp-order-product-cell"><strong>@row.VppName</strong><small>@row.VppCode</small></div></Template>
                                    <FooterTemplate><strong class="vpp-settlement-summary-label" data-testid="settlement-summary-label">@SettlementSummaryLabel</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.CategoryName)" Title="@Loc["Category"]" Width="220px" />
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.UomName)" Title="@Loc["UOM"]" Width="110px" TextAlign="TextAlign.Center" />
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["OrderCount"]" Width="96px" TextAlign="TextAlign.Right" Sortable="false" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number">
                                    <Template Context="row">@row.Breakdown.Count</Template>
                                    <FooterTemplate><span class="vpp-settlement-summary-value">@itemTotals.OrderCount</span></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.TotalQty)" Title="@Loc["Quantity"]" Width="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number">
                                    <Template Context="row"><strong>@row.TotalQty</strong></Template>
                                    <FooterTemplate><span class="vpp-settlement-summary-value">@itemTotals.TotalQuantity</span></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["UnitPrice"]" Width="126px" TextAlign="TextAlign.Right" Sortable="false" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number">
                                    <Template Context="row">@FormatMoney(ItemNetUnitPrice(row))</Template>
                                    <FooterTemplate><span class="vpp-settlement-summary-na">–</span></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["SettlementVatRate"]" Width="76px" TextAlign="TextAlign.Right" Sortable="false" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number">
                                    <Template Context="row">@($"{ItemVatRate(row):0.##}%")</Template>
                                    <FooterTemplate><span class="vpp-settlement-summary-na">–</span></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["SettlementNetAmount"]" Width="122px" TextAlign="TextAlign.Right" Sortable="false" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number">
                                    <Template Context="row">@FormatMoney(ItemNetAmount(row))</Template>
                                    <FooterTemplate><span class="vpp-settlement-summary-value">@FormatMoney(itemTotals.NetAmount)</span></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["SettlementGrossAmount"]" Width="128px" TextAlign="TextAlign.Right" Sortable="false" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number">
                                    <Template Context="row"><strong class="vpp-settlement-money">@FormatMoney(ItemGrossAmount(row))</strong></Template>
                                    <FooterTemplate><strong class="vpp-settlement-summary-value">@FormatMoney(itemTotals.GrossAmount)</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["Actions"]" Width="76px" MinWidth="76px" TextAlign="TextAlign.Center" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                                    <Template Context="row"><RadzenButton Icon="@VppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenItemOrdersAsync(row))" title="@Loc["SettlementViewOrders"]" aria-label="@Loc["SettlementViewOrders"]" /></Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                </div>
            }
            else if (viewMode == RequestersView)
            {
                <div class="vpp-period-grid-wrap">
                        <RadzenDataGrid TItem="RequesterSettlementRow"
                                        Data="@FilteredRequesterRows"
                                        AllowPaging="true"
                                        PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                        PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                        PagerAlwaysVisible="true"
                                        ShowPagingSummary="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowMultiColumnSorting="false"
                                        ShowMultiColumnSortingIndex="false"
                                        GotoFirstPageOnSort="true"
                                        AllowFiltering="false"
                                        AllowColumnResize="false"
                                        AllowAlternatingRows="false"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-order-grid vpp-data-grid vpp-data-density-compact vpp-settlement-order-grid">
                            <EmptyTemplate>
                                <VppDataGridEmptyState State="@(HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                                       Title="@Loc["NoData"]"
                                                       Description="@(HasFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
                            </EmptyTemplate>
                            <Columns>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(FilteredRequesterRows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="RequesterName" Title="@Loc["User"]" MinWidth="180px">
                                    <Template Context="row"><strong>@row.RequesterName</strong></Template>
                                    <FooterTemplate><strong class="vpp-settlement-summary-label" data-testid="settlement-summary-label">@SettlementSummaryLabel</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="DepartmentSummary" Title="@Loc["Department"]" Width="180px" MinWidth="180px">
                                    <Template Context="row"><span title="@row.DepartmentSummary">@row.DepartmentSummary</span></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="OrderCount" Title="@OrderColumnTitle" Width="200px" MinWidth="200px" Sortable="false" CssClass="vpp-settlement-order-count-cell" HeaderCssClass="vpp-settlement-order-count-cell">
                                    <Template Context="row">
                                        <div class="vpp-settlement-order-count">
                                            @if (string.IsNullOrWhiteSpace(selectedOrderType))
                                            {
                                                <VppCategoryChip Text="@OrderCountLabel(Loc["Regular"], row.RegularOrderCount)" Tone="VppCategoryTone.Neutral" />
                                                <VppCategoryChip Text="@OrderCountLabel(Loc["AdditionalOrder"], row.AdditionalOrderCount)" Tone="VppCategoryTone.Accent" />
                                            }
                                            else
                                            {
                                                <VppCategoryChip Text="@OrderCountLabel(SelectedOrderTypeLabel, row.OrderCount)" Tone="@SelectedOrderTypeTone" />
                                            }
                                        </div>
                                    </Template>
                                    <FooterTemplate>
                                        <div class="vpp-settlement-order-count is-summary">
                                            @if (string.IsNullOrWhiteSpace(selectedOrderType))
                                            {
                                                <VppCategoryChip Text="@OrderCountLabel(Loc["Regular"], requesterTotals.RegularOrderCount)" Tone="VppCategoryTone.Neutral" />
                                                <VppCategoryChip Text="@OrderCountLabel(Loc["AdditionalOrder"], requesterTotals.AdditionalOrderCount)" Tone="VppCategoryTone.Accent" />
                                            }
                                            else
                                            {
                                                <VppCategoryChip Text="@OrderCountLabel(SelectedOrderTypeLabel, requesterTotals.OrderCount)" Tone="@SelectedOrderTypeTone" />
                                            }
                                        </div>
                                    </FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Title="@StatusColumnTitle" Width="180px" MinWidth="180px" TextAlign="TextAlign.Center" Sortable="false" CssClass="vpp-settlement-status-cell" HeaderCssClass="vpp-settlement-status-cell">
                                    <Template Context="row">
                                        <div class="vpp-settlement-status-count">
                                            @foreach (var item in row.StatusCounts)
                                            {
                                                <VppStatusBadge Text="@StatusCountLabel(item)" Tone="@StatusCountTone(item)" />
                                            }
                                        </div>
                                    </Template>
                                    <FooterTemplate>
                                        <div class="vpp-settlement-status-count is-summary">
                                            @if (selectedStatus.HasValue)
                                            {
                                                <VppStatusBadge Text="@($"{SelectedStatusLabel}: {requesterTotals.OrderCount}")" Tone="@SelectedStatusTone" />
                                            }
                                            else
                                            {
                                                @foreach (var item in requesterStatusTotals)
                                                {
                                                    <VppStatusBadge Text="@StatusCountLabel(item)" Tone="@StatusCountTone(item)" />
                                                }
                                            }
                                        </div>
                                    </FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="TotalLines" Title="@Loc["DemandLines"]" Width="96px" MinWidth="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><FooterTemplate><span class="vpp-settlement-summary-value">@requesterTotals.TotalLines</span></FooterTemplate></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="TotalQuantity" Title="@Loc["Quantity"]" Width="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><FooterTemplate><span class="vpp-settlement-summary-value">@requesterTotals.TotalQuantity</span></FooterTemplate></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="NetAmount" Title="@Loc["SettlementNetAmount"]" Width="122px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><Template Context="row">@FormatMoney(row.NetAmount)</Template><FooterTemplate><span class="vpp-settlement-summary-value">@FormatMoney(requesterTotals.NetAmount)</span></FooterTemplate></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="VatAmount" Title="@Loc["SettlementVatAmount"]" Width="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><Template Context="row">@FormatMoney(row.VatAmount)</Template><FooterTemplate><span class="vpp-settlement-summary-value">@FormatMoney(requesterTotals.VatAmount)</span></FooterTemplate></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Property="GrossAmount" Title="@Loc["SettlementGrossAmount"]" Width="128px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><Template Context="row"><strong class="vpp-settlement-money">@FormatMoney(row.GrossAmount)</strong></Template><FooterTemplate><strong class="vpp-settlement-summary-value">@FormatMoney(requesterTotals.GrossAmount)</strong></FooterTemplate></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RequesterSettlementRow" Title="@Loc["Actions"]" Width="76px" MinWidth="76px" TextAlign="TextAlign.Center" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                                    <Template Context="row"><RadzenButton Icon="@VppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenRequesterOrdersAsync(row))" title="@Loc["SettlementViewOrders"]" aria-label="@Loc["SettlementViewOrders"]" /></Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                </div>
            }
            else
            {
                <div class="vpp-period-grid-wrap">
                    <RadzenDataGrid TItem="DepartmentSettlementRow"
                                    Data="@FilteredDepartmentRows"
                                    AllowPaging="true"
                                    PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                    PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                    PagerAlwaysVisible="true"
                                    ShowPagingSummary="true"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    AllowSorting="true"
                                    AllowMultiColumnSorting="false"
                                    ShowMultiColumnSortingIndex="false"
                                    GotoFirstPageOnSort="true"
                                    AllowFiltering="false"
                                    AllowColumnResize="false"
                                    AllowAlternatingRows="false"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Horizontal"
                                    class="vpp-order-grid vpp-data-grid vpp-data-density-compact vpp-settlement-order-grid">
                        <EmptyTemplate>
                            <VppDataGridEmptyState State="@(HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                                   Title="@Loc["NoData"]"
                                                   Description="@(HasFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
                        </EmptyTemplate>
                        <Columns>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(FilteredDepartmentRows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="DepartmentName" Title="@Loc["Department"]" MinWidth="190px">
                                <Template Context="row"><div class="vpp-order-product-cell"><strong>@row.DepartmentName</strong><small title="@row.DepartmentCode">@row.DepartmentCode</small></div></Template>
                                <FooterTemplate><strong class="vpp-settlement-summary-label" data-testid="settlement-summary-label">@SettlementSummaryLabel</strong></FooterTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="OrderCount" Title="@OrderColumnTitle" Width="200px" MinWidth="200px" Sortable="false" CssClass="vpp-settlement-order-count-cell" HeaderCssClass="vpp-settlement-order-count-cell">
                                <Template Context="row">
                                    <div class="vpp-settlement-order-count">
                                        @if (string.IsNullOrWhiteSpace(selectedOrderType))
                                        {
                                            <VppCategoryChip Text="@OrderCountLabel(Loc["Regular"], row.RegularOrderCount)" Tone="VppCategoryTone.Neutral" />
                                            <VppCategoryChip Text="@OrderCountLabel(Loc["AdditionalOrder"], row.AdditionalOrderCount)" Tone="VppCategoryTone.Accent" />
                                        }
                                        else
                                        {
                                            <VppCategoryChip Text="@OrderCountLabel(SelectedOrderTypeLabel, row.OrderCount)" Tone="@SelectedOrderTypeTone" />
                                        }
                                    </div>
                                </Template>
                                <FooterTemplate>
                                    <div class="vpp-settlement-order-count is-summary">
                                        @if (string.IsNullOrWhiteSpace(selectedOrderType))
                                        {
                                            <VppCategoryChip Text="@OrderCountLabel(Loc["Regular"], departmentTotals.RegularOrderCount)" Tone="VppCategoryTone.Neutral" />
                                            <VppCategoryChip Text="@OrderCountLabel(Loc["AdditionalOrder"], departmentTotals.AdditionalOrderCount)" Tone="VppCategoryTone.Accent" />
                                        }
                                        else
                                        {
                                            <VppCategoryChip Text="@OrderCountLabel(SelectedOrderTypeLabel, departmentTotals.OrderCount)" Tone="@SelectedOrderTypeTone" />
                                        }
                                    </div>
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="StatusText" Title="@StatusColumnTitle" Width="180px" MinWidth="180px" TextAlign="TextAlign.Center" Sortable="false" CssClass="vpp-settlement-status-cell" HeaderCssClass="vpp-settlement-status-cell">
                                <Template Context="row">
                                    <div class="vpp-settlement-status-count">
                                        @foreach (var item in row.StatusCounts)
                                        {
                                            <VppStatusBadge Text="@StatusCountLabel(item)" Tone="@StatusCountTone(item)" />
                                        }
                                    </div>
                                </Template>
                                <FooterTemplate>
                                    <div class="vpp-settlement-status-count is-summary">
                                        @if (selectedStatus.HasValue)
                                        {
                                            <VppStatusBadge Text="@($"{SelectedStatusLabel}: {departmentTotals.OrderCount}")" Tone="@SelectedStatusTone" />
                                        }
                                        else
                                        {
                                            @foreach (var item in departmentStatusTotals)
                                            {
                                                <VppStatusBadge Text="@StatusCountLabel(item)" Tone="@StatusCountTone(item)" />
                                            }
                                        }
                                    </div>
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="TopItemName" Title="@Loc["SettlementTopItem"]" Width="180px" MinWidth="180px">
                                <Template Context="row"><div class="vpp-order-product-cell"><strong title="@row.TopItemName">@row.TopItemName</strong><small>@(row.TopItemQuantity > 0 ? Loc["SettlementTopItemQuantity", row.TopItemQuantity] : "–")</small></div></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="TotalLines" Title="@Loc["DemandLines"]" Width="96px" MinWidth="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><FooterTemplate><span class="vpp-settlement-summary-value">@departmentTotals.TotalLines</span></FooterTemplate></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="TotalQuantity" Title="@Loc["Quantity"]" Width="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><FooterTemplate><span class="vpp-settlement-summary-value">@departmentTotals.TotalQuantity</span></FooterTemplate></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="NetAmount" Title="@Loc["SettlementNetAmount"]" Width="122px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><Template Context="row">@FormatMoney(row.NetAmount)</Template><FooterTemplate><span class="vpp-settlement-summary-value">@FormatMoney(departmentTotals.NetAmount)</span></FooterTemplate></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="VatAmount" Title="@Loc["SettlementVatAmount"]" Width="96px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><Template Context="row">@FormatMoney(row.VatAmount)</Template><FooterTemplate><span class="vpp-settlement-summary-value">@FormatMoney(departmentTotals.VatAmount)</span></FooterTemplate></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Property="GrossAmount" Title="@Loc["SettlementGrossAmount"]" Width="128px" TextAlign="TextAlign.Right" CssClass="vpp-settlement-number" HeaderCssClass="vpp-settlement-number"><Template Context="row"><strong class="vpp-settlement-money">@FormatMoney(row.GrossAmount)</strong></Template><FooterTemplate><strong class="vpp-settlement-summary-value">@FormatMoney(departmentTotals.GrossAmount)</strong></FooterTemplate></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="DepartmentSettlementRow" Title="@Loc["Actions"]" Width="76px" MinWidth="76px" TextAlign="TextAlign.Center" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                                <Template Context="row"><RadzenButton Icon="@VppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => OpenDepartmentOrdersAsync(row))" title="@Loc["SettlementViewOrders"]" aria-label="@Loc["SettlementViewOrders"]" /></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            }
        </ChildContent>
    </VppDataSurfaceFrame>

    @if (pendingPostSettlementCorrections.Count > 0)
    {
        @* Route-local workflow exception: panel này chưa phát hành khi không có yêu cầu hiệu chỉnh. *@
        <VppDataSurfaceFrame AriaLabel="@Loc["PendingAdjustments"]"
                             TestId="post-settlement-corrections"
                             DataSourceMode="VppDataSourceMode.Static"
                             Density="VppDataDensity.Compact"
                             State="VppDataSurfaceState.Populated">
            <Header>
                <VppCollectionHeader Title="@Loc["PendingAdjustments"]"
                                     Summary="@(string.Format(Loc["PendingAdjustmentCount"], pendingPostSettlementCorrections.Count))" />
            </Header>
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["ReviewAdjustmentRequests"]">
                    <label class="vpp-settlement-correction-reason">
                        <span>@Loc["DecisionReasonWhenRejecting"]</span>
                        <RadzenTextBox @bind-Value="postSettlementDecisionReason"
                                       MaxLength="500"
                                       aria-label="@Loc["DecisionReasonWhenRejecting"]" />
                    </label>
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
                <RadzenDataGrid TItem="PostSettlementOrderCorrectionResDTO"
                                Data="@pendingPostSettlementCorrections"
                                AllowPaging="false"
                                AllowSorting="false"
                                AllowFiltering="false"
                                Density="Density.Compact"
                                class="vpp-admin-grid vpp-data-grid vpp-data-density-compact vpp-settlement-correction-grid">
                    <EmptyTemplate>
                        <VppDataGridEmptyState Icon="fact_check"
                                               Title="@Loc["AllClear"]" />
                    </EmptyTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="PostSettlementOrderCorrectionResDTO" Title="@Loc["Order"]" Width="220px">
                            <Template Context="correction"><strong>@correction.RequestCode</strong></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PostSettlementOrderCorrectionResDTO" Title="@Loc["Change"]" Width="150px">
                            <Template Context="correction">@PostSettlementCorrectionActionText(correction.Action)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PostSettlementOrderCorrectionResDTO" Property="EmployeeNote" Title="@Loc["EmployeeMessage"]" />
                        <RadzenDataGridColumn TItem="PostSettlementOrderCorrectionResDTO" Property="RequestedByUserId" Title="@Loc["RequestedBy"]" Width="140px" />
                        <RadzenDataGridColumn TItem="PostSettlementOrderCorrectionResDTO"
                                              Title="@Loc["Decision"]"
                                              Width="190px"
                                              TextAlign="TextAlign.Center"
                                              Frozen="true"
                                              FrozenPosition="FrozenColumnPosition.Right"
                                              Sortable="false"
                                              Filterable="false">
                            <Template Context="correction">
                                <div class="vpp-admin-actions">
                                    <VppAdminIconAction Icon="@VppIcons.Approved"
                                                        Text="@Loc["Approve"]"
                                                        Title="@Loc["Approve"]"
                                                        ButtonStyle="ButtonStyle.Success"
                                                        Disabled="@isLoading"
                                                        Click="@(_ => ConfirmPostSettlementCorrectionAsync(correction))" />
                                    <VppAdminIconAction Icon="@VppIcons.Rejected"
                                                        Text="@Loc["Reject"]"
                                                        Title="@Loc["Reject"]"
                                                        ButtonStyle="ButtonStyle.Danger"
                                                        Variant="Variant.Outlined"
                                                        Disabled="@isLoading"
                                                        Click="@(_ => RejectPostSettlementCorrectionAsync(correction))" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </VppDataSurfaceFrame>
    }

    <HistoryOrderDetailSheet @ref="orderDetailSheet"
                             IsOpen="@isOrderDetailOpen"
                             SelectedOrder="@selectedOrderDetail"
                             SelectedOrderId="@SelectedOrderDetailId"
                             OrderOptions="@OrderDetailOptions"
                             OrderPickerLabel="@Loc["SettlementOrderPicker"]"
                              OrderPickerDisabled="@isOrderDetailLoading"
                              OrderSelectionChanged="@LoadOrderDetailAsync"
                              SelectedOrderAmount="@SelectedOrderFinancialAmount"
                              IsAggregateView="@isAggregateOrderDetail"
                              AggregateOrderCount="@orderDetailScope.Count"
                              ShowExportActions="@(!isAggregateOrderDetail)"
                              Class="vpp-settlement-detail-drawer"
                              SelectedSupplierName="@SelectedSupplierName"
                             IsDetailLoading="@isOrderDetailLoading"
                             HasDetailError="@hasOrderDetailError"
                             DetailRows="@orderDetailRows"
                             DetailCategories="@orderDetailCategories"
                             DetailUoms="@orderDetailUnits"
                             DetailSearch="@orderDetailSearch"
                             DetailCategory="@orderDetailCategory"
                             DetailUom="@orderDetailUnit"
                             ActiveDetailCodeNumber="@activeOrderDetailCodeNumber"
                             ActiveDetailNoteNumber="@activeOrderDetailNoteNumber"
                             HasDetailFilters="@HasOrderDetailFilters"
                             TotalCount="@orderDetailScope.Count"
                             UnitHeaderLabel="@OrderDetailUnitHeaderLabel"
                             BusyExportFormat="@exportingOrderFormat"
                              ShowPostSettlementCorrection="@CanRequestPostSettlementCorrection"
                              PostSettlementCorrectionText="@OrderAdjustmentActionText"
                             CloseRequested="@CloseOrderDetail"
                             ExportRequested="@ExportSelectedOrderDetailAsync"
                             PostSettlementCorrectionRequested="@OpenPostSettlementCorrection"
                             RetryRequested="@RetryOrderDetailAsync"
                             DetailSearchChanged="@OnOrderDetailSearchChangedAsync"
                             DetailCategorySelected="@OnOrderDetailCategoryChangedAsync"
                             DetailUomSelected="@OnOrderDetailUnitChangedAsync"
                             DetailFiltersCleared="@ClearOrderDetailFiltersAsync"
                             DetailCodeToggled="@ToggleOrderDetailCode"
                             DetailNoteToggled="@ToggleOrderDetailNote" />

        </HistoryWorkspaceShell>
    </div>
</VppOperationWorkspace>
