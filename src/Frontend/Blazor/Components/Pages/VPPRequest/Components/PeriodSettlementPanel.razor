<div class="vpp-period-panel">
    <section class="vpp-period-settle-status @StatusCardClass" aria-labelledby="period-settle-status-title">
        <div>
            <span>@Loc["PeriodStatus"] · @Month.ToString("00")/@Year</span>
            <h2 id="period-settle-status-title">@StatusTitle</h2>
            <p>@StatusDescription</p>
        </div>
        <VppIcon Name="@(status?.IsSettled == true ? VppIcons.Lock : CanConfirm ? VppIcons.Check : VppIcons.Warning)" />
    </section>

    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.Static"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["PeriodSettlement"]"
                         TestId="period-settlement-data-surface"
                         Class="vpp-period-data-frame">
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["PeriodSettlement"]" Class="vpp-period-data-toolbar">
                <div class="vpp-period-data-heading">
                    <h2>@Loc["PeriodSettleStep"]</h2>
                    <span>@(Preview is null ? Loc["SettleRunPreviewHint"] : $"{Preview.PrimaryQuote?.SupplierName} · {Preview.PrimaryQuote?.PriceListCode} v{Preview.PrimaryQuote?.Version}")</span>
                </div>
                @if (Preview is not null)
                {
                    <code class="vpp-settle-input-hash" title="@Loc["SettleInputHashTitle"]">@ShortInputHash</code>
                }
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            @if (isLoading)
            {
                <SkeletonPage Cards="2" Rows="6" Cols="5" />
            }
            else if (status?.PendingAdditionalCount > 0)
            {
                <VppContentState State="VppContentStateKind.Warning"
                                 Icon="@VppIcons.Warning"
                                 Title="@Loc["ReviewHeroBlocked"]"
                                 Description="@string.Format(Loc["Warning_PendingAdditional"].Value, status.PendingAdditionalCount)" />
            }
            else if (Preview is null)
            {
                <VppContentState State="VppContentStateKind.Empty"
                                 Icon="@VppIcons.Supplier"
                                 Title="@Loc["SupplyRunPreview"]"
                                 Description="@Loc["SupplySelectionOrderHint"]" />
            }
            else
            {
                <div class="vpp-settlement-preview-kpis">
                    <article><span>@Loc["SettleRequestedItems"]</span><strong>@Preview.RequestedItemCount</strong></article>
                    <article><span>@Loc["SettleRequestedLines"]</span><strong>@Preview.RequestedLineCount</strong></article>
                    <article><span>@Loc["SupplyCoverageLabel"]</span><strong>@(Preview.PrimaryQuote is null ? "—" : $"{Preview.PrimaryQuote.CoveredItemCount}/{Preview.PrimaryQuote.RequestedItemCount}")</strong></article>
                    <article><span>@Loc["SettleQuoteTotal"]</span><strong>@FormatMoney(Preview.PrimaryQuote?.GrandTotal ?? 0)</strong></article>
                </div>

                @if (Preview.Blockers.Count > 0)
                {
                    <div class="vpp-settlement-blockers">
                        <h3><VppIcon Name="@VppIcons.Warning" /> @Loc["SettleBlockersHeading"]</h3>
                        <ul>@foreach (var blocker in Preview.Blockers) { <li>@PeriodSettlementSupport.DescribeBlocker(blocker)</li> }</ul>
                    </div>
                }
                else
                {
                    <div class="vpp-settle-readiness-board">
                        <span><VppIcon Name="@VppIcons.Check" /> @string.Format(Loc["SettleReadinessOrders"].Value, Preview.RequestedItemCount, Preview.RequestedLineCount)</span>
                        <span><VppIcon Name="@VppIcons.Check" /> @Loc["SettleReadinessCoverage"]</span>
                        <span><VppIcon Name="@VppIcons.Lock" /> @Loc["SettleImmutableNote"]</span>
                    </div>
                }

                <h3 class="vpp-period-section-title">@Loc["SettleQuotesHeading"]</h3>
                <div class="vpp-period-grid-wrap">
                    <RadzenDataGrid TItem="gtas_vpp_shared.DTOs.Res.Library.PriceBookQuoteResDTO"
                                    Data="@Preview.Quotes.OrderBy(quote => quote.Rank)"
                                    AllowPaging="false"
                                    AllowFiltering="false"
                                    AllowSorting="false"
                                    AllowColumnResize="false"
                                    AllowAlternatingRows="false"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Horizontal"
                                    class="vpp-order-grid vpp-data-grid vpp-data-density-compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.Library.PriceBookQuoteResDTO" Property="Rank" Title="@Loc["SettleQuoteRank"]" Width="80px" TextAlign="TextAlign.Center"><Template Context="quote">#@quote.Rank</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.Library.PriceBookQuoteResDTO" Property="SupplierName" Title="@Loc["SettleQuoteSupplier"]"><Template Context="quote"><div class="vpp-order-product-cell"><strong>@quote.SupplierName</strong><small>@quote.PriceListCode · v@quote.Version</small></div></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.Library.PriceBookQuoteResDTO" Title="@Loc["SettleQuoteCoverage"]" Width="170px" TextAlign="TextAlign.Center"><Template Context="quote">@quote.CoveredItemCount/@quote.RequestedItemCount (@quote.CoveragePercent.ToString("N0")%)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.Library.PriceBookQuoteResDTO" Property="GrandTotal" Title="@Loc["SettleQuoteTotal"]" Width="180px" TextAlign="TextAlign.Right"><Template Context="quote"><strong>@FormatMoney(quote.GrandTotal)</strong></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="gtas_vpp_shared.DTOs.Res.Library.PriceBookQuoteResDTO" Property="MaximumLeadTimeDays" Title="@Loc["SettleQuoteLeadTime"]" Width="150px" TextAlign="TextAlign.Center"><Template Context="quote">@string.Format(Loc["SettleQuoteLeadTimeDays"].Value, quote.MaximumLeadTimeDays)</Template></RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>

                @if (canCorrect)
                {
                    <div class="vpp-settle-correction">
                        <label for="period-correction-reason">@Loc["CorrectionReasonLabel"]</label>
                        <RadzenTextArea id="period-correction-reason" @bind-Value="correctionReason" Rows="3" MaxLength="500" Placeholder="@Loc["CorrectionReasonPlaceholder"]" />
                        <span>@Loc["CorrectionFourEyesHint"]</span>
                    </div>
                }
            }
        </ChildContent>
        <Footer>
            <div class="vpp-period-action-footer">
                <RadzenButton Icon="arrow_back" Text="@Loc["PeriodSupplyStep"]" ButtonStyle="ButtonStyle.Light" Click="@OnBackToSupply" />
                <div class="vpp-settle-footer-actions">
                    @if (canCorrect)
                    {
                        <RadzenButton Icon="edit_note" Text="@Loc["CreateCorrectionRevision"]" ButtonStyle="ButtonStyle.Warning" Disabled="@(!CanConfirm || isCorrecting)" Click="@CorrectAsync" />
                    }
                    else
                    {
                        <RadzenButton Icon="lock" Text="@Loc["SettlePeriod"]" ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanConfirm || isSettling)" Click="@SettleAsync" />
                    }
                </div>
            </div>
        </Footer>
    </VppDataSurfaceFrame>
</div>
