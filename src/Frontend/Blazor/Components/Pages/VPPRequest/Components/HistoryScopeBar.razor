@* Atlas history scope bar: thanh chọn phạm vi kỳ (preset + popover khoảng tùy chọn) — state do Tab_History giữ. *@
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryUiKeys

<div class="vpp-history-toolbar">
    <div class="vpp-history-scope-host" @onclick:stopPropagation>
        <VppSegmentedSelector TValue="string"
                              Value="@Scope"
                              Options="@ScopeOptions"
                              ValueChanged="@SelectScopeAsync"
                              AriaLabel="@Loc["HistoryTimeRange"]"
                              Class="vpp-history-scope-selector" />
        @if (ShowCustomRange)
        {
            <div class="vpp-history-range-popover vpp-transient-surface" role="dialog" aria-label="@Loc["HistoryCustomRange"]" @onclick:stopPropagation>
                <label><span>@Loc["HistoryFromPeriod"]</span><input type="month" value="@CustomFrom" @onchange="CustomFromChanged" /></label>
                <label><span>@Loc["HistoryToPeriod"]</span><input type="month" value="@CustomTo" @onchange="CustomToChanged" /></label>
                <button type="button" class="vpp-history-range-apply" @onclick="CustomRangeApplied">@Loc["ApplyFilters"]</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Scope { get; set; } = string.Empty;
    [Parameter] public bool ShowCustomRange { get; set; }
    [Parameter] public string CustomFrom { get; set; } = string.Empty;
    [Parameter] public string CustomTo { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PresetScopeSelected { get; set; }
    [Parameter] public EventCallback CustomScopeRequested { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> CustomFromChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> CustomToChanged { get; set; }
    [Parameter] public EventCallback CustomRangeApplied { get; set; }

    private IReadOnlyList<VppSegmentedOption<string>> ScopeOptions =>
    [
        new(AllScope, Loc["HistoryAllPeriods"]),
        new(Last1Scope, Loc["HistoryCurrentPeriod"]),
        new(Last3Scope, Loc["HistoryLast3Periods"]),
        new(Last6Scope, Loc["HistoryLast6Periods"]),
        new(Last12Scope, Loc["HistoryLast12Periods"]),
        new(CustomScope, Loc["HistoryCustom"], VppIcons.Calendar, IsExpanded: ShowCustomRange)
    ];

    private Task SelectScopeAsync(string scope)
        => scope == CustomScope
            ? CustomScopeRequested.InvokeAsync()
            : PresetScopeSelected.InvokeAsync(scope);
}
