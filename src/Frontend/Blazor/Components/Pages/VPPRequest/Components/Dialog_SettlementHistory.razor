@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.VPP
@inject DialogService DialogService

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Standard" TestId="settlement-version-history-dialog">
    <Intro>
        <p class="vpp-settlement-history-intro">@Loc["SavedSettlementVersionsHint"]</p>
    </Intro>
    <ChildContent>
        <div class="vpp-settlement-history-list">
            @foreach (var version in Versions.OrderByDescending(item => item.RevisionNumber))
            {
                <article class="vpp-settlement-history-item @(version.IsCurrentRevision ? "is-current" : null)">
                    <div class="vpp-settlement-history-heading">
                        <div>
                            <strong>@string.Format(Loc["SettlementVersionLabel"], version.RevisionNumber)</strong>
                            <span>@DateFormatter.Format(version.ConfirmedAtUtc, DateFormatter.LongDate)</span>
                        </div>
                        @if (version.IsCurrentRevision)
                        {
                            <VppCategoryChip Text="@Loc["CurrentlyUsed"]" Tone="VppCategoryTone.Accent" />
                        }
                    </div>
                    <dl>
                        <div><dt>@Loc["Supplier"]</dt><dd>@version.PrimarySupplierName</dd></div>
                        <div><dt>@Loc["PriceList"]</dt><dd>@version.PriceListName</dd></div>
                        <div><dt>@Loc["TotalValue"]</dt><dd>@version.GrandTotal.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(version.CorrectionReason))
                    {
                        <p><span>@Loc["ChangeReason"]</span>@version.CorrectionReason</p>
                    }
                </article>
            }
        </div>
    </ChildContent>
    <Footer>
        <VppDialogActions CancelText="@Loc["Close"]"
                          ShowPrimary="false"
                          CancelClick="@CloseAsync" />
    </Footer>
</VppAdaptiveDialogShell>

@code {
    [Parameter] public IReadOnlyList<SettlementRevisionResDTO> Versions { get; set; } = [];

    private Task CloseAsync() => DialogService.TryCloseAsync(null);
}
