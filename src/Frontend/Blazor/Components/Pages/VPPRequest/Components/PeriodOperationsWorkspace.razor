@using System.Security.Claims
@using gtas_vpp_fe.Features.Requests.Api
@using gtas_vpp_fe.Features.Settlement.State
@using gtas_vpp_shared.DTOs.Res.VPP
@inject RequestsQueryClient Requests
@inject PeriodSettlementState State

@if (isLoadingPeriod)
{
    <SkeletonPage Cards="0" Rows="8" Cols="8" />
}
else
{
    <PeriodSettlementPanel Year="@State.Year"
                           Month="@State.Month"
                           CurrentPeriodYear="@currentPeriodYear"
                           CurrentPeriodMonth="@currentPeriodMonth"
                           PreviousPeriodYear="@previousPeriodYear"
                           PreviousPeriodMonth="@previousPeriodMonth"
                           PeriodChanged="@ChangePeriodAsync"
                           OnSettled="@Settled" />
}

@code {
    [Parameter] public IEnumerable<Claim>? Claims { get; set; }
    [Parameter] public string ActiveStep { get; set; } = "review";
    [Parameter] public EventCallback<string> NavigateRequested { get; set; }
    [Parameter] public EventCallback Settled { get; set; }

    private bool isLoadingPeriod = true;
    private int currentPeriodYear;
    private int currentPeriodMonth;
    private int previousPeriodYear;
    private int previousPeriodMonth;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var period = await Requests.GetPeriodInfoAsync();
            if (period is not null)
            {
                currentPeriodYear = period.CurrentPeriodYear;
                currentPeriodMonth = period.CurrentPeriodMonth;
                previousPeriodYear = period.PreviousPeriodYear;
                previousPeriodMonth = period.PreviousPeriodMonth;

                // Chốt kỳ mở ở kỳ trước, nhưng nhãn "Kỳ này" luôn trỏ tới kỳ đặt hàng hiện tại.
                State.SetPeriod(previousPeriodYear, previousPeriodMonth);
            }
        }
        finally
        {
            isLoadingPeriod = false;
        }
    }

    private Task ChangePeriodAsync(PeriodTargetSelection target)
    {
        State.SetPeriod(target.Year, target.Month);
        return InvokeAsync(StateHasChanged);
    }
}
