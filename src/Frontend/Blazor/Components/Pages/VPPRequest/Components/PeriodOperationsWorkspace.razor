@using System.Security.Claims
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Res.VPP
@inject IAPIServices ApiServices
@inject PeriodSettlementState State

@if (isLoadingPeriod)
{
    <SkeletonPage Cards="0" Rows="8" Cols="8" />
}
else
{
    <PeriodSettlementPanel Year="@State.Year"
                           Month="@State.Month"
                           DefaultYear="@defaultYear"
                           DefaultMonth="@defaultMonth"
                           PeriodChanged="@ChangePeriodAsync"
                           OnSettled="@Settled" />
}

@code {
    [Parameter] public IEnumerable<Claim>? Claims { get; set; }
    [Parameter] public string ActiveStep { get; set; } = "review";
    [Parameter] public EventCallback<string> NavigateRequested { get; set; }
    [Parameter] public EventCallback Settled { get; set; }

    private bool isLoadingPeriod = true;
    private int defaultYear;
    private int defaultMonth;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var period = await ApiServices.GetFromApiAsync<VppPeriodInfoResDTO>(Config.VppApi.PeriodInfo);
            if (period is not null)
            {
                defaultYear = period.PreviousPeriodYear;
                defaultMonth = period.PreviousPeriodMonth;
                if (!State.HasPeriod)
                {
                    State.SetPeriod(defaultYear, defaultMonth);
                }
            }
        }
        finally
        {
            isLoadingPeriod = false;
        }
    }

    private Task ChangePeriodAsync(PeriodTargetSelection target)
    {
        State.SetPeriod(target.Year, target.Month);
        return InvokeAsync(StateHasChanged);
    }
}
