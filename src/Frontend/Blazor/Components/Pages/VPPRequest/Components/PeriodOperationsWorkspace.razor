@using System.Security.Claims

<VppOperationWorkspace Gap="VppWorkspaceGap.Compact"
                       Class="vpp-period-workspace">
    <Steps>
        <VppWorkflowStepper Steps="@PeriodWorkflowSteps"
                            AriaLabel="@Loc["PeriodFlowAria"]"
                            StepSelected="@OnPeriodStepSelected" />
    </Steps>

    <ChildContent>
    @if (ShowDemand)
    {
        <PeriodDemandPanel Claims="@Claims" />
    }
    else if (ShowSupply)
    {
        <PeriodSupplyAllocationPanel OnContinueToSettle="@(() => NavigateRequested.InvokeAsync("review"))" />
    }
    else
    {
        <section class="vpp-period-stage" aria-labelledby="period-review-title">
            <div class="vpp-period-stage-heading">
                <div><span>@Loc["PeriodStageStep1"]</span><h2 id="period-review-title">@Loc["PeriodStageReviewTitle"]</h2></div>
                <p>@Loc["PeriodStageReviewHint"]</p>
            </div>
            <PeriodReviewPanel OnSettled="@Settled" />
        </section>

        <section class="vpp-period-stage" aria-labelledby="period-settlement-title">
            <div class="vpp-period-stage-heading">
                <div><span>@Loc["PeriodStageStep4"]</span><h2 id="period-settlement-title">@Loc["PeriodStageSettleTitle"]</h2></div>
                <p>@Loc["PeriodStageSettleHint"]</p>
            </div>
            <PeriodSettlementPanel OnSettled="@Settled" />
        </section>
    }
    </ChildContent>
</VppOperationWorkspace>

@code {
    [Parameter] public IEnumerable<Claim>? Claims { get; set; }
    [Parameter] public bool ShowReview { get; set; }
    [Parameter] public bool ShowDemand { get; set; }
    [Parameter] public bool ShowSupply { get; set; }
    [Parameter] public EventCallback<string> NavigateRequested { get; set; }
    [Parameter] public EventCallback Settled { get; set; }

    private int CurrentStepNumber => ShowSupply ? 3 : ShowDemand ? 2 : 1;

    private IReadOnlyList<VppWorkflowStep> PeriodWorkflowSteps =>
    [
        CreateStep("review", 1, Loc["PeriodReview"]),
        CreateStep("demand", 2, Loc["PeriodDemandStep"]),
        CreateStep("supply", 3, Loc["PeriodSupplyStep"]),
        CreateStep("settle", 4, Loc["PeriodSettleStep"])
    ];

    private VppWorkflowStep CreateStep(string key, int number, string label)
        => new(key, number, label, number < CurrentStepNumber
            ? VppWorkflowStepState.Complete
            : number == CurrentStepNumber
                ? VppWorkflowStepState.Active
                : VppWorkflowStepState.Pending);

    private Task OnPeriodStepSelected(string stepKey)
        => NavigateRequested.InvokeAsync(string.Equals(stepKey, "settle", StringComparison.Ordinal) ? "review" : stepKey);
}
