@using gtas_vpp_shared.DTOs.Res.Library

<div class="vpp-period-panel">
    @if (State.Preview is not null)
    {
        var preview = State.Preview;
        var primary = preview.PrimaryQuote;
        <section class="vpp-supply-coverage-card @(primary is null ? "is-blocked" : primary.MissingVppIds.Count > 0 ? "is-partial" : "is-full")">
            <div class="vpp-supply-coverage-main">
                <span class="vpp-supply-coverage-label">@Loc["SupplyCoverageLabel"]</span>
                <strong>@(primary is null ? "—" : $"{primary.CoveredItemCount}/{primary.RequestedItemCount}")</strong>
                <span class="vpp-supply-coverage-meta">@(primary is null ? Loc["SupplyCoverageNoPrimary"] : primary.MissingVppIds.Count > 0 ? string.Format(Loc["SupplyCoverageMissingFormat"].Value, primary.MissingVppIds.Count) : Loc["SupplyCoverageFull"])</span>
            </div>
            @if (primary is not null)
            {
                <div class="vpp-supply-coverage-side">
                    <div><span>@Loc["SupplyPrimarySupplier"]</span><strong>@primary.SupplierName</strong></div>
                    <div><span>@Loc["SupplyEffectivePriceList"]</span><strong>@EffectivePriceListLabel</strong></div>
                    <div><span>@Loc["SettleQuoteTotal"]</span><strong>@FormatMoney(primary.GrandTotal)</strong></div>
                    <div><span>@Loc["SettleQuoteLeadTime"]</span><strong>@string.Format(Loc["SettleQuoteLeadTimeDays"].Value, primary.MaximumLeadTimeDays)</strong></div>
                </div>
            }
        </section>
    }

    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.Static"
                         Density="VppDataDensity.RichTwoLine"
                         AriaLabel="@Loc["PeriodSupplyStep"]"
                         TestId="period-supply-data-surface"
                         Class="vpp-period-data-frame">
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["PeriodSupplyStep"]" Class="vpp-period-data-toolbar">
                <div class="vpp-period-data-heading">
                    <h2>@Loc["SupplyPriceComparisonTitle"]</h2>
                    <span>@Month.ToString("00")/@Year · @EffectivePriceListLabel</span>
                </div>
                <div class="vpp-period-filters vpp-supply-toolbar-controls">
                    <VppFilterSearch Value="@searchText" Input="@OnSearchInput" Placeholder="@Loc["HistorySearchItem"]" AriaLabel="@Loc["HistorySearchItem"]" />
                    <VppFilterSelect TValue="SupplyPriceResult?" Value="@selectedResult" Options="@ResultOptions" ValueChanged="@OnResultChanged" Placeholder="@Loc["Result"]" AriaLabel="@Loc["Result"]" />
                    <RadzenDropDown TValue="Guid?"
                                    Data="@suppliers"
                                    TextProperty="SupplierName"
                                    ValueProperty="Id"
                                    Value="@selectedSupplierId"
                                    ValueChanged="@OnSupplierChangedAsync"
                                    AllowClear="true"
                                    AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@Loc["SupplyPrimarySupplier"]"
                                    Disabled="@isBusy"
                                    class="vpp-period-radzen-filter" />
                    <VppClearFiltersButton Text="@Loc["HistoryClearFilters"]" IsActive="@HasTableFilters" Clicked="@ClearTableFilters" />
                </div>
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            @if (isBusy && State.Preview is null)
            {
                <SkeletonPage Cards="0" Rows="8" Cols="6" />
            }
            else if (State.Preview is null)
            {
                <VppContentState State="VppContentStateKind.Empty"
                                 Icon="@VppIcons.Supplier"
                                 Title="@Loc["SupplyPrimarySupplier"]"
                                 Description="@Loc["SupplySelectionOrderHint"]" />
            }
            else
            {
                var preview = State.Preview;
                var primary = preview.PrimaryQuote;

                @if (preview.Blockers.Count > 0)
                {
                    <div class="vpp-settlement-blockers">
                        <h3><VppIcon Name="@VppIcons.Warning" /> @Loc["SettleBlockersHeading"]</h3>
                        <ul>@foreach (var blocker in preview.Blockers) { <li>@PeriodSettlementSupport.DescribeBlocker(blocker)</li> }</ul>
                    </div>
                }

                @if (primary is not null && (primary.MissingVppIds.Count > 0 || State.Exceptions.Count > 0))
                {
                    <section class="vpp-supply-exceptions" aria-labelledby="supply-exceptions-title">
                        <div class="vpp-supply-exceptions-heading"><div><h3 id="supply-exceptions-title">@Loc["SupplyExceptionsTitle"]</h3><p>@Loc["SupplyExceptionsHint"]</p></div><span class="vpp-badge @(PendingExceptionCount > 0 ? "vpp-badge-warning" : "vpp-badge-success")">@string.Format(Loc["SupplyExceptionsCountFormat"].Value, State.Exceptions.Count, primary.MissingVppIds.Count)</span></div>
                        @foreach (var vppId in primary.MissingVppIds)
                        {
                            var row = GetOrCreateExceptionRow(vppId);
                            var resolved = preview.Exceptions.FirstOrDefault(item => item.VppId == vppId);
                            <div class="vpp-supply-exception-row @(resolved?.IsValid == true ? "is-valid" : null)">
                                <div class="vpp-supply-exception-item"><strong>@GetItemName(vppId)</strong><small>@(resolved?.IsValid == true ? string.Format(Loc["SupplyExceptionResolvedFormat"].Value, FormatMoney(resolved.GrossAmount)) : resolved?.Blocker is null ? "—" : PeriodSettlementSupport.DescribeBlocker(resolved.Blocker))</small></div>
                                <RadzenDropDown TValue="Guid?" Data="@AlternativeSuppliers" TextProperty="SupplierName" ValueProperty="Id" Value="@row.SupplierId" ValueChanged="@(value => OnExceptionSupplierChanged(vppId, value))" AllowClear="true" AllowFiltering="true" Placeholder="@Loc["SupplyExceptionSupplierPlaceholder"]" class="vpp-period-radzen-filter" />
                                <RadzenTextBox Value="@row.Reason" Change="@(value => OnExceptionReasonChanged(vppId, value))" MaxLength="500" Placeholder="@Loc["SupplyExceptionReasonPlaceholder"]" />
                            </div>
                        }
                        <div class="vpp-supply-exception-actions"><span><VppIcon Name="@VppIcons.History" /> @Loc["SupplyExceptionAuditHint"]</span><RadzenButton Icon="refresh" Text="@Loc["SupplyReRunWithExceptions"]" ButtonStyle="ButtonStyle.Secondary" Disabled="@isBusy" Click="@RunPreviewAsync" /></div>
                    </section>
                }

                @if (FilteredPriceRows.Count == 0)
                {
                    <VppContentState State="VppContentStateKind.FilteredEmpty" Icon="search_off" Title="@Loc["NoData"]" Description="@Loc["HistoryAdjustFilters"]" />
                }
                else
                {
                    <div class="vpp-period-grid-wrap">
                        <RadzenDataGrid TItem="SupplyPriceComparisonRow"
                                        Data="@FilteredPriceRows"
                                        AllowPaging="true"
                                        PageSize="20"
                                        PagerAlwaysVisible="true"
                                        ShowPagingSummary="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowFiltering="false"
                                        AllowSorting="true"
                                        AllowColumnResize="false"
                                        AllowAlternatingRows="false"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        IsLoading="@isPriceComparisonLoading"
                                        class="vpp-order-grid vpp-data-grid vpp-data-density-rich-two-line">
                            <Columns>
                                <RadzenDataGridColumn TItem="SupplyPriceComparisonRow" Title="#" Width="52px" TextAlign="TextAlign.Center"><Template Context="row">@(FilteredPriceRows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SupplyPriceComparisonRow" Property="VppName" Title="@Loc["ItemName"]"><Template Context="row"><div class="vpp-order-product-cell"><strong>@row.VppName</strong><small>@row.VppCode</small></div></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SupplyPriceComparisonRow" Property="TotalQuantity" Title="@Loc["Quantity"]" Width="130px" TextAlign="TextAlign.Right" />
                                <RadzenDataGridColumn TItem="SupplyPriceComparisonRow" Property="UnitPrice" Title="@Loc["UnitPrice"]" Width="160px" TextAlign="TextAlign.Right"><Template Context="row">@(row.UnitPrice.HasValue ? FormatMoney(row.UnitPrice.Value) : "—")</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="SupplyPriceComparisonRow" Title="@Loc["Result"]" Width="150px" TextAlign="TextAlign.Center"><Template Context="row"><span class="vpp-badge @GetPriceResultCss(row.Result)">@GetPriceResultText(row.Result)</span></Template></RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
            }
        </ChildContent>
        <Footer>
            <div class="vpp-period-action-footer">
                <span>@Loc["SupplyPriceComparisonCount", PriceComparisonRows.Count]</span>
                <div class="vpp-period-footer-actions">
                    <RadzenButton Icon="fact_check" Text="@Loc["SupplyRunPreview"]" ButtonStyle="ButtonStyle.Secondary" Disabled="@(isBusy || !selectedSupplierId.HasValue)" Click="@RunPreviewAsync" />
                    <RadzenButton Icon="arrow_forward" Text="@Loc["SupplyContinueToSettle"]" ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanContinue)" Click="@ContinueToSettle" />
                </div>
            </div>
        </Footer>
    </VppDataSurfaceFrame>
</div>
