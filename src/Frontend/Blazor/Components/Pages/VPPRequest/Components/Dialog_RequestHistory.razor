@using gtas_vpp_fe.Helpers
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Res.VPP
@inject IAPIServices ApiServices
@inject DialogService DialogService

<div aria-live="polite">
    @if (_isLoading)
    {
        <SkeletonPage Cards="0" Rows="5" Cols="3" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <VppContentState State="VppContentStateKind.Error"
                         Icon="error_outline"
                         Title="@Loc["HistoryLoadFailed"]"
                         Description="@_error"
                         PrimaryActionText="@Loc["Retry"]"
                         PrimaryActionIcon="@VppIcons.Refresh"
                         PrimaryAction="@(_ => LoadAsync())" />
    }
    else if (_history is null)
    {
        <VppContentState State="VppContentStateKind.Empty" Icon="history" Title="@Loc["NoRequestHistory"]" />
    }
    else
    {
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <VppStatusBadge Text="@Loc["RevisionCount", _history.Revisions.Count]" Tone="VppStatusTone.Info" />
                <VppStatusBadge Text="@Loc["TimelineEventCount", _history.Timeline.Count]" Tone="VppStatusTone.Neutral" />
            </RadzenStack>

            <section aria-labelledby="request-timeline-title">
                <h3 id="request-timeline-title" class="rz-text-subtitle2">@Loc["RequestTimeline"]</h3>
                @if (_history.Timeline.Count == 0)
                {
                    <p>@Loc["NoTimelineEvents"]</p>
                }
                else
                {
                    <ol class="vpp-request-history-timeline">
                        @foreach (var item in _history.Timeline.OrderByDescending(x => x.OccurredAt))
                        {
                            <li class="vpp-request-history-timeline-item">
                                <strong>@GetActionLabel(item.Action)</strong>
                                @if (item.RevisionNumber.HasValue)
                                {
                                    <span> · @Loc["RevisionShort", item.RevisionNumber]</span>
                                }
                                <div class="vpp-request-history-meta">
                                    @DateFormatter.Format(item.OccurredAt, DateFormatter.LongDate)
                                    @if (!string.IsNullOrWhiteSpace(item.ActorName))
                                    {
                                        <span> · @item.ActorName</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Reason))
                                {
                                    <div>@Loc["Reason"]: @item.Reason</div>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>

            <section aria-labelledby="request-revisions-title">
                <h3 id="request-revisions-title" class="rz-text-subtitle2">@Loc["RequestRevisions"]</h3>
                <RadzenDataGrid TItem="VppRequestResDTO"
                                Data="@_history.Revisions.OrderByDescending(x => x.RevisionNumber)"
                                AllowPaging="false" AllowSorting="false" AllowFiltering="false"
                                Density="Density.Compact" GridLines="DataGridGridLines.Horizontal">
                    <Columns>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="RevisionNumber" Title="@Loc["Revision"]" Width="90px" />
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="StatusText" Title="@Loc["Status"]" Width="130px" />
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="TotalLines" Title="@Loc["Lines"]" Width="80px" />
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="TotalQty" Title="@Loc["TotalQuantity"]" Width="100px" />
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Title="@Loc["UpdatedAt"]" Width="165px">
                            <Template Context="revision">@DateFormatter.Format(revision.UpdatedAtUtc, DateFormatter.LongDate)</Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </section>
        </RadzenStack>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-4">
        <RadzenButton Text="@Loc["Close"]" ButtonStyle="ButtonStyle.Light" Click="@(_ => DialogService.Close())" />
    </RadzenStack>
</div>

@code {
    [Parameter, EditorRequired] public Guid RequestId { get; set; }

    private VppRequestHistoryResDTO? _history;
    private bool _isLoading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _history = await ApiServices.GetFromApiAsync<VppRequestHistoryResDTO>(
                $"{Config.VppApi.Orders}/{RequestId}/history");
        }
        catch (Exception ex)
        {
            _error = UiErrorMapper.GetMessage(ex, Loc);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetActionLabel(string action)
    {
        var localized = Loc[$"RequestAction_{action}"];
        return localized.ResourceNotFound ? action : localized.Value;
    }
}
