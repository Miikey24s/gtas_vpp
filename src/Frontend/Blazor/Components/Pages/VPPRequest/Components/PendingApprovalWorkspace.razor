@* PAGE: VPPRequest/Components/PendingApprovalWorkspace.razor *@
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.VPP
@using Radzen

<VppOperationWorkspace Gap="VppWorkspaceGap.Compact"
                       FillAvailableSpace="true"
                       ScrollMode="VppWorkspaceScrollMode.Internal"
                       IsBusy="@(IsLoading || IsGridLoading)"
                       Class="vpp-approval-operation-workspace">
    @if (IsLoading)
    {
        <SkeletonPage Cards="0" Rows="8" Cols="7" FillAvailable="true" />
    }
    else
    {
        @* CONTENT: Danh sách đơn chờ duyệt và panel chi tiết đơn đang chọn. *@
        <VppListDetailWorkspace Ratio="VppListDetailRatio.WideDetail"
                                ScrollMode="VppWorkspaceScrollMode.Internal"
                                DetailLabel="@Loc["OrderDetails"]"
                                Class="vpp-approval-workspace">
            <List>
                <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                                     Density="VppDataDensity.RichTwoLine"
                                     Bordered="false"
                                     IsBusy="@IsGridLoading"
                                     State="@ApprovalSurfaceState"
                                     AriaLabel="@Loc["PendingOrders"]"
                                     TestId="pending-approval-list"
                                     Class="vpp-approval-list-surface">
                    @* HEADER: Tiêu đề danh sách và tổng số đơn chờ duyệt. *@
                    <Header>
                        <VppCollectionHeader Title="@Loc["PendingOrders"]"
                                             Summary="@Loc["PendingOrdersCountFormat", TotalCount]" />
                    </Header>
                    @* TOOLBAR: Tìm kiếm, lọc phòng ban và xóa bộ lọc. *@
                    <Toolbar>
                        <VppDataToolbar AriaLabel="@Loc["PendingOrders"]"
                                        Class="vpp-approval-toolbar">
                            <VppFilterSearch Value="@SearchText"
                                             Input="@SearchChanged"
                                             Placeholder="@Loc["HistorySearchOrderOrNote"]"
                                             AriaLabel="@Loc["HistorySearchOrderOrNote"]" />
                            <VppFilterSelect TValue="string"
                                             Value="@SelectedDepartment"
                                             Options="@DepartmentOptions"
                                             ValueChanged="@DepartmentSelected"
                                             Placeholder="@Loc["AllDepartments"]"
                                             AriaLabel="@Loc["Department"]" />
                            <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                                   IsActive="@HasFilters"
                                                   Clicked="@ClearFiltersRequested" />
                        </VppDataToolbar>
                    </Toolbar>
                    <ChildContent>
                        @* ROWS: Các đơn bổ sung chờ người dùng chọn để duyệt. *@
                        <RadzenDataGrid TItem="VppRequestResDTO"
                                        Data="@Orders"
                                        Count="@TotalCount"
                                        LoadData="@LoadDataRequested"
                                        AllowPaging="true"
                                        PageSize="@PageSize"
                                        ShowPagingSummary="true"
                                        PagingSummaryFormat="@Loc["HistoryPagingSummaryFormat"]"
                                        PagerAlwaysVisible="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowMultiColumnSorting="false"
                                        ShowMultiColumnSortingIndex="false"
                                        GotoFirstPageOnSort="true"
                                        AllowFiltering="false"
                                        AllowAlternatingRows="false"
                                        AllowColumnResize="false"
                                        RowSelect="@OrderSelected"
                                        RowRender="@OnRowRender"
                                        SelectionMode="DataGridSelectionMode.Single"
                                        @bind-Value="selectedOrders"
                                        IsLoading="@IsGridLoading"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-approval-list-grid vpp-data-grid vpp-data-density-rich-two-line">
                            <EmptyTemplate>
                                <VppDataGridEmptyState State="@(HasGridLoadError ? VppContentStateKind.Error : HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                                       Icon="@(HasGridLoadError ? "error" : "check_circle")"
                                                       Title="@(HasGridLoadError ? Loc["PendingApprovalLoadFailed"].Value : HasFilters ? Loc["NoOrdersMatchSelectedFilters"].Value : Loc["AllClear"].Value)"
                                                       Description="@(HasGridLoadError ? Loc["HistoryLoadErrorDescription"].Value : HasFilters ? Loc["HistoryAdjustFilters"].Value : Loc["NoPendingAdditionalOrders"].Value)"
                                                       PrimaryActionText="@(HasGridLoadError ? Loc["Retry"].Value : null)"
                                                       PrimaryActionIcon="@(HasGridLoadError ? VppIcons.Reset : null)"
                                                       PrimaryAction="@(_ => ReloadRequested.InvokeAsync())" />
                            </EmptyTemplate>
                            @* COLUMNS: STT, mã đơn, người tạo, thời gian và trạng thái. *@
                            <Columns>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="48px" TextAlign="TextAlign.Center" Sortable="false">
                                    <Template Context="row">@(CurrentSkip + Orders.IndexOf(row) + 1)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["AdditionalOrder"]">
                                    <Template Context="row">
                                        <div class="vpp-approval-order-identity">
                                            <div class="vpp-approval-order-topline">
                                                <strong title="@row.VppCode">@row.VppCode</strong>
                                                <VppStatusBadge Tone="VppStatusTone.Warning"
                                                                Text="@Loc[StatusDisplay.GetResourceKey(row.Status, row.IsDeadlinePassed, row.IsAdditionalOrder)]" />
                                            </div>
                                            <div class="vpp-approval-order-meta">
                                                <span class="vpp-approval-order-owner">@row.DepartmentCode · @row.RequesterName</span>
                                                <span class="vpp-approval-order-summary">@row.Period · @Loc["PendingOrderItemsFormat", row.TotalLines]</span>
                                            </div>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </ChildContent>
                </VppDataSurfaceFrame>
            </List>

            <Detail>
                @if (SelectedOrder is null)
                {
                    <div class="vpp-approval-detail-empty">
                        <VppIcon Name="@VppIcons.NavApproval" />
                        <strong>@Loc["ApprovalSelectOrder"]</strong>
                        <span>@Loc["ApprovalSelectOrderDescription"]</span>
                    </div>
                }
                else
                {
                    <section class="vpp-approval-detail" aria-labelledby="pending-approval-detail-title">
                        <header class="vpp-approval-detail-header">
                            <div class="vpp-approval-detail-heading">
                                <span>GTAS VPP — @Loc["HistoryDetailSheetTitle"]</span>
                                <div class="vpp-approval-detail-code-row">
                                    <h2 id="pending-approval-detail-title" title="@SelectedOrder.VppCode">@SelectedOrder.VppCode</h2>
                                    <VppCategoryChip Tone="VppCategoryTone.Accent" Text="@Loc["AdditionalOrder"]" />
                                    <VppStatusBadge Tone="VppStatusTone.Warning"
                                                    Text="@Loc[StatusDisplay.GetResourceKey(SelectedOrder.Status, SelectedOrder.IsDeadlinePassed, SelectedOrder.IsAdditionalOrder)]" />
                                </div>
                                <p>@string.Format(Loc["SubmittedAtInlineFormat"].Value, DateFormatter.Format(SelectedOrder.SubmittedDate, DateFormatter.LongDate))</p>
                            </div>
                            <div class="vpp-approval-detail-exports">
                                <VppFileExportActions BusyFormat="@BusyExportFormat"
                                                      ExportRequested="@ExportRequested"
                                                      AriaContext="@SelectedOrder.VppCode" />
                            </div>
                        </header>

                        <dl class="vpp-approval-detail-facts">
                            <div><dt>@Loc["HistoryRequester"]</dt><dd>@SelectedOrder.RequesterName</dd></div>
                            <div><dt>@Loc["Department"]</dt><dd>@SelectedOrder.DepartmentCode</dd></div>
                            <div><dt>@Loc["Period"]</dt><dd>@SelectedOrder.Period</dd></div>
                            <div><dt>@Loc["HistoryItem"]</dt><dd>@SelectedOrder.TotalLines</dd></div>
                            <div><dt>@Loc["TotalQuantity"]</dt><dd>@SelectedOrder.TotalQty</dd></div>
                        </dl>

                        <div class="vpp-approval-reason">
                            <span>@Loc["SupplementReason"]</span>
                            <p>@(string.IsNullOrWhiteSpace(SelectedOrder.SupplementReason) ? Loc["ApprovalNoReason"] : SelectedOrder.SupplementReason)</p>
                        </div>

                        @if (DetailLoading(SelectedOrder.Id))
                        {
                            <SkeletonPage Cards="0" Rows="6" Cols="6" />
                        }
                        else
                        {
                            <div class="vpp-approval-items-heading">
                                <div>
                                    <h3>@Loc["ApprovalItemsHeading"]</h3>
                                    <p>@Loc["HistoryItemsHeadingHint"]</p>
                                </div>
                                <div class="vpp-approval-items-summary">
                                    <span><strong>@SelectedOrder.TotalLines</strong> @Loc["HistoryItem"]</span>
                                    <span><strong>@SelectedOrder.TotalQty</strong> @Loc["TotalQuantity"]</span>
                                </div>
                            </div>
                            <VppOrderItemsSurface Items="@DetailItems"
                                                  TotalItemCount="@DetailItems.Count"
                                                  AriaLabel="@Loc["ApprovalItemsHeading"]"
                                                  TestId="pending-approval-detail"
                                                  ShowFilters="false"
                                                  EmptyTitle="@Loc["NoData"]"
                                                  EmptyDescription="@Loc["NoData"]"
                                                  ActiveCodeNumber="@activeCodeNumber"
                                                  ActiveNoteNumber="@activeNoteNumber"
                                                  CodeToggled="@ToggleCode"
                                                  NoteToggled="@ToggleNote"
                                                  CopyRequested="@CopyRequested" />
                        }

                        <footer class="vpp-approval-actions">
                            <span>@(SelectedOrder.CanApproveSupplement
                                ? Loc["ApprovalDecisionHint"]
                                : Loc["SupplementApprovalExpiredHint"])</span>
                            <div class="vpp-approval-action-buttons">
                                @if (CanReject)
                                {
                                    <RadzenButton Icon="cancel"
                                                  Text="@Loc["Reject"]"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Text"
                                                  Disabled="@(!SelectedOrder.CanRejectSupplement || Processing(SelectedOrder.Id))"
                                                  title="@(SelectedOrder.CanRejectSupplement ? Loc["Reject"] : Loc["RequestActionUnavailable"])"
                                                  aria-label="@string.Format(Loc["RejectOrderAria"], SelectedOrder.VppCode)"
                                                  Click="@(_ => RejectRequested.InvokeAsync(SelectedOrder))" />
                                }
                                @if (CanApprove)
                                {
                                    <RadzenButton Icon="check_circle"
                                                  Text="@Loc["Approve"]"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Disabled="@(!SelectedOrder.CanApproveSupplement || Processing(SelectedOrder.Id))"
                                                  title="@(SelectedOrder.CanApproveSupplement ? Loc["Approve"] : Loc["SupplementApprovalExpiredHint"])"
                                                  IsBusy="@Processing(SelectedOrder.Id)"
                                                  aria-label="@string.Format(Loc["ApproveOrderAria"], SelectedOrder.VppCode)"
                                                  Click="@(_ => ApproveRequested.InvokeAsync(SelectedOrder))" />
                                }
                            </div>
                        </footer>
                    </section>
                }
            </Detail>
        </VppListDetailWorkspace>
    }
</VppOperationWorkspace>

@code {
    [Parameter, EditorRequired] public List<VppRequestResDTO> Orders { get; set; } = [];
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalLines { get; set; }
    [Parameter] public int TotalQuantity { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int CurrentSkip { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsGridLoading { get; set; }
    [Parameter] public bool HasGridLoadError { get; set; }
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public bool CanReject { get; set; }
    [Parameter] public VppFileExportFormat? BusyExportFormat { get; set; }
    [Parameter] public VppRequestResDTO? SelectedOrder { get; set; }
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public string SelectedDepartment { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<VppFilterOption<string>> DepartmentOptions { get; set; } = [];
    [Parameter] public bool HasFilters { get; set; }
    [Parameter, EditorRequired] public Func<Guid, bool> Processing { get; set; } = _ => false;
    [Parameter, EditorRequired] public Func<Guid, bool> DetailLoading { get; set; } = _ => false;
    [Parameter] public EventCallback ReloadRequested { get; set; }
    [Parameter] public EventCallback<LoadDataArgs> LoadDataRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> OrderSelected { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ApproveRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> RejectRequested { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> SearchChanged { get; set; }
    [Parameter] public EventCallback<string> DepartmentSelected { get; set; }
    [Parameter] public EventCallback ClearFiltersRequested { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }
    [Parameter] public EventCallback<VppFileExportFormat> ExportRequested { get; set; }

    private int? activeCodeNumber;
    private int? activeNoteNumber;
    private IList<VppRequestResDTO> selectedOrders = [];
    private VppDataSurfaceState ApprovalSurfaceState => HasGridLoadError
        ? VppDataSurfaceState.Error
        : IsGridLoading
            ? VppDataSurfaceState.Loading
            : TotalCount == 0
                ? HasFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty
                : VppDataSurfaceState.Populated;

    private IReadOnlyList<VppOrderDetailItem> DetailItems => SelectedOrder?.Items?
        .Select((item, index) => new VppOrderDetailItem(
            index + 1,
            item.VppCode,
            item.VppName ?? item.VppCode ?? Loc["NoData"],
            item.CategoryName,
            item.UomName,
            item.Qty,
            item.Description))
        .ToArray() ?? [];

    protected override void OnParametersSet()
    {
        selectedOrders = SelectedOrder is null
            ? []
            : Orders.Where(order => order.Id == SelectedOrder.Id).Take(1).ToList();
    }

    private void OnRowRender(RowRenderEventArgs<VppRequestResDTO> args)
    {
        if (SelectedOrder is null || args.Data is null || args.Data.Id != SelectedOrder.Id)
        {
            return;
        }

        args.Attributes["aria-selected"] = "true";
        args.Attributes["class"] = args.Attributes.TryGetValue("class", out var value) && value is not null
            ? $"{value} rz-state-highlight vpp-approval-row-selected"
            : "rz-state-highlight vpp-approval-row-selected";
    }

    private void ToggleCode(int number)
    {
        activeNoteNumber = null;
        activeCodeNumber = activeCodeNumber == number ? null : number;
    }

    private void ToggleNote(int number)
    {
        activeCodeNumber = null;
        activeNoteNumber = activeNoteNumber == number ? null : number;
    }
}
