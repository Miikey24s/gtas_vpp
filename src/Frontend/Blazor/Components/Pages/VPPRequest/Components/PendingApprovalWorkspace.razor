@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.VPP
@using Radzen

<VppOperationWorkspace Gap="VppWorkspaceGap.Compact"
                       IsBusy="@(IsLoading || IsGridLoading)"
                       Class="vpp-approval-operation-workspace">
    @if (IsLoading)
    {
        <SkeletonPage Cards="0" Rows="8" Cols="7" />
    }
    else if (TotalCount == 0 && !IsGridLoading)
    {
        <VppContentState State="VppContentStateKind.Success"
                         Icon="check_circle"
                         Title="@Loc["AllClear"]"
                         Description="@Loc["NoPendingAdditionalOrders"]"
                         PrimaryActionText="@Loc["RefreshQueue"]"
                         PrimaryActionIcon="@VppIcons.Refresh"
                         PrimaryAction="@(_ => ReloadRequested.InvokeAsync())" />
    }
    else
    {
        <VppListDetailWorkspace Ratio="VppListDetailRatio.WideDetail"
                                DetailLabel="@Loc["OrderDetails"]"
                                Class="vpp-approval-workspace">
            <List>
                <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                                     Density="VppDataDensity.RichTwoLine"
                                     Bordered="false"
                                     AriaLabel="@Loc["PendingOrders"]"
                                     TestId="pending-approval-list"
                                     Class="vpp-approval-list-surface">
                    <Toolbar>
                        <VppDataToolbar AriaLabel="@Loc["PendingOrders"]"
                                        Class="vpp-approval-toolbar">
                            <VppFilterSearch Value="@SearchText"
                                             Input="@SearchChanged"
                                             Placeholder="@Loc["HistorySearchOrderOrNote"]"
                                             AriaLabel="@Loc["HistorySearchOrderOrNote"]" />
                            <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                                   IsActive="@HasFilters"
                                                   Clicked="@ClearFiltersRequested" />
                        </VppDataToolbar>
                    </Toolbar>
                    <ChildContent>
                        <RadzenDataGrid TItem="VppRequestResDTO"
                                        Data="@Orders"
                                        Count="@TotalCount"
                                        LoadData="@LoadDataRequested"
                                        AllowPaging="true"
                                        PageSize="@PageSize"
                                        ShowPagingSummary="true"
                                        PagingSummaryFormat="@Loc["HistoryPagingSummaryFormat"]"
                                        PagerAlwaysVisible="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowMultiColumnSorting="false"
                                        ShowMultiColumnSortingIndex="false"
                                        GotoFirstPageOnSort="true"
                                        AllowFiltering="false"
                                        AllowAlternatingRows="false"
                                        AllowColumnResize="false"
                                        RowSelect="@OrderSelected"
                                        SelectionMode="DataGridSelectionMode.Single"
                                        IsLoading="@IsGridLoading"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-approval-list-grid vpp-data-grid vpp-data-density-rich-two-line">
                            <Columns>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="48px" TextAlign="TextAlign.Center" Sortable="false">
                                    <Template Context="row">@(CurrentSkip + Orders.IndexOf(row) + 1)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["AdditionalOrder"]">
                                    <Template Context="row">
                                        <div class="vpp-approval-order-identity">
                                            <strong title="@row.VppCode">@ShortCode(row)</strong>
                                            <small>@row.DepartmentCode · @row.RequesterName · @row.Period</small>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </ChildContent>
                </VppDataSurfaceFrame>
            </List>

            <Detail>
                @if (SelectedOrder is null)
                {
                    <div class="vpp-approval-detail-empty">
                        <VppIcon Name="@VppIcons.NavApproval" />
                        <strong>@Loc["ApprovalSelectOrder"]</strong>
                        <span>@Loc["ApprovalSelectOrderDescription"]</span>
                    </div>
                }
                else
                {
                    <section class="vpp-approval-detail" aria-labelledby="pending-approval-detail-title">
                        <header class="vpp-approval-detail-header">
                            <div>
                                <span>@Loc["HistoryDetailSheetTitle"]</span>
                                <h2 id="pending-approval-detail-title" title="@SelectedOrder.VppCode">@ShortCode(SelectedOrder)</h2>
                                <p>@string.Format(Loc["SubmittedAtInlineFormat"].Value, DateFormatter.Format(SelectedOrder.SubmittedDate, DateFormatter.LongDate))</p>
                            </div>
                            <div class="vpp-approval-detail-exports">
                                <RadzenButton Icon="picture_as_pdf" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                              Click="@(_ => ExportPdfRequested.InvokeAsync(SelectedOrder))" Title="@Loc["ExportPdf"]" Disabled="@IsExporting" />
                                <RadzenButton Icon="table_view" Size="ButtonSize.Small" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                              Click="@(_ => ExportExcelRequested.InvokeAsync(SelectedOrder))" Title="@Loc["ExportExcel"]" Disabled="@IsExporting" />
                            </div>
                        </header>

                        <dl class="vpp-approval-detail-facts">
                            <div><dt>@Loc["HistoryRequester"]</dt><dd>@SelectedOrder.RequesterName</dd></div>
                            <div><dt>@Loc["Department"]</dt><dd>@SelectedOrder.DepartmentCode</dd></div>
                            <div><dt>@Loc["Period"]</dt><dd>@SelectedOrder.Period</dd></div>
                            <div><dt>@Loc["TotalQuantity"]</dt><dd>@SelectedOrder.TotalQty</dd></div>
                        </dl>

                        <div class="vpp-approval-reason">
                            <span>@Loc["SupplementReason"]</span>
                            <p>@(string.IsNullOrWhiteSpace(SelectedOrder.SupplementReason) ? Loc["ApprovalNoReason"] : SelectedOrder.SupplementReason)</p>
                        </div>

                        @if (DetailLoading(SelectedOrder.Id))
                        {
                            <SkeletonPage Cards="0" Rows="6" Cols="6" />
                        }
                        else
                        {
                            <VppOrderItemsSurface Items="@DetailItems"
                                                  TotalItemCount="@DetailItems.Count"
                                                  AriaLabel="@Loc["ApprovalItemsHeading"]"
                                                  TestId="pending-approval-detail"
                                                  ShowFilters="false"
                                                  EmptyTitle="@Loc["NoData"]"
                                                  EmptyDescription="@Loc["NoData"]"
                                                  ActiveCodeNumber="@activeCodeNumber"
                                                  ActiveNoteNumber="@activeNoteNumber"
                                                  CodeToggled="@ToggleCode"
                                                  NoteToggled="@ToggleNote"
                                                  CopyRequested="@CopyRequested" />
                        }

                        <footer class="vpp-approval-actions">
                            @if (CanReject)
                            {
                                <RadzenButton Icon="cancel"
                                              Text="@Loc["Reject"]"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Text"
                                              Disabled="@Processing(SelectedOrder.Id)"
                                              Click="@(_ => RejectRequested.InvokeAsync(SelectedOrder))" />
                            }
                            @if (CanApprove)
                            {
                                <RadzenButton Icon="check_circle"
                                              Text="@Loc["Approve"]"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Disabled="@Processing(SelectedOrder.Id)"
                                              IsBusy="@Processing(SelectedOrder.Id)"
                                              Click="@(_ => ApproveRequested.InvokeAsync(SelectedOrder))" />
                            }
                        </footer>
                    </section>
                }
            </Detail>
        </VppListDetailWorkspace>
    }
</VppOperationWorkspace>

@code {
    [Parameter, EditorRequired] public List<VppRequestResDTO> Orders { get; set; } = [];
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalLines { get; set; }
    [Parameter] public int TotalQuantity { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int CurrentSkip { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsGridLoading { get; set; }
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public bool CanReject { get; set; }
    [Parameter] public bool IsExporting { get; set; }
    [Parameter] public VppRequestResDTO? SelectedOrder { get; set; }
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public bool HasFilters { get; set; }
    [Parameter, EditorRequired] public Func<Guid, bool> Processing { get; set; } = _ => false;
    [Parameter, EditorRequired] public Func<Guid, bool> DetailLoading { get; set; } = _ => false;
    [Parameter, EditorRequired] public Func<VppRequestResDTO, string> ShortCode { get; set; } = _ => string.Empty;
    [Parameter] public EventCallback ReloadRequested { get; set; }
    [Parameter] public EventCallback<LoadDataArgs> LoadDataRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> OrderSelected { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ApproveRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> RejectRequested { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> SearchChanged { get; set; }
    [Parameter] public EventCallback ClearFiltersRequested { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ExportPdfRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ExportExcelRequested { get; set; }

    private int? activeCodeNumber;
    private int? activeNoteNumber;

    private IReadOnlyList<VppOrderDetailItem> DetailItems => SelectedOrder?.Items?
        .Select((item, index) => new VppOrderDetailItem(
            index + 1,
            item.VppCode,
            item.VppName ?? item.VppCode ?? Loc["NoData"],
            item.CategoryName,
            item.UomName,
            item.Qty,
            item.Description))
        .ToArray() ?? [];

    private void ToggleCode(int number)
    {
        activeNoteNumber = null;
        activeCodeNumber = activeCodeNumber == number ? null : number;
    }

    private void ToggleNote(int number)
    {
        activeCodeNumber = null;
        activeNoteNumber = activeNoteNumber == number ? null : number;
    }
}
