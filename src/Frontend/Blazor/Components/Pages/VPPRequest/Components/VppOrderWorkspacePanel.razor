@using gtas_vpp_shared.DTOs.Res.VPP

<section class="vpp-order-view-panel" data-testid="@TestId" aria-label="@PanelLabel">
    @if (Order is not null)
    {
    <header class="vpp-order-view-meta">
        <div class="vpp-order-view-identity">
            <div class="vpp-data-card-value-row vpp-order-code-cell">
                    <span class="vpp-data-card-value vpp-order-code-static" title="@Order.VppCode">@Order.VppCode</span>
                    @if (Order.IsAdditionalOrder)
                    {
                        <VppStatusBadge Text="@Loc["Additional"]" Tone="VppStatusTone.Warning" />
                    }
                    <VppStatusBadge Tone="@StatusDisplay.GetTone(Order.Status)"
                                    Text="@Loc[StatusDisplay.GetResourceKey(Order.Status, Order.IsDeadlinePassed, Order.IsAdditionalOrder)]" />
                    @if (Order.SettledAt.HasValue)
                    {
                        <VppStatusBadge Text="@Loc["Settled"]" Tone="VppStatusTone.Success" Title="@($"{Loc["Settled"]}: {DateFormatter.Format(Order.SettledAt, DateFormatter.LongDate)} - {Order.SettledByPriceListName}")" />
                    }
                    @if (ReadOnly)
                    {
                        <span class="vpp-order-read-only"><VppIcon Name="@VppIcons.Lock" /> @Loc["ReadOnly"]</span>
                    }
            </div>
            <span class="vpp-order-card-submitted">
                @string.Format(Loc["SubmittedAtInlineFormat"].Value, DateFormatter.Format(Order.SubmittedDate, DateFormatter.LongDate))
            </span>
        </div>

        @if (AvailableOrders.Count > 1)
        {
            <div class="vpp-order-attempt-picker">
                <label for="@OrderPickerId">@Loc["AdditionalOrder"]</label>
                <RadzenDropDown TValue="Guid"
                                id="@OrderPickerId"
                                Data="@AvailableOrders"
                                TextProperty="VppCode"
                                ValueProperty="Id"
                                Value="@SelectedOrderId"
                                Change="@OnOrderSelectionChanged"
                                aria-label="@Loc["AdditionalOrder"]" />
            </div>
        }

        <div class="vpp-order-card-toolbar">
                <div class="vpp-data-card-actions">
                    @if (!ReadOnly && CanEdit)
                    {
                        <RadzenButton Icon="edit"
                                      Text="@Loc["Edit"]"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      Click="@(async _ => await EditRequested.InvokeAsync(Order))"
                                      Title="@Loc["Edit"]"
                                      aria-label="@string.Format(Loc["EditOrderAria"], Order.VppCode)" />
                    }
                    @if (!ReadOnly && CanRestore)
                    {
                        <RadzenButton Icon="undo"
                                      Text="@Loc["RestoreOrder"]"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      Click="@(async _ => await RestoreRequested.InvokeAsync(Order))"
                                      Title="@Loc["RestoreOrder"]"
                                      aria-label="@string.Format(Loc["RestoreOrderAria"], Order.VppCode)"
                                      Disabled="@IsRestoring"
                                      IsBusy="@IsRestoring" />
                    }
                    @if (!ReadOnly && CanRecreate)
                    {
                        <RadzenButton Icon="@VppIcons.Add"
                                      Text="@Loc["RecreateOrder"]"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@(async _ => await RecreateRequested.InvokeAsync(Order))"
                                      Title="@Loc["RecreateOrder"]"
                                      aria-label="@string.Format(Loc["RecreateOrderAria"], Order.VppCode)" />
                    }
                    <RadzenButton Icon="@VppIcons.History"
                                  Text="@Loc["History"]"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Base"
                                  Variant="Variant.Text"
                                  Click="@(async _ => await HistoryRequested.InvokeAsync(Order))"
                                  Title="@Loc["ViewRequestHistory"]"
                                  aria-label="@string.Format(Loc["ViewRequestHistoryAria"], Order.VppCode)" />
                    @if (ExportPdfRequested.HasDelegate)
                    {
                        <RadzenButton Icon="picture_as_pdf"
                                      Text="@Loc["ExportPdf"]"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      Click="@(async _ => await ExportPdfRequested.InvokeAsync(Order))"
                                      Title="@Loc["ExportPdf"]"
                                      aria-label="@string.Format(Loc["ExportOrderPdfAria"], Order.VppCode)"
                                      Disabled="@IsExporting" />
                    }
                    @if (ExportExcelRequested.HasDelegate)
                    {
                        <RadzenButton Icon="table_view"
                                      Text="@Loc["ExportExcel"]"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      Click="@(async _ => await ExportExcelRequested.InvokeAsync(Order))"
                                      Title="@Loc["ExportExcel"]"
                                      aria-label="@string.Format(Loc["ExportOrderExcelAria"], Order.VppCode)"
                                      Disabled="@IsExporting" />
                    }
                    @if (!ReadOnly && CanCancel)
                    {
                        <RadzenButton Icon="@VppIcons.Rejected"
                                      Text="@Loc["Cancel"]"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text"
                                      Click="@(async _ => await CancelRequested.InvokeAsync(Order))"
                                      Title="@Loc["Cancel"]"
                                      aria-label="@string.Format(Loc["CancelOrderAria"], Order.VppCode)"
                                      Disabled="@IsCancelling"
                                      IsBusy="@IsCancelling" />
                    }
                </div>
        </div>
    </header>
    }

    <VppOrderItemsSurface @ref="_itemsSurface"
                          Variant="VppOrderItemsSurfaceVariant.Workspace"
                          Items="@FilteredItems"
                          TotalItemCount="@Items.Count"
                          AriaLabel="@PanelLabel"
                          UnitHeaderLabel="@Loc["UOM"]"
                          TestId="@TestId"
                          EmptyIcon="@EmptyIcon"
                          EmptyTitle="@EmptyTitle"
                          EmptyDescription="@EmptyDescription"
                          EmptyActionText="@EmptyActionText"
                          EmptyActionClick="@EmptyActionClick"
                          Categories="@CategoryFilterOptions"
                          Units="@UnitFilterOptions"
                          SearchText="@(ItemSearch ?? string.Empty)"
                          SelectedCategory="@(CategoryFilter ?? string.Empty)"
                          SelectedUnit="@(UnitFilter ?? string.Empty)"
                          HasFilters="@HasItemFilters"
                          SearchPlaceholder="@Loc["HistorySearchItem"]"
                          FiltersAriaLabel="@Loc["CatalogFilters"]"
                          CategoryAriaLabel="@Loc["Category"]"
                          AllCategoriesText="@Loc["HistoryAllCategories"]"
                          AllUnitsText="@Loc["HistoryAllUnits"]"
                          ClearFiltersText="@Loc["HistoryClearFilters"]"
                          SearchChanged="@OnItemSearchInput"
                          CategorySelected="@SelectCategoryAsync"
                          UnitSelected="@SelectUnitAsync"
                          FiltersCleared="@ClearItemFiltersAsync"
                          ActiveCodeNumber="@ActiveItemCodeNumber"
                          ActiveNoteNumber="@ActiveItemNoteNumber"
                          CodeToggled="@ToggleItemCode"
                          NoteToggled="@ToggleItemNote"
                          CopyRequested="@CopyCodeRequested"
                          TransientSurfacesClosed="@CloseTransientSurfaces" />
</section>

@code {
    [Parameter] public string TestId { get; set; } = "order-view-panel";
    [Parameter, EditorRequired] public string PanelLabel { get; set; } = string.Empty;
    [Parameter] public VppRequestResDTO? Order { get; set; }
    [Parameter] public IReadOnlyList<VppRequestResDTO> AvailableOrders { get; set; } = Array.Empty<VppRequestResDTO>();
    [Parameter] public Guid SelectedOrderId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedOrderIdChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanRestore { get; set; }
    [Parameter] public bool CanRecreate { get; set; }
    [Parameter] public bool CanCancel { get; set; }
    [Parameter] public bool IsCancelling { get; set; }
    [Parameter] public bool IsRestoring { get; set; }
    [Parameter, EditorRequired] public string EmptyIcon { get; set; } = VppIcons.Orders;
    [Parameter, EditorRequired] public string EmptyTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EmptyDescription { get; set; } = string.Empty;
    [Parameter] public string? EmptyActionText { get; set; }
    [Parameter] public EventCallback EmptyActionClick { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> EditRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> RestoreRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> RecreateRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> HistoryRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> CancelRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ExportPdfRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> ExportExcelRequested { get; set; }
    [Parameter] public bool IsExporting { get; set; }
    [Parameter] public EventCallback<string?> CopyCodeRequested { get; set; }

    private VppOrderItemsSurface? _itemsSurface;
    private readonly List<VppOrderDetailItem> _filteredItems = [];
    private string? ItemSearch { get; set; }
    private string? CategoryFilter { get; set; }
    private string? UnitFilter { get; set; }
    private int? ActiveItemCodeNumber { get; set; }
    private int? ActiveItemNoteNumber { get; set; }

    private List<VppRequestDetailResDTO> Items => Order?.Items ?? [];
    private List<VppOrderDetailItem> FilteredItems => _filteredItems;
    private string OrderPickerId => $"{TestId}-picker";

    private IReadOnlyList<string> CategoryFilterOptions => GetDistinctValues(item => item.CategoryName);
    private IReadOnlyList<string> UnitFilterOptions => GetDistinctValues(item => item.UomName);
    private bool HasItemFilters => !string.IsNullOrWhiteSpace(ItemSearch)
        || !string.IsNullOrEmpty(CategoryFilter)
        || !string.IsNullOrEmpty(UnitFilter);

    protected override void OnParametersSet() => RebuildFilteredItems();

    private IReadOnlyList<string> GetDistinctValues(Func<VppRequestDetailResDTO, string?> selector) => Items
        .Select(selector)
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim())
        .Distinct(StringComparer.CurrentCultureIgnoreCase)
        .OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    private void RebuildFilteredItems()
    {
        var search = ItemSearch?.Trim();
        _filteredItems.Clear();
        var filtered = Items.Where(item =>
                (string.IsNullOrEmpty(search)
                    || (item.VppCode?.Contains(search, StringComparison.CurrentCultureIgnoreCase) ?? false)
                    || (item.VppName?.Contains(search, StringComparison.CurrentCultureIgnoreCase) ?? false))
                && (string.IsNullOrEmpty(CategoryFilter)
                    || string.Equals(item.CategoryName?.Trim(), CategoryFilter, StringComparison.CurrentCultureIgnoreCase))
                && (string.IsNullOrEmpty(UnitFilter)
                    || string.Equals(item.UomName?.Trim(), UnitFilter, StringComparison.CurrentCultureIgnoreCase)))
            .Select((item, index) => new VppOrderDetailItem(
                index + 1,
                item.VppCode,
                item.VppName ?? string.Empty,
                item.CategoryName,
                item.UomName,
                item.Qty,
                GetBusinessNote(item.Description)));

        _filteredItems.AddRange(filtered);
    }

    private async Task OnItemSearchInput(ChangeEventArgs args)
    {
        CloseTransientSurfaces();
        ItemSearch = args.Value?.ToString();
        await ApplyItemFiltersAsync();
    }

    private async Task SelectCategoryAsync(string value)
    {
        CloseTransientSurfaces();
        CategoryFilter = value;
        await ApplyItemFiltersAsync();
    }

    private async Task SelectUnitAsync(string value)
    {
        CloseTransientSurfaces();
        UnitFilter = value;
        await ApplyItemFiltersAsync();
    }

    private async Task ClearItemFiltersAsync()
    {
        CloseTransientSurfaces();
        ItemSearch = null;
        CategoryFilter = null;
        UnitFilter = null;
        await ApplyItemFiltersAsync();
    }

    private void ToggleItemCode(int number)
    {
        var shouldOpen = ActiveItemCodeNumber != number;
        CloseTransientSurfaces();
        ActiveItemCodeNumber = shouldOpen ? number : null;
    }

    private void ToggleItemNote(int number)
    {
        var shouldOpen = ActiveItemNoteNumber != number;
        CloseTransientSurfaces();
        ActiveItemNoteNumber = shouldOpen ? number : null;
    }

    private void CloseTransientSurfaces()
    {
        ActiveItemCodeNumber = null;
        ActiveItemNoteNumber = null;
    }

    private async Task ApplyItemFiltersAsync()
    {
        RebuildFilteredItems();
        if (_itemsSurface is not null)
        {
            await _itemsSurface.ReloadAsync();
        }
    }

    private Task OnOrderSelectionChanged(object value)
        => value is Guid id ? SelectedOrderIdChanged.InvokeAsync(id) : Task.CompletedTask;

    private static string? GetBusinessNote(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return null;
        }

        var value = description.Trim();
        return value.StartsWith("Demo quantity inferred", StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("Normalized from", StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("QA-", StringComparison.OrdinalIgnoreCase)
                ? null
                : value;
    }

}
