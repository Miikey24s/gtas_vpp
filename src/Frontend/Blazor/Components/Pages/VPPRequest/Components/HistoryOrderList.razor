@* PAGE: VPPRequest/Components/HistoryOrderList.razor *@
@* Atlas history order list: toolbar lọc (tìm kiếm · loại đơn · trạng thái · xóa bộ lọc) + bảng đơn phân trang server + danh sách mobile. *@
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_fe.Helpers
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryUiKeys

<section class="vpp-history-orders-card @Class" aria-labelledby="history-orders-title">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         Bordered="false"
                         AriaLabelledBy="history-orders-title"
                         TestId="@TestId"
                         Class="vpp-history-data-frame">
    @* TOOLBAR: Tìm kiếm, lọc loại/trạng thái và xóa bộ lọc. *@
    <Toolbar>
        <VppDataToolbar AriaLabel="@Loc["HistoryOrderList"]"
                        Class="vpp-history-orders-toolbar">
            <h2 id="history-orders-title">@EffectiveTitle</h2>
            <div class="vpp-history-filters">
                <VppFilterSearch Value="@Search"
                                 Input="@SearchChanged"
                                 Placeholder="@Loc["HistorySearchOrderOrNote"]"
                                 AriaLabel="@Loc["HistorySearchOrderOrNote"]" />
                <VppFilterSelect TValue="string"
                                 Value="@SelectedOrderType"
                                 Options="@OrderTypeOptions"
                                 ValueChanged="@OrderTypeSelected"
                                 Opening="@TransientSurfacesClosed"
                                 Placeholder="@Loc["HistoryAllOrderTypes"]"
                                 AriaLabel="@Loc["HistoryOrderType"]" />
                <VppFilterSelect TValue="int?"
                                 Value="@SelectedStatus"
                                 Options="@StatusOptions"
                                 ValueChanged="@StatusSelected"
                                 Opening="@TransientSurfacesClosed"
                                 Placeholder="@Loc["HistoryAllStatuses"]"
                                 AriaLabel="@Loc["Status"]" />
                <VppClearFiltersButton Text="@Loc["HistoryClearFilters"]"
                                       IsActive="@HasTableFilters"
                                       Clicked="@TableFiltersCleared"
                                       Class="vpp-history-clear" />
            </div>
        </VppDataToolbar>
    </Toolbar>
    <ChildContent>
    @if (HasGridLoadError)
    {
        <VppContentState State="VppContentStateKind.Error"
                         FillAvailable="true"
                         Icon="error"
                         Title="@Loc["HistoryLoadFailed"]"
                         Description="@Loc["HistoryLoadErrorDescription"]"
                         PrimaryActionText="@Loc["Retry"]"
                         PrimaryActionIcon="@VppIcons.Reset"
                         PrimaryAction="@(_ => RetryRequested.InvokeAsync())"
                         Class="vpp-history-state-panel vpp-history-grid-state" />
    }
    else if (TotalCount == 0 && !IsGridLoading)
    {
        <VppContentState State="VppContentStateKind.FilteredEmpty"
                         FillAvailable="true"
                         Icon="search_off"
                         Title="@Loc["NoOrdersMatchSelectedFilters"]"
                         Description="@Loc["HistoryAdjustFilters"]"
                         Class="vpp-history-state-panel vpp-history-grid-state" />
    }
    else
    {
        @* ROWS: Danh sách phiếu lịch sử có phân trang. *@
        <div class="vpp-history-grid-wrap">
            <RadzenDataGrid TItem="VppRequestResDTO"
                            @key="(PageSize, SelectedOrderId)"
                            Data="@Orders"
                            Count="@TotalCount"
                            LoadData="@LoadRequested"
                            RowSelect="@OrderSelected"
                            RowRender="@OnRowRender"
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value="selectedOrders"
                            AllowPaging="true"
                            PageSize="@PageSize"
                            PagerAlwaysVisible="true"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="@Loc["HistoryPagingSummaryFormat"]"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowSorting="false"
                            AllowFiltering="false"
                            AllowColumnResize="false"
                            AllowAlternatingRows="false"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal"
                            IsLoading="@IsGridLoading"
                            class="vpp-history-grid vpp-data-grid vpp-data-density-compact">
                @* COLUMNS: Kỳ, trạng thái kỳ, mã đơn, loại đơn, trạng thái đơn, ngày gửi và ghi chú. *@
                <Columns>
                    @if (Columns is not null)
                    {
                        @Columns
                    }
                    else
                    {
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" TextAlign="TextAlign.Center" CssClass="vpp-history-col-center" HeaderCssClass="vpp-history-col-center">
                        <Template Context="row">@(CurrentSkip + Orders.IndexOf(row) + 1)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="Period" Title="@Loc["Period"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-center" HeaderCssClass="vpp-history-col-center" />
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="PeriodState" Title="@Loc["PeriodStateLabel"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-period-state vpp-history-col-center" HeaderCssClass="vpp-history-col-period-state vpp-history-col-center">
                        <Template Context="row">
                            <VppPeriodStateBadge State="@row.PeriodState" Compact="true" Class="vpp-history-period-state" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="VppCode" Title="@Loc["OrderCode"]" CssClass="vpp-history-col-left" HeaderCssClass="vpp-history-col-left">
                        <Template Context="row">
                            <VppCellValuePopover Value="@row.VppCode"
                                                 Label="@Loc["OrderCode"]"
                                                 CopyLabel="@Loc["Copy"]"
                                                 Kind="VppCellValueKind.Code"
                                                 IsOpen="@(ActiveCodeOrderId == row.Id)"
                                                 Toggled="@(() => CodeToggled.InvokeAsync(row.Id))"
                                                 CopyRequested="@CopyRequested"
                                                 Class="vpp-history-code-cell"
                                                 TriggerClass="vpp-history-code vpp-history-code-trigger"
                                                 PanelClass="vpp-history-code-popover" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Title="@Loc["HistoryOrderType"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-type vpp-history-col-center" HeaderCssClass="vpp-history-col-type vpp-history-col-center">
                        <Template Context="row">
                            <VppCategoryChip Text="@(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])"
                                             Tone="@(row.IsAdditionalOrder ? VppCategoryTone.Accent : VppCategoryTone.Neutral)"
                                             Class="vpp-history-order-type" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="StatusText" Title="@Loc["Status"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-status vpp-history-col-center" HeaderCssClass="vpp-history-col-status vpp-history-col-center">
                        @* Render trạng thái qua resx để badge và bộ lọc dùng chung một copy ("Đã từ chối"...). *@
                        <Template Context="row"><VppStatusBadge Tone="@StatusDisplay.GetTone(row.Status)" Text="@Loc[StatusDisplay.GetResourceKey(row.Status, row.IsDeadlinePassed, row.IsAdditionalOrder)]" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="SubmittedDate" Title="@Loc["SubmittedDate"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-date vpp-history-col-center" HeaderCssClass="vpp-history-col-date vpp-history-col-center">
                        <Template Context="row"><span class="vpp-history-date">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="Description" Title="@Loc["Note"]" CssClass="vpp-history-col-note vpp-history-col-left" HeaderCssClass="vpp-history-col-note vpp-history-col-left">
                        <Template Context="row">
                            @if (string.IsNullOrWhiteSpace(row.Description))
                            {
                                <span class="vpp-history-note">–</span>
                            }
                            else
                            {
                                <VppCellValuePopover Value="@row.Description"
                                                     Label="@Loc["Note"]"
                                                     CopyLabel="@Loc["Copy"]"
                                                     Kind="VppCellValueKind.Note"
                                                     IsOpen="@(ActiveNoteOrderId == row.Id)"
                                                     Toggled="@(() => NoteToggled.InvokeAsync(row.Id))"
                                                     CopyRequested="@CopyRequested"
                                                     Class="vpp-history-note-cell"
                                                     TriggerClass="vpp-history-note vpp-history-note-trigger"
                                                     PanelClass="vpp-history-note-popover" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
            @if (IsGridLoading)
            {
                <div class="vpp-history-region-loading vpp-history-grid-loading" role="status" aria-live="polite"><span class="vpp-history-state-spinner" aria-hidden="true"></span>@Loc["Loading"]</div>
            }
        </div>

        <div class="vpp-history-mobile-list">
            @foreach (var row in Orders)
            {
                <button type="button" @onclick="() => OrderSelected.InvokeAsync(row)">
                    @if (MobileRow is not null)
                    {
                        @MobileRow(row)
                    }
                    else
                    {
                    <span class="vpp-history-mobile-topline">
                        <strong>@row.VppCode</strong>
                        <VppStatusBadge Tone="@StatusDisplay.GetTone(row.Status)" Text="@Loc[StatusDisplay.GetResourceKey(row.Status, row.IsDeadlinePassed, row.IsAdditionalOrder)]" />
                    </span>
                    <span>@row.Period</span>
                    <VppCategoryChip Text="@(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])"
                                     Tone="@(row.IsAdditionalOrder ? VppCategoryTone.Accent : VppCategoryTone.Neutral)"
                                     Class="vpp-history-order-type" />
                    @if (PeriodStateDisplay.IsKnown(row.PeriodState))
                    {
                        <span class="vpp-history-mobile-period-state"><span>@Loc["PeriodStateLabel"]:</span><VppPeriodStateBadge State="@row.PeriodState" Class="vpp-history-period-state" /></span>
                    }
                    <span class="vpp-history-note">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span>
                    }
                </button>
            }
        </div>
    }
    </ChildContent>
    </VppDataSurfaceFrame>
</section>

@code {
    [Parameter, EditorRequired] public List<VppRequestResDTO> Orders { get; set; } = [];
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int CurrentSkip { get; set; }
    [Parameter] public Guid? SelectedOrderId { get; set; }
    [Parameter] public bool IsGridLoading { get; set; }
    [Parameter] public bool HasGridLoadError { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public string SelectedOrderType { get; set; } = string.Empty;
    [Parameter] public int? SelectedStatus { get; set; }
    [Parameter] public Guid? ActiveCodeOrderId { get; set; }
    [Parameter] public Guid? ActiveNoteOrderId { get; set; }
    [Parameter] public bool HasTableFilters { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string TestId { get; set; } = "history-orders-data-surface";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public RenderFragment<VppRequestResDTO>? MobileRow { get; set; }
    [Parameter] public EventCallback<LoadDataArgs> LoadRequested { get; set; }
    [Parameter] public EventCallback<VppRequestResDTO> OrderSelected { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> SearchChanged { get; set; }
    [Parameter] public EventCallback<string> OrderTypeSelected { get; set; }
    [Parameter] public EventCallback<int?> StatusSelected { get; set; }
    [Parameter] public EventCallback TableFiltersCleared { get; set; }
    [Parameter] public EventCallback TransientSurfacesClosed { get; set; }
    [Parameter] public EventCallback<Guid> CodeToggled { get; set; }
    [Parameter] public EventCallback<Guid> NoteToggled { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }

    private IList<VppRequestResDTO> selectedOrders = [];

    protected override void OnParametersSet()
    {
        selectedOrders = SelectedOrderId.HasValue
            ? Orders.Where(order => order.Id == SelectedOrderId.Value).Take(1).ToList()
            : [];
    }

    private void OnRowRender(RowRenderEventArgs<VppRequestResDTO> args)
    {
        if (!SelectedOrderId.HasValue || args.Data is null || args.Data.Id != SelectedOrderId.Value)
        {
            return;
        }

        args.Attributes["aria-selected"] = "true";
        if (args.Attributes.TryGetValue("class", out var value) && value is not null)
        {
            args.Attributes["class"] = $"{value} rz-state-highlight vpp-history-row-selected";
        }
        else
        {
            args.Attributes["class"] = "rz-state-highlight vpp-history-row-selected";
        }
    }

    private IReadOnlyList<VppFilterOption<string>> OrderTypeOptions =>
    [
        new(string.Empty, Loc["HistoryAllOrderTypes"]),
        new("regular", Loc["Regular"]),
        new("additional", Loc["AdditionalOrder"])
    ];

    private IReadOnlyList<VppFilterOption<int?>> StatusOptions =>
    [
        new(null, Loc["HistoryAllStatuses"]),
        new(1, Loc["Submitted"]),
        new(4, Loc["Cancelled"]),
        new(6, Loc["Pending"]),
        new(7, Loc["Approved"]),
        new(8, Loc["Rejected"])
    ];

    private string EffectiveTitle => string.IsNullOrWhiteSpace(Title)
        ? Loc["HistoryOrderList"].Value
        : Title;
}
