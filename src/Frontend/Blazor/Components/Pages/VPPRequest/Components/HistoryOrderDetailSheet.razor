@* PAGE: VPPRequest/Components/HistoryOrderDetailSheet.razor *@
@* Atlas orderDetailSheet: drawer chi tiết phiếu (backdrop + header + tóm tắt + toolbar lọc + bảng ảo hóa) — state do Tab_History giữ. *@
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_fe.Helpers
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryFormat

@if (IsOpen && SelectedOrder is not null)
{
    <button type="button"
            class="vpp-history-drawer-backdrop @(IsSettlementDetail ? "vpp-settlement-detail-backdrop" : null)"
            aria-label="@Loc["Close"]"
            @onclick="CloseRequested"></button>
}
@* DETAIL: Drawer chi tiết phiếu lịch sử. *@
<aside class="vpp-history-drawer @(IsOpen ? "is-open" : null) @(IsFullscreen ? "is-fullscreen" : null) @Class"
           @ref="DrawerElement"
           tabindex="-1"
           role="dialog"
           aria-modal="@(IsOpen ? "true" : "false")"
           aria-labelledby="history-drawer-title">
        @* HEADER: Mã phiếu, trạng thái và các thao tác xuất/đóng drawer. *@
        <header class="vpp-history-drawer-header">
            <div class="vpp-history-sheet-heading">
                <p class="vpp-history-sheet-kicker">GTAS VPP — <span>@Loc["HistoryDetailSheetTitle"]</span></p>
                @if (SelectedOrder is not null)
                {
                    <div class="vpp-history-drawer-code">
                        <h2 id="history-drawer-title">@SelectedOrder.VppCode</h2>
                        @if (!IsAggregateView)
                        {
                            <VppStatusBadge Tone="@StatusDisplay.GetTone(SelectedOrder.Status)" Text="@Loc[StatusDisplay.GetResourceKey(SelectedOrder.Status, SelectedOrder.IsDeadlinePassed, SelectedOrder.IsAdditionalOrder)]" />
                        }
                    </div>
                }
            </div>
            @if (SelectedOrder is not null && !HasDetailError)
            {
                @* D10: xuất phiếu ngay từ màn lịch sử, tái dùng ExportOrderAsync của BaseOrderTab. *@
                <div class="vpp-history-drawer-actions">
                    @if (ShowPostSettlementCorrection && PostSettlementCorrectionRequested.HasDelegate)
                    {
                        <RadzenButton Icon="edit_note"
                                      Text="@PostSettlementCorrectionText"
                                      ButtonStyle="ButtonStyle.Warning"
                                      Variant="Variant.Outlined"
                                      Disabled="@IsDetailLoading"
                                      Click="@(_ => PostSettlementCorrectionRequested.InvokeAsync())" />
                    }
                    @if (ShowExportActions)
                    {
                        <VppFileExportActions BusyFormat="@BusyExportFormat"
                                              ExportRequested="@ExportRequested"
                                              Disabled="@IsDetailLoading"
                                              AriaContext="@SelectedOrder.VppCode" />
                    }
                    @if (FullscreenRequested.HasDelegate)
                    {
                        <RadzenButton Icon="@(IsFullscreen ? "close_fullscreen" : "open_in_full")"
                                      Text="@(IsFullscreen ? Loc["ExitFullscreen"] : Loc["ViewFullscreen"])"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Base"
                                      Variant="Variant.Text"
                                      Click="@FullscreenRequested"
                                      aria-label="@(IsFullscreen ? Loc["ExitFullscreen"] : Loc["ViewFullscreen"])" />
                    }
                    <RadzenButton Icon="close"
                                  class="vpp-history-drawer-close"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Base"
                                  Variant="Variant.Text"
                                  Click="@CloseRequested"
                                  aria-label="@Loc["Close"]" />
                </div>
            }
        </header>

        @if (IsDetailLoading && SelectedOrder is null)
        {
            <div class="vpp-history-drawer-loading">
                <div class="vpp-history-detail-loading" role="status" aria-live="polite" aria-label="@Loc["Loading"]">
                    <span class="vpp-history-skeleton vpp-history-skeleton-summary"></span>
                    <span class="vpp-history-skeleton vpp-history-skeleton-toolbar"></span>
                    @for (var i = 0; i < 6; i++) { <span class="vpp-history-skeleton vpp-history-skeleton-detail-row"></span> }
                </div>
            </div>
        }
        else if (SelectedOrder is null)
        {
            <VppContentState State="@(HasTableFilters && TotalCount == 0 ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                             FillAvailable="true"
                             Icon="receipt_long"
                             Title="@(HasTableFilters && TotalCount == 0 ? Loc["NoOrdersMatchSelectedFilters"] : Loc["HistorySelectOrder"] )"
                             Description="@(HasTableFilters && TotalCount == 0 ? Loc["HistoryAdjustFilters"] : Loc["HistorySelectOrderDescription"] )"
                             Class="vpp-history-state-panel vpp-history-detail-state vpp-history-detail-no-selection" />
        }
        else if (HasDetailError)
        {
            <VppContentState State="VppContentStateKind.Error"
                             FillAvailable="true"
                             Icon="error"
                             Title="@Loc["HistoryDetailsLoadFailed"]"
                             Description="@Loc["HistoryDetailsErrorDescription"]"
                             PrimaryActionText="@Loc["Retry"]"
                             PrimaryActionIcon="@VppIcons.Reset"
                             PrimaryAction="@(_ => RetryRequested.InvokeAsync())"
                             Class="vpp-history-state-panel vpp-history-detail-state" />
        }
        else
        {
            @* SUMMARY: Thông tin tổng quan của phiếu đang chọn. *@
            <section class="vpp-history-drawer-summary">
                @if (OrderOptions.Count > 1)
                {
                    <div class="vpp-history-order-picker">
                        <span>@OrderPickerLabel</span>
                        <VppFilterSelect TValue="Guid"
                                         Value="@SelectedOrderId"
                                         Options="@OrderOptions"
                                         ValueChanged="@OrderSelectionChanged"
                                         Placeholder="@OrderPickerLabel"
                                         AriaLabel="@OrderPickerLabel"
                                         Active="false"
                                         Disabled="@OrderPickerDisabled" />
                    </div>
                }
                @* Header phiếu bám đúng trật tự dữ liệu của bản PDF canonical. *@
                <dl class="vpp-history-order-meta @(IsAggregateView ? "is-aggregate" : null)">
                    <div><dt>@Loc["Period"]</dt><dd>@SelectedOrder.Period</dd></div>
                    @if (IsAggregateView)
                    {
                        <div><dt>@Loc["SettlementGroupOrderCount"]</dt><dd>@AggregateOrderCount</dd></div>
                        <div><dt>@Loc["OrderItems"]</dt><dd>@SelectedOrder.TotalLines</dd></div>
                        <div><dt>@Loc["TotalQuantity"]</dt><dd>@SelectedOrder.TotalQty</dd></div>
                    }
                    else if (PeriodStateDisplay.IsKnown(SelectedOrder.PeriodState))
                    {
                        <div><dt>@Loc["PeriodStateLabel"]</dt><dd><VppPeriodStateBadge State="@SelectedOrder.PeriodState" Class="vpp-history-period-state" /></dd></div>
                    }
                    @if (!IsAggregateView)
                    {
                        <div><dt>@Loc["HistoryOrderType"]</dt><dd><VppCategoryChip Text="@(SelectedOrder.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])" Tone="@(SelectedOrder.IsAdditionalOrder ? VppCategoryTone.Accent : VppCategoryTone.Neutral)" Class="vpp-history-order-type" /></dd></div>
                        <div><dt>@Loc["HistoryRequester"]</dt><dd title="@SelectedOrder.RequesterName">@(string.IsNullOrWhiteSpace(SelectedOrder.RequesterName) ? "–" : SelectedOrder.RequesterName)</dd></div>
                        <div><dt>@Loc["Department"]</dt><dd title="@SelectedOrder.DepartmentCode">@(string.IsNullOrWhiteSpace(SelectedOrder.DepartmentCode) ? "–" : SelectedOrder.DepartmentCode)</dd></div>
                        <div><dt>@Loc["SubmittedAtLabel"]</dt><dd>@(SelectedOrder.SubmittedDate.HasValue ? DateFormatter.Format(SelectedOrder.SubmittedDate, DateFormatter.LongDate) : "–")</dd></div>
                        @if (!string.IsNullOrWhiteSpace(SelectedSupplierName))
                        {
                            <div><dt>@Loc["SupplyPrimarySupplier"]</dt><dd title="@SelectedSupplierName">@SelectedSupplierName</dd></div>
                        }
                    }
                    @if (SelectedOrderAmount.HasValue)
                    {
                        <div><dt>@Loc["Amount"]</dt><dd class="vpp-history-order-amount">@SelectedOrderAmount.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</dd></div>
                    }
                </dl>
                @if (!IsAggregateView)
                {
                    <div class="vpp-history-order-note">
                        <span>@Loc["Note"]</span>
                        <p>@(string.IsNullOrWhiteSpace(SelectedOrder.Description) ? "–" : SelectedOrder.Description)</p>
                    </div>
                }
            </section>

            @* Atlas approval-items-heading: mỏ neo thị giác giữa phần tóm tắt và vùng lọc. *@
            <div class="vpp-history-items-heading">
                <div>
                    <h3>@Loc["HistoryItemsHeading"]</h3>
                    <p>@Loc["HistoryItemsHeadingHint"]</p>
                </div>
                <div class="vpp-history-items-summary" aria-label="@Loc["HistoryItemsHeading"]">
                    <span><strong>@FormatNumber(SelectedOrder.TotalLines)</strong> @Loc["HistoryItem"]</span>
                    <span><strong>@FormatNumber(SelectedOrder.TotalQty)</strong> @Loc["TotalQuantity"]</span>
                </div>
            </div>

            <VppOrderItemsSurface @key="(SelectedOrder.Id, DetailRows.Count)"
                                  @ref="_detailSurface"
                                  Variant="VppOrderItemsSurfaceVariant.HistoryDrawer"
                                  Items="@DetailRows"
                                  TotalItemCount="@(SelectedOrder.Items?.Count ?? 0)"
                                  AriaLabel="@Loc["HistoryItemsHeading"]"
                                  UnitHeaderLabel="@UnitHeaderLabel"
                                  ActiveCodeNumber="@ActiveDetailCodeNumber"
                                  ActiveNoteNumber="@ActiveDetailNoteNumber"
                                  CodeToggled="@DetailCodeToggled"
                                  NoteToggled="@DetailNoteToggled"
                                  CopyRequested="@CopyRequested"
                                  Categories="@DetailCategories"
                                  Units="@DetailUoms"
                                  SearchText="@DetailSearch"
                                  SelectedCategory="@DetailCategory"
                                  SelectedUnit="@DetailUom"
                                  HasFilters="@HasDetailFilters"
                                  SearchPlaceholder="@Loc["HistorySearchItem"]"
                                  FiltersAriaLabel="@Loc["CatalogFilters"]"
                                  CategoryAriaLabel="@Loc["Category"]"
                                  AllCategoriesText="@Loc["HistoryAllCategories"]"
                                  AllUnitsText="@Loc["HistoryAllUnits"]"
                                  ClearFiltersText="@Loc["HistoryClearFilters"]"
                                  SearchChanged="@DetailSearchChanged"
                                  CategorySelected="@DetailCategorySelected"
                                  UnitSelected="@DetailUomSelected"
                                  FiltersCleared="@DetailFiltersCleared" />
            @if (IsDetailLoading)
            {
                <div class="vpp-history-region-loading vpp-history-detail-refresh" role="status" aria-live="polite"><span class="vpp-history-state-spinner" aria-hidden="true"></span>@Loc["Loading"]</div>
            }
        }
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsFullscreen { get; set; }
    [Parameter] public bool IsAggregateView { get; set; }
    [Parameter] public int AggregateOrderCount { get; set; }
    [Parameter] public bool ShowExportActions { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public VppRequestResDTO? SelectedOrder { get; set; }
    [Parameter] public Guid SelectedOrderId { get; set; }
    [Parameter] public IReadOnlyList<VppFilterOption<Guid>> OrderOptions { get; set; } = [];
    [Parameter] public string OrderPickerLabel { get; set; } = string.Empty;
    [Parameter] public bool OrderPickerDisabled { get; set; }
    [Parameter] public string? SelectedSupplierName { get; set; }
  [Parameter] public decimal? SelectedOrderAmount { get; set; }
    [Parameter] public bool IsDetailLoading { get; set; }
    [Parameter] public bool HasDetailError { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<VppOrderDetailItem> DetailRows { get; set; } = [];
    [Parameter] public IReadOnlyList<string> DetailCategories { get; set; } = [];
    [Parameter] public IReadOnlyList<string> DetailUoms { get; set; } = [];
    [Parameter] public string DetailSearch { get; set; } = string.Empty;
    [Parameter] public string DetailCategory { get; set; } = string.Empty;
    [Parameter] public string DetailUom { get; set; } = string.Empty;
    [Parameter] public int? ActiveDetailCodeNumber { get; set; }
    [Parameter] public int? ActiveDetailNoteNumber { get; set; }
    [Parameter] public bool HasDetailFilters { get; set; }
    [Parameter] public bool HasTableFilters { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public string UnitHeaderLabel { get; set; } = string.Empty;
    [Parameter] public VppFileExportFormat? BusyExportFormat { get; set; }
    [Parameter] public bool ShowPostSettlementCorrection { get; set; }
    [Parameter] public string PostSettlementCorrectionText { get; set; } = string.Empty;
    [Parameter] public EventCallback CloseRequested { get; set; }
    [Parameter] public EventCallback<Guid> OrderSelectionChanged { get; set; }
    [Parameter] public EventCallback FullscreenRequested { get; set; }
    [Parameter] public EventCallback<VppFileExportFormat> ExportRequested { get; set; }
    [Parameter] public EventCallback PostSettlementCorrectionRequested { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> DetailSearchChanged { get; set; }
    [Parameter] public EventCallback<string> DetailCategorySelected { get; set; }
    [Parameter] public EventCallback<string> DetailUomSelected { get; set; }
    [Parameter] public EventCallback DetailFiltersCleared { get; set; }
    [Parameter] public EventCallback<int> DetailCodeToggled { get; set; }
    [Parameter] public EventCallback<int> DetailNoteToggled { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }

    private VppOrderItemsSurface? _detailSurface;
    private bool IsSettlementDetail => Class?.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Contains("vpp-settlement-detail-drawer", StringComparer.Ordinal) == true;

    /// <summary>Element của aside drawer — Tab_History dùng cho JS focusHistoryDrawer.</summary>
    public ElementReference DrawerElement { get; private set; }

    /// <summary>Cho Tab_History gọi Reload() bảng chi tiết sau khi lọc lại dữ liệu.</summary>
    public async Task ReloadDetailGridAsync()
    {
        if (_detailSurface is not null)
        {
            await _detailSurface.ReloadAsync();
        }
    }
}
