@* Atlas orderDetailSheet: drawer chi tiết phiếu (backdrop + header + tóm tắt + toolbar lọc + bảng ảo hóa) — state do Tab_History giữ. *@
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_fe.Helpers
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryUiKeys
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryFormat

@if (IsOpen && SelectedOrder is not null)
{
    <button type="button" class="vpp-history-drawer-backdrop" aria-label="@Loc["Close"]" @onclick="CloseRequested"></button>
}
<aside class="vpp-history-drawer @(IsOpen ? "is-open" : null)"
           @ref="DrawerElement"
           tabindex="-1"
           role="dialog"
           aria-modal="@(IsOpen ? "true" : "false")"
           aria-labelledby="history-drawer-title">
        <header class="vpp-history-drawer-header">
            <div>
                @* Atlas orderDetailSheet: kicker "Phiếu chi tiết đơn" + mã + badge + meta "Gửi lúc ...". *@
                <h2 id="history-drawer-title">@Loc["HistoryDetailSheetTitle"]</h2>
                @if (SelectedOrder is not null)
                {
                    <div class="vpp-history-drawer-code">
                        <strong>@SelectedOrder.VppCode</strong>
                        <span class="vpp-badge @StatusDisplay.GetCssClass(SelectedOrder.Status)">@Loc[StatusDisplay.GetResourceKey(SelectedOrder.Status, SelectedOrder.IsDeadlinePassed, SelectedOrder.IsAdditionalOrder)]</span>
                    </div>
                    @if (SelectedOrder.SubmittedDate.HasValue)
                    {
                        <span class="vpp-history-drawer-submitted">
                            @string.Format(Loc["SubmittedAtInlineFormat"].Value, DateFormatter.Format(SelectedOrder.SubmittedDate, DateFormatter.LongDate))
                        </span>
                    }
                }
            </div>
            @if (SelectedOrder is not null && !HasDetailError)
            {
                @* D10: xuất phiếu ngay từ màn lịch sử, tái dùng ExportOrderAsync của BaseOrderTab. *@
                <div class="vpp-history-drawer-actions">
                    <RadzenButton Icon="picture_as_pdf"
                                  Text="@Loc["ExportPdf"]"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Base"
                                  Variant="Variant.Text"
                                  Click="@(async _ => await ExportRequested.InvokeAsync("export.pdf"))"
                                  Title="@Loc["ExportPdf"]"
                                  aria-label="@string.Format(Loc["ExportOrderPdfAria"], SelectedOrder.VppCode)"
                                  Disabled="@(IsDetailLoading || IsExporting)" />
                    <RadzenButton Icon="table_view"
                                  Text="@Loc["ExportExcel"]"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Base"
                                  Variant="Variant.Text"
                                  Click="@(async _ => await ExportRequested.InvokeAsync("export.xlsx"))"
                                  Title="@Loc["ExportExcel"]"
                                  aria-label="@string.Format(Loc["ExportOrderExcelAria"], SelectedOrder.VppCode)"
                                  Disabled="@(IsDetailLoading || IsExporting)" />
                </div>
            }
        </header>

        @if (IsDetailLoading && SelectedOrder is null)
        {
            <div class="vpp-history-drawer-loading">
                <div class="vpp-history-detail-loading" role="status" aria-live="polite" aria-label="@Loc["Loading"]">
                    <span class="vpp-history-skeleton vpp-history-skeleton-summary"></span>
                    <span class="vpp-history-skeleton vpp-history-skeleton-toolbar"></span>
                    @for (var i = 0; i < 6; i++) { <span class="vpp-history-skeleton vpp-history-skeleton-detail-row"></span> }
                </div>
            </div>
        }
        else if (SelectedOrder is null)
        {
            <VppStatePanel State="empty"
                           Icon="receipt_long"
                           Title="@(HasTableFilters && TotalCount == 0 ? Loc["NoOrdersMatchSelectedFilters"] : Loc["HistorySelectOrder"] )"
                           Description="@(HasTableFilters && TotalCount == 0 ? Loc["HistoryAdjustFilters"] : Loc["HistorySelectOrderDescription"] )"
                           Class="vpp-history-state-panel vpp-history-detail-state vpp-history-detail-no-selection" />
        }
        else if (HasDetailError)
        {
            <VppStatePanel State="error"
                           Icon="error"
                           Title="@Loc["HistoryDetailsLoadFailed"]"
                           Description="@Loc["HistoryDetailsErrorDescription"]"
                           RetryText="@Loc["Retry"]"
                           RetryAction="@(_ => RetryRequested.InvokeAsync())"
                           Class="vpp-history-state-panel vpp-history-detail-state" />
        }
        else
        {
            <section class="vpp-history-drawer-summary">
                @* Atlas: 4 ô Kỳ · Loại đơn · Người đặt · Phòng ban (Ngày gửi đã chuyển lên header; DTO chỉ có mã phòng ban — xem retrofit #11). *@
                <dl class="vpp-history-order-meta">
                    <div><dt>@Loc["Period"]</dt><dd>@SelectedOrder.Period</dd></div>
                    <div><dt>@Loc["HistoryOrderType"]</dt><dd><span class="vpp-history-order-type @(SelectedOrder.IsAdditionalOrder ? "is-additional" : "is-regular")">@(SelectedOrder.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])</span></dd></div>
                    <div><dt>@Loc["HistoryRequester"]</dt><dd title="@SelectedOrder.RequesterName">@(string.IsNullOrWhiteSpace(SelectedOrder.RequesterName) ? "–" : SelectedOrder.RequesterName)</dd></div>
                    <div><dt>@Loc["Department"]</dt><dd title="@SelectedOrder.DepartmentCode">@(string.IsNullOrWhiteSpace(SelectedOrder.DepartmentCode) ? "–" : SelectedOrder.DepartmentCode)</dd></div>
                </dl>
                <dl class="vpp-history-order-totals">
                    <div><dd>@FormatNumber(SelectedOrder.TotalLines)</dd><dt>@Loc["HistoryItem"]</dt></div>
                    <div><dd>@FormatNumber(SelectedOrder.TotalQty)</dd><dt>@Loc["TotalQuantity"]</dt></div>
                </dl>
                <div class="vpp-history-order-note">
                    <div>
                        <span>@Loc["Note"]</span>
                        <p>@(string.IsNullOrWhiteSpace(SelectedOrder.Description) ? "–" : SelectedOrder.Description)</p>
                    </div>
                    <button type="button" @onclick="HistoryRequested">
                        @Loc["ViewRequestHistory"]
                        <VppIcon Name="chevron_right" />
                    </button>
                </div>
            </section>

            @* Atlas approval-items-heading: mỏ neo thị giác giữa phần tóm tắt và vùng lọc. *@
            <div class="vpp-history-items-heading">
                <div>
                    <h3>@Loc["HistoryItemsHeading"]</h3>
                    <p>@Loc["HistoryItemsHeadingHint"]</p>
                </div>
                <span class="vpp-badge status-info">@Loc["ItemsCount", SelectedOrder.Items?.Count ?? 0]</span>
            </div>

            <div class="vpp-history-detail-toolbar">
                <label class="vpp-history-search vpp-history-detail-search @(!string.IsNullOrWhiteSpace(DetailSearch) ? "is-active" : string.Empty)">
                    <VppIcon Name="search" />
                    <input value="@DetailSearch"
                           @oninput="DetailSearchChanged"
                           placeholder="@Loc["HistorySearchItem"]"
                           aria-label="@Loc["HistorySearchItem"]" />
                </label>
                <div class="vpp-history-select vpp-history-detail-select" @onclick:stopPropagation>
                    <button type="button" class="vpp-history-select-trigger @(!string.IsNullOrEmpty(DetailCategory) ? "is-active" : string.Empty)"
                            aria-haspopup="listbox" aria-expanded="@(OpenFilterMenu == CategoryMenu)"
                            aria-label="@Loc["Category"]" title="@DetailCategoryLabel" @onclick="@(() => FilterMenuToggled.InvokeAsync(CategoryMenu))" @onclick:stopPropagation>
                        <span class="vpp-history-select-label">@DetailCategoryLabel</span><VppIcon Name="expand_more" />
                    </button>
                    @if (OpenFilterMenu == CategoryMenu)
                    {
                        <div class="vpp-history-select-menu" role="listbox" @onclick:stopPropagation>
                            <button type="button" role="option" aria-selected="@string.IsNullOrEmpty(DetailCategory)" @onclick="@(() => DetailCategorySelected.InvokeAsync(string.Empty))">@Loc["HistoryAllCategories"]</button>
                            @foreach (var category in DetailCategories)
                            {
                                <button type="button" role="option" aria-selected="@(DetailCategory == category)" title="@category" @onclick="@(() => DetailCategorySelected.InvokeAsync(category))">@category</button>
                            }
                        </div>
                    }
                </div>
                @* Atlas order-detail-toolbar: bộ lọc thứ ba "Tất cả đơn vị" (lọc client-side theo UomName). *@
                <div class="vpp-history-select vpp-history-detail-select" @onclick:stopPropagation>
                    <button type="button" class="vpp-history-select-trigger @(!string.IsNullOrEmpty(DetailUom) ? "is-active" : string.Empty)"
                            aria-haspopup="listbox" aria-expanded="@(OpenFilterMenu == UomMenu)"
                            aria-label="@UnitHeaderLabel" title="@DetailUomLabel" @onclick="@(() => FilterMenuToggled.InvokeAsync(UomMenu))" @onclick:stopPropagation>
                        <span class="vpp-history-select-label">@DetailUomLabel</span><VppIcon Name="expand_more" />
                    </button>
                    @if (OpenFilterMenu == UomMenu)
                    {
                        <div class="vpp-history-select-menu" role="listbox" @onclick:stopPropagation>
                            <button type="button" role="option" aria-selected="@string.IsNullOrEmpty(DetailUom)" @onclick="@(() => DetailUomSelected.InvokeAsync(string.Empty))">@Loc["HistoryAllUnits"]</button>
                            @foreach (var uom in DetailUoms)
                            {
                                <button type="button" role="option" aria-selected="@(DetailUom == uom)" title="@uom" @onclick="@(() => DetailUomSelected.InvokeAsync(uom))">@uom</button>
                            }
                        </div>
                    }
                </div>
                <button type="button"
                        class="vpp-history-clear vpp-history-detail-clear @(HasDetailFilters ? "is-active" : string.Empty)"
                        @onclick="DetailFiltersCleared">
                    <VppIcon Name="filter_alt_off" />
                    @Loc["HistoryClearFilters"]
                </button>
            </div>

            <VppOrderItemsSurface @ref="_detailSurface"
                                  Variant="VppOrderItemsSurfaceVariant.HistoryDrawer"
                                  Items="@DetailRows"
                                  TotalItemCount="@(SelectedOrder.Items?.Count ?? 0)"
                                  AriaLabel="@Loc["HistoryItemsHeading"]"
                                  UnitHeaderLabel="@UnitHeaderLabel"
                                  ActiveCode="@ActiveDetailCode"
                                  ActiveNoteNumber="@ActiveDetailNoteNumber"
                                  CodeToggled="@DetailCodeToggled"
                                  NoteToggled="@DetailNoteToggled"
                                  CopyRequested="@CopyRequested" />
            @if (IsDetailLoading)
            {
                <div class="vpp-history-region-loading vpp-history-detail-refresh" role="status" aria-live="polite"><span class="vpp-history-state-spinner" aria-hidden="true"></span>@Loc["Loading"]</div>
            }
        }
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public VppRequestResDTO? SelectedOrder { get; set; }
    [Parameter] public bool IsDetailLoading { get; set; }
    [Parameter] public bool HasDetailError { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<VppOrderDetailItem> DetailRows { get; set; } = [];
    [Parameter] public IReadOnlyList<string> DetailCategories { get; set; } = [];
    [Parameter] public IReadOnlyList<string> DetailUoms { get; set; } = [];
    [Parameter] public string DetailSearch { get; set; } = string.Empty;
    [Parameter] public string DetailCategory { get; set; } = string.Empty;
    [Parameter] public string DetailUom { get; set; } = string.Empty;
    [Parameter] public string OpenFilterMenu { get; set; } = string.Empty;
    [Parameter] public string? ActiveDetailCode { get; set; }
    [Parameter] public int? ActiveDetailNoteNumber { get; set; }
    [Parameter] public bool HasDetailFilters { get; set; }
    [Parameter] public bool HasTableFilters { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public string UnitHeaderLabel { get; set; } = string.Empty;
    [Parameter] public string DetailCategoryLabel { get; set; } = string.Empty;
    [Parameter] public string DetailUomLabel { get; set; } = string.Empty;
    [Parameter] public bool IsExporting { get; set; }
    [Parameter] public EventCallback CloseRequested { get; set; }
    [Parameter] public EventCallback<string> ExportRequested { get; set; }
    [Parameter] public EventCallback HistoryRequested { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> DetailSearchChanged { get; set; }
    [Parameter] public EventCallback<string> FilterMenuToggled { get; set; }
    [Parameter] public EventCallback<string> DetailCategorySelected { get; set; }
    [Parameter] public EventCallback<string> DetailUomSelected { get; set; }
    [Parameter] public EventCallback DetailFiltersCleared { get; set; }
    [Parameter] public EventCallback<string> DetailCodeToggled { get; set; }
    [Parameter] public EventCallback<int> DetailNoteToggled { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }

    private VppOrderItemsSurface? _detailSurface;

    /// <summary>Element của aside drawer — Tab_History dùng cho JS focusHistoryDrawer.</summary>
    public ElementReference DrawerElement { get; private set; }

    /// <summary>Cho Tab_History gọi Reload() bảng chi tiết sau khi lọc lại dữ liệu.</summary>
    public async Task ReloadDetailGridAsync()
    {
        if (_detailSurface is not null)
        {
            await _detailSurface.ReloadAsync();
        }
    }
}
