@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.VPP

<div class="vpp-period-panel">
    @if (periodStatus is not null)
    {
        <section class="vpp-period-hero @HeroStateClass" aria-labelledby="period-review-state-title">
            <div class="vpp-period-hero-main">
                <span class="vpp-period-hero-eyebrow">@string.Format(Loc["DepartmentPeriodMetaFormat"].Value, $"{Month:00}/{Year}")</span>
                <h2 id="period-review-state-title">@HeroTitle</h2>
                <p>@HeroMeta</p>
            </div>
            <ul class="vpp-period-readiness" aria-label="@Loc["SettleReadinessAria"]">
                <li class="@(periodStatus.PendingAdditionalCount == 0 ? "is-pass" : "is-fail")">
                    <VppIcon Name="@(periodStatus.PendingAdditionalCount == 0 ? VppIcons.Check : VppIcons.Warning)" />
                    @(periodStatus.PendingAdditionalCount == 0
                        ? Loc["ReviewNoPendingSupplements"]
                        : string.Format(Loc["ReviewPendingSupplementsFormat"].Value, periodStatus.PendingAdditionalCount))
                </li>
                <li class="@(totalCount > 0 ? "is-pass" : "is-fail")">
                    <VppIcon Name="@(totalCount > 0 ? VppIcons.Check : VppIcons.Error)" />
                    @(totalCount > 0
                        ? string.Format(Loc["ReviewValidOrdersFormat"].Value, totalCount)
                        : Loc["ReviewNoValidOrders"])
                </li>
                @if (periodStatus.IsSettled)
                {
                    <li class="is-info">
                        <VppIcon Name="@VppIcons.Lock" />
                        @string.Format(Loc["Info_AlreadySettled"], DateFormatter.Format(periodStatus.SettledAt, DateFormatter.LongDate), periodStatus.SettledByUserName ?? "-", periodStatus.PriceListName ?? "-")
                    </li>
                }
            </ul>
            @if (periodStatus.PendingAdditionalCount > 0)
            {
                <RadzenButton Icon="approval"
                              Text="@Loc["ReviewOpenApprovals"]"
                              ButtonStyle="ButtonStyle.Warning"
                              Click="@OpenApprovalsAsync" />
            }
        </section>
    }

    <div class="kpi-grid" style="--kpi-cols: 4;">
        <div class="kpi-card kpi-blue"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["TotalOrders"]</span><VppIcon Name="@VppIcons.Orders" /></div><div class="kpi-card-value">@totalCount</div></div></div>
        <div class="kpi-card kpi-emerald"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["TotalLineItems"]</span><VppIcon Name="@VppIcons.Table" /></div><div class="kpi-card-value">@totalLines</div></div></div>
        <div class="kpi-card kpi-amber"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["TotalQuantity"]</span><VppIcon Name="@VppIcons.Catalog" /></div><div class="kpi-card-value">@totalQty</div></div></div>
        <div class="kpi-card kpi-purple"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["Amount"]</span><VppIcon Name="@VppIcons.Price" /></div><div class="kpi-card-value">@FormatMoney(totalAmount)</div></div></div>
    </div>

    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["ReviewOrderBeforeSubmit"]"
                         TestId="period-review-data-surface"
                         Class="vpp-period-data-frame">
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["ReviewOrderBeforeSubmit"]" Class="vpp-period-data-toolbar">
                <div class="vpp-period-data-heading">
                    <h2>@Loc["PeriodReview"]</h2>
                    <span>@Month.ToString("00")/@Year</span>
                </div>
                <div class="vpp-period-filters">
                    <VppFilterSearch Value="@searchText"
                                     Input="@OnSearchInputAsync"
                                     Placeholder="@Loc["HistorySearchOrderOrNote"]"
                                     AriaLabel="@Loc["HistorySearchOrderOrNote"]" />
                    <VppFilterSelect TValue="string"
                                     Value="@selectedOrderType"
                                     Options="@OrderTypeOptions"
                                     ValueChanged="@OnOrderTypeChangedAsync"
                                     Placeholder="@Loc["HistoryAllOrderTypes"]"
                                     AriaLabel="@Loc["HistoryOrderType"]" />
                    <VppFilterSelect TValue="int?"
                                     Value="@selectedStatus"
                                     Options="@StatusOptions"
                                     ValueChanged="@OnStatusChangedAsync"
                                     Placeholder="@Loc["HistoryAllStatuses"]"
                                     AriaLabel="@Loc["Status"]" />
                    <VppClearFiltersButton Text="@Loc["HistoryClearFilters"]"
                                           IsActive="@HasFilters"
                                           Clicked="@ClearFiltersAsync" />
                </div>
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            @if (isLoading)
            {
                <SkeletonPage Cards="0" Rows="7" Cols="9" />
            }
            else if (!string.IsNullOrWhiteSpace(alertMessage))
            {
                <VppContentState State="VppContentStateKind.Error"
                                 Icon="@VppIcons.Error"
                                 Title="@Loc["HistoryLoadFailed"]"
                                 Description="@alertMessage"
                                 PrimaryActionText="@Loc["Retry"]"
                                 PrimaryActionIcon="@VppIcons.Refresh"
                                 PrimaryAction="@(_ => ReloadPeriodAsync())" />
            }
            else if (totalCount == 0 && !isGridLoading)
            {
                <VppContentState State="VppContentStateKind.FilteredEmpty"
                                 Icon="search_off"
                                 Title="@Loc["NoOrdersMatchSelectedFilters"]"
                                 Description="@Loc["HistoryAdjustFilters"]" />
            }
            else
            {
                <div class="vpp-period-grid-wrap">
                    <RadzenDataGrid TItem="VppRequestResDTO"
                                    Data="@orders"
                                    Count="@totalCount"
                                    LoadData="@OnLoadData"
                                    AllowPaging="true"
                                    PageSize="@pageSize"
                                    PageSizeOptions="@VppPagingProfiles.SplitList.PageSizeOptions"
                                    PagerAlwaysVisible="true"
                                    ShowPagingSummary="true"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    AllowSorting="true"
                                    AllowMultiColumnSorting="false"
                                    ShowMultiColumnSortingIndex="false"
                                    GotoFirstPageOnSort="true"
                                    AllowFiltering="false"
                                    AllowColumnResize="false"
                                    AllowAlternatingRows="false"
                                    ExpandMode="DataGridExpandMode.Single"
                                    RowExpand="@OnRowExpandAsync"
                                    IsLoading="@isGridLoading"
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Horizontal"
                                    class="vpp-order-grid vpp-data-grid vpp-data-density-compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(currentSkip + orders.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.DepartmentCode)" Title="@Loc["Department"]" Width="110px" />
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.RequesterName)" Title="@Loc["Username"]" Width="160px" />
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["OrderCode"]" Width="210px">
                                <Template Context="row">
                                    <VppCellValuePopover Value="@row.VppCode"
                                                         Label="@Loc["OrderCode"]"
                                                         CopyLabel="@Loc["Copy"]"
                                                         Kind="VppCellValueKind.Code"
                                                         IsOpen="@(activeCodeOrderId == row.Id)"
                                                         Toggled="@(() => ToggleCode(row.Id))"
                                                         CopyRequested="@CopyToClipboard" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Title="@Loc["HistoryOrderType"]" Width="120px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row"><span class="vpp-badge @(row.IsAdditionalOrder ? "vpp-badge-warning" : "vpp-badge-info")">@(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.StatusText)" Title="@Loc["Status"]" Width="120px" TextAlign="TextAlign.Center"><Template Context="row"><span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@row.StatusText</span></Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalLines)" Title="@Loc["TotalLineItems"]" Width="105px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.TotalQty)" Title="@Loc["TotalQuantity"]" Width="110px" TextAlign="TextAlign.Right" />
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.SubmittedDate)" Title="@Loc["SubmittedDate"]" Width="165px" TextAlign="TextAlign.Center"><Template Context="row">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</Template></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.Description)" Title="@Loc["Note"]" Width="190px" Sortable="false">
                                <Template Context="row">
                                    @if (string.IsNullOrWhiteSpace(row.Description))
                                    {
                                        <span>–</span>
                                    }
                                    else
                                    {
                                        <VppCellValuePopover Value="@row.Description"
                                                             Label="@Loc["Note"]"
                                                             CopyLabel="@Loc["Copy"]"
                                                             Kind="VppCellValueKind.Note"
                                                             IsOpen="@(activeNoteOrderId == row.Id)"
                                                             Toggled="@(() => ToggleNote(row.Id))"
                                                             CopyRequested="@CopyToClipboard" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                        <Template Context="row">
                            <div class="vpp-expand-detail">
                                @if (IsRowDetailLoading(row.Id))
                                {
                                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                                }
                                else
                                {
                                    <RadzenDataGrid TItem="VppRequestDetailResDTO" Data="@(row.Items ?? [])" AllowPaging="false" AllowFiltering="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" class="vpp-order-grid">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Title="#" Width="52px" TextAlign="TextAlign.Center"><Template Context="item">@((row.Items?.IndexOf(item) ?? -1) + 1)</Template></RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="VppName" Title="@Loc["ProductName"]" />
                                            <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="CategoryName" Title="@Loc["Category"]" />
                                            <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="UomName" Title="@Loc["UOM"]" Width="110px" />
                                            <RadzenDataGridColumn TItem="VppRequestDetailResDTO" Property="Qty" Title="@Loc["Quantity"]" Width="100px" TextAlign="TextAlign.Right" />
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </div>
                        </Template>
                    </RadzenDataGrid>
                </div>
            }
        </ChildContent>
        <Footer>
            <div class="vpp-period-action-footer">
                <span>@string.Format(Loc["ReviewValidOrdersFormat"].Value, totalCount)</span>
                <RadzenButton Icon="arrow_forward"
                              Text="@Loc["PeriodDemandStep"]"
                              ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(totalCount == 0 || isLoading)"
                              Click="@OnContinueToDemand" />
            </div>
        </Footer>
    </VppDataSurfaceFrame>
</div>
