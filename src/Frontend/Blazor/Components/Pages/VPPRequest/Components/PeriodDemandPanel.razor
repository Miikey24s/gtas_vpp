@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_fe.Components.Pages.VPPRequest.Tabs

<div class="vpp-period-panel">
    <div class="vpp-period-view-switchbar" role="tablist" aria-label="@Loc["DemandViewMode"]">
        <button type="button" role="tab" aria-selected="@(viewMode == DemandViewMode.ByItem)" class="@(viewMode == DemandViewMode.ByItem ? "is-active" : null)" @onclick="() => SetViewMode(DemandViewMode.ByItem)">@Loc["DemandByItem"]</button>
        <button type="button" role="tab" aria-selected="@(viewMode == DemandViewMode.ByOrder)" class="@(viewMode == DemandViewMode.ByOrder ? "is-active" : null)" @onclick="() => SetViewMode(DemandViewMode.ByOrder)">@Loc["DemandByOrder"]</button>
    </div>

    @if (viewMode == DemandViewMode.ByOrder)
    {
        <div class="vpp-period-orders-view">
            <Tab_AllOrdersSummary claims="@Claims" FixedYear="@Year" FixedMonth="@Month" />
        </div>
        <div class="vpp-period-action-footer is-standalone">
            <span>@Loc["DemandByOrder"] · @Month.ToString("00")/@Year</span>
            <RadzenButton Icon="arrow_forward" Text="@Loc["PeriodSupplyStep"]" ButtonStyle="ButtonStyle.Primary" Click="@OnContinueToSupply" />
        </div>
    }
    else
    {
        <div class="kpi-grid" style="--kpi-cols: 4;">
            <div class="kpi-card kpi-blue"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["DemandValidOrders"]</span><VppIcon Name="@VppIcons.Orders" /></div><div class="kpi-card-value">@(demand?.TotalOrders ?? 0)</div></div></div>
            <div class="kpi-card kpi-emerald"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["DemandUniqueItems"]</span><VppIcon Name="@VppIcons.Catalog" /></div><div class="kpi-card-value">@(demand?.Items.Count ?? 0)</div></div></div>
            <div class="kpi-card kpi-amber"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["TotalQuantity"]</span><VppIcon Name="@VppIcons.Table" /></div><div class="kpi-card-value">@(demand?.TotalQty ?? 0)</div></div></div>
            <div class="kpi-card @(pendingAdditionalCount > 0 ? "kpi-rose" : "kpi-purple")"><div class="kpi-card-content"><div class="kpi-card-header"><span class="kpi-card-label">@Loc["DemandBlockers"]</span><VppIcon Name="@(pendingAdditionalCount > 0 ? VppIcons.Warning : VppIcons.Check)" /></div><div class="kpi-card-value">@pendingAdditionalCount</div></div></div>
        </div>

        <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.Static"
                             Density="VppDataDensity.RichTwoLine"
                             AriaLabel="@Loc["DemandTableTitle"]"
                             TestId="period-demand-data-surface"
                             Class="vpp-period-data-frame">
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["DemandTableTitle"]" Class="vpp-period-data-toolbar">
                    <div class="vpp-period-data-heading">
                        <h2>@Loc["DemandTableTitle"]</h2>
                        <span>@Loc["DemandTableSubtitle"]</span>
                    </div>
                    <div class="vpp-period-filters">
                        <VppFilterSearch Value="@searchText" Input="@OnSearchInput" Placeholder="@Loc["HistorySearchItem"]" AriaLabel="@Loc["HistorySearchItem"]" />
                        <VppFilterSelect TValue="string" Value="@selectedCategory" Options="@CategoryOptions" ValueChanged="@OnCategoryChanged" Placeholder="@Loc["HistoryAllCategories"]" AriaLabel="@Loc["Category"]" />
                        <VppFilterSelect TValue="string" Value="@selectedUom" Options="@UomOptions" ValueChanged="@OnUomChanged" Placeholder="@Loc["HistoryAllUnits"]" AriaLabel="@Loc["UOM"]" />
                        <VppClearFiltersButton Text="@Loc["HistoryClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFilters" />
                    </div>
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
                @if (isLoading)
                {
                    <SkeletonPage Cards="0" Rows="8" Cols="6" />
                }
                else if (demand is null)
                {
                    <VppContentState State="VppContentStateKind.Error" Icon="@VppIcons.Error" Title="@Loc["HistoryLoadFailed"]" Description="@Loc["DemandEmptyDescription"]" PrimaryActionText="@Loc["Retry"]" PrimaryActionIcon="@VppIcons.Refresh" PrimaryAction="@(_ => ReloadAsync())" />
                }
                else if (FilteredItems.Count == 0)
                {
                    <VppContentState State="VppContentStateKind.FilteredEmpty" Icon="search_off" Title="@Loc["NoData"]" Description="@Loc["HistoryAdjustFilters"]" />
                }
                else
                {
                    <div class="vpp-period-grid-wrap">
                        <RadzenDataGrid TItem="AggregatedVppItemResDTO"
                                        Data="@FilteredItems"
                                        AllowPaging="true"
                                        PageSize="20"
                                        PagerAlwaysVisible="true"
                                        ShowPagingSummary="true"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowFiltering="false"
                                        AllowColumnResize="false"
                                        AllowAlternatingRows="false"
                                        ExpandMode="DataGridExpandMode.Single"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-order-grid vpp-data-grid vpp-data-density-rich-two-line">
                            <Columns>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="#" Width="52px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row">@(FilteredItems.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.VppName)" Title="@Loc["HistoryItem"]"><Template Context="row"><div class="vpp-order-product-cell"><strong>@row.VppName</strong><small>@row.VppCode</small></div></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.CategoryName)" Title="@Loc["Category"]" Width="220px" />
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.UomName)" Title="@Loc["UOM"]" Width="120px" />
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Property="@nameof(AggregatedVppItemResDTO.TotalQty)" Title="@Loc["Quantity"]" Width="130px" TextAlign="TextAlign.Right"><Template Context="row"><strong>@row.TotalQty</strong></Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="AggregatedVppItemResDTO" Title="@Loc["DemandBreakdown"]" Width="140px" TextAlign="TextAlign.Center" Sortable="false"><Template Context="row"><span class="vpp-badge vpp-badge-info">@Loc["DemandOrdersCount", row.Breakdown.Count]</span></Template></RadzenDataGridColumn>
                            </Columns>
                            <Template Context="row">
                                <div class="vpp-demand-breakdown">
                                    <table>
                                        <thead><tr><th>@Loc["OrderCode"]</th><th>@Loc["HistoryRequester"]</th><th>@Loc["Quantity"]</th><th>@Loc["Note"]</th></tr></thead>
                                        <tbody>
                                            @foreach (var line in row.Breakdown)
                                            {
                                                <tr><td>@line.Code</td><td>@(string.IsNullOrWhiteSpace(line.RequesterName) ? "–" : line.RequesterName)</td><td>@line.Qty</td><td>@(string.IsNullOrWhiteSpace(line.Note) ? "–" : line.Note)</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </Template>
                        </RadzenDataGrid>
                    </div>
                }
            </ChildContent>
            <Footer>
                <div class="vpp-period-action-footer">
                    <span>@Loc["SupplyPriceComparisonCount", FilteredItems.Count]</span>
                    <RadzenButton Icon="arrow_forward" Text="@Loc["PeriodSupplyStep"]" ButtonStyle="ButtonStyle.Primary" Disabled="@(demand is null || demand.Items.Count == 0)" Click="@OnContinueToSupply" />
                </div>
            </Footer>
        </VppDataSurfaceFrame>
    }
</div>
