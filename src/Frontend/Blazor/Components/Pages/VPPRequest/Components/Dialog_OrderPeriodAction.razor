@using gtas_vpp_shared.DTOs.Req.VPP
@using gtas_vpp_shared.DTOs.Res.VPP
@inject DialogService DialogService

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Standard"
                        TestId="order-period-action-dialog"
                        Class="vpp-order-period-action-dialog">
    <Intro>
        <div class="vpp-order-period-dialog-heading">
            <div>
                <span>Kỳ @PeriodLabel</span>
                <strong>Gia hạn kỳ</strong>
            </div>
            <VppPeriodStateBadge State="@Period.State" Compact="true" />
        </div>
        <VppInlineNotice Tone="VppStatusTone.Info">
            Chỉ kéo dài ngày đóng và hạn duyệt đơn bổ sung. Lý do gia hạn sẽ được lưu vào lịch sử kỳ.
        </VppInlineNotice>
    </Intro>
    <ChildContent>
        <div class="vpp-order-period-dialog-grid">
            <RadzenFormField Text="Ngày đóng mới" Variant="Variant.Outlined">
                <RadzenDatePicker TValue="DateTime"
                                  @bind-Value="DeadlineExtension.CloseAtLocal"
                                  DateFormat="HH:mm dd/MM/yyyy"
                                  ShowTime="true"
                                  ShowSeconds="false"
                                  class="vpp-order-period-dialog-control" />
            </RadzenFormField>
            <RadzenFormField Text="Hạn duyệt đơn bổ sung mới" Variant="Variant.Outlined">
                <RadzenDatePicker TValue="DateTime"
                                  @bind-Value="DeadlineExtension.SupplementApprovalDeadlineLocal"
                                  DateFormat="HH:mm dd/MM/yyyy"
                                  ShowTime="true"
                                  ShowSeconds="false"
                                  class="vpp-order-period-dialog-control" />
            </RadzenFormField>
            <RadzenFormField Text="Lý do gia hạn" Variant="Variant.Outlined" class="is-wide">
                <RadzenTextArea @bind-Value="DeadlineExtension.Reason"
                                Rows="3"
                                MaxLength="500"
                                class="vpp-order-period-dialog-control" />
            </RadzenFormField>
        </div>

        @if (!string.IsNullOrWhiteSpace(ValidationMessage))
        {
            <VppInlineNotice Tone="VppStatusTone.Warning">@ValidationMessage</VppInlineNotice>
        }
    </ChildContent>
    <Footer>
        <VppDialogActions CancelText="Hủy"
                          PrimaryText="Xác nhận gia hạn"
                          PrimaryIcon="event_repeat"
                          PrimaryButtonStyle="ButtonStyle.Primary"
                          CancelClick="@CancelAsync"
                          PrimaryClick="@SubmitAsync" />
    </Footer>
</VppAdaptiveDialogShell>

@code {
    [Parameter, EditorRequired] public VppManagedPeriodResDTO Period { get; set; } = new();

    private bool initialized;
    private string ValidationMessage { get; set; } = string.Empty;
    private VppOrderPeriodExtendDeadlineReqDTO DeadlineExtension { get; set; } = new();
    private string PeriodLabel => $"{Period.Month:00}/{Period.Year}";

    protected override void OnParametersSet()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        DeadlineExtension = new VppOrderPeriodExtendDeadlineReqDTO
        {
            CloseAtLocal = Period.CloseAtLocal.AddDays(1),
            SupplementApprovalDeadlineLocal = Period.SupplementApprovalDeadlineLocal.AddDays(1),
            RowVersion = Period.RowVersion
        };
    }

    private Task CancelAsync() => DialogService.TryCloseAsync(null);

    private async Task SubmitAsync()
    {
        ValidationMessage = Validate();
        if (!string.IsNullOrWhiteSpace(ValidationMessage))
        {
            return;
        }

        DeadlineExtension.Reason = DeadlineExtension.Reason.Trim();
        await DialogService.TryCloseAsync(DeadlineExtension);
    }

    private string Validate()
    {
        if (DeadlineExtension.CloseAtLocal <= Period.CloseAtLocal)
        {
            return "Ngày đóng mới phải muộn hơn ngày đóng hiện tại.";
        }
        if (DeadlineExtension.SupplementApprovalDeadlineLocal < DeadlineExtension.CloseAtLocal)
        {
            return "Hạn duyệt đơn bổ sung không được trước ngày đóng mới.";
        }
        return DeadlineExtension.Reason.Trim().Length < 5
            ? "Nhập lý do gia hạn ít nhất 5 ký tự."
            : string.Empty;
    }
}
