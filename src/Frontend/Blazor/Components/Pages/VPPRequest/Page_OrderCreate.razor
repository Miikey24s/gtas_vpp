@page "/dashboard/order-create"
@using gtas_vpp_fe.Helpers
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Share

<PageTitle>GTAS VPP - @OrderModeTitle</PageTitle>

<CascadingValue Value="Context">
    @if (IsPageLoading)
    {
        <div class="vpp-wizard">
            <SkeletonPage Cards="0" Rows="10" Cols="5" />
        </div>
    }
    else
    {
        <div class="vpp-wizard vpp-order-create-page">
            <VppWorkflowStepper Steps="@OrderWorkflowSteps"
                                AriaLabel="@Loc["OrderCreationSteps"]"
                                StepSelected="@OnOrderWorkflowStepSelected" />

            @if (!CanSubmitForPeriod)
            {
                <VppStatePanel State="warning"
                               Icon="event_busy"
                               Title="@Loc["RequestActionUnavailable"]"
                               Description="@PeriodActionReason" />
            }

            <section class="vpp-wizard-stage">
                @if (currentStep == 0)
                {
                    <OrderCreateStep2 TargetPeriodLabel="@TargetPeriodText"
                                      BackRequested="@GoBack"
                                      SaveDraftRequested="@(async () => await SaveDraftAsync(true))"
                                      CanSaveDraft="@(!IsEdit)"
                                      NextRequested="@GoNextStepAsync" />
                }
                else
                {
                    <OrderCreateStep3 />
                    <div class="vpp-wizard-nav vpp-order-review-actions">
                        <button type="button" class="vpp-order-review-back" @onclick="GoPreviousStep">
                            <VppIcon Name="arrow_back" />
                            <span>@Loc["Previous"]</span>
                        </button>
                        <RadzenButton Icon="send"
                                      Text="@PrimaryActionText"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(IsSaving || SelectedItemCount == 0 || !CanSubmitForPeriod)"
                                      IsBusy="@IsSaving"
                                      BusyText="@Loc["Saving"]"
                                      Click="@SubmitAsync" />
                    </div>
                }
            </section>
        </div>
    }
</CascadingValue>
