@* PAGE: VPPRequest/Page_OrderCreate.razor *@
@page "/dashboard/order-create"
@using gtas_vpp_fe.Features.Requests.Editor
@using gtas_vpp_fe.Helpers
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Share

<PageTitle>GTAS VPP - @OrderModeTitle</PageTitle>

@* WORKFLOW: Khởi tạo editor context và hiển thị trạng thái của trang. *@
<CascadingValue Value="Editor">
    @if (IsPageLoading)
    {
        <div class="vpp-wizard">
            <SkeletonPage Cards="0" Rows="10" Cols="5" />
        </div>
    }
    else
    {
        <div class="vpp-wizard vpp-order-create-page">
            @* HEADER: Thanh bước của quy trình tạo đơn. *@
            <VppWorkflowStepper Steps="@OrderWorkflowSteps"
                                AriaLabel="@Loc["OrderCreationSteps"]"
                                StepSelected="@OnOrderWorkflowStepSelected" />

            @if (!CanSubmitForPeriod)
            {
                <VppContentState State="VppContentStateKind.Warning"
                                 Icon="event_busy"
                                 Title="@Loc["RequestActionUnavailable"]"
                                 Description="@PeriodActionReason" />
            }

            @* CONTENT: Nội dung của bước hiện tại trong quy trình tạo đơn. *@
            <section class="vpp-wizard-stage">
                @if (Editor.CurrentStep == OrderEditorStep.Products)
                {
                    <OrderCreateStep2 TargetPeriodLabel="@TargetPeriodText"
                                      BackRequested="@GoBack"
                                      SaveDraftRequested="@(async () => await SaveDraftAsync(true))"
                                      CanSaveDraft="@(!IsEdit)"
                                      NextRequested="@GoNextStepAsync" />
                }
                else
                {
                    <OrderCreateStep3 SupplementReasonRequested="@OpenSupplementReasonForm" />
                    @* FOOTER: Quay lại hoặc gửi đơn sau khi review. *@
                    <div class="vpp-wizard-nav vpp-order-review-actions">
                        <button type="button" class="vpp-order-review-back" @onclick="GoPreviousStep">
                            <VppIcon Name="arrow_back" />
                            <span>@Loc["Previous"]</span>
                        </button>
                        <RadzenButton Icon="send"
                                      Text="@PrimaryActionText"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(IsSaving || SelectedItemCount == 0 || !CanSubmitForPeriod)"
                                      IsBusy="@IsSaving"
                                      BusyText="@Loc["Saving"]"
                                      Click="@SubmitAsync" />
                    </div>
                }
            </section>

            @* DIALOG: Nhập lý do khi tạo đơn bổ sung. *@
            @if (_showSupplementReasonForm)
            {
                <div class="vpp-supplement-reason-backdrop" @onclick="CloseSupplementReasonForm">
                    <section class="vpp-supplement-reason-dialog"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="supplement-reason-title"
                             @onclick:stopPropagation>
                        @* HEADER: Tiêu đề dialog và nút đóng. *@
                        <header>
                            <div>
                                <strong id="supplement-reason-title">@Loc["SupplementReason"]</strong>
                                <span>@Loc["OrderBeingCreated"]</span>
                            </div>
                            <button type="button" aria-label="@Loc["Close"]" @onclick="CloseSupplementReasonForm">
                                <VppIcon Name="close" />
                            </button>
                        </header>

                        @* CONTENT: Nội dung lý do và thông báo validation. *@
                        <textarea value="@_supplementReasonDraft"
                                  @oninput="args => UpdateSupplementReasonDraft(args.Value?.ToString())"
                                  maxlength="500"
                                  autofocus
                                  aria-describedby="supplement-reason-help"
                                  placeholder="@Loc["SupplementReasonPlaceholder"]"></textarea>
                        <small id="supplement-reason-help" class="@(_supplementReasonTouched && !CanSaveSupplementReason ? "is-invalid" : null)">
                            @(_supplementReasonTouched && !CanSaveSupplementReason
                                ? Loc["ProvideReasonBeforeContinue"]
                                : Loc["OrderNoteScopeHint"])
                        </small>

                        @* FOOTER: Hủy hoặc lưu lý do bổ sung. *@
                        <footer>
                            <button type="button" class="vpp-supplement-reason-cancel" @onclick="CloseSupplementReasonForm">@Loc["Cancel"]</button>
                            <button type="button"
                                    class="vpp-supplement-reason-save"
                                    disabled="@(!CanSaveSupplementReason)"
                                    @onclick="SaveSupplementReason">
                                <VppIcon Name="check" />
                                <span>@Loc["SaveNote"]</span>
                            </button>
                        </footer>
                    </section>
                </div>
            }
        </div>
    }
</CascadingValue>
