@inherits gtas_vpp_fe.Components.Pages.VPPRequest.Tabs.BaseOrderTab
@using gtas_vpp_fe.Components.Pages.VPPRequest.Components

@if (CanView)
{
    @if (ShowPeriodNavigation)
    {
        <nav class="vpp-local-header-tabs"
             aria-label="@Loc["PeriodOperations"]">
            <VppHeaderTabGroup ParentLabel="@Loc["PeriodOperations"]"
                               Tabs="@PeriodHeaderTabs" />
        </nav>
    }

    @if (ShowSettlementWorkspace)
    {
        <PeriodOperationsWorkspace Claims="@claims"
                                   ActiveStep="@ActivePeriodTab"
                                   NavigateRequested="@NavigateToPeriodTab"
                                   SettlementChanged="@RefreshAfterSettlementChangeAsync" />
    }
    else if (ShowApprovalsContent)
    {
        <PendingApprovalWorkspace Orders="@PendingOrders"
                                  TotalCount="@TotalCount"
                                  TotalLines="@TotalLines"
                                  TotalQuantity="@TotalQty"
                                  PageSize="@PageSize"
                                  CurrentSkip="@CurrentSkip"
                                  IsLoading="@IsLoading"
                                  IsGridLoading="@IsGridLoading"
                                  HasGridLoadError="@HasGridLoadError"
                                  CanApprove="@CanApprove"
                                  CanReject="@CanReject"
                                  BusyExportFormat="@ExportingOrderFormat"
                                  SelectedOrder="@SelectedPendingOrder"
                                  Processing="@IsProcessing"
                                  DetailLoading="@IsRowDetailLoading"
                                  SearchText="@PendingSearchText"
                                  SelectedDepartment="@PendingDepartmentCode"
                                  DepartmentOptions="@PendingDepartmentOptions"
                                  HasFilters="@PendingHasFilters"
                                  ReloadRequested="@ReloadPendingWorkspaceAsync"
                                  LoadDataRequested="@OnPendingLoadDataAsync"
                                  OrderSelected="@SelectPendingOrderAsync"
                                  ApproveRequested="@HandleApproveClick"
                                  RejectRequested="@HandleRejectClick"
                                  SearchChanged="@OnPendingSearchChangedAsync"
                                  DepartmentSelected="@OnPendingDepartmentSelectedAsync"
                                  ClearFiltersRequested="@ClearPendingFiltersAsync"
                                  CopyRequested="@CopyToClipboard"
                                  ExportRequested="@ExportPendingOrderAsync" />
    }
    else
    {
        <VppContentState State="VppContentStateKind.Denied"
                         Icon="lock"
                         Title="@Loc["AccessDenied"]"
                         Description="@Loc["NoPermission"]"
                         SecondaryActionText="@Loc["BackToAllowedPage"]"
                         SecondaryActionHref="/" />
    }
}
else
{
    <VppContentState State="VppContentStateKind.Denied"
                     Icon="lock"
                     Title="@Loc["AccessDenied"]"
                     Description="@Loc["NoPermission"]"
                     SecondaryActionText="@Loc["BackToAllowedPage"]"
                     SecondaryActionHref="/" />
}
