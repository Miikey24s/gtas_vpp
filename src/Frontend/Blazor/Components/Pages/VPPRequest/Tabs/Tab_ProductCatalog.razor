@* PAGE: VPPRequest/Tabs/Tab_ProductCatalog.razor *@
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.Library
@inject IToastService Toast

@if (CanView)
{
    @* HEADER: Workspace danh mục mặt hàng. *@
    <div class="vpp-catalog-workspace">
        <VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@IsFirstLoading">
        @if (IsFirstLoading)
        {
            <SkeletonPage Cards="0" Rows="10" Cols="5" FillAvailable="true" />
        }
        else
        {
            <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                                 Density="VppDataDensity.RichTwoLine"
                                 Bordered="true"
                                 IsBusy="@IsGridLoading"
                                 State="@CatalogSurfaceState"
                                 AriaLabel="@Loc["ProductCatalog"]"
                                 TestId="catalog-data-surface"
                                 Class="vpp-catalog-data-frame">
                    @* TOOLBAR: Tìm kiếm, lọc danh mục/đơn vị và xóa bộ lọc. *@
                    <Toolbar>
                        <VppDataToolbar AriaLabel="@Loc["CatalogFilters"]"
                                        Class="vpp-catalog-filter-group">
                            <VppFilterSearch Value="@SearchText"
                                             Input="@OnSearchInput"
                                             Placeholder="@Loc["SearchCatalogItems"]"
                                             AriaLabel="@Loc["SearchCatalogItems"]" />
                            <VppFilterSelect TValue="string"
                                             Value="@CategoryFilterValue"
                                             Options="@CategoryOptions"
                                             ValueChanged="@OnCategoryChanged"
                                             Placeholder="@Loc["AllCategories"]"
                                             AriaLabel="@Loc["AllCategories"]" />
                            <VppFilterSelect TValue="string"
                                             Value="@(UnitFilter ?? string.Empty)"
                                             Options="@UnitOptions"
                                             ValueChanged="@OnUnitChanged"
                                             Placeholder="@Loc["AllUnits"]"
                                             AriaLabel="@Loc["AllUnits"]" />
                            <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                                   IsActive="@HasFilters"
                                                   Clicked="@ClearFiltersAsync" />
                        </VppDataToolbar>
                    </Toolbar>
                    @* CONTENT: Trạng thái lỗi/rỗng hoặc bảng dữ liệu danh mục. *@
                    <ChildContent>
                        <div class="vpp-catalog-grid-frame">
                            @* TABLE: Bảng danh mục với paging và sorting phía server. *@
                            <RadzenDataGrid @ref="productGrid"
                                        TItem="VppItemResDTO"
                                        Data="@Products"
                                        Count="@ProductCount"
                                        LoadData="@LoadProductsAsync"
                                        AllowPaging="true"
                                        PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                                        PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                                        PagerAlwaysVisible="true"
                                        ShowPagingSummary="true"
                                        PagingSummaryFormat="@Loc["CatalogPagingSummary"]"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowMultiColumnSorting="false"
                                        ShowMultiColumnSortingIndex="false"
                                        GotoFirstPageOnSort="true"
                                        AllowFiltering="false"
                                        AllowAlternatingRows="false"
                                        AllowColumnResize="true"
                                        IsLoading="@IsGridLoading"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-catalog-grid vpp-data-grid vpp-data-density-rich-two-line">
                            <EmptyTemplate>
                                <VppDataGridEmptyState State="@(HasLoadError ? VppContentStateKind.Error : HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                                       Icon="@(HasLoadError ? "error_outline" : null)"
                                                       Title="@(HasLoadError ? Loc["CatalogLoadFailed"].Value : HasFilters ? Loc["NoCatalogProductsMatchQuery"].Value : Loc["NoData"].Value)"
                                                       Description="@(HasLoadError ? Loc["CatalogLoadFailedDescription"].Value : HasFilters ? Loc["AdjustCatalogFilters"].Value : null)"
                                                       PrimaryActionText="@(HasLoadError ? Loc["Retry"].Value : null)"
                                                       PrimaryActionIcon="@(HasLoadError ? VppIcons.Reset : null)"
                                                       PrimaryAction="@(_ => ReloadAsync())" />
                            </EmptyTemplate>
                            @* COLUMNS: STT, mặt hàng, danh mục, đơn vị và mô tả. *@
                            <Columns>
                                <RadzenDataGridColumn TItem="VppItemResDTO" Title="#" Width="56px" MinWidth="56px" TextAlign="TextAlign.Center" Sortable="false" Resizable="false">
                                    <Template Context="row">@(CurrentSkip + Products.IndexOf(row) + 1)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppName" Title="@Loc["ItemName"]" Width="300px" MinWidth="280px" TextAlign="TextAlign.Left">
                                    <Template Context="row">
                                        <div class="vpp-catalog-item-cell">
                                            <strong>@row.VppName</strong>
                                            <small>@row.VppCode</small>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppCategoryName" Title="@Loc["Category"]" Width="220px" MinWidth="200px" TextAlign="TextAlign.Left" />
                                <RadzenDataGridColumn TItem="VppItemResDTO" Property="UomName" Title="@Loc["UOM"]" Width="110px" MinWidth="100px" TextAlign="TextAlign.Center" />
                                   <RadzenDataGridColumn TItem="VppItemResDTO" Property="Description" Title="@Loc["Description"]" Width="300px" MinWidth="280px" TextAlign="TextAlign.Left">
                                          <Template Context="row">
                                        <span class="vpp-catalog-description" title="@row.Description">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                            </RadzenDataGrid>
                        </div>
                    </ChildContent>
            </VppDataSurfaceFrame>
        }
        </VppCollectionWorkspace>
    </div>
}
else
{
    <VppContentState State="VppContentStateKind.Denied"
                     FillAvailable="true"
                     Icon="lock"
                     Title="@Loc["AccessDenied"]"
                     Description="@Loc["NoPermission"]"
                     SecondaryActionText="@Loc["BackToAllowedPage"]"
                     SecondaryActionHref="/" />
}

@code {
    private VppDataSurfaceState CatalogSurfaceState => HasLoadError
        ? VppDataSurfaceState.Error
        : IsGridLoading
            ? VppDataSurfaceState.Loading
            : ProductCount == 0
                ? HasFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty
                : VppDataSurfaceState.Populated;
}
