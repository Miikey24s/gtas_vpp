@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Share
@inject IToastService Toast

@if (CanView)
{
    <div class="vpp-catalog-workspace">
        <VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@IsFirstLoading">
        @if (IsFirstLoading)
        {
            <SkeletonPage Cards="0" Rows="10" Cols="5" />
        }
        else
        {
            <section class="vpp-catalog-card" aria-labelledby="catalog-result-title">
                <header class="vpp-catalog-card-header">
                    <div class="vpp-catalog-heading">
                        <h2 id="catalog-result-title">@Loc["AvailableCatalogItems", ProductCount]</h2>
                        <p>@Loc["CatalogReferenceDescription"]</p>
                    </div>
                    <div class="vpp-catalog-filter-group" aria-label="@Loc["CatalogFilters"]">
                        <label class="vpp-catalog-search">
                            <VppIcon Name="search" />
                            <input value="@SearchText"
                                   @oninput="OnSearchInput"
                                   placeholder="@Loc["SearchCatalogItems"]"
                                   aria-label="@Loc["SearchCatalogItems"]" />
                        </label>

                        <RadzenDropDown TValue="Guid?"
                                        Data="@CategoryOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Value="@CategoryFilter"
                                        Change="@OnCategoryChanged"
                                        Placeholder="@Loc["AllCategories"]"
                                        aria-label="@Loc["AllCategories"]"
                                        class="vpp-catalog-select" />

                        <RadzenDropDown TValue="string"
                                        Data="@UnitOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Value="@UnitFilter"
                                        Change="@OnUnitChanged"
                                        Placeholder="@Loc["AllUnits"]"
                                        aria-label="@Loc["AllUnits"]"
                                        class="vpp-catalog-select" />

                        <button type="button" class="vpp-flat-action" @onclick="ClearFiltersAsync">
                            <VppIcon Name="filter_alt_off" />
                            <span>@Loc["ClearFilters"]</span>
                        </button>
                    </div>
                </header>

                @if (HasLoadError)
                {
                    <VppContentState State="VppContentStateKind.Error"
                                     Icon="error_outline"
                                     Title="@Loc["CatalogLoadFailed"]"
                                     Description="@Loc["CatalogLoadFailedDescription"]"
                                     PrimaryActionText="@Loc["Retry"]"
                                     PrimaryActionIcon="@VppIcons.Refresh"
                                     PrimaryAction="@(_ => ReloadAsync())"
                                     Class="vpp-catalog-state" />
                }
                else if (ProductCount == 0 && !IsGridLoading)
                {
                    <VppContentState State="VppContentStateKind.FilteredEmpty"
                                     Icon="search_off"
                                     Title="@Loc["NoCatalogProductsMatchQuery"]"
                                     Description="@Loc["AdjustCatalogFilters"]"
                                     Class="vpp-catalog-state" />
                }
                else
                {
                    <div class="vpp-catalog-grid-frame">
                        <RadzenDataGrid @ref="productGrid"
                                        TItem="ProductItem"
                                        Data="@Products"
                                        Count="@ProductCount"
                                        LoadData="@LoadProductsAsync"
                                        AllowPaging="true"
                                        PageSize="20"
                                        PagerAlwaysVisible="false"
                                        ShowPagingSummary="true"
                                        PagingSummaryFormat="@Loc["CatalogPagingSummary"]"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        AllowFiltering="false"
                                        AllowAlternatingRows="false"
                                        AllowColumnResize="true"
                                        IsLoading="@IsGridLoading"
                                        Density="Density.Compact"
                                        GridLines="DataGridGridLines.Horizontal"
                                        class="vpp-catalog-grid">
                            <Columns>
                                @* Atlas catalog: bảng tra cứu 4 cột, không có cột thứ tự "#" (mã VPP ở ô mặt hàng đã tự định danh dòng). *@
                                <RadzenDataGridColumn TItem="ProductItem" Property="VppName" Title="@Loc["ItemName"]" TextAlign="TextAlign.Left">
                                    <Template Context="row">
                                        <div class="vpp-catalog-item-cell">
                                            <strong>@row.VppName</strong>
                                            <small>@row.VppCode</small>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="ProductItem" Property="VppCategoryName" Title="@Loc["Category"]" Width="260px" TextAlign="TextAlign.Left" />
                                <RadzenDataGridColumn TItem="ProductItem" Property="UomName" Title="@Loc["UOM"]" Width="130px" TextAlign="TextAlign.Center" />
                                <RadzenDataGridColumn TItem="ProductItem" Property="Description" Title="@Loc["Description"]" Width="340px" TextAlign="TextAlign.Left">
                                    <Template Context="row">
                                        <span class="vpp-catalog-description" title="@row.Description">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
            </section>
        }
        </VppCollectionWorkspace>
    </div>
}
else
{
    <VppEmptyState Icon="lock"
                   Title="@Loc["AccessDenied"]"
                   Description="@Loc["NoPermission"]"
                   SecondaryText="@Loc["BackToAllowedPage"]"
                   SecondaryHref="/" />
}
