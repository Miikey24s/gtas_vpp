@using gtas_vpp_fe.Components.Pages.VPPRequest.Components
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_fe.Helpers
@inject DialogService DialogService
@inject GlobalClass glb
@inject IToastService Toast

@if (CanView)
{
    <div class="vpp-orders-workspace order-page">
        @if (IsLoading)
        {
            <SkeletonPage Cards="3" Rows="5" Cols="4" />
        }
        else
        {
            <section class="vpp-orders-story vpp-orders-overview" aria-labelledby="orders-story-title">
                <header class="vpp-orders-story-header">
                    <div class="vpp-orders-story-intro">
                        <div class="vpp-orders-eyebrow">
                            <VppIcon Name="@VppIcons.Calendar" />
                            <span class="vpp-orders-period-label">@Loc["ActiveOrderPeriod"]</span>
                        </div>

                        <div class="vpp-orders-story-heading">
                            <div class="vpp-orders-period-row">
                                <h2 id="orders-story-title">@CurrentOrderPeriodText</h2>
                                @if (PeriodInfo is not null)
                                {
                                    <span class="vpp-orders-deadline-inline">
                                        <VppIcon Name="@VppIcons.Schedule" />
                                        @RemainingDeadlineText · @Loc["SubmissionDeadline"] @CurrentDeadlineText
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(OrdersStoryDescription))
                            {
                                <p>@OrdersStoryDescription</p>
                            }
                        </div>
                    </div>
                </header>

                <div class="vpp-orders-story-controls">
                    <div class="vpp-orders-summary-grid" role="group" aria-label="@Loc["OrderCycleSummary"]">
                        <article class="@(OrderViewSelectedIndex == CurrentOrderViewIndex ? "is-selected" : string.Empty)">
                            <button type="button"
                                    @onclick="() => SelectOrderViewAsync(CurrentOrderViewIndex)"
                                    aria-pressed="@(OrderViewSelectedIndex == CurrentOrderViewIndex ? "true" : "false")">
                                <span class="vpp-orders-summary-label">
                                    <span>@Loc["CurrentRegularOrder"]</span>
                                    <span class="vpp-orders-summary-count">@CurrentRegularLineCount</span>
                                </span>
                            </button>
                        </article>
                        <article class="@(OrderViewSelectedIndex == SupplementOrderViewIndex ? "is-selected" : string.Empty)">
                            <button type="button"
                                    @onclick="() => SelectOrderViewAsync(SupplementOrderViewIndex)"
                                    aria-pressed="@(OrderViewSelectedIndex == SupplementOrderViewIndex ? "true" : "false")">
                                <span class="vpp-orders-summary-label">
                                    <span>@Loc["AdditionalOrders"]</span>
                                    <span class="vpp-orders-summary-count">@SelectedSupplementLineCount</span>
                                </span>
                            </button>
                        </article>
                        <article class="@(OrderViewSelectedIndex == PreviousOrderViewIndex ? "is-selected" : string.Empty)">
                            <button type="button"
                                    @onclick="() => SelectOrderViewAsync(PreviousOrderViewIndex)"
                                    aria-pressed="@(OrderViewSelectedIndex == PreviousOrderViewIndex ? "true" : "false")">
                                <span class="vpp-orders-summary-label">
                                    <span>@Loc["PreviousOrderPeriod"]</span>
                                    <span class="vpp-orders-summary-count">@PreviousOrderLineCount</span>
                                </span>
                            </button>
                        </article>
                    </div>

                    <div class="vpp-orders-story-commands">
                        @if (OrderViewSelectedIndex == CurrentOrderViewIndex)
                        {
                            <div class="vpp-orders-story-actions" aria-label="@Loc["Actions"]">
                                @if (CanCreateRegular)
                                {
                                    <RadzenButton Icon="@VppIcons.Add"
                                                  Text="@Loc["CreateOrderThisCycle"]"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Click="@(async _ => await GoToCreatePage(false))" />
                                }
                                else if (CanCopyPrevious)
                                {
                                    <RadzenButton Icon="@VppIcons.Copy"
                                                  Text="@Loc["CopyPreviousOrder"]"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Variant="Variant.Outlined"
                                                  Click="@(async _ => await CopyPreviousAsync())" />
                                }
                            </div>
                        }
                        else if (OrderViewSelectedIndex == SupplementOrderViewIndex && ShowSupplementAction)
                        {
                            <div class="vpp-orders-story-actions" aria-label="@Loc["Actions"]">
                                <RadzenButton Icon="@VppIcons.Add"
                                              Text="@Loc["RequestAdditional"]"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@(async _ => await GoToCreatePage(true))"
                                              Disabled="@(!CanCreateSupplement)"
                                              Title="@SupplementActionHint"
                                              data-testid="create-supplement" />
                            </div>
                        }
                        else if (OrderViewSelectedIndex == PreviousOrderViewIndex && CanCopyPrevious)
                        {
                            <div class="vpp-orders-story-actions" aria-label="@Loc["Actions"]">
                                <RadzenButton Icon="@VppIcons.Copy"
                                              Text="@Loc["CopyPreviousOrder"]"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Outlined"
                                              Click="@(async _ => await CopyPreviousAsync())" />
                            </div>
                        }
                    </div>
                </div>

                <div class="vpp-orders-selection-summary" role="status" aria-live="polite">
                    <strong>@SelectedOrderViewTitle</strong>
                    <span aria-hidden="true">·</span>
                    <span>@SelectedOrderViewSummary</span>
                </div>
            </section>

            <div class="vpp-orders-selected-view">
                @if (OrderViewSelectedIndex == CurrentOrderViewIndex)
                {
                    <VppOrderWorkspacePanel @key="@CurrentRegularOrder?.Id"
                                            TestId="current-order-panel"
                                            PanelLabel="@Loc["CurrentRegularOrder"]"
                                            Order="@CurrentRegularOrder"
                                            SelectedOrderId="@(CurrentRegularOrder?.Id ?? Guid.Empty)"
                                            CanEdit="@(CurrentRegularOrder is not null && CanUpdate(CurrentRegularOrder))"
                                            CanReplace="@(CurrentRegularOrder is not null && CanReplace(CurrentRegularOrder))"
                                            CanCancel="@(CurrentRegularOrder is not null && CanCancel(CurrentRegularOrder))"
                                            IsCancelling="@(CurrentRegularOrder is not null && IsCancelling(CurrentRegularOrder.Id))"
                                            EmptyIcon="@VppIcons.Orders"
                                            EmptyTitle="@Loc["NoCurrentRegularOrders"]"
                                            EmptyDescription="@EmptyCurrentOrdersDescription"
                                            EditRequested="@GoToEditPage"
                                            HistoryRequested="@OpenHistoryAsync"
                                            CancelRequested="@CancelOrderAsync"
                                            ExportPdfRequested="@ExportOrderPdfAsync"
                                            ExportExcelRequested="@ExportOrderExcelAsync"
                                            IsExporting="@IsExportingOrder"
                                            CopyCodeRequested="@CopyToClipboard" />
                }
                else if (OrderViewSelectedIndex == SupplementOrderViewIndex)
                {
                    <VppOrderWorkspacePanel @key="@SelectedSupplementOrder?.Id"
                                            TestId="supplement-order-panel"
                                            PanelLabel="@Loc["AdditionalOrders"]"
                                            Order="@SelectedSupplementOrder"
                                            AvailableOrders="@CurrentPeriodAdditionalOrders"
                                            SelectedOrderId="@(SelectedSupplementOrder?.Id ?? Guid.Empty)"
                                            SelectedOrderIdChanged="@SelectSupplementOrderAsync"
                                            CanEdit="@(SelectedSupplementOrder is not null && CanUpdate(SelectedSupplementOrder))"
                                            CanReplace="@(SelectedSupplementOrder is not null && CanReplace(SelectedSupplementOrder))"
                                            CanCancel="@(SelectedSupplementOrder is not null && CanCancel(SelectedSupplementOrder))"
                                            IsCancelling="@(SelectedSupplementOrder is not null && IsCancelling(SelectedSupplementOrder.Id))"
                                            EmptyIcon="@VppIcons.Supplement"
                                            EmptyTitle="@Loc["NoAdditionalOrdersYet"]"
                                            EmptyDescription="@SupplementSectionDescription"
                                            EditRequested="@GoToEditPage"
                                            HistoryRequested="@OpenHistoryAsync"
                                            CancelRequested="@CancelOrderAsync"
                                            ExportPdfRequested="@ExportOrderPdfAsync"
                                            ExportExcelRequested="@ExportOrderExcelAsync"
                                            IsExporting="@IsExportingOrder"
                                            CopyCodeRequested="@CopyToClipboard" />
                }
                else
                {
                    <VppOrderWorkspacePanel @key="@PreviousRegularOrder?.Id"
                                            TestId="previous-order-panel"
                                            PanelLabel="@($"{Loc["PreviousOrderPeriod"]} · {PreviousOrderPeriodText}")"
                                            Order="@PreviousRegularOrder"
                                            SelectedOrderId="@(PreviousRegularOrder?.Id ?? Guid.Empty)"
                                            ReadOnly="true"
                                            EmptyIcon="@VppIcons.History"
                                            EmptyTitle="@Loc["NoPreviousOrderYet"]"
                                            EmptyDescription="@Loc["NoRegularOrdersFoundPreviousCycle"]"
                                            HistoryRequested="@OpenHistoryAsync"
                                            ExportPdfRequested="@ExportOrderPdfAsync"
                                            ExportExcelRequested="@ExportOrderExcelAsync"
                                            IsExporting="@IsExportingOrder"
                                            CopyCodeRequested="@CopyToClipboard" />
                }
            </div>
        }
    </div>
}
