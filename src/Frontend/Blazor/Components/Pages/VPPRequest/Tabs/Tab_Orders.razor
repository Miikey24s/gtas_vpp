@* PAGE: VPPRequest/Tabs/Tab_Orders.razor *@
@using gtas_vpp_fe.Components.Pages.VPPRequest.Components
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_fe.Helpers
@inject DialogService DialogService
@inject IToastService Toast

@if (CanView)
{
    @* HEADER: Một kỳ và hai mốc hạn luôn hiện cùng nhau để dễ đối chiếu. *@
    <div class="vpp-orders-workspace order-page">
        @if (IsLoading)
        {
            <SkeletonPage Cards="3" Rows="5" Cols="4" FillAvailable="true" />
        }
        else
        {
            <section class="vpp-orders-decision-area" aria-label="@Loc["OrderPeriod"]">
                <VppDecisionCardGroup Class="vpp-orders-decision-cards">
                    <VppDecisionSelect TValue="Guid?"
                                       Value="@PeriodInfo?.SelectedPeriodId"
                                       Options="@OpenPeriodOptions"
                                       ValueChanged="@ChangeSelectedPeriodAsync"
                                       Placeholder="@CurrentOrderPeriodText"
                                       AriaLabel="@Loc["OrderPeriod"]"
                                       Eyebrow="@Loc["OrderPeriod"]"
                                       Class="vpp-decision-card vpp-orders-period-decision-card"
                                       TriggerClass="vpp-decision-card-trigger"
                                       Disabled="@(PeriodInfo is null || OpenPeriodOptions.Count == 0)" />

                    <div class="vpp-decision-card-context vpp-orders-deadline-context @GetDeadlineToneClass(RegularDeadlineDate)"
                         aria-label="@Loc["RegularOrderDeadline"]">
                        <small>@Loc["RegularOrderDeadline"]</small>
                        <div class="vpp-decision-card-context-body">
                            <span class="vpp-orders-deadline-status">
                                <VppIcon Name="@VppIcons.Schedule" />
                                <strong>@GetDeadlineStatusText(RegularDeadlineDate)</strong>
                            </span>
                            <time datetime="@RegularDeadlineDate.ToString("O")">@FormatDeadline(RegularDeadlineDate)</time>
                        </div>
                    </div>

                    <div class="vpp-decision-card-context vpp-orders-deadline-context @GetDeadlineToneClass(SupplementDeadlineDate)"
                         aria-label="@Loc["SupplementOrderDeadline"]">
                        <small>@Loc["SupplementOrderDeadline"]</small>
                        <div class="vpp-decision-card-context-body">
                            <span class="vpp-orders-deadline-status">
                                <VppIcon Name="@VppIcons.Schedule" />
                                <strong>@GetDeadlineStatusText(SupplementDeadlineDate)</strong>
                            </span>
                            <time datetime="@SupplementDeadlineDate.ToString("O")">@FormatDeadline(SupplementDeadlineDate)</time>
                        </div>
                    </div>
                </VppDecisionCardGroup>
            </section>

            @* TOOLBAR: Loại đơn áp dụng cho kỳ được chọn ở card phía trên. *@
            <section class="vpp-orders-view-switchbar" aria-label="@Loc["OrderCycleSummary"]">
                <div class="vpp-orders-view-controls">
                    <VppSegmentedSelector TValue="int"
                                          Value="@OrderViewSelectedIndex"
                                          Options="@OrderViewOptions"
                                          ValueChanged="@SelectOrderViewAsync"
                                          AriaLabel="@Loc["OrderCycleSummary"]"
                                          Class="vpp-orders-view-selector" />
                </div>

            </section>

            @* CONTENT: Hiển thị workspace của view đang được chọn. *@
            <div class="vpp-orders-selected-view">
                @if (OrderViewSelectedIndex == CurrentOrderViewIndex)
                {
                    <VppOrderWorkspacePanel @key="@CurrentRegularOrder?.Id"
                                            TestId="current-order-panel"
                                            PanelLabel="@Loc["RegularOrder"]"
                                            Order="@CurrentRegularOrder"
                                            SelectedOrderId="@(CurrentRegularOrder?.Id ?? Guid.Empty)"
                                             CanEdit="@(CurrentRegularOrder is not null && CanUpdate(CurrentRegularOrder))"
                                             CanRestore="@(CurrentRegularOrder is not null && CanRestore(CurrentRegularOrder))"
                                             CanRecreate="@(CurrentRegularOrder is not null && CanRecreate(CurrentRegularOrder))"
                                             CanCancel="@(CurrentRegularOrder is not null && CanCancel(CurrentRegularOrder))"
                                             ShowEditAction="@CanUpdateOwnOrders"
                                             ShowRestoreAction="@CanUpdateOwnOrders"
                                             ShowRecreateAction="@CanUpdateOwnOrders"
                                             ShowCancelAction="@CanCancelOwnOrders"
                                            IsCancelling="@(CurrentRegularOrder is not null && IsCancelling(CurrentRegularOrder.Id))"
                                            IsRestoring="@(CurrentRegularOrder is not null && IsRestoring(CurrentRegularOrder.Id))"
                                            EmptyIcon="@VppIcons.Orders"
                                            EmptyTitle="@Loc["NoCurrentRegularOrders"]"
                                            EmptyDescription="@EmptyCurrentOrdersDescription"
                                            EmptyActionText="@CurrentEmptyActionText"
                                            EmptyActionClick="@CurrentEmptyActionRequested"
                                            PrimaryActionText="@CurrentPrimaryActionText"
                                            PrimaryActionIcon="@CurrentPrimaryActionIcon"
                                            PrimaryActionRequested="@CurrentPrimaryActionRequested"
                                            EditRequested="@GoToEditPage"
                                            RestoreRequested="@RestoreCancelledOrderAsync"
                                            RecreateRequested="@GoToRecreatePage"
                                            HistoryRequested="@OpenHistoryAsync"
                                            CancelRequested="@CancelOrderAsync"
                                            ExportRequested="@(format => ExportOrderAsync(CurrentRegularOrder!, format))"
                                            BusyExportFormat="@ExportingOrderFormat"
                                            CopyCodeRequested="@CopyToClipboard" />
                }
                else if (OrderViewSelectedIndex == SupplementOrderViewIndex)
                {
                    <VppOrderWorkspacePanel @key="@SelectedSupplementOrder?.Id"
                                            TestId="supplement-order-panel"
                                            PanelLabel="@Loc["AdditionalOrders"]"
                                            Order="@SelectedSupplementOrder"
                                            AvailableOrders="@CurrentPeriodAdditionalOrders"
                                            SelectedOrderId="@(SelectedSupplementOrder?.Id ?? Guid.Empty)"
                                            SelectedOrderIdChanged="@SelectSupplementOrderAsync"
                                             CanEdit="@(SelectedSupplementOrder is not null && CanUpdate(SelectedSupplementOrder))"
                                             CanRestore="@(SelectedSupplementOrder is not null && CanRestore(SelectedSupplementOrder))"
                                             CanRecreate="@(SelectedSupplementOrder is not null && CanRecreate(SelectedSupplementOrder))"
                                             CanCancel="@(SelectedSupplementOrder is not null && CanCancel(SelectedSupplementOrder))"
                                             ShowEditAction="@CanUpdateOwnOrders"
                                             ShowRestoreAction="@CanUpdateOwnOrders"
                                             ShowRecreateAction="@CanUpdateOwnOrders"
                                             ShowCancelAction="@CanCancelOwnOrders"
                                            IsCancelling="@(SelectedSupplementOrder is not null && IsCancelling(SelectedSupplementOrder.Id))"
                                            IsRestoring="@(SelectedSupplementOrder is not null && IsRestoring(SelectedSupplementOrder.Id))"
                                            EmptyIcon="@VppIcons.Supplement"
                                            EmptyTitle="@Loc["NoAdditionalOrdersYet"]"
                                            EmptyDescription="@SupplementSectionDescription"
                                            EmptyActionText="@SupplementEmptyActionText"
                                            EmptyActionClick="@CreateSupplementOrderAsync"
                                            PrimaryActionText="@SupplementPrimaryActionText"
                                            PrimaryActionIcon="@VppIcons.Add"
                                            PrimaryActionRequested="@CreateSupplementOrderAsync"
                                            PrimaryActionDisabled="@(!CanCreateSupplement)"
                                            PrimaryActionTitle="@SupplementActionHint"
                                            PrimaryActionTestId="create-supplement"
                                            EditRequested="@GoToEditPage"
                                            RestoreRequested="@RestoreCancelledOrderAsync"
                                            RecreateRequested="@GoToRecreatePage"
                                            HistoryRequested="@OpenHistoryAsync"
                                            CancelRequested="@CancelOrderAsync"
                                            ExportRequested="@(format => ExportOrderAsync(SelectedSupplementOrder!, format))"
                                            BusyExportFormat="@ExportingOrderFormat"
                                            CopyCodeRequested="@CopyToClipboard" />
                }
            </div>
        }
    </div>
}
