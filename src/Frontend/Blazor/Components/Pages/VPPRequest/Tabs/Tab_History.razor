@inherits gtas_vpp_fe.Components.Pages.VPPRequest.Tabs.BaseOrderTab
@using gtas_vpp_fe.Components.Pages.VPPRequest.Components
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryUiKeys

@* Coordinator màn Lịch sử: giữ toàn bộ state và handler; markup từng vùng Atlas nằm trong 5 component con
   (HistoryScopeBar · HistoryKpiCards · HistoryTrendChart · HistoryOrderList · HistoryOrderDetailSheet). *@
<div class="vpp-history-page @(_isSummaryLoading && !_isInitialLoading ? "is-summary-refreshing" : string.Empty) @(IsGridLoading && !_isInitialLoading ? "is-grid-refreshing" : string.Empty)" @ref="_historyRoot" aria-busy="@IsRefreshing">
    @if (!CanView)
    {
        <VppEmptyState Icon="lock"
                       Title="@Loc["AccessDenied"]"
                       Description="@Loc["NoPermission"]"
                       SecondaryText="@Loc["BackToAllowedPage"]"
                       SecondaryHref="/" />
    }
    else if (_isInitialLoading)
    {
        <div class="vpp-history-loading-state" role="status" aria-live="polite" aria-label="@Loc["Loading"]">
            <div class="vpp-history-loading-toolbar"><span class="vpp-history-skeleton vpp-history-skeleton-scope"></span></div>
            <div class="vpp-history-loading-kpis">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="vpp-history-loading-kpi"><span class="vpp-history-skeleton vpp-history-skeleton-label"></span><span class="vpp-history-skeleton vpp-history-skeleton-value"></span></div>
                }
            </div>
            <div class="vpp-history-loading-chart"><span class="vpp-history-skeleton vpp-history-skeleton-title"></span><span class="vpp-history-skeleton vpp-history-skeleton-chart"></span></div>
            <div class="vpp-history-loading-table"><span class="vpp-history-skeleton vpp-history-skeleton-title"></span>@for (var i = 0; i < 5; i++) { <span class="vpp-history-skeleton vpp-history-skeleton-row"></span> }</div>
            <div class="vpp-history-loading-drawer"><span class="vpp-history-skeleton vpp-history-skeleton-summary"></span><span class="vpp-history-skeleton vpp-history-skeleton-toolbar"></span>@for (var i = 0; i < 7; i++) { <span class="vpp-history-skeleton vpp-history-skeleton-detail-row"></span> }</div>
        </div>
    }
    else
    {
        <HistoryScopeBar Scope="@_scope"
                         ShowCustomRange="@_showCustomRange"
                         CustomFrom="@_customFrom"
                         CustomTo="@_customTo"
                         PresetScopeSelected="@SelectPresetScopeAsync"
                         CustomScopeRequested="@(() => SelectScopeAsync(CustomScope))"
                         CustomFromChanged="@OnCustomFromChanged"
                         CustomToChanged="@OnCustomToChanged"
                         CustomRangeApplied="@ApplyCustomRangeAsync" />

        @if (_summaryError)
        {
            <VppStatePanel State="error"
                           Icon="error"
                           Title="@Loc["HistoryLoadFailed"]"
                           Description="@Loc["HistoryLoadErrorDescription"]"
                           RetryText="@Loc["Retry"]"
                           RetryAction="@(_ => RefreshAsync())"
                           Class="vpp-history-state-panel" />
        }
        else if (_summary is null)
        {
            <VppEmptyState Icon="history"
                           Title="@Loc["NoHistoryOrders"]"
                           Description="@Loc["HistoryNoOrdersDescription"]"
                           PrimaryText="@Loc["Refresh"]"
                           PrimaryAction="@(_ => RefreshAsync())"
                           Class="vpp-history-state-panel" />
        }
        else
        {
            <HistoryKpiCards Summary="@_summary"
                             ActiveKpi="@_activeKpi"
                             ChartRangeLabel="@ChartRangeLabel"
                             KpiToggled="@ToggleKpi" />

            <HistoryTrendChart Summary="@_summary"
                               ShowRegularSeries="@_showRegularSeries"
                               ShowAdditionalSeries="@_showAdditionalSeries"
                               IsSummaryLoading="@_isSummaryLoading"
                               HasSelectedPeriod="@_selectedPeriod.HasValue"
                               SelectedPeriodLabel="@SelectedPeriodLabel"
                               ChartRangeLabel="@ChartRangeLabel"
                               ChartAccessibleLabel="@ChartAccessibleLabel"
                               SeriesClicked="@OnChartSeriesClick"
                               SelectedPeriodCleared="@ClearSelectedPeriodAsync"
                               SeriesToggled="@ToggleChartSeries" />

            <HistoryOrderList Orders="@Orders"
                              TotalCount="@TotalCount"
                              PageSize="@PageSize"
                              CurrentSkip="@CurrentSkip"
                              IsGridLoading="@IsGridLoading"
                              HasGridLoadError="@HasGridLoadError"
                              Search="@_search"
                              SelectedOrderType="@_selectedOrderType"
                              SelectedStatus="@_selectedStatus"
                              OpenFilterMenu="@_openFilterMenu"
                              ActiveCodeOrderId="@_activeCodeOrderId"
                              ActiveNoteOrderId="@_activeNoteOrderId"
                              HasTableFilters="@HasTableFilters"
                              OrderTypeFilterLabel="@OrderTypeFilterLabel"
                              StatusFilterLabel="@StatusFilterLabel"
                              LoadRequested="@OnHistoryLoadData"
                              OrderSelected="@OnOrderSelectedAsync"
                              RetryRequested="@LoadOrdersAndSelectAsync"
                              SearchChanged="@OnSearchInput"
                              FilterMenuToggled="@ToggleFilterMenu"
                              OrderTypeSelected="@SelectOrderTypeAsync"
                              StatusSelected="@SelectStatusAsync"
                              TableFiltersCleared="@ClearTableFiltersAsync"
                              CodeToggled="@ToggleCode"
                              NoteToggled="@ToggleNote"
                              CopyRequested="@CopyTextAsync" />
        }
    }

    @* Drawer luôn render (kể cả khi chưa có quyền/đang tải) để giữ hành vi và component ref như trước khi tách. *@
    <HistoryOrderDetailSheet @ref="_detailSheet"
                             IsOpen="@_isDrawerOpen"
                             SelectedOrder="@_selectedOrder"
                             IsDetailLoading="@_isDetailLoading"
                             HasDetailError="@_detailError"
                             DetailRows="@_detailRows"
                             DetailCategories="@_detailCategories"
                             DetailUoms="@_detailUoms"
                             DetailSearch="@_detailSearch"
                             DetailCategory="@_detailCategory"
                             DetailUom="@_detailUom"
                             OpenFilterMenu="@_openFilterMenu"
                             ActiveDetailCode="@_activeDetailCode"
                             ActiveDetailNoteNumber="@_activeDetailNoteNumber"
                             HasDetailFilters="@HasDetailFilters"
                             HasTableFilters="@HasTableFilters"
                             TotalCount="@TotalCount"
                             UnitHeaderLabel="@UnitHeaderLabel"
                             IsExporting="@IsExportingOrder"
                             CloseRequested="@CloseDrawer"
                             ExportRequested="@ExportSelectedOrderAsync"
                             RetryRequested="@(() => OpenOrderAsync(_selectedOrder!, false))"
                             DetailSearchChanged="@OnDetailSearchInput"
                             FilterMenuToggled="@ToggleFilterMenu"
                             DetailCategorySelected="@SelectDetailCategoryAsync"
                             DetailUomSelected="@SelectDetailUomAsync"
                             DetailFiltersCleared="@ClearDetailFiltersAsync"
                             DetailCodeToggled="@ToggleDetailCode"
                             DetailNoteToggled="@ToggleDetailNote"
                             CopyRequested="@CopyTextAsync" />
</div>
