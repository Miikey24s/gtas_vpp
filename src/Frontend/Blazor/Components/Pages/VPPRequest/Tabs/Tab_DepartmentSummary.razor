@inherits gtas_vpp_fe.Components.Pages.VPPRequest.Tabs.BaseOrderTab
@using gtas_vpp_shared.DTOs.Res.VPP
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_fe.Helpers


@if (CanView)
{
    <VppAnalyticsWorkspace Gap="VppWorkspaceGap.Comfortable"
                           IsBusy="@(IsLoading || IsGridLoading)"
                           Class="rz-p-0 rz-p-md-2">

        @* ── KPI Summary ────────────────────────────────────── *@
        @if (IsLoading)
        {
            <SkeletonPage Cards="3" Rows="6" Cols="7" />
        }
        else
        {
            <div class="kpi-grid" style="--kpi-cols: 3;">
                <div class="kpi-card kpi-blue">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["Orders"]</span>
                            <span class="kpi-card-icon rzi rzi-receipt-long"></span>
                        </div>
                        <div class="kpi-card-value">@TotalCount</div>
                    </div>
                </div>
                <div class="kpi-card kpi-emerald">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["TotalLineItems"]</span>
                            <span class="kpi-card-icon rzi rzi-format-list-numbered"></span>
                        </div>
                        <div class="kpi-card-value">@TotalLines</div>
                    </div>
                </div>
                <div class="kpi-card kpi-amber">
                    <div class="kpi-card-shine"></div>
                    <div class="kpi-card-content">
                        <div class="kpi-card-header">
                            <span class="kpi-card-label">@Loc["TotalQuantity"]</span>
                            <span class="kpi-card-icon rzi rzi-inventory-2"></span>
                        </div>
                        <div class="kpi-card-value">@TotalQty</div>
                        <span class="kpi-card-meta">@PeriodMetaText</span>
                    </div>
                </div>
            </div>
        }

        @* ── DataGrid ───────────────────────────────────────── *@
        @if (TotalCount == 0 && !IsGridLoading && !IsLoading && !HasToolbarFilters)
        {
            <VppEmptyState Icon="business"
                           Title="@Loc["NoData"]"
                           Description="@Loc["NoDepartmentOrdersFound"]"
                           PrimaryText="@Loc["Reload"]"
                           PrimaryAction="@(async _ => await ReloadAsync())" />
        }
        else
        {
            <div class="vpp-atlas-order-workspace">
            <div class="vpp-atlas-order-collection">
            <div class="vpp-mobile-cards">
                <VppMobileCard Items="@Orders" />
            </div>

            <div class="vpp-data-card vpp-datagrid" style="padding: 0; overflow: hidden;">
                @* Atlas department-summary: toolbar lọc trên đầu card danh sách (tìm mã đơn/họ tên
                   + loại đơn + trạng thái + kỳ) thay cho filter CheckBoxList theo cột. *@
                <div class="vpp-atlas-orders-toolbar">
                    <h3 id="department-orders-title">@Loc["HistoryOrderList"]</h3>
                    <div class="vpp-atlas-orders-filters" aria-label="@Loc["ClearFilters"]">
                        <label class="vpp-order-view-search">
                            <VppIcon Name="search" />
                            <input value="@SearchText"
                                   @oninput="OnSearchInput"
                                   placeholder="@Loc["DepartmentSearchPlaceholder"]"
                                   aria-label="@Loc["DepartmentSearchPlaceholder"]" />
                        </label>
                        <RadzenDropDown TValue="int?"
                                        Data="@OrderTypeOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Value="@OrderTypeFilter"
                                        Change="@OnOrderTypeChanged"
                                        aria-label="@Loc["HistoryOrderType"]"
                                        class="vpp-order-view-select" />
                        <RadzenDropDown TValue="int?"
                                        Data="@StatusOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Value="@StatusFilter"
                                        Change="@OnStatusChanged"
                                        aria-label="@Loc["Status"]"
                                        class="vpp-order-view-select" />
                        <RadzenDropDown TValue="int?"
                                        Data="@YearOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Value="@YearFilter"
                                        Change="@OnYearChanged"
                                        aria-label="@Loc["Year"]"
                                        class="vpp-order-view-select vpp-order-view-select-compact" />
                        <RadzenDropDown TValue="int?"
                                        Data="@MonthOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Value="@MonthFilter"
                                        Change="@OnMonthChanged"
                                        aria-label="@Loc["Month"]"
                                        class="vpp-order-view-select vpp-order-view-select-compact" />
                        <button type="button" class="vpp-order-view-clear" disabled="@(!HasToolbarFilters)" @onclick="ClearToolbarFiltersAsync">
                            <VppIcon Name="filter_alt_off" />
                            <span>@Loc["ClearFilters"]</span>
                        </button>
                    </div>
                </div>
                <RadzenDataGrid TItem="VppRequestResDTO" Data="@Orders"
                                Count="@TotalCount" LoadData="@OnLoadData"
                                AllowPaging="true" PageSize="@PageSize"
                                PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                                PageSizeText="@Loc["ItemsPerPage"]"
                                ShowPagingSummary="true"
                                PagerHorizontalAlign="HorizontalAlign.Left"
                                AllowSorting="true" AllowAlternatingRows="true"
                                AllowColumnResize="true"
                                RowSelect="SelectDepartmentOrderAsync"
                                SelectionMode="DataGridSelectionMode.Single"
                                AllowColumnReorder="false"
                                IsLoading="@IsGridLoading"
                                Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                                class="vpp-order-grid"
                                Style="border: none; --vpp-grid-min-width: 1080px;">
                    <Columns>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="row">@(CurrentSkip + Orders.IndexOf(row) + 1)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.Period)" Title="@Loc["Period"]" Width="95px" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@row.Period" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.VppCode)" Title="@Loc["OrderCode"]" Width="200px" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <div class="vpp-order-code-cell">
                                    <span class="vpp-link-text vpp-order-code-link vpp-order-code-trigger" role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false" title="@row.VppCode" style="cursor: pointer; text-decoration: underline dotted var(--vpp-border-strong); user-select: all;">
                                        @GetShortCode(row)
                                    </span>
                                    <div class="vpp-order-code-popover">
                                        <span class="vpp-order-code-popover-text">@row.VppCode</span>
                                        <RadzenButton Icon="content_copy" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="width: 24px; height: 24px; padding: 0; min-width: 24px;" Click="@(async _ => await CopyToClipboard(row.VppCode))" Title="@Loc["Copy"]" />
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.RequesterName)" Title="@Loc["FullName"]" Width="150px" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <span style="font-weight: var(--vpp-font-weight-medium);">@row.RequesterName</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.IsAdditionalOrder)" Title="@Loc["HistoryOrderType"]" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                <span class="vpp-badge @(row.IsAdditionalOrder ? "vpp-badge-warning" : "vpp-badge-info")">
                                    @(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="StatusText" Title="@Loc["Status"]" Width="130px" TextAlign="TextAlign.Center" Sortable="true">
                            <Template Context="row">
                                <span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@row.StatusText</span>
                                @if (row.SettledAt.HasValue)
                                {
                                    <span class="vpp-badge-settled" title="@($"{Loc["Settled"]}: {DateFormatter.Format(row.SettledAt, DateFormatter.LongDate)} - {row.SettledByPriceListName}")">
                                        @Loc["Settled"]
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        @* F-29: đi qua DateFormatter để culture vi-VN được áp dụng nhất quán với các tab đơn hàng còn lại. *@
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.SubmittedDate)" Title="@Loc["SubmittedDate"]" Width="150px" TextAlign="TextAlign.Center" FormatString="{0:HH:mm dd/MM/yyyy}">
                            <Template Context="row">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="VppRequestResDTO" Property="@nameof(VppRequestResDTO.Description)" Title="@Loc["Note"]" Width="180px" TextAlign="TextAlign.Left" />
                    </Columns>
                </RadzenDataGrid>
            </div>
            </div>
            <aside class="vpp-atlas-order-detail" aria-live="polite">
                @if (SelectedOrder is null)
                {
                    <div class="vpp-atlas-order-detail-empty">
                        <span class="rzi rzi-receipt_long" aria-hidden="true"></span>
                        <strong>@Loc["HistorySelectOrder"]</strong>
                        <span>@Loc["DepartmentDetailScopeHint"]</span>
                    </div>
                }
                else
                {
                    @* Atlas orderDetailSheet: kicker + mã/badge + meta + nút xuất (D10) + tóm tắt + ghi chú + mặt hàng. *@
                    <header class="vpp-atlas-sheet-header">
                        <div>
                            <span class="vpp-atlas-sheet-kicker">@Loc["HistoryDetailSheetTitle"]</span>
                            <div class="vpp-atlas-sheet-code">
                                <strong>@SelectedOrder.VppCode</strong>
                                <span class="vpp-badge @StatusDisplay.GetCssClass(SelectedOrder.Status)">@SelectedOrder.StatusText</span>
                            </div>
                            @if (SelectedOrder.SubmittedDate.HasValue)
                            {
                                <p class="vpp-atlas-sheet-meta">@string.Format(Loc["SubmittedAtInlineFormat"].Value, DateFormatter.Format(SelectedOrder.SubmittedDate, DateFormatter.LongDate))</p>
                            }
                        </div>
                        <div class="vpp-atlas-sheet-actions">
                            <RadzenButton Icon="picture_as_pdf"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Text"
                                          Click="@(async _ => await ExportOrderPdfAsync(SelectedOrder))"
                                          Title="@Loc["ExportPdf"]"
                                          aria-label="@string.Format(Loc["ExportOrderPdfAria"], SelectedOrder.VppCode)"
                                          Disabled="@IsExportingOrder" />
                            <RadzenButton Icon="table_view"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Base"
                                          Variant="Variant.Text"
                                          Click="@(async _ => await ExportOrderExcelAsync(SelectedOrder))"
                                          Title="@Loc["ExportExcel"]"
                                          aria-label="@string.Format(Loc["ExportOrderExcelAria"], SelectedOrder.VppCode)"
                                          Disabled="@IsExportingOrder" />
                        </div>
                    </header>
                    <dl class="vpp-atlas-order-facts">
                        <div><dt>@Loc["Period"]</dt><dd>@SelectedOrder.Period</dd></div>
                        <div><dt>@Loc["HistoryOrderType"]</dt><dd><span class="vpp-badge @(SelectedOrder.IsAdditionalOrder ? "vpp-badge-warning" : "vpp-badge-info")">@(SelectedOrder.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])</span></dd></div>
                        <div><dt>@Loc["HistoryRequester"]</dt><dd title="@SelectedOrder.RequesterName">@(string.IsNullOrWhiteSpace(SelectedOrder.RequesterName) ? "–" : SelectedOrder.RequesterName)</dd></div>
                        <div><dt>@Loc["Department"]</dt><dd title="@SelectedOrder.DepartmentCode">@(string.IsNullOrWhiteSpace(SelectedOrder.DepartmentCode) ? "–" : SelectedOrder.DepartmentCode)</dd></div>
                    </dl>
                    <div class="vpp-atlas-sheet-totals">
                        <div><strong>@SelectedOrder.TotalLines</strong><span>@Loc["HistoryItem"]</span></div>
                        <div><strong>@SelectedOrder.TotalQty</strong><span>@Loc["TotalQuantity"]</span></div>
                    </div>
                    <div class="vpp-atlas-sheet-note">
                        <span>@Loc["Note"]</span>
                        <p>@(string.IsNullOrWhiteSpace(SelectedOrder.Description) ? "–" : SelectedOrder.Description)</p>
                    </div>
                    <div class="vpp-atlas-order-items">
                        <div class="vpp-atlas-sheet-items-heading">
                            <h3>@Loc["HistoryItemsHeading"]</h3>
                            <span class="vpp-badge vpp-badge-info">@Loc["ItemsCount", SelectedOrder.Items?.Count ?? 0]</span>
                        </div>
                        @if (IsRowDetailLoading(SelectedOrder.Id))
                        {
                            <SkeletonPage Cards="0" Rows="5" Cols="3" />
                        }
                        else if (SelectedOrder.Items is null || SelectedOrder.Items.Count == 0)
                        {
                            <VppEmptyState Icon="inventory_2" Title="@Loc["OrderHasNoItems"]" />
                        }
                        else
                        {
                            <div class="vpp-atlas-sheet-filters">
                                <label class="vpp-order-view-search">
                                    <VppIcon Name="search" />
                                    <input value="@AsideSearch"
                                           @oninput="OnAsideSearchInput"
                                           placeholder="@Loc["HistorySearchItem"]"
                                           aria-label="@Loc["HistorySearchItem"]" />
                                </label>
                                <RadzenDropDown TValue="string"
                                                Data="@AsideCategoryOptions"
                                                Value="@AsideCategory"
                                                Change="@OnAsideCategoryChanged"
                                                AllowClear="true"
                                                Placeholder="@Loc["AllCategories"]"
                                                aria-label="@Loc["AllCategories"]"
                                                class="vpp-order-view-select" />
                                <RadzenDropDown TValue="string"
                                                Data="@AsideUomOptions"
                                                Value="@AsideUom"
                                                Change="@OnAsideUomChanged"
                                                AllowClear="true"
                                                Placeholder="@Loc["AllUnits"]"
                                                aria-label="@Loc["AllUnits"]"
                                                class="vpp-order-view-select" />
                                <button type="button" class="vpp-order-view-clear" disabled="@(!HasAsideFilters)" @onclick="ClearAsideFilters">
                                    <VppIcon Name="filter_alt_off" />
                                    <span>@Loc["ClearFilters"]</span>
                                </button>
                            </div>
                            @if (!FilteredAsideItems.Any())
                            {
                                <p class="vpp-atlas-sheet-no-match">@Loc["NoOrdersMatchSelectedFilters"]</p>
                            }
                            @foreach (var item in FilteredAsideItems)
                            {
                                <div class="vpp-atlas-order-item">
                                    <span>
                                        <strong title="@item.VppName">@item.VppName</strong>
                                        <small>@item.VppCode · @item.CategoryName · @item.UomName</small>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small class="vpp-atlas-item-note" title="@item.Description">@item.Description</small>
                                        }
                                    </span>
                                    <b>@item.Qty</b>
                                </div>
                            }
                        }
                    </div>
                }
            </aside>
            </div>
        }
    </VppAnalyticsWorkspace>
}
else
{
    <VppEmptyState Icon="lock"
                   Title="@Loc["AccessDenied"]"
                   Description="@Loc["NoPermission"]"
                   SecondaryText="@Loc["BackToAllowedPage"]"
                   SecondaryHref="/" />
}
