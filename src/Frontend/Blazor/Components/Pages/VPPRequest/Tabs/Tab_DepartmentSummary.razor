@inherits gtas_vpp_fe.Components.Pages.VPPRequest.Tabs.HistoryOrderWorkspaceTabBase
@using gtas_vpp_fe.Components.Pages.VPPRequest.Components
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.VPP
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryUiKeys
@using static gtas_vpp_fe.Components.Pages.VPPRequest.Components.HistoryFormat

@* Tổng hợp phòng ban dùng cùng workspace Lịch sử; chỉ thay contract cột danh sách. *@
<HistoryWorkspaceShell @ref="_workspaceShell"
                       IsBusy="@IsRefreshing"
                       IsSummaryRefreshing="@(_isSummaryLoading && !_isInitialLoading)"
                       IsGridRefreshing="@(IsGridLoading && !_isInitialLoading)">
    @if (!CanView)
    {
        <VppContentState State="VppContentStateKind.Denied"
                         Icon="lock"
                         Title="@Loc["AccessDenied"]"
                         Description="@Loc["NoPermission"]"
                         SecondaryActionText="@Loc["BackToAllowedPage"]"
                         SecondaryActionHref="/" />
    }
    else if (_isInitialLoading)
    {
        <div class="vpp-history-loading-state" role="status" aria-live="polite" aria-label="@Loc["Loading"]">
            <div class="vpp-history-loading-toolbar"><span class="vpp-history-skeleton vpp-history-skeleton-scope"></span></div>
            <div class="vpp-history-loading-kpis">@for (var i = 0; i < 4; i++) { <div class="vpp-history-loading-kpi"><span class="vpp-history-skeleton vpp-history-skeleton-label"></span><span class="vpp-history-skeleton vpp-history-skeleton-value"></span></div> }</div>
            <div class="vpp-history-loading-chart"><span class="vpp-history-skeleton vpp-history-skeleton-title"></span><span class="vpp-history-skeleton vpp-history-skeleton-chart"></span></div>
            <div class="vpp-history-loading-table"><span class="vpp-history-skeleton vpp-history-skeleton-title"></span>@for (var i = 0; i < 5; i++) { <span class="vpp-history-skeleton vpp-history-skeleton-row"></span> }</div>
            <div class="vpp-history-loading-drawer"><span class="vpp-history-skeleton vpp-history-skeleton-summary"></span><span class="vpp-history-skeleton vpp-history-skeleton-toolbar"></span>@for (var i = 0; i < 7; i++) { <span class="vpp-history-skeleton vpp-history-skeleton-detail-row"></span> }</div>
        </div>
    }
    else
    {
        <HistoryScopeBar Scope="@_scope"
                         ShowCustomRange="@_showCustomRange"
                         CustomFrom="@_customFrom"
                         CustomTo="@_customTo"
                         PresetScopeSelected="@SelectPresetScopeAsync"
                         CustomScopeRequested="@(() => SelectScopeAsync(CustomScope))"
                         CustomFromChanged="@OnCustomFromChanged"
                         CustomToChanged="@OnCustomToChanged"
                         CustomRangeApplied="@ApplyCustomRangeAsync" />

        @if (_summaryError)
        {
            <VppContentState State="VppContentStateKind.Error" Icon="error" Title="@Loc["HistoryLoadFailed"]"
                             Description="@Loc["HistoryLoadErrorDescription"]" PrimaryActionText="@Loc["Retry"]"
                             PrimaryActionIcon="@VppIcons.Refresh" PrimaryAction="@(_ => RefreshAsync())" Class="vpp-history-state-panel" />
        }
        else if (_summary is null)
        {
            <VppContentState State="VppContentStateKind.Empty" Icon="business" Title="@Loc["NoData"]"
                             Description="@Loc["NoDepartmentOrdersFound"]" PrimaryActionText="@Loc["Refresh"]"
                             PrimaryActionIcon="@VppIcons.Refresh" PrimaryAction="@(_ => RefreshAsync())" Class="vpp-history-state-panel" />
        }
        else
        {
            <HistoryKpiCards Summary="@_summary" ActiveKpi="@_activeKpi"
                             ChartRangeLabel="@ChartRangeLabel" KpiToggled="@ToggleKpi" />

            <HistoryTrendChart Summary="@_summary"
                               ShowRegularSeries="@_showRegularSeries"
                               ShowAdditionalSeries="@_showAdditionalSeries"
                               IsSummaryLoading="@_isSummaryLoading"
                               HasSelectedPeriod="@_selectedPeriod.HasValue"
                               SelectedPeriodLabel="@SelectedPeriodLabel"
                               ChartRangeLabel="@ChartRangeLabel"
                               ChartAccessibleLabel="@ChartAccessibleLabel"
                               SeriesClicked="@OnChartSeriesClick"
                               SelectedPeriodCleared="@ClearSelectedPeriodAsync"
                               SeriesToggled="@ToggleChartSeries" />

            <HistoryOrderList Orders="@Orders" TotalCount="@TotalCount" PageSize="@PageSize"
                              CurrentSkip="@CurrentSkip" IsGridLoading="@IsGridLoading"
                              HasGridLoadError="@HasGridLoadError" Search="@_search"
                              SelectedOrderType="@_selectedOrderType" SelectedStatus="@_selectedStatus"
                              ActiveCodeOrderId="@_activeCodeOrderId" ActiveNoteOrderId="@_activeNoteOrderId"
                              HasTableFilters="@HasTableFilters" LoadRequested="@OnHistoryLoadData"
                              OrderSelected="@OnOrderSelectedAsync" RetryRequested="@LoadOrdersAndSelectAsync"
                              SearchChanged="@OnSearchInput" OrderTypeSelected="@SelectOrderTypeAsync"
                              StatusSelected="@SelectStatusAsync" TableFiltersCleared="@ClearTableFiltersAsync"
                              TransientSurfacesClosed="@CloseTransientSurfaces" CodeToggled="@ToggleCode"
                              NoteToggled="@ToggleNote" CopyRequested="@CopyTextAsync"
                              TestId="department-summary-data-surface"
                              Class="vpp-history-orders-card--department">
                <Columns>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Title="#" TextAlign="TextAlign.Center" CssClass="vpp-history-col-center" HeaderCssClass="vpp-history-col-center">
                        <Template Context="row">@(CurrentSkip + Orders.IndexOf(row) + 1)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="Period" Title="@Loc["Period"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-center" HeaderCssClass="vpp-history-col-center" />
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="VppCode" Title="@Loc["OrderCode"]" CssClass="vpp-history-col-left" HeaderCssClass="vpp-history-col-left">
                        <Template Context="row"><VppCellValuePopover Value="@row.VppCode" Label="@Loc["OrderCode"]" CopyLabel="@Loc["Copy"]" Kind="VppCellValueKind.Code" IsOpen="@(_activeCodeOrderId == row.Id)" Toggled="@(() => ToggleCode(row.Id))" CopyRequested="@CopyTextAsync" Class="vpp-history-code-cell" TriggerClass="vpp-history-code vpp-history-code-trigger" PanelClass="vpp-history-code-popover" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="RequesterName" Title="@Loc["HistoryRequester"]" CssClass="vpp-history-col-left" HeaderCssClass="vpp-history-col-left">
                        <Template Context="row"><span title="@row.RequesterName">@(string.IsNullOrWhiteSpace(row.RequesterName) ? "–" : row.RequesterName)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Title="@Loc["HistoryOrderType"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-type vpp-history-col-center" HeaderCssClass="vpp-history-col-type vpp-history-col-center">
                        <Template Context="row"><span class="vpp-history-order-type @(row.IsAdditionalOrder ? "is-additional" : "is-regular")">@(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="StatusText" Title="@Loc["Status"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-center" HeaderCssClass="vpp-history-col-center">
                        <Template Context="row"><span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@Loc[StatusDisplay.GetResourceKey(row.Status, row.IsDeadlinePassed, row.IsAdditionalOrder)]</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="SubmittedDate" Title="@Loc["SubmittedDate"]" TextAlign="TextAlign.Center" CssClass="vpp-history-col-date vpp-history-col-center" HeaderCssClass="vpp-history-col-date vpp-history-col-center">
                        <Template Context="row"><span class="vpp-history-date">@DateFormatter.Format(row.SubmittedDate, DateFormatter.LongDate)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppRequestResDTO" Property="Description" Title="@Loc["Note"]" CssClass="vpp-history-col-note vpp-history-col-left" HeaderCssClass="vpp-history-col-note vpp-history-col-left">
                        <Template Context="row">
                            @if (string.IsNullOrWhiteSpace(row.Description)) { <span class="vpp-history-note">–</span> }
                            else { <VppCellValuePopover Value="@row.Description" Label="@Loc["Note"]" CopyLabel="@Loc["Copy"]" Kind="VppCellValueKind.Note" IsOpen="@(_activeNoteOrderId == row.Id)" Toggled="@(() => ToggleNote(row.Id))" CopyRequested="@CopyTextAsync" Class="vpp-history-note-cell" TriggerClass="vpp-history-note vpp-history-note-trigger" PanelClass="vpp-history-note-popover" /> }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <MobileRow Context="row">
                    <span class="vpp-history-mobile-topline"><strong>@row.VppCode</strong><span class="vpp-badge @StatusDisplay.GetCssClass(row.Status)">@Loc[StatusDisplay.GetResourceKey(row.Status, row.IsDeadlinePassed, row.IsAdditionalOrder)]</span></span>
                    <span class="vpp-history-order-type @(row.IsAdditionalOrder ? "is-additional" : "is-regular")">@row.Period · @(row.IsAdditionalOrder ? Loc["AdditionalOrder"] : Loc["Regular"])</span>
                    <span>@Loc["HistoryRequester"]: @(string.IsNullOrWhiteSpace(row.RequesterName) ? "–" : row.RequesterName)</span>
                    <span class="vpp-history-note">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span>
                </MobileRow>
            </HistoryOrderList>
        }
    }

    <HistoryOrderDetailSheet @ref="_detailSheet" IsOpen="@_isDrawerOpen" SelectedOrder="@_selectedOrder"
                             IsDetailLoading="@_isDetailLoading" HasDetailError="@_detailError"
                             DetailRows="@_detailRows" DetailCategories="@_detailCategories" DetailUoms="@_detailUoms"
                             DetailSearch="@_detailSearch" DetailCategory="@_detailCategory" DetailUom="@_detailUom"
                             ActiveDetailCodeNumber="@_activeDetailCodeNumber" ActiveDetailNoteNumber="@_activeDetailNoteNumber"
                             HasDetailFilters="@HasDetailFilters" HasTableFilters="@HasTableFilters" TotalCount="@TotalCount"
                             UnitHeaderLabel="@UnitHeaderLabel" IsExporting="@IsExportingOrder" CloseRequested="@CloseDrawer"
                             ExportRequested="@ExportSelectedOrderAsync" RetryRequested="@(() => OpenOrderAsync(_selectedOrder!, false))"
                             DetailSearchChanged="@OnDetailSearchInput" DetailCategorySelected="@SelectDetailCategoryAsync"
                             DetailUomSelected="@SelectDetailUomAsync" DetailFiltersCleared="@ClearDetailFiltersAsync"
                             DetailCodeToggled="@ToggleDetailCode" DetailNoteToggled="@ToggleDetailNote" CopyRequested="@CopyTextAsync" />
</HistoryWorkspaceShell>
