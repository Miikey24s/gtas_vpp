@* PAGE: VPPRequest/OrderCreateStep3.razor *@
@using gtas_vpp_fe.Features.Requests.Editor

@* REVIEW: Kiểm tra nội dung đơn trước khi gửi. *@
<div class="wizard-step wizard-step-review">
    <section class="vpp-order-review-panel" aria-labelledby="order-review-title">
        @* HEADER: Tiêu đề review và badge tóm tắt loại đơn. *@
        <header class="vpp-order-review-header">
            <div>
                <h2 id="order-review-title">@Loc["ReviewOrderBeforeSubmit"]</h2>
                <p>@Loc["ReviewOrderBeforeSubmitDescription"]</p>
            </div>
            <div class="vpp-order-draft-badges">
                <VppCategoryChip Text="@Loc["ItemsCount", Editor.SelectedItemCount]" Tone="VppCategoryTone.Primary" />
                @if (Editor.IsAdditional)
                {
                    <VppCategoryChip Text="@Loc["AdditionalOrder"]" Tone="VppCategoryTone.Accent" />
                }
            </div>
        </header>

        @* SUMMARY: Số dòng, tổng số lượng và ghi chú/lý do bổ sung. *@
        @* LINE 1 → 3: Tổng dòng, tổng số lượng và ghi chú/lý do. *@
        <dl class="vpp-order-review-summary">
            <div><dt>@Loc["TotalLineItems"]</dt><dd>@Editor.SelectedItemCount</dd></div>
            <div><dt>@Loc["TotalQuantity"]</dt><dd>@Editor.TotalQuantity</dd></div>
            <div class="@(IsSupplementReasonMissing ? "is-missing" : null)">
                <dt>@(Editor.IsAdditional ? Loc["SupplementReason"] : Loc["OrderNote"])</dt>
                <dd>@OrderNote</dd>
            </div>
        </dl>

        @* SUPPLEMENT REASON: Cảnh báo và mở form nhập lý do khi cần. *@
        @if (IsSupplementReasonMissing)
        {
            <button type="button"
                    class="vpp-order-review-warning"
                    @onclick="SupplementReasonRequested">
                <VppIcon Name="info" />
                <span>@Loc["ProvideReasonBeforeContinue"]</span>
                <strong>@Loc["SupplementReason"]</strong>
            </button>
        }

        @* SELECTED ITEMS: Giữ nguyên khung bảng khi đơn chưa có mặt hàng. *@
        <div class="vpp-order-review-grid-frame">
                <RadzenDataGrid TItem="OrderEditorSession.SelectedItem"
                                Data="@Editor.SelectedItems"
                                AllowVirtualization="true"
                                VirtualizationOverscanCount="4"
                                AllowPaging="false"
                                AllowSorting="false"
                                AllowFiltering="false"
                                AllowAlternatingRows="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                class="vpp-order-review-grid vpp-data-grid vpp-data-density-rich-two-line">
                    <EmptyTemplate>
                        <VppDataGridEmptyState Icon="remove_shopping_cart"
                                               Title="@Loc["WizardNoItemsToSubmit"]"
                                               Description="@Loc["WizardNoItemsToSubmitDesc"]" />
                    </EmptyTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="OrderEditorSession.SelectedItem" Title="#" Width="56px" TextAlign="TextAlign.Center">
                            <Template Context="item">@Editor.GetItemNumber(item)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OrderEditorSession.SelectedItem" Property="VppName" Title="@Loc["ItemName"]">
                            <Template Context="item">
                                <div class="vpp-order-builder-item-cell">
                                    <strong>@item.VppName</strong>
                                    <small>@item.VppCode</small>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OrderEditorSession.SelectedItem" Property="Quantity" Title="@Loc["Quantity"]" Width="130px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="OrderEditorSession.SelectedItem" Property="UomName" Title="@Loc["UOM"]" Width="120px" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="OrderEditorSession.SelectedItem" Property="Description" Title="@Loc["ItemNote"]" Width="320px">
                            <Template Context="item">@(string.IsNullOrWhiteSpace(item.Description) ? "–" : item.Description)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="OrderEditorSession.SelectedItem" Title="" Width="56px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <button type="button"
                                        class="vpp-order-draft-remove"
                                        title="@Loc["RemoveItemFromOrder"]"
                                        aria-label="@Loc["RemoveItemFromOrder"]"
                                        @onclick="() => RemoveItem(item)">
                                    <VppIcon Name="close" />
                                </button>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
        </div>
        @* FOOTER: Tổng kết số mặt hàng và tổng số lượng. *@
        <footer class="vpp-order-builder-data-footer">@Loc["SelectedItemsSummary", Editor.SelectedItemCount, Editor.TotalQuantity]</footer>
    </section>
</div>

@code {
    // STATE: Editor context và callback mở form lý do bổ sung.
    [CascadingParameter] public OrderEditorSession Editor { get; set; } = default!;
    [Parameter] public EventCallback SupplementReasonRequested { get; set; }

    // DISPLAY: Chọn nội dung ghi chú phù hợp với loại đơn.
    private string OrderNote => Editor.IsAdditional
        ? Editor.SupplementReason ?? "–"
        : Editor.Description ?? "–";

    private bool IsSupplementReasonMissing => Editor.IsAdditional
        && (string.IsNullOrWhiteSpace(Editor.SupplementReason)
            || Editor.SupplementReason.Trim().Length < 5);

    // ACTIONS: Xóa một mặt hàng khỏi phiên chỉnh sửa đơn.
    private void RemoveItem(OrderEditorSession.SelectedItem item) => Editor.RemoveItem(item);
}
