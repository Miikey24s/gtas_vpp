@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_fe.Services

<div class="wizard-step wizard-step-products">
    <div class="vpp-order-builder">
        <VppSplitEditorWorkspace Ratio="VppSplitEditorRatio.WidePrimary">
        <Primary>
        <section class="vpp-order-builder-catalog" aria-labelledby="order-catalog-title">
            <header class="vpp-order-builder-section-header">
                <div>
                    <h2 id="order-catalog-title">@Loc["OrderableCatalog"]</h2>
                    <p>@Loc["OrderableCatalogCount", Context.SelectedItems.Count, ProductCount]</p>
                </div>
            </header>

            <div class="vpp-order-builder-filters" aria-label="@Loc["CatalogFilters"]">
                <VppFilterSearch Value="@SearchText"
                                 Input="@OnSearchInput"
                                 Placeholder="@Loc["SearchCatalogItems"]"
                                 AriaLabel="@Loc["SearchCatalogItems"]" />
                <VppFilterSelect TValue="string"
                                 Value="@(CategoryFilter ?? string.Empty)"
                                 Options="@CategoryOptions"
                                 ValueChanged="@OnCategoryChanged"
                                 Placeholder="@Loc["AllCategories"]"
                                 AriaLabel="@Loc["AllCategories"]" />
                <VppFilterSelect TValue="string"
                                 Value="@(UnitFilter ?? string.Empty)"
                                 Options="@UnitOptions"
                                 ValueChanged="@OnUnitChanged"
                                 Placeholder="@Loc["AllUnits"]"
                                 AriaLabel="@Loc["AllUnits"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                       IsActive="@HasProductFilters"
                                       Clicked="@ClearFiltersAsync" />
            </div>

            <div class="vpp-order-builder-grid-frame">
                <RadzenDataGrid @ref="productGrid"
                                TItem="ProductOption"
                                Data="@ProductOptions"
                                Count="@ProductCount"
                                LoadData="@LoadProductsAsync"
                                IsLoading="@IsLoadingProducts"
                                AllowVirtualization="true"
                                VirtualizationOverscanCount="5"
                                AllowPaging="false"
                                AllowSorting="true"
                                AllowFiltering="false"
                                AllowColumnResize="true"
                                AllowAlternatingRows="false"
                                Density="Density.Compact"
                                GridLines="DataGridGridLines.Horizontal"
                                RowRender="@OnRowRender"
                                class="vpp-order-builder-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ProductOption" Title="#" Width="56px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="row">@GetProductRowNumber(row)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ProductOption" Property="VppName" Title="@Loc["ItemName"]" TextAlign="TextAlign.Left">
                            <Template Context="row">
                                <div class="vpp-order-builder-item-cell">
                                    <strong>@row.VppName</strong>
                                    <small>@row.VppCode</small>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ProductOption" Property="VppCategoryName" Title="@Loc["Category"]" Width="220px" TextAlign="TextAlign.Left" />
                        <RadzenDataGridColumn TItem="ProductOption" Property="UomName" Title="@Loc["UOM"]" Width="110px" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ProductOption" Title="@Loc["Actions"]" Width="100px" Sortable="false" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                @if (IsSelected(row.Id))
                                {
                                    <button type="button"
                                            class="vpp-order-builder-row-action is-remove"
                                            title="@Loc["RemoveItemFromOrder"]"
                                            aria-label="@Loc["RemoveItemFromOrder"]"
                                            @onclick="() => RemoveProductAsync(row.Id)">
                                        <VppIcon Name="close" />
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="vpp-order-builder-row-action"
                                            aria-label="@Loc["AddProductToOrder"]"
                                            @onclick="() => AddProductAsync(row)">
                                        <VppIcon Name="add" />
                                        <span>@Loc["Add"]</span>
                                    </button>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
            <footer class="vpp-order-builder-data-footer">@Loc["VirtualizedCatalogSummary", ProductCount]</footer>
        </section>
        </Primary>

        <Secondary>
        <aside class="vpp-order-draft" aria-labelledby="order-draft-title">
            <header class="vpp-order-draft-header">
                <div>
                    <h2 id="order-draft-title">@Loc["OrderBeingCreated"]</h2>
                    <p>@Loc["Period"] @TargetPeriodLabel</p>
                </div>
                <div class="vpp-order-draft-badges">
                    <span class="vpp-badge status-info">@Loc["ItemsCount", Context.SelectedItems.Count]</span>
                    <span class="vpp-badge status-warning">@Loc["Draft"]</span>
                </div>
            </header>

            <div class="vpp-order-draft-columns" aria-hidden="true">
                <span>@Loc["ItemName"]</span>
                <span>@Loc["QuantityShort"]</span>
                <span>@Loc["UOM"]</span>
                <span>@Loc["Actions"]</span>
            </div>

            @if (Context.SelectedItems.Count == 0)
            {
                <div class="vpp-order-draft-empty">
                    <VppIcon Name="add_shopping_cart" />
                    <strong>@Loc["WizardNoItemsSelected"]</strong>
                    <p>@Loc["WizardNoItemsSelectedDesc"]</p>
                </div>
            }
            else
            {
                <div class="vpp-order-draft-list">
                    @foreach (var item in Context.SelectedItems)
                    {
                        <article class="vpp-order-draft-item" @key="item.VppId">
                            <div class="vpp-order-draft-item-main">
                                <div class="vpp-order-builder-item-cell">
                                    <strong>@item.VppName</strong>
                                    <small>@item.VppCode</small>
                                </div>
                                <div class="vpp-order-quantity-stepper" aria-label="@($"{Loc["Quantity"].Value}: {GetItemLabel(item)}")">
                                    <button type="button" @onclick="() => ChangeQuantity(item, -1)" aria-label="@Loc["DecreaseQuantity"]" disabled="@(item.Qty <= 1)">−</button>
                                    <span>@item.Qty</span>
                                    <button type="button" @onclick="() => ChangeQuantity(item, 1)" aria-label="@Loc["IncreaseQuantity"]">+</button>
                                </div>
                                <span class="vpp-order-draft-unit">@item.UomName</span>
                                <div class="vpp-order-draft-item-actions">
                                    <button type="button"
                                            class="vpp-order-draft-note"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            title="@Loc["ItemNote"]"
                                            aria-label="@($"{Loc["ItemNote"]}: {GetItemLabel(item)}")"
                                            @onclick="() => SnapshotItemNote(item)">
                                        <VppIcon Name="edit_note" />
                                    </button>
                                    <button type="button"
                                            class="vpp-order-draft-remove"
                                            title="@Loc["RemoveItemFromOrder"]"
                                            aria-label="@Loc["RemoveItemFromOrder"]"
                                            @onclick="() => RemoveItemAsync(item)">
                                        <VppIcon Name="close" />
                                    </button>
                                </div>
                            </div>
                            <div id="@GetItemNotePopoverId(item)"
                                 class="vpp-order-note-popover vpp-transient-surface vpp-transient-surface--center"
                                 popover="auto">
                                <header>
                                    <div>
                                        <strong>@Loc["ItemNote"]</strong>
                                        <span>@GetItemLabel(item)</span>
                                    </div>
                                    <button type="button"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            popovertargetaction="hide"
                                            aria-label="@Loc["Close"]">
                                        <VppIcon Name="close" />
                                    </button>
                                </header>
                                <textarea value="@item.Description"
                                          @oninput="args => UpdateItemNote(item, args.Value?.ToString())"
                                          maxlength="500"
                                          placeholder="@Loc["ItemNotePlaceholder"]"></textarea>
                                <small class="vpp-order-note-scope">@Loc["ItemNoteScopeHint"]</small>
                                <footer class="vpp-order-note-footer">
                                    <button type="button"
                                            class="vpp-order-note-cancel"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            popovertargetaction="hide"
                                            @onclick="() => RevertItemNote(item)">@Loc["Cancel"]</button>
                                    <button type="button"
                                            class="vpp-order-note-save"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            popovertargetaction="hide">
                                        <VppIcon Name="check" />
                                        <span>@Loc["SaveNote"]</span>
                                    </button>
                                </footer>
                            </div>
                        </article>
                    }
                </div>
            }

            <div class="vpp-order-draft-summary">
                <span>@Loc["ItemsCount", Context.SelectedItems.Count]</span>
                <strong>@Loc["TotalQuantity"] @Context.TotalQty</strong>
            </div>

            <footer class="vpp-order-draft-actions">
                <button type="button" class="vpp-order-action-back" @onclick="async () => await BackRequested.InvokeAsync()">
                    <VppIcon Name="arrow_back" />
                    <span>@Loc["Previous"]</span>
                </button>
                <div class="vpp-order-draft-actions-right">
                    @if (CanSaveDraft)
                    {
                        <button type="button" class="vpp-order-action-save" @onclick="async () => await SaveDraftRequested.InvokeAsync()">
                            <VppIcon Name="save" />
                            <span>@Loc["SaveDraft"]</span>
                        </button>
                    }
                    <button type="button"
                            class="vpp-order-action-note"
                            popovertarget="@OrderNotePopoverId"
                            @onclick="SnapshotOrderNote">
                        <VppIcon Name="edit_note" />
                        <span>@Loc["Note"]</span>
                    </button>
                    <RadzenButton Icon="arrow_forward"
                                  Text="@Loc["ContinueReview"]"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(!CanContinue)"
                                  Click="@(async _ => await NextRequested.InvokeAsync())" />
                </div>
            </footer>

            <div id="@OrderNotePopoverId" class="vpp-order-note-popover vpp-order-note-popover--order vpp-transient-surface vpp-transient-surface--center" popover="auto">
                <header>
                    <div>
                        <strong>@OrderNoteLabel</strong>
                        <span>@OrderNoteContextLabel</span>
                    </div>
                    <button type="button"
                            popovertarget="@OrderNotePopoverId"
                            popovertargetaction="hide"
                            aria-label="@Loc["Close"]">
                        <VppIcon Name="close" />
                    </button>
                </header>
                <textarea value="@OrderNote"
                          @oninput="args => UpdateOrderNote(args.Value?.ToString())"
                          maxlength="500"
                          placeholder="@OrderNotePlaceholder"></textarea>
                <small class="vpp-order-note-scope">@Loc["OrderNoteScopeHint"]</small>
                <footer class="vpp-order-note-footer">
                    <button type="button"
                            class="vpp-order-note-cancel"
                            popovertarget="@OrderNotePopoverId"
                            popovertargetaction="hide"
                            @onclick="RevertOrderNote">@Loc["Cancel"]</button>
                    <button type="button"
                            class="vpp-order-note-save"
                            popovertarget="@OrderNotePopoverId"
                            popovertargetaction="hide">
                        <VppIcon Name="check" />
                        <span>@Loc["SaveNote"]</span>
                    </button>
                </footer>
            </div>
        </aside>
        </Secondary>
        </VppSplitEditorWorkspace>
    </div>
</div>

@code {
    [CascadingParameter] public OrderCreateContext Context { get; set; } = default!;
    [Parameter] public EventCallback NextRequested { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }
    [Parameter] public EventCallback SaveDraftRequested { get; set; }
    [Parameter] public bool CanSaveDraft { get; set; }
    [Parameter] public string TargetPeriodLabel { get; set; } = string.Empty;
    [Inject] public IAPIServices ApiServices { get; set; } = default!;

    public sealed class ProductOption
    {
        public Guid Id { get; set; }
        public string? VppCode { get; set; }
        public string? VppName { get; set; }
        public string? UomCode { get; set; }
        public string? UomName { get; set; }
        public string? VppCategoryName { get; set; }
    }

    public bool IsLoadingProducts { get; set; }
    public int ProductCount { get; set; }
    public List<ProductOption> ProductOptions { get; set; } = [];
    public List<VppFilterOption<string>> CategoryOptions { get; set; } = [];
    public List<VppFilterOption<string>> UnitOptions { get; set; } = [];
    public string? SearchText { get; set; }
    public string? CategoryFilter { get; set; }
    public string? UnitFilter { get; set; }
    public RadzenDataGrid<ProductOption>? productGrid;

    private int _currentSkip;
    private readonly Dictionary<ProductOption, int> _visibleRowNumbers = new(ReferenceEqualityComparer.Instance);
    private CancellationTokenSource? _searchDebounceCts;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");

    private string OrderNotePopoverId => $"vpp-order-note-{_instanceId}";
    private bool HasProductFilters => !string.IsNullOrWhiteSpace(SearchText)
        || !string.IsNullOrWhiteSpace(CategoryFilter)
        || !string.IsNullOrWhiteSpace(UnitFilter);

    private bool CanContinue => Context.SelectedItems.Count > 0
        && (!Context.IsAdditional || (!string.IsNullOrWhiteSpace(Context.SupplementReason) && Context.SupplementReason.Trim().Length >= 5));
    private string OrderNoteLabel => Context.IsAdditional ? Loc["SupplementReason"].Value : Loc["OrderNote"].Value;
    private string OrderNotePlaceholder => Context.IsAdditional ? Loc["SupplementReasonPlaceholder"].Value : Loc["OrderNotePlaceholder"].Value;
    private string? OrderNote => Context.IsAdditional ? Context.SupplementReason : Context.Description;
    // Atlas order-note-popover: dòng phụ "Đơn kỳ MM/yyyy"; nhánh đơn bổ sung giữ ngữ cảnh "Đơn đang tạo".
    private string OrderNoteContextLabel => Context.IsAdditional
        ? Loc["OrderBeingCreated"].Value
        : string.Format(Loc["OrderNotePeriodFormat"].Value, TargetPeriodLabel);

    // Nút "Hủy" của popover ghi chú hoàn nguyên giá trị chụp lúc mở (textarea vẫn auto-bind khi gõ).
    private Guid _itemNoteSnapshotId;
    private string? _itemNoteSnapshot;
    private string? _orderNoteSnapshot;

    private int GetProductRowNumber(ProductOption row)
        => _visibleRowNumbers.GetValueOrDefault(row, _currentSkip + 1);

    private void SnapshotItemNote(OrderCreateContext.SelectedItem item)
    {
        _itemNoteSnapshotId = item.VppId;
        _itemNoteSnapshot = item.Description;
    }

    private void RevertItemNote(OrderCreateContext.SelectedItem item)
    {
        if (item.VppId == _itemNoteSnapshotId)
        {
            UpdateItemNote(item, _itemNoteSnapshot);
        }
    }

    private void SnapshotOrderNote() => _orderNoteSnapshot = OrderNote;

    private void RevertOrderNote() => UpdateOrderNote(_orderNoteSnapshot);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadFilterOptionsAsync("VppCategoryName", CategoryOptions, Loc["AllCategories"]),
            LoadFilterOptionsAsync("UomName", UnitOptions, Loc["AllUnits"]));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && productGrid is not null)
        {
            await productGrid.Reload();
        }
    }

    private async Task LoadFilterOptionsAsync(string property, List<VppFilterOption<string>> target, string allText)
    {
        target.Clear();
        target.Add(new VppFilterOption<string>(string.Empty, allText));
        try
        {
            var data = await ApiServices.GetFromApiAsync<List<ProductOption>>(
                $"/api/VPPRequest/products?distinct={property}&top=1000") ?? [];
            var values = property == "UomName"
                ? data.Select(item => item.UomName)
                : data.Select(item => item.VppCategoryName);
            target.AddRange(values
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value!.Trim())
                .Distinct(StringComparer.CurrentCultureIgnoreCase)
                .OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase)
                .Select(value => new VppFilterOption<string>(value, value)));
        }
        catch
        {
        }
    }

    private async Task LoadProductsAsync(LoadDataArgs args)
    {
        IsLoadingProducts = true;
        _currentSkip = args.Skip ?? 0;
        _visibleRowNumbers.Clear();
        try
        {
            var query = new List<string>
            {
                $"skip={args.Skip ?? 0}",
                $"top={args.Top ?? 40}"
            };
            if (!string.IsNullOrWhiteSpace(SearchText)) query.Add($"search={Uri.EscapeDataString(SearchText.Trim())}");
            var filter = BuildFilter();
            if (!string.IsNullOrWhiteSpace(filter)) query.Add($"filter={Uri.EscapeDataString(filter)}");
            if (!string.IsNullOrWhiteSpace(args.OrderBy)) query.Add($"orderby={Uri.EscapeDataString(args.OrderBy)}");

            var result = await ApiServices.GetFromApiWithTotalCountAsync<List<ProductOption>>(
                $"/api/VPPRequest/products?{string.Join("&", query)}");
            ProductOptions = result.Data ?? [];
            ProductCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OrderCreateStep2] LoadProducts failed: {ex.Message}");
            ProductOptions = [];
            ProductCount = 0;
        }
        finally
        {
            IsLoadingProducts = false;
        }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchDebounceCts.Token);
            await ReloadProductsAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task OnCategoryChanged(string value)
    {
        CategoryFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        await ReloadProductsAsync();
    }

    private async Task OnUnitChanged(string value)
    {
        UnitFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        await ReloadProductsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        SearchText = null;
        CategoryFilter = null;
        UnitFilter = null;
        await ReloadProductsAsync();
    }

    private async Task ReloadProductsAsync()
    {
        if (productGrid is not null)
        {
            await productGrid.Reload();
        }
    }

    private string? BuildFilter()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(CategoryFilter)) parts.Add($"VppCategoryName == \"{EscapeFilterValue(CategoryFilter)}\"");
        if (!string.IsNullOrWhiteSpace(UnitFilter)) parts.Add($"UomName == \"{EscapeFilterValue(UnitFilter)}\"");
        return parts.Count == 0 ? null : string.Join(" && ", parts);
    }

    private static string EscapeFilterValue(string value)
        => value.Replace("\\", "\\\\", StringComparison.Ordinal).Replace("\"", "\\\"", StringComparison.Ordinal);

    private bool IsSelected(Guid id) => Context.SelectedItems.Any(item => item.VppId == id);

    private async Task AddProductAsync(ProductOption row)
    {
        if (!IsSelected(row.Id))
        {
            Context.SelectedItems.Add(new OrderCreateContext.SelectedItem
            {
                VppId = row.Id,
                VppCode = row.VppCode,
                VppName = row.VppName,
                UomCode = row.UomCode,
                UomName = row.UomName,
                Qty = 1
            });
            await RefreshSelectionAsync();
        }
    }

    private async Task RemoveProductAsync(Guid id)
    {
        var item = Context.SelectedItems.FirstOrDefault(selected => selected.VppId == id);
        if (item is not null)
        {
            await RemoveItemAsync(item);
        }
    }

    private async Task RemoveItemAsync(OrderCreateContext.SelectedItem item)
    {
        Context.SelectedItems.Remove(item);
        await RefreshSelectionAsync();
    }

    private void ChangeQuantity(OrderCreateContext.SelectedItem item, int delta)
    {
        item.Qty = Math.Clamp(item.Qty + delta, 1, 9999);
        Context.NotifyStateChanged();
    }

    private void UpdateItemNote(OrderCreateContext.SelectedItem item, string? value)
    {
        item.Description = value;
        Context.NotifyStateChanged();
    }

    private void UpdateOrderNote(string? value)
    {
        if (Context.IsAdditional)
        {
            Context.SupplementReason = value;
        }
        else
        {
            Context.Description = value;
        }
        Context.NotifyStateChanged();
    }

    private void OnRowRender(RowRenderEventArgs<ProductOption> args)
    {
        if (args.Data is null)
        {
            return;
        }

        _visibleRowNumbers[args.Data] = _currentSkip + args.Index + 1;
        if (IsSelected(args.Data.Id))
        {
            args.Attributes["class"] = "vpp-wizard-row-selected";
        }
    }

    private async Task RefreshSelectionAsync()
    {
        Context.NotifyStateChanged();
        await InvokeAsync(StateHasChanged);
    }

    private static string GetItemLabel(OrderCreateContext.SelectedItem item)
        => !string.IsNullOrWhiteSpace(item.VppName) ? item.VppName : item.VppCode ?? string.Empty;

    private string GetItemNotePopoverId(OrderCreateContext.SelectedItem item)
        => $"vpp-item-note-{_instanceId}-{item.VppId:N}";

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
