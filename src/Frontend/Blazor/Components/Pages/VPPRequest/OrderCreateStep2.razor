@* PAGE: VPPRequest/OrderCreateStep2.razor *@
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_fe.Features.Requests.Api
@using gtas_vpp_fe.Features.Requests.Editor
@implements IDisposable
@inject IJSRuntime JSRuntime

@* CATALOG: Danh mục mặt hàng có thể thêm vào đơn. *@
<div class="wizard-step wizard-step-products">
    <div class="vpp-order-builder">
        <VppSplitEditorWorkspace Ratio="VppSplitEditorRatio.WidePrimary">
        <Primary>
        <section class="vpp-order-builder-catalog" aria-labelledby="order-catalog-title">
            <header class="vpp-order-builder-section-header">
                <div>
                    <h2 id="order-catalog-title">@Loc["OrderableCatalog"]</h2>
                    <p>@Loc["OrderableCatalogCount", Editor.SelectedItemCount, ProductCount]</p>
                </div>
            </header>

            @* FILTERS: Tìm kiếm, lọc danh mục/đơn vị và xóa bộ lọc. *@
            <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ClientSnapshotPaged"
                                 Density="VppDataDensity.RichTwoLine"
                                 Bordered="false"
                                 State="@(ProductCount == 0 ? HasProductFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty : VppDataSurfaceState.Populated)"
                                 AriaLabelledBy="order-catalog-title"
                                 TestId="order-create-catalog-data-surface"
                                 Class="vpp-order-builder-data-surface">
            <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["CatalogFilters"]"
                            Class="vpp-order-builder-filters">
                <VppFilterSearch Value="@SearchText"
                                 Input="@OnSearchInput"
                                 Placeholder="@Loc["SearchCatalogItems"]"
                                 AriaLabel="@Loc["SearchCatalogItems"]" />
                <VppFilterSelect TValue="string"
                                 Value="@(CategoryFilter ?? string.Empty)"
                                 Options="@CategoryOptions"
                                 ValueChanged="@OnCategoryChanged"
                                 Opening="@CloseProductTransientSurfaces"
                                 Placeholder="@Loc["AllCategories"]"
                                 AriaLabel="@Loc["AllCategories"]" />
                <VppFilterSelect TValue="string"
                                 Value="@(UnitFilter ?? string.Empty)"
                                 Options="@UnitOptions"
                                 ValueChanged="@OnUnitChanged"
                                 Opening="@CloseProductTransientSurfaces"
                                 Placeholder="@Loc["AllUnits"]"
                                 AriaLabel="@Loc["AllUnits"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                       IsActive="@HasProductFilters"
                                       Clicked="@ClearFiltersAsync" />
            </VppDataToolbar>
            </Toolbar>

            @* PRODUCT LIST: Hiển thị mặt hàng và thao tác thêm/xóa khỏi đơn. *@
            <ChildContent>
            <div class="vpp-order-builder-grid-frame">
                <div class="vpp-order-builder-grid"
                     role="table"
                     aria-rowcount="@ProductCount"
                     aria-labelledby="order-catalog-title">
                    @* COLUMNS: Tiêu đề các cột danh mục mặt hàng. *@
                    <div class="vpp-order-builder-virtual-header" role="row">
                        <span role="columnheader">#</span>
                        <span role="columnheader">@Loc["ItemName"]</span>
                        <span role="columnheader">@Loc["Category"]</span>
                        <span role="columnheader">@Loc["UOM"]</span>
                        <span role="columnheader">@Loc["Actions"]</span>
                    </div>

                    @* ROWS: Các dòng mặt hàng trong danh mục. *@
                    <div class="vpp-order-builder-virtual-body" role="rowgroup">
                        @if (ProductCount == 0)
                        {
                            <VppDataGridEmptyState State="@(HasProductFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                                   Title="@(HasProductFilters ? Loc["NoCatalogProductsMatchQuery"] : Loc["NoData"])"
                                                   Description="@(HasProductFilters ? Loc["AdjustCatalogFilters"].Value : null)" />
                        }
                        else
                        {
                            @foreach (var row in VisibleProductOptions)
                            {
                                <div @key="row.Id"
                                 class="vpp-order-builder-virtual-row @(IsSelected(row.Id) ? "vpp-wizard-row-selected" : string.Empty)"
                                 role="row">
                                <span class="vpp-order-builder-virtual-cell is-index" role="cell">@GetProductRowNumber(row)</span>
                                <div class="vpp-order-builder-virtual-cell" role="cell">
                                    <div class="vpp-order-builder-item-cell">
                                        <strong>@row.VppName</strong>
                                        <VppCellValuePopover Value="@row.VppCode"
                                                             Label="@Loc["ItemCode"]"
                                                             CopyLabel="@Loc["Copy"]"
                                                             Kind="VppCellValueKind.Code"
                                                             IsOpen="@(_openProductCodeId == row.Id)"
                                                             Toggled="@(() => ToggleProductCode(row.Id))"
                                                             CopyRequested="@CopyProductCodeAsync"
                                                             TriggerClass="vpp-order-builder-code" />
                                        <span class="vpp-order-item-limit">@Loc["MaxQuantityPerOrderFormat", row.MaxQuantityPerOrder]</span>
                                    </div>
                                </div>
                                <span class="vpp-order-builder-virtual-cell" role="cell">@row.VppCategoryName</span>
                                <span class="vpp-order-builder-virtual-cell is-centered" role="cell">@row.UomName</span>
                                <div class="vpp-order-builder-virtual-cell is-action" role="cell">
                                    @if (IsSelected(row.Id))
                                    {
                                        <button type="button"
                                                class="vpp-order-builder-row-action is-remove"
                                                title="@Loc["RemoveItemFromOrder"]"
                                                aria-label="@Loc["RemoveItemFromOrder"]"
                                                @onclick="() => RemoveProductAsync(row.Id)">
                                            <VppIcon Name="close" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="vpp-order-builder-row-action"
                                                aria-label="@Loc["AddProductToOrder"]"
                                                @onclick="() => AddProductAsync(row)">
                                            <VppIcon Name="add" />
                                            <span>@Loc["Add"]</span>
                                        </button>
                                    }
                                </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            </ChildContent>
            @* PAGINATION: Phân trang snapshot danh mục phía client. *@
            <Footer>
                <RadzenPager @key="_catalogPagerVersion"
                             Count="@ProductCount"
                             PageSize="@_catalogPageSize"
                             PageSizeOptions="@VppPagingProfiles.LargeWorkingSet.PageSizeOptions"
                             PageSizeText="@Loc["ItemsPerPage"]"
                             ShowPagingSummary="true"
                             PagingSummaryFormat="@Loc["CatalogPagingSummary"]"
                             AlwaysVisible="@(ProductCount > 0)"
                             Density="Density.Compact"
                             HorizontalAlign="HorizontalAlign.Right"
                             PageChanged="@OnCatalogPageChanged"
                             PageSizeChanged="@OnCatalogPageSizeChanged"
                             class="vpp-order-builder-pager" />
            </Footer>
            </VppDataSurfaceFrame>
        </section>
        </Primary>

        @* DRAFT: Hiển thị các mặt hàng đã chọn và tổng số lượng của đơn. *@
        <Secondary>
        <aside class="vpp-order-draft" aria-labelledby="order-draft-title">
            <header class="vpp-order-draft-header">
                <div>
                    <h2 id="order-draft-title">@Loc["OrderBeingCreated"]</h2>
                    <p>@Loc["Period"] @TargetPeriodLabel</p>
                </div>
                <div class="vpp-order-draft-badges">
                    <VppCategoryChip Text="@Loc["ItemsCount", Editor.SelectedItemCount]" Tone="VppCategoryTone.Primary" />
                    <VppStatusBadge Text="@Loc["Draft"]" Tone="@VppStatusToneContract.Resolve("Draft")" />
                </div>
            </header>

            @* COLUMNS: Tiêu đề các cột mặt hàng đã chọn trong đơn. *@
            <div class="vpp-order-draft-columns" aria-hidden="true">
                <span>@Loc["ItemName"]</span>
                <span>@Loc["QuantityShort"]</span>
                <span>@Loc["UOM"]</span>
                <span>@Loc["Actions"]</span>
            </div>

            @if (Editor.SelectedItemCount == 0)
            {
                <div class="vpp-order-draft-empty">
                    <VppIcon Name="add_shopping_cart" />
                    <strong>@Loc["WizardNoItemsSelected"]</strong>
                    <p>@Loc["WizardNoItemsSelectedDesc"]</p>
                </div>
            }
            else
            {
                <div class="vpp-order-draft-list">
                    @* ROWS: Các dòng mặt hàng đã chọn trong bản nháp. *@
                    @foreach (var item in Editor.SelectedItems)
                    {
                        <article class="vpp-order-draft-item" @key="item.VppId">
                            <div class="vpp-order-draft-item-main">
                                <div class="vpp-order-builder-item-cell">
                                    <strong>@item.VppName</strong>
                                    <small>@item.VppCode</small>
                                    <span class="vpp-order-item-limit">@Loc["MaxQuantityPerOrderFormat", item.EffectiveMaxQuantityPerOrder]</span>
                                </div>
                                <div class="vpp-order-quantity-stepper" aria-label="@($"{Loc["Quantity"].Value}: {GetItemLabel(item)}")">
                                     @* QUANTITY: Điều chỉnh số lượng trong bản nháp. *@
                                     <button type="button" @onclick="() => ChangeQuantity(item, -1)" aria-label="@Loc["DecreaseQuantity"]" disabled="@(item.Quantity <= 1)">−</button>
                                    <input type="number"
                                           class="vpp-order-quantity-input"
                                           min="1"
                                           max="@item.EffectiveMaxQuantityPerOrder"
                                           step="1"
                                           value="@item.Quantity"
                                           inputmode="numeric"
                                           aria-label="@($"{Loc["Quantity"].Value}: {GetItemLabel(item)}")"
                                           @onchange="args => SetQuantity(item, args.Value)" />
                                    <button type="button"
                                            @onclick="() => ChangeQuantity(item, 1)"
                                            aria-label="@Loc["IncreaseQuantity"]"
                                            disabled="@Editor.IsAtQuantityLimit(item)">+</button>
                                </div>
                                <span class="vpp-order-draft-unit">@item.UomName</span>
                                <div class="vpp-order-draft-item-actions">
                                     @* ITEM ACTIONS: Mở ghi chú hoặc xóa mặt hàng khỏi bản nháp. *@
                                     <button type="button"
                                            class="vpp-order-draft-note"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            title="@Loc["ItemNote"]"
                                            aria-label="@($"{Loc["ItemNote"]}: {GetItemLabel(item)}")"
                                            @onclick="() => SnapshotItemNote(item)">
                                        <VppIcon Name="edit_note" />
                                    </button>
                                    <button type="button"
                                            class="vpp-order-draft-remove"
                                            title="@Loc["RemoveItemFromOrder"]"
                                            aria-label="@Loc["RemoveItemFromOrder"]"
                                            @onclick="() => RemoveItemAsync(item)">
                                        <VppIcon Name="close" />
                                    </button>
                                </div>
                            </div>
                            @if (Editor.ExceedsQuantityLimit(item))
                            {
                                <p class="vpp-order-quantity-warning">@Loc["OrderItemQuantityLimitExceeded", item.EffectiveMaxQuantityPerOrder]</p>
                            }
                             @* ITEM NOTE: Popover chỉnh sửa ghi chú của từng mặt hàng. *@
                             <div id="@GetItemNotePopoverId(item)"
                                 class="vpp-order-note-popover vpp-transient-surface vpp-transient-surface--center"
                                 popover="auto">
                                <header>
                                    <div>
                                        <strong>@Loc["ItemNote"]</strong>
                                        <span>@GetItemLabel(item)</span>
                                    </div>
                                    <button type="button"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            popovertargetaction="hide"
                                            aria-label="@Loc["Close"]">
                                        <VppIcon Name="close" />
                                    </button>
                                </header>
                                <textarea value="@item.Description"
                                          @oninput="args => UpdateItemNote(item, args.Value?.ToString())"
                                          maxlength="500"
                                          placeholder="@Loc["ItemNotePlaceholder"]"></textarea>
                                <small class="vpp-order-note-scope">@Loc["ItemNoteScopeHint"]</small>
                                <footer class="vpp-order-note-footer">
                                    <button type="button"
                                            class="vpp-order-note-cancel"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            popovertargetaction="hide"
                                            @onclick="() => RevertItemNote(item)">@Loc["Cancel"]</button>
                                    <button type="button"
                                            class="vpp-order-note-save"
                                            popovertarget="@GetItemNotePopoverId(item)"
                                            popovertargetaction="hide">
                                        <VppIcon Name="check" />
                                        <span>@Loc["SaveNote"]</span>
                                    </button>
                                </footer>
                            </div>
                        </article>
                    }
                </div>
            }

             @* SUMMARY: Tổng số mặt hàng và tổng số lượng hiện tại. *@
             <div class="vpp-order-draft-summary">
                <span>@Loc["ItemsCount", Editor.SelectedItemCount]</span>
                <strong>@Loc["TotalQuantity"] @Editor.TotalQuantity</strong>
            </div>

             @* ACTIONS: Quay lại, lưu nháp, ghi chú đơn và chuyển sang bước review. *@
             <footer class="vpp-order-draft-actions">
                <button type="button" class="vpp-order-action-back" @onclick="async () => await BackRequested.InvokeAsync()">
                    <VppIcon Name="arrow_back" />
                    <span>@Loc["Previous"]</span>
                </button>
                <div class="vpp-order-draft-actions-right">
                    @if (CanSaveDraft)
                    {
                        <button type="button" class="vpp-order-action-save" @onclick="async () => await SaveDraftRequested.InvokeAsync()">
                            <VppIcon Name="save" />
                            <span>@Loc["SaveDraft"]</span>
                        </button>
                    }
                    <button type="button"
                            class="vpp-order-action-note"
                            popovertarget="@OrderNotePopoverId"
                            @onclick="SnapshotOrderNote">
                        <VppIcon Name="edit_note" />
                        <span>@Loc["Note"]</span>
                    </button>
                    <RadzenButton Icon="arrow_forward"
                                  Text="@Loc["ContinueReview"]"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(!CanContinue)"
                                  Click="@(async _ => await NextRequested.InvokeAsync())" />
                </div>
            </footer>

            <div id="@OrderNotePopoverId" class="vpp-order-note-popover vpp-order-note-popover--order vpp-transient-surface vpp-transient-surface--center" popover="auto">
                <header>
                    <div>
                        <strong>@OrderNoteLabel</strong>
                        <span>@OrderNoteContextLabel</span>
                    </div>
                    <button type="button"
                            popovertarget="@OrderNotePopoverId"
                            popovertargetaction="hide"
                            aria-label="@Loc["Close"]">
                        <VppIcon Name="close" />
                    </button>
                </header>
                <textarea value="@OrderNote"
                          @oninput="args => UpdateOrderNote(args.Value?.ToString())"
                          maxlength="500"
                          placeholder="@OrderNotePlaceholder"></textarea>
                <small class="vpp-order-note-scope">@Loc["OrderNoteScopeHint"]</small>
                <footer class="vpp-order-note-footer">
                    <button type="button"
                            class="vpp-order-note-cancel"
                            popovertarget="@OrderNotePopoverId"
                            popovertargetaction="hide"
                            @onclick="RevertOrderNote">@Loc["Cancel"]</button>
                    <button type="button"
                            class="vpp-order-note-save"
                            popovertarget="@OrderNotePopoverId"
                            popovertargetaction="hide">
                        <VppIcon Name="check" />
                        <span>@Loc["SaveNote"]</span>
                    </button>
                </footer>
            </div>
        </aside>
        </Secondary>
        </VppSplitEditorWorkspace>
    </div>
</div>

@code {
    // STATE: Filter, pagination, loading và trạng thái transient surface của bước chọn hàng.
    [CascadingParameter] public OrderEditorSession Editor { get; set; } = default!;
    [Parameter] public EventCallback NextRequested { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }
    [Parameter] public EventCallback SaveDraftRequested { get; set; }
    [Parameter] public bool CanSaveDraft { get; set; }
    [Parameter] public string TargetPeriodLabel { get; set; } = string.Empty;
    [Inject] public RequestsQueryClient Requests { get; set; } = default!;

    public bool IsLoadingProducts { get; set; }
    public int ProductCount { get; set; }
    public List<VppItemResDTO> ProductOptions { get; set; } = [];
    public List<VppFilterOption<string>> CategoryOptions { get; set; } = [];
    public List<VppFilterOption<string>> UnitOptions { get; set; } = [];
    public string? SearchText { get; set; }
    public string? CategoryFilter { get; set; }
    public string? UnitFilter { get; set; }
    private const int SnapshotBatchSize = 100;
    private int _catalogPageSize = VppPagingProfiles.LargeWorkingSet.DefaultPageSize;
    private int _catalogSkip;
    private int _catalogPagerVersion;
    private readonly List<VppItemResDTO> _allProductOptions = [];
    private CancellationTokenSource? _searchDebounceCts;
    private Guid? _openProductCodeId;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");

    private string OrderNotePopoverId => $"vpp-order-note-{_instanceId}";
    private IReadOnlyList<VppItemResDTO> VisibleProductOptions => ProductOptions
        .Skip(_catalogSkip)
        .Take(_catalogPageSize)
        .ToList();
    private bool HasProductFilters => !string.IsNullOrWhiteSpace(SearchText)
        || !string.IsNullOrWhiteSpace(CategoryFilter)
        || !string.IsNullOrWhiteSpace(UnitFilter);

    private bool CanContinue => Editor.SelectedItemCount > 0;
    private string OrderNoteLabel => Editor.IsAdditional ? Loc["SupplementReason"].Value : Loc["OrderNote"].Value;
    private string OrderNotePlaceholder => Editor.IsAdditional ? Loc["SupplementReasonPlaceholder"].Value : Loc["OrderNotePlaceholder"].Value;
    private string? OrderNote => Editor.IsAdditional ? Editor.SupplementReason : Editor.Description;
    // Atlas order-note-popover: dòng phụ "Đơn kỳ MM/yyyy"; nhánh đơn bổ sung giữ ngữ cảnh "Đơn đang tạo".
    private string OrderNoteContextLabel => Editor.IsAdditional
        ? Loc["OrderBeingCreated"].Value
        : string.Format(Loc["OrderNotePeriodFormat"].Value, TargetPeriodLabel);

    // NOTE STATE: Snapshot dùng để hoàn nguyên ghi chú khi người dùng bấm Hủy.
    // Nút "Hủy" của popover ghi chú hoàn nguyên giá trị chụp lúc mở (textarea vẫn auto-bind khi gõ).
    private Guid _itemNoteSnapshotId;
    private string? _itemNoteSnapshot;
    private string? _orderNoteSnapshot;

    private int GetProductRowNumber(VppItemResDTO row)
        => ProductOptions.IndexOf(row) + 1;

    private void SnapshotItemNote(OrderEditorSession.SelectedItem item)
    {
        _itemNoteSnapshotId = item.VppId;
        _itemNoteSnapshot = item.Description;
    }

    private void RevertItemNote(OrderEditorSession.SelectedItem item)
    {
        if (item.VppId == _itemNoteSnapshotId)
        {
            UpdateItemNote(item, _itemNoteSnapshot);
        }
    }

    private void SnapshotOrderNote() => _orderNoteSnapshot = OrderNote;

    private void RevertOrderNote() => UpdateOrderNote(_orderNoteSnapshot);

    // LIFECYCLE: Tải snapshot catalog khi bước được khởi tạo.
    protected override async Task OnInitializedAsync()
    {
        await LoadProductSnapshotAsync();
    }

    // FILTER OPTIONS: Tạo danh sách category/unit từ snapshot catalog.
    private void BuildFilterOptions()
    {
        static void Fill(List<VppFilterOption<string>> target, string allText, IEnumerable<string?> values)
        {
            target.Clear();
            target.Add(new VppFilterOption<string>(string.Empty, allText));
            target.AddRange(values
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value!.Trim())
                .Distinct(StringComparer.CurrentCultureIgnoreCase)
                .OrderBy(value => value, StringComparer.CurrentCultureIgnoreCase)
                .Select(value => new VppFilterOption<string>(value, value)));
        }

        Fill(CategoryOptions, Loc["AllCategories"], _allProductOptions.Select(item => item.VppCategoryName));
        Fill(UnitOptions, Loc["AllUnits"], _allProductOptions.Select(item => item.UomName));
    }

    // DATA LOADING: Nạp dữ liệu catalog và áp dụng bộ lọc ban đầu.
    private async Task LoadProductSnapshotAsync()
    {
        IsLoadingProducts = true;
        try
        {
            _allProductOptions.Clear();
            _allProductOptions.AddRange(await Requests.GetCatalogSnapshotAsync(
                SnapshotBatchSize,
                "VppName"));
            ReconcileSelectedItemLimits();
            BuildFilterOptions();
            ApplyProductFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[OrderCreateStep2] LoadProducts failed: {ex.Message}");
            ProductOptions = [];
            ProductCount = 0;
        }
        finally
        {
            IsLoadingProducts = false;
        }
    }

    private void ReconcileSelectedItemLimits()
    {
        var limitsByItem = _allProductOptions.ToDictionary(
            item => item.Id,
            item => item.MaxQuantityPerOrder);

        foreach (var selectedItem in Editor.SelectedItems)
        {
            if (limitsByItem.TryGetValue(selectedItem.VppId, out var limit))
            {
                selectedItem.MaxQuantityPerOrder = limit;
            }
        }
    }

    // FILTER EVENTS: Debounce tìm kiếm và xử lý thay đổi các bộ lọc.
    private async Task OnSearchInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchDebounceCts.Token);
            ApplyProductFilters();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task OnCategoryChanged(string value)
    {
        CategoryFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        CloseProductTransientSurfaces();
        ApplyProductFilters();
        return Task.CompletedTask;
    }

    private Task OnUnitChanged(string value)
    {
        UnitFilter = string.IsNullOrWhiteSpace(value) ? null : value;
        CloseProductTransientSurfaces();
        ApplyProductFilters();
        return Task.CompletedTask;
    }

    private Task ClearFiltersAsync()
    {
        SearchText = null;
        CategoryFilter = null;
        UnitFilter = null;
        CloseProductTransientSurfaces();
        ApplyProductFilters();
        return Task.CompletedTask;
    }

    // FILTERING: Lọc snapshot và reset vị trí phân trang.
    private void ApplyProductFilters()
    {
        var search = SearchText?.Trim();
        ProductOptions = _allProductOptions.Where(item =>
                (string.IsNullOrEmpty(search)
                    || (item.VppName?.Contains(search, StringComparison.CurrentCultureIgnoreCase) ?? false)
                    || (item.VppCode?.Contains(search, StringComparison.CurrentCultureIgnoreCase) ?? false))
                && (string.IsNullOrEmpty(CategoryFilter) || string.Equals(item.VppCategoryName, CategoryFilter, StringComparison.CurrentCultureIgnoreCase))
                && (string.IsNullOrEmpty(UnitFilter) || string.Equals(item.UomName, UnitFilter, StringComparison.CurrentCultureIgnoreCase)))
            .ToList();
        ProductCount = ProductOptions.Count;
        ResetCatalogPager();
    }

    // PAGING: Cập nhật trang và kích thước trang của catalog.
    private void OnCatalogPageChanged(PagerEventArgs args)
    {
        _catalogSkip = args.Skip;
        CloseProductTransientSurfaces();
    }

    private void OnCatalogPageSizeChanged(int pageSize)
    {
        _catalogPageSize = pageSize;
        ResetCatalogPager();
    }

    private void ResetCatalogPager()
    {
        _catalogSkip = 0;
        _catalogPagerVersion++;
        CloseProductTransientSurfaces();
    }

    // TRANSIENT UI: Điều khiển popover mã hàng và đóng surface tạm thời.
    private void ToggleProductCode(Guid id)
        => _openProductCodeId = _openProductCodeId == id ? null : id;

    private void CloseProductTransientSurfaces()
        => _openProductCodeId = null;

    // CLIPBOARD: Sao chép mã mặt hàng qua JavaScript interop.
    private async Task CopyProductCodeAsync(string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
        }
    }

    // SELECTION: Đồng bộ thao tác thêm/xóa với OrderEditorSession.
    private bool IsSelected(Guid id) => Editor.IsSelected(id);

    private async Task AddProductAsync(VppItemResDTO row)
    {
        if (Editor.TryAddItem(new OrderEditorSession.SelectedItem
        {
            VppId = row.Id,
            VppCode = row.VppCode,
            VppName = row.VppName,
            UomCode = row.UomCode,
            UomName = row.UomName,
            MaxQuantityPerOrder = row.MaxQuantityPerOrder,
            Quantity = 1
        }))
        {
            await RefreshSelectionAsync();
        }
    }

    private async Task RemoveProductAsync(Guid id)
    {
        var item = Editor.FindSelectedItem(id);
        if (item is not null)
        {
            await RemoveItemAsync(item);
        }
    }

    private async Task RemoveItemAsync(OrderEditorSession.SelectedItem item)
    {
        if (Editor.RemoveItem(item))
        {
            await RefreshSelectionAsync();
        }
    }

    private void ChangeQuantity(OrderEditorSession.SelectedItem item, int delta) =>
        Editor.ChangeQuantity(item, delta);

    private void SetQuantity(OrderEditorSession.SelectedItem item, object? value) =>
        Editor.SetQuantity(item, value);

    private void UpdateItemNote(OrderEditorSession.SelectedItem item, string? value) =>
        Editor.UpdateItemDescription(item, value);

    private void UpdateOrderNote(string? value) => Editor.UpdateOrderNote(value);

    private Task RefreshSelectionAsync() => InvokeAsync(StateHasChanged);

    private static string GetItemLabel(OrderEditorSession.SelectedItem item)
        => !string.IsNullOrWhiteSpace(item.VppName) ? item.VppName : item.VppCode ?? string.Empty;

    private string GetItemNotePopoverId(OrderEditorSession.SelectedItem item)
        => $"vpp-item-note-{_instanceId}-{item.VppId:N}";

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
