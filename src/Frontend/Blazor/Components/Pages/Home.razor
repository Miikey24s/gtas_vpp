@* PAGE: Home.razor *@
@page "/"
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject gtas_vpp_fe.Helpers.AuthHelper AuthHelper
@inject gtas_vpp_fe.Features.IdentityAccess.State.PermissionState PermissionState

<PageTitle>GTAS VPP - @Loc["Loading"]</PageTitle>

<main class="vpp-system-page">
    <VppContentState State="VppContentStateKind.Loading"
                     FillAvailable="true"
                     Icon="@VppIcons.Progress"
                     Title="@Loc["Loading"]"
                     Description="@Loc["RedirectingToAllowedWorkspace"]" />
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        var (isAuthenticated, _) = await AuthHelper.EnsureAuthenticatedAsync();
        if (!isAuthenticated)
        {
            NavigationManager.NavigateTo(Config.LoginPagePath, true);
            return;
        }

        await PermissionState.EnsureLoadedAsync();
        NavigationManager.NavigateTo(PermissionState.GetFirstAccessibleRoute() ?? "/not-found", replace: true);
    }
}
