@using gtas_vpp_fe.Components.Pages.Lib.Tabs
@using gtas_vpp_shared.Constants
@using gtas_vpp_shared.DTOs.Res.Library
@inject GlobalClass glb

<PageTitle>GTAS VPP - Library</PageTitle>



@if (HasAnyVisibleLibraryTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="librariestab vpp-admin-tabs vpp-bounded-shell"
                RenderMode="TabRenderMode.Client"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            @if (CanViewLibraryTab(Permissions.LibraryClass))
            {
                <RadzenTabsItem Text="@Loc["ClassDefinitions"]">
                    @if (IsActiveTab(0))
                    {
                        <Tab_LookupLibrary claims="@claims" PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryCategory))
            {
                <RadzenTabsItem Text="@Loc["OperationCategories"]">
                    @if (IsActiveTab(1))
                    {
                        <Tab_CategoryLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryItem))
            {
                <RadzenTabsItem Text="@Loc["Operations"]">
                    @if (IsActiveTab(2))
                    {
                        <Component_ShareGrid TType=VppItemResDTO @bind-Data=@operations DicDropdownData=@CategoryDropdownDatas Add=@ApiAddAsync Update=@ApiUpdateAsync SetStatus=@ApiSetStatusAsync DataEndpoint="@Config.ApiCatalogItems" PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddItem"]" GridAriaLabel="@Loc["Operations"]" SearchPlaceholder="@Loc["LibrarySearchItems"]" SearchFields="@(new[] { "VppCode", "VppName" })" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibrarySupplier))
            {
                <RadzenTabsItem Text="@Loc["Suppliers"]">
                    @if (IsActiveTab(3))
                    {
                        <Component_ShareGrid TType=SupplierResDTO @bind-Data=@suppliers Add=@ApiAddAsync Update=@ApiUpdateAsync PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddSupplier"]" GridAriaLabel="@Loc["Suppliers"]" SearchPlaceholder="@Loc["LibrarySearchSuppliers"]" SearchFields="@(new[] { "SupplierShortName", "SupplierName" })" />
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryPriceList, Permissions.LibraryPrice))
            {
                <RadzenTabsItem Text="@Loc["Pricing"]">
                    @if (IsActiveTab(6))
                    {
                        @if (CanShowPricingTabs)
                        {
                            <div class="vpp-library-local-selector">
                                <VppSegmentedSelector TValue="int"
                                                      Value="@SelectedPricingTabId"
                                                      Options="@PricingSelectorOptions"
                                                      ValueChanged="@SelectPricingTabAsync"
                                                      AriaLabel="@Loc["Pricing"]" />
                            </div>

                            @if (IsActivePricingTab(PriceListTabIndex))
                            {
                                <Tab_PriceListLibrary claims="@claims"
                                                      PagePermissionResDTO="@PagePermissionResDTO" />
                            }
                            else if (IsActivePricingTab(PriceTabIndex))
                            {
                                <Tab_PriceLibrary claims="@claims"
                                                  PagePermissionResDTO="@PagePermissionResDTO" />
                            }
                        }
                        else if (CanShowPriceLists)
                        {
                            <Tab_PriceListLibrary claims="@claims"
                                                  PagePermissionResDTO="@PagePermissionResDTO" />
                        }
                        else if (CanShowPrices)
                        {
                            <Tab_PriceLibrary claims="@claims"
                                              PagePermissionResDTO="@PagePermissionResDTO" />
                        }
                    }
                </RadzenTabsItem>
            }
            @if (CanViewLibraryTab(Permissions.LibraryDepartment))
            {
                <RadzenTabsItem Text="@Loc["Departments"]">
                    @if (IsActiveTab(5))
                    {
                        <Component_ShareGrid TType=DepartmentResDTO @bind-Data=@departments Add=@ApiAddAsync Update=@ApiUpdateAsync PagePermissionResDTO="@PagePermissionResDTO" CreateLabel="@Loc["AddDepartment"]" GridAriaLabel="@Loc["Departments"]" SearchPlaceholder="@Loc["LibrarySearchDepartments"]" SearchFields="@(new[] { "Code", "Name" })" />
                    }
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
