@* PAGE: Lib/Component_Library.razor *@
@using gtas_vpp_fe.Components.Pages.Lib.Tabs
@using gtas_vpp_shared.Constants

<PageTitle>GTAS VPP - Library</PageTitle>



@if (HasAnyVisibleLibraryTab)
{
    <RadzenTabs Change="@TabOnChange"
                TabPosition="@tabPosition"
                class="vpp-admin-tabs vpp-bounded-shell"
                RenderMode="TabRenderMode.Server"
                @bind-SelectedIndex=SelectedIndex>
        <Tabs>
            @if (HasAuthorizedLibraryTab(0))
            {
                <RadzenTabsItem Text="@Loc["ClassDefinitions"]">
                    @if (IsActiveTab(0))
                    {
                        <Tab_LookupLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedLibraryTab(1))
            {
                <RadzenTabsItem Text="@Loc["OperationCategories"]">
                    @if (IsActiveTab(1))
                    {
                        <Tab_CategoryLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedLibraryTab(2))
            {
                <RadzenTabsItem Text="@Loc["Operations"]">
                    @if (IsActiveTab(2))
                    {
                        <Tab_ItemLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedLibraryTab(3))
            {
                <RadzenTabsItem Text="@Loc["Suppliers"]">
                    @if (IsActiveTab(3))
                    {
                        <Tab_SupplierLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedLibraryTab(6))
            {
                <RadzenTabsItem Text="@Loc["Pricing"]">
                    @if (IsActiveTab(6))
                    {
                        <div class="vpp-pricing-workspace">
                            @if (ShowPricingNavigation)
                            {
                                <nav class="vpp-local-header-tabs"
                                     aria-label="@Loc["Pricing"]">
                                    <VppHeaderTabGroup ParentLabel="@Loc["Pricing"]"
                                                       Tabs="@PricingHeaderTabs" />
                                </nav>
                            }

                            @if (IsActivePricingTab(PriceListTabIndex))
                            {
                                <Tab_PriceListLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                            }
                            else if (IsActivePricingTab(PriceTabIndex))
                            {
                                <Tab_PriceLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                            }
                        </div>
                    }
                </RadzenTabsItem>
            }
            @if (HasAuthorizedLibraryTab(5))
            {
                <RadzenTabsItem Text="@Loc["Departments"]">
                    @if (IsActiveTab(5))
                    {
                        <Tab_DepartmentLibrary PagePermissionResDTO="@PagePermissionResDTO" />
                    }
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
