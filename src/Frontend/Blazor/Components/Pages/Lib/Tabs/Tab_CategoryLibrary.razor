@* PAGE: Lib/Tabs/Tab_CategoryLibrary.razor *@
@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_fe.Helpers
@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<VppCategoryResDTO>

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         IsBusy="@isLoading"
                         State="@(isLoading ? VppDataSurfaceState.Loading : totalCount == 0 ? HasFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty : VppDataSurfaceState.Populated)"
                         AriaLabel="@Loc["OperationCategories"]"
                         TestId="category-admin-data-surface"
                         Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Header>
            <VppCollectionHeader Title="@Loc["OperationCategories"]"
                                 Summary="@Loc["RecordsCount", totalCount]"
                                 AddText="@Loc["AddCategory"]"
                                 CompactAddText="@Loc["Add"]"
                                 ShowAddAction="@CanModify"
                                 AddClicked="@OpenCreateAsync" />
        </Header>
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["OperationCategories"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText"
                                 Input="@OnSearchInputAsync"
                                 Placeholder="@Loc["LibrarySearchCategories"]"
                                 AriaLabel="@Loc["LibrarySearchCategories"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                       IsActive="@HasFilters"
                                       Clicked="@ClearFiltersAsync" />
                <VppColumnPicker TItem="VppCategoryResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid"
                            TItem="VppCategoryResDTO"
                            data-vpp-grid-region="true"
                            aria-label="@Loc["OperationCategories"]"
                            Data="@rows"
                            Count="@totalCount"
                            LoadData="@LoadDataAsync"
                            IsLoading="@isLoading"
                            AllowFiltering="false"
                            AllowSorting="true"
                            AllowAlternatingRows="false"
                            AllowMultiColumnSorting="false"
                            ShowMultiColumnSortingIndex="false"
                            AllowPaging="true"
                            PagerAlwaysVisible="true"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                            PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal"
                            RowRender="@OnRowRender"
                            class="vpp-admin-grid vpp-data-grid vpp-data-density-compact"
                            ColumnWidth="150px"
                            Style="--vpp-admin-grid-min-width: 960px;">
                <EmptyTemplate>
                    <VppDataGridEmptyState State="@(HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                           Title="@(HasFilters ? Loc["NoOrdersMatchSelectedFilters"] : Loc["NoData"])"
                                           Description="@(HasFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
                </EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" Reorderable="false" Pickable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="VppCategoryName" Title="@Loc["CategoryName"]" Width="220px" MinWidth="190px" />
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="VppCategoryCode" Title="@Loc["CategoryCode"]" Width="140px" MinWidth="125px" />
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="Id" Title="@Loc["SystemId"]" Width="270px" MinWidth="240px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="IsDeleted" Title="@Loc["Status"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="row"><VppStatusBadge Text="@(row.IsDeleted ? Loc["Inactive"] : Loc["Active"])" Tone="@VppStatusToneContract.Resolve(row.IsDeleted ? "Inactive" : "Active")" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="Description" Title="@Loc["Description"]" Width="260px" MinWidth="220px">
                        <Template Context="row"><span class="vpp-admin-truncate" title="@row.Description">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="CreatedAtUtc" Title="@Loc["CreatedAt"]" Width="160px" TextAlign="TextAlign.Center" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Property="UpdatedAtUtc" Title="@Loc["UpdatedAt"]" Width="150px" TextAlign="TextAlign.Center" FormatString="{0:dd/MM/yyyy HH:mm}" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppCategoryResDTO" Title="@Loc["Actions"]" Width="128px" MinWidth="128px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-medium" HeaderCssClass="rz-col-actions rz-col-actions-medium" Visible="@CanModify">
                        <Template Context="row">
                            <div class="vpp-admin-actions">
                                <VppAdminIconAction Icon="edit" Text="@Loc["Edit"]" Title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" />
                                <VppAdminLifecycleMenu Title="@Loc["MoreActions"]"
                                                       RestoreText="@Loc["Restore"]"
                                                       DeactivateText="@Loc["Deactivate"]"
                                                       HardDeleteText="@Loc["HardDelete"]"
                                                       IsDeleted="@row.IsDeleted"
                                                       CanToggle="@CanModify"
                                                       CanHardDelete="@(CanModify && row.IsDeleted)"
                                                       DeletedChanged="@((bool isDeleted) => ToggleDeletedAsync(row, isDeleted))"
                                                       HardDeleteRequested="@(() => HardDeleteAsync(row))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
