@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_shared.DTOs.Res.Library

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging" Density="VppDataDensity.Compact" AriaLabel="@Loc["Departments"]" TestId="department-admin-data-surface" Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Toolbar><VppDataToolbar AriaLabel="@Loc["Departments"]" Class="vpp-admin-grid-toolbar"><VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchDepartments"]" AriaLabel="@Loc["LibrarySearchDepartments"]" /><VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" /><RadzenButton Icon="add" Text="@Loc["AddDepartment"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="vpp-library-primary-action" Disabled="@(!CanModify)" Click="@OpenCreateAsync" /><VppColumnPicker TItem="DepartmentResDTO" GridAccessor="@(() => grid)" /></VppDataToolbar></Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid" TItem="DepartmentResDTO" data-vpp-grid-region="true" aria-label="@Loc["Departments"]" Data="@rows" Count="@totalCount" LoadData="@LoadDataAsync" LoadColumnFilterData="@LoadColumnFilterDataAsync" IsLoading="@isLoading" AllowFiltering="true" AllowSorting="true" AllowMultiColumnSorting="false" ShowMultiColumnSortingIndex="false" AllowPaging="true" PagerAlwaysVisible="true" GotoFirstPageOnSort="true" PageSize="@VppPagingProfiles.Collection.DefaultPageSize" PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions" AllowColumnResize="true" AllowColumnPicking="false" AllowPickAllColumns="true" ColumnsPickerAllowFiltering="true" FilterMode="FilterMode.CheckBoxList" FilterPopupRenderMode="PopupRenderMode.OnDemand" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" RowRender="@OnRowRender" class="vpp-admin-grid vpp-data-grid vpp-data-density-compact" ColumnWidth="150px" Style="--vpp-admin-grid-min-width: 1080px;">
                <Columns>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index"><Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="Name" Title="@Loc["DepartmentName"]" Width="280px" MinWidth="240px"><Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.Name ?? "–")</strong><small>@(row.Code ?? "–")</small></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="ParentDepartmentId" Title="Phòng ban cha" Width="240px"><Template Context="row">@GetParentName(row.ParentDepartmentId)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="Description" Title="@Loc["Description"]" Width="360px"><Template Context="row"><span class="vpp-admin-truncate" title="@row.Description">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted"><Template Context="row"><div class="vpp-admin-is-deleted-cell"><RadzenSwitch TValue="bool" Value="@row.IsDeleted" Disabled="@(!CanModify)" Change="@(async (bool value) => await ToggleDeletedAsync(row, value))" class="isDeleteSwitch vpp-admin-switch-compact" /></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Title="@Loc["Actions"]" Width="100px" MinWidth="100px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions"><Template Context="row"><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanModify)" title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" /></Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
