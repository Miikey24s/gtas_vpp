@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<DepartmentResDTO>

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging" Density="VppDataDensity.Compact" AriaLabel="@Loc["Departments"]" TestId="department-admin-data-surface" Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Toolbar><VppDataToolbar AriaLabel="@Loc["Departments"]" Class="vpp-admin-grid-toolbar"><VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchDepartments"]" AriaLabel="@Loc["LibrarySearchDepartments"]" /><VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" /><VppColumnPicker TItem="DepartmentResDTO" GridAccessor="@(() => grid)" /></VppDataToolbar></Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid" TItem="DepartmentResDTO" data-vpp-grid-region="true" aria-label="@Loc["Departments"]" Data="@rows" Count="@totalCount" LoadData="@LoadDataAsync" LoadColumnFilterData="@LoadColumnFilterDataAsync" IsLoading="@isLoading" AllowFiltering="true" AllowSorting="true" AllowMultiColumnSorting="false" ShowMultiColumnSortingIndex="false" AllowPaging="true" PagerAlwaysVisible="true" GotoFirstPageOnSort="true" PageSize="@VppPagingProfiles.Collection.DefaultPageSize" PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions" AllowColumnResize="true" AllowColumnPicking="false" AllowPickAllColumns="true" ColumnsPickerAllowFiltering="true" FilterMode="FilterMode.CheckBoxList" FilterPopupRenderMode="PopupRenderMode.OnDemand" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" RowRender="@OnRowRender" class="vpp-admin-grid vpp-data-grid vpp-data-density-compact" ColumnWidth="150px" Style="--vpp-admin-grid-min-width: 960px; --vpp-admin-actions-width: 140px;">
                <Columns>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index"><Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="Name" Title="@Loc["DepartmentName"]" Width="250px" MinWidth="220px"><Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.Name ?? "–")</strong><small>@(row.Code ?? "–")</small></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="ParentDepartmentId" Title="Phòng ban cha" Width="180px"><Template Context="row">@GetParentName(row.ParentDepartmentId)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="Description" Title="@Loc["Description"]" Width="280px"><Template Context="row"><span class="vpp-admin-truncate" title="@row.Description">@(string.IsNullOrWhiteSpace(row.Description) ? "–" : row.Description)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Property="IsDeleted" Title="@Loc["Status"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false"><Template Context="row"><RadzenBadge Text="@(row.IsDeleted ? Loc["Inactive"] : Loc["Active"])" BadgeStyle="@(row.IsDeleted ? BadgeStyle.Light : BadgeStyle.Success)" /></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DepartmentResDTO" Title="@Loc["Actions"]" Width="140px" MinWidth="140px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions"><HeaderTemplate><VppActionColumnHeader Text="@Loc["Actions"]" AddText="@Loc["AddDepartment"]" Disabled="@(!CanModify)" AddClicked="@OpenCreateAsync" /></HeaderTemplate><Template Context="row"><div class="vpp-admin-actions"><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanModify)" title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" /><RadzenButton Icon="@(row.IsDeleted ? "restore_from_trash" : "delete")" Size="ButtonSize.Small" ButtonStyle="@(row.IsDeleted ? ButtonStyle.Light : ButtonStyle.Danger)" Disabled="@(!CanModify)" title="@(row.IsDeleted ? Loc["Restore"] : Loc["Deactivate"])" Click="@(() => ToggleDeletedAsync(row, !row.IsDeleted))" /></div></Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
