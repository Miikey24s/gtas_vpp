@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_shared.DTOs.Res.Library

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["Suppliers"]"
                         TestId="supplier-admin-data-surface"
                         Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["Suppliers"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchSuppliers"]" AriaLabel="@Loc["LibrarySearchSuppliers"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                <RadzenButton Icon="add" Text="@Loc["AddSupplier"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="vpp-library-primary-action" Disabled="@(!CanModify)" Click="@OpenCreateAsync" />
                <VppColumnPicker TItem="SupplierResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid" TItem="SupplierResDTO" data-vpp-grid-region="true" aria-label="@Loc["Suppliers"]"
                            Data="@rows" Count="@totalCount" LoadData="@LoadDataAsync" LoadColumnFilterData="@LoadColumnFilterDataAsync"
                            IsLoading="@isLoading" AllowFiltering="true" AllowSorting="true" AllowMultiColumnSorting="false"
                            ShowMultiColumnSortingIndex="false" AllowPaging="true" PagerAlwaysVisible="true" GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.Collection.DefaultPageSize" PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                            AllowColumnResize="true" AllowColumnPicking="false" AllowPickAllColumns="true" ColumnsPickerAllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList" FilterPopupRenderMode="PopupRenderMode.OnDemand" Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal" RowRender="@OnRowRender"
                            class="vpp-admin-grid vpp-data-grid vpp-data-density-compact" ColumnWidth="150px" Style="--vpp-admin-grid-min-width: 1180px;">
                <Columns>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="SupplierName" Title="@Loc["SupplierName"]" Width="300px" MinWidth="260px">
                        <Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.SupplierName ?? "–")</strong><small>@(row.SupplierShortName ?? "–")</small></div></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="City" Title="@Loc["City"]" Width="150px" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Ward" Title="@Loc["Ward"]" Width="160px" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Address1" Title="@Loc["Address1"]" Width="360px" MinWidth="280px">
                        <Template Context="row"><span class="vpp-admin-truncate" title="@row.Address1">@(string.IsNullOrWhiteSpace(row.Address1) ? "–" : row.Address1)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                        <Template Context="row"><div class="vpp-admin-is-deleted-cell"><RadzenSwitch TValue="bool" Value="@row.IsDeleted" Disabled="@(!CanModify)" Change="@(async (bool value) => await ToggleDeletedAsync(row, value))" class="isDeleteSwitch vpp-admin-switch-compact" /></div></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Title="@Loc["Actions"]" Width="100px" MinWidth="100px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                        <Template Context="row"><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanModify)" title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" /></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
