@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<SupplierResDTO>

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["Suppliers"]"
                         TestId="supplier-admin-data-surface"
                         Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Header>
            <VppCollectionHeader Title="@Loc["Suppliers"]"
                                 Summary="@Loc["RecordsCount", totalCount]"
                                 AddText="@Loc["AddSupplier"]"
                                 CompactAddText="@Loc["Add"]"
                                 Disabled="@(!CanModify)"
                                 AddClicked="@OpenCreateAsync" />
        </Header>
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["Suppliers"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchSuppliers"]" AriaLabel="@Loc["LibrarySearchSuppliers"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                <VppColumnPicker TItem="SupplierResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid" TItem="SupplierResDTO" data-vpp-grid-region="true" aria-label="@Loc["Suppliers"]"
                            Data="@rows" Count="@totalCount" LoadData="@LoadDataAsync"
                            IsLoading="@isLoading" AllowFiltering="false" AllowSorting="true" AllowMultiColumnSorting="false"
                            AllowAlternatingRows="false"
                            ShowMultiColumnSortingIndex="false" AllowPaging="true" PagerAlwaysVisible="true" GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.Collection.DefaultPageSize" PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                            AllowColumnResize="true" AllowColumnPicking="false" AllowPickAllColumns="true" ColumnsPickerAllowFiltering="true"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal" RowRender="@OnRowRender"
                            class="vpp-admin-grid vpp-data-grid vpp-data-density-compact" ColumnWidth="150px" Style="--vpp-admin-grid-min-width: 960px; --vpp-admin-actions-width: 140px;">
                <Columns>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="SupplierName" Title="@Loc["SupplierName"]" Width="250px" MinWidth="220px">
                        <Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.SupplierName ?? "–")</strong><small>@(row.SupplierShortName ?? "–")</small></div></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="City" Title="@Loc["Location"]" Width="180px">
                        <Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(string.IsNullOrWhiteSpace(row.City) ? "–" : row.City)</strong><small>@(string.IsNullOrWhiteSpace(row.Ward) ? "–" : row.Ward)</small></div></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Address1" Title="@Loc["Address1"]" Width="270px" MinWidth="220px">
                        <Template Context="row"><span class="vpp-admin-truncate" title="@row.Address1">@(string.IsNullOrWhiteSpace(row.Address1) ? "–" : row.Address1)</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Ward" Title="@Loc["Ward"]" Width="150px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Address2" Title="@Loc["Address2"]" Width="220px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Address3" Title="@Loc["Address3"]" Width="220px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="Description" Title="@Loc["Description"]" Width="240px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="UpdatedAtUtc" Title="@Loc["UpdatedAt"]" Width="150px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="SupplierResDTO" Property="IsDeleted" Title="@Loc["Status"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="row"><VppStatusBadge Text="@(row.IsDeleted ? Loc["Inactive"] : Loc["Active"])" Tone="@(row.IsDeleted ? VppStatusTone.Neutral : VppStatusTone.Success)" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SupplierResDTO" Title="@Loc["Actions"]" Width="140px" MinWidth="140px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                        <Template Context="row"><div class="vpp-admin-actions"><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanModify)" title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" /><RadzenButton Icon="@(row.IsDeleted ? "restore_from_trash" : "delete")" Size="ButtonSize.Small" ButtonStyle="@(row.IsDeleted ? ButtonStyle.Light : ButtonStyle.Danger)" Disabled="@(!CanModify)" title="@(row.IsDeleted ? Loc["Restore"] : Loc["Deactivate"])" Click="@(() => ToggleDeletedAsync(row, !row.IsDeleted))" /></div></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
