@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_shared.DTOs.Res.Library

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging" Density="VppDataDensity.Compact" AriaLabel="@Loc["Operations"]" TestId="item-admin-data-surface" Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["Operations"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchItems"]" AriaLabel="@Loc["LibrarySearchItems"]" />
                <VppFilterSelect TValue="string" Value="@categoryFilter" Options="@categoryOptions" ValueChanged="@OnCategoryChangedAsync" Placeholder="@Loc["AllCategories"]" AriaLabel="@Loc["AllCategories"]" />
                <VppFilterSelect TValue="string" Value="@uomFilter" Options="@uomOptions" ValueChanged="@OnUomChangedAsync" Placeholder="@Loc["AllUnits"]" AriaLabel="@Loc["AllUnits"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                <RadzenButton Icon="add" Text="@Loc["AddItem"]" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" class="vpp-library-primary-action" Disabled="@(!CanModify)" Click="@OpenCreateAsync" />
                <VppColumnPicker TItem="VppItemResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid" TItem="VppItemResDTO" data-vpp-grid-region="true" aria-label="@Loc["Operations"]" Data="@rows" Count="@totalCount" LoadData="@LoadDataAsync" LoadColumnFilterData="@LoadColumnFilterDataAsync" IsLoading="@isLoading" AllowFiltering="true" AllowSorting="true" AllowMultiColumnSorting="false" ShowMultiColumnSortingIndex="false" AllowPaging="true" PagerAlwaysVisible="true" GotoFirstPageOnSort="true" PageSize="@VppPagingProfiles.Collection.DefaultPageSize" PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions" AllowColumnResize="true" AllowColumnPicking="false" AllowPickAllColumns="true" ColumnsPickerAllowFiltering="true" FilterMode="FilterMode.CheckBoxList" FilterPopupRenderMode="PopupRenderMode.OnDemand" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" RowRender="@OnRowRender" class="vpp-admin-grid vpp-data-grid vpp-data-density-compact" ColumnWidth="150px" Style="--vpp-admin-grid-min-width: 1260px;">
                <Columns>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index"><Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppName" Title="@Loc["ProductName"]" Width="300px" MinWidth="260px"><Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.VppName ?? "–")</strong><small>@(row.VppCode ?? "–")</small></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppCategoryName" Title="@Loc["Category"]" Width="220px" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="UomName" Title="@Loc["UOM"]" Width="120px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="DefaultSupplierName" Title="@Loc["Supplier"]" Width="220px" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="DefaultPrice" Title="@Loc["Price"]" Width="120px" TextAlign="TextAlign.Right" FormatString="{0:N0}" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted"><Template Context="row"><div class="vpp-admin-is-deleted-cell"><RadzenSwitch TValue="bool" Value="@row.IsDeleted" Disabled="@(!CanModify)" Change="@(async (bool value) => await ToggleDeletedAsync(row, value))" class="isDeleteSwitch vpp-admin-switch-compact" /></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Title="@Loc["Actions"]" Width="100px" MinWidth="100px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions"><Template Context="row"><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(!CanModify)" title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" /></Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
