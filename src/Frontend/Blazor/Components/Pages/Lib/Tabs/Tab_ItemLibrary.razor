@* PAGE: Lib/Tabs/Tab_ItemLibrary.razor *@
@using gtas_vpp_fe.Components.DesignSystem.Composites
@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<VppItemResDTO>

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging" Density="VppDataDensity.Compact" IsBusy="@isLoading" State="@(isLoading ? VppDataSurfaceState.Loading : totalCount == 0 ? HasFilters ? VppDataSurfaceState.FilteredEmpty : VppDataSurfaceState.Empty : VppDataSurfaceState.Populated)" AriaLabel="@Loc["Operations"]" TestId="item-admin-data-surface" Class="vpp-admin-data-surface vpp-admin-collection-surface">
        <Header><VppCollectionHeader Title="@Loc["Operations"]" Summary="@Loc["RecordsCount", totalCount]" AddText="@Loc["AddItem"]" CompactAddText="@Loc["Add"]" ShowAddAction="@CanModify" AddClicked="@OpenCreateAsync" /></Header>
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["Operations"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchItems"]" AriaLabel="@Loc["LibrarySearchItems"]" />
                <VppFilterSelect TValue="string" Value="@categoryFilter" Options="@categoryOptions" ValueChanged="@OnCategoryChangedAsync" Placeholder="@Loc["AllCategories"]" AriaLabel="@Loc["AllCategories"]" />
                <VppFilterSelect TValue="string" Value="@uomFilter" Options="@uomOptions" ValueChanged="@OnUomChangedAsync" Placeholder="@Loc["AllUnits"]" AriaLabel="@Loc["AllUnits"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                <VppColumnPicker TItem="VppItemResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid" TItem="VppItemResDTO" data-vpp-grid-region="true" aria-label="@Loc["Operations"]" Data="@rows" Count="@totalCount" LoadData="@LoadDataAsync" IsLoading="@isLoading" AllowFiltering="false" AllowSorting="true" AllowAlternatingRows="false" AllowMultiColumnSorting="false" ShowMultiColumnSortingIndex="false" AllowPaging="true" PagerAlwaysVisible="true" PagerHorizontalAlign="HorizontalAlign.Right" GotoFirstPageOnSort="true" PageSize="@VppPagingProfiles.Collection.DefaultPageSize" PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions" AllowColumnResize="true" AllowColumnPicking="false" AllowPickAllColumns="true" ColumnsPickerAllowFiltering="true" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" RowRender="@OnRowRender" class="vpp-admin-grid vpp-data-grid vpp-data-density-compact" ColumnWidth="150px" Style="--vpp-admin-grid-min-width: 960px; --vpp-admin-actions-width: 140px;">
                <EmptyTemplate><VppDataGridEmptyState State="@(HasFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)" Title="@(HasFilters ? Loc["NoOrdersMatchSelectedFilters"] : Loc["NoData"])" Description="@(HasFilters ? Loc["HistoryAdjustFilters"].Value : null)" /></EmptyTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" Reorderable="false" Pickable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index"><Template Context="row">@(currentSkip + rows.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppName" Title="@Loc["ItemName"]" Width="220px" MinWidth="190px" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppCode" Title="@Loc["ItemCode"]" Width="150px" MinWidth="135px" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="Id" Title="@Loc["SystemId"]" Width="270px" MinWidth="240px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="VppCategoryName" Title="@Loc["Category"]" Width="150px" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="UomName" Title="@Loc["UOM"]" Width="92px" TextAlign="TextAlign.Center" Filterable="false"><HeaderTemplate><span title="@Loc["UOM"]">@Loc["UomCompact"]</span></HeaderTemplate></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="DefaultSupplierName" Title="@Loc["Supplier"]" Width="140px" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="SupplierCount" Title="@Loc["SupplierCount"]" Width="125px" TextAlign="TextAlign.Center" Filterable="false" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="IsDeleted" Title="@Loc["Status"]" Width="110px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false"><Template Context="row"><VppStatusBadge Text="@(row.IsDeleted ? Loc["Inactive"] : Loc["Active"])" Tone="@VppStatusToneContract.Resolve(row.IsDeleted ? "Inactive" : "Active")" /></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="DefaultPrice" Title="@Loc["Price"]" Width="105px" TextAlign="TextAlign.Right" FormatString="{0:N0}" Filterable="false" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="DefaultVatRate" Title="@Loc["DefaultVatRate"]" Width="110px" TextAlign="TextAlign.Right" Filterable="false" Visible="false" Pickable="true"><Template Context="row">@row.DefaultVatRate.ToString("0.##")%</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="Description" Title="@Loc["Description"]" Width="220px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="CreatedAtUtc" Title="@Loc["CreatedAt"]" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Property="UpdatedAtUtc" Title="@Loc["UpdatedAt"]" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="VppItemResDTO" Title="@Loc["Actions"]" Width="140px" MinWidth="140px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions" Visible="@CanModify">
                        <Template Context="row">
                            <div class="vpp-admin-actions">
                                <VppAdminIconAction Icon="edit" Text="@Loc["Edit"]" Title="@Loc["Edit"]" Click="@(() => OpenEditAsync(row))" />
                                <VppAdminLifecycleMenu Title="@Loc["MoreActions"]"
                                                       RestoreText="@Loc["Restore"]"
                                                       DeactivateText="@Loc["Deactivate"]"
                                                       HardDeleteText="@Loc["HardDelete"]"
                                                       IsDeleted="@row.IsDeleted"
                                                       CanToggle="@CanModify"
                                                       CanHardDelete="@(CanModify && row.IsDeleted)"
                                                       DeletedChanged="@((bool isDeleted) => ToggleDeletedAsync(row, isDeleted))"
                                                       HardDeleteRequested="@(() => HardDeleteAsync(row))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
