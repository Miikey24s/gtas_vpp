@* PAGE: Lib/Tabs/Dialog/Dialog_PriceListEditor.razor *@
@using gtas_vpp_fe.Helpers
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Req.Library
@using gtas_vpp_shared.DTOs.Res.Library

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Workspace" TestId="price-list-editor">
    <ChildContent>
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["PriceListCode"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.Code" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["PriceListName"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.Name" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            <RadzenFormField Text="Nhà cung cấp" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid?" Data="@Suppliers" TextProperty="SupplierName" ValueProperty="Id" @bind-Value="Model.SupplierId" AllowFiltering="true" Style="width:100%" /></RadzenFormField>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Phiên bản" Variant="Variant.Outlined"><RadzenNumeric TValue="int" @bind-Value="Model.Version" Min="1" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Tiền tệ" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.CurrencyCode" MaxLength="3" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4"><RadzenFormField Text="Mã hợp đồng" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.ContractCode" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="3"><RadzenFormField Text="Chiết khấu %" Variant="Variant.Outlined"><RadzenNumeric TValue="decimal" @bind-Value="Model.DiscountRate" Min="0" Max="100" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3"><RadzenFormField Text="Rebate" Variant="Variant.Outlined"><RadzenNumeric TValue="decimal" @bind-Value="Model.RebateAmount" Min="0" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3"><RadzenFormField Text="Phí" Variant="Variant.Outlined"><RadzenNumeric TValue="decimal" @bind-Value="Model.FeeAmount" Min="0" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3"><RadzenFormField Text="Vận chuyển" Variant="Variant.Outlined"><RadzenNumeric TValue="decimal" @bind-Value="Model.ShippingAmount" Min="0" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            @if (!IsClone)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox TValue="bool" @bind-Value="Model.IsDefault" /><RadzenText Text="@Loc["IsDefault"]" TextStyle="TextStyle.Body2" /></RadzenStack>
            }
            <RadzenFormField Text="@Loc["Description"]" Variant="Variant.Outlined"><RadzenTextArea @bind-Value="Model.Description" Rows="4" Style="width:100%" /></RadzenFormField>
        </RadzenStack>
    </ChildContent>
    <Footer><VppDialogActions CancelText="@Loc["Cancel"]" PrimaryText="@Loc["Save"]" CancelClick="@Cancel" PrimaryClick="@Save" /></Footer>
</VppAdaptiveDialogShell>
