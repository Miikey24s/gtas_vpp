@* PAGE: Lib/Tabs/Dialog/Dialog_PriceListEditor.razor *@
@using gtas_vpp_fe.Helpers
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Req.Library
@using gtas_vpp_shared.DTOs.Res.Library

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Standard" TestId="price-list-editor">
    <ChildContent>
        <RadzenStack Gap="1rem">
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["PriceListCode"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.Code" MaxLength="50" Style="width:100%" /></RadzenFormField></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenFormField Text="@Loc["PriceListName"]" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="Model.Name" MaxLength="200" Style="width:100%" /></RadzenFormField></RadzenColumn>
            </RadzenRow>
            @if (IsClone)
            {
                <RadzenText Text="@Loc["PriceListCloneTermsHint"]" TextStyle="TextStyle.Caption" />
            }
            else
            {
                <VppDecisionSelect TValue="Guid?"
                                   Value="@Model.SupplierId"
                                   ValueChanged="@OnSupplierChanged"
                                   Options="@SupplierOptions"
                                   Placeholder="@Loc["PriceListSelectSupplier"]"
                                   AriaLabel="@Loc["PriceListSupplier"]"
                                   Eyebrow="@Loc["PriceListSupplier"]"
                                   Disabled="@(SupplierOptions.Count == 0)" />
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"><RadzenCheckBox TValue="bool" @bind-Value="Model.IsDefault" /><RadzenText Text="@Loc["PriceListUseAsDefault"]" TextStyle="TextStyle.Body2" /></RadzenStack>
            }
            <RadzenFormField Text="@Loc["Description"]" Variant="Variant.Outlined"><RadzenTextArea @bind-Value="Model.Description" Rows="4" Style="width:100%" /></RadzenFormField>
        </RadzenStack>
    </ChildContent>
    <Footer><VppDialogActions CancelText="@Loc["Cancel"]" PrimaryText="@Loc["Save"]" CancelClick="@Cancel" PrimaryClick="@Save" /></Footer>
</VppAdaptiveDialogShell>
