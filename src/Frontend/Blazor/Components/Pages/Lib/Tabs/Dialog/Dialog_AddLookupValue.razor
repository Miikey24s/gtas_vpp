@* PAGE: Lib/Tabs/Dialog/Dialog_AddLookupValue.razor *@
@using gtas_vpp_fe.Features.CatalogPricing.Api
@using gtas_vpp_fe.Services
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_shared.DTOs.Share
@inject DialogService DialogService
@inject LookupApiClient LookupApi
@inject IToastService _toastService
@inject CurrentUserState CurrentUserState

<VppAdaptiveDialogShell Size="VppAdminDialogSize.Compact" TestId="lookup-value-editor">
<ChildContent>
<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@Loc["Code"]" Variant="Variant.Outlined" AllowFloatingLabel="false">
                <RadzenTextBox @bind-Value="@Model.Code" Placeholder="@BuildExample(ExampleCode)" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="@Loc["Value"]" Variant="Variant.Outlined" AllowFloatingLabel="false">
                <RadzenTextBox @bind-Value="@Model.Value" Placeholder="@BuildExample(ExampleValue)" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@Loc["SortOrder"]" Variant="Variant.Outlined" AllowFloatingLabel="false">
                <RadzenNumeric @bind-Value="@Model.Sort" Placeholder="@BuildExample(ExampleSort?.ToString())" Style="width: 100%;" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenFormField Text="@Loc["Description"]" Variant="Variant.Outlined" AllowFloatingLabel="false">
                <RadzenTextArea @bind-Value="@Model.Description" Placeholder="@BuildExample(ExampleDescription)" Style="width: 100%;" Rows="3" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
</RadzenStack>
</ChildContent>
<Footer>
    <VppDialogActions CancelText="@Loc["Cancel"]"
                      PrimaryText="@Loc["Save"]"
                      IsBusy="@isBusy"
                      CancelClick="@Cancel"
                      PrimaryClick="@Save" />
</Footer>
</VppAdaptiveDialogShell>

@code {
    [Parameter] public LookupValueResDTO Model { get; set; } = new() { Code = "", Value = "" };
    [Parameter] public bool IsCreate { get; set; }
    [Parameter] public string? ExampleCode { get; set; }
    [Parameter] public string? ExampleValue { get; set; }
    [Parameter] public int? ExampleSort { get; set; }
    [Parameter] public string? ExampleDescription { get; set; }
    
    private bool isBusy = false;

    private string? BuildExample(string? value)
        => IsCreate && !string.IsNullOrWhiteSpace(value)
            ? string.Format(Loc["FieldExample"].Value, value)
            : null;

    private async Task Cancel()
    {
        await DialogService.TryCloseAsync(null);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(Model.Code) || string.IsNullOrWhiteSpace(Model.Value))
        {
            _toastService.Show(NotificationSeverity.Warning, Loc["ValidationTitle"], Loc["LookupValueRequired"], 5000, false);
            return;
        }

        isBusy = true;
        try
        {
            Model.UpdatedAtUtc = DateTime.Now;
            Model.UpdatedByUserId = CurrentUserState.Current?.UserId ?? 0;

            LookupValueResDTO? result;
            if (IsCreate)
            {
                Model.Id = Guid.NewGuid();
                Model.CreatedAtUtc = DateTime.Now;
                Model.CreatedByUserId = CurrentUserState.Current?.UserId ?? 0;
                result = await LookupApi.CreateValueAsync(Model);
            }
            else
            {
                result = await LookupApi.UpdateValueAsync(Model);
            }

            if (result != null)
            {
                _toastService.Show(NotificationSeverity.Success, Loc["Success"],
                    IsCreate ? Loc["LookupValueCreated"].Value : Loc["LookupValueUpdated"].Value, 5000, false);
                DialogService.Close(result);
            }
            else
            {
                _toastService.Show(NotificationSeverity.Error, Loc["Error"], Loc["LookupValueSaveFailed"], 5000, true);
            }
        }
        catch (Exception ex)
        {
            _toastService.Error(ex, Loc, "CreateRecordFailed");
        }
        finally
        {
            isBusy = false;
        }
    }
}
