@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<VppItemPriceResDTO>


<VppCollectionWorkspace Class="vpp-admin-workspace vpp-price-workspace">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["Prices"]"
                         TestId="prices-data-surface"
                         Class="vpp-admin-data-surface">
    <Toolbar>
    <VppDataToolbar AriaLabel="@Loc["Prices"]" Class="vpp-admin-grid-toolbar vpp-price-filterbar">
        <VppFilterSelect TValue="Guid?" Value="@selectedPriceListId" Options="@PriceListFilterOptions" ValueChanged="@OnPriceListChangedAsync" Placeholder="@Loc["PriceList"]" AriaLabel="@Loc["PriceList"]" Disabled="@(!HasPriceLists)" />
        <VppFilterSelect TValue="Guid?" Value="@selectedSupplierId" Options="@SupplierFilterOptions" ValueChanged="@OnSupplierChangedAsync" Placeholder="@Loc["Supplier"]" AriaLabel="@Loc["Supplier"]" Disabled="@(!HasPriceListSelected)" />
        <VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchPrices"]" AriaLabel="@Loc["LibrarySearchPrices"]" />
        <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@(!string.IsNullOrWhiteSpace(searchText))" Clicked="@ClearSearchAsync" />
        <VppColumnPicker TItem="VppItemPriceResDTO" GridAccessor="@(() => grid)" />
    </VppDataToolbar>
    </Toolbar>
    <ChildContent>

    @if (!HasPriceLists)
    {
        <VppInlineNotice Tone="VppStatusTone.Warning">
            @Loc["NoPriceListAvailable"]
        </VppInlineNotice>
    }

    <RadzenDataGrid @ref="grid"
                    data-vpp-grid-region="true"
                    aria-label="@Loc["Prices"]"
                    TItem="VppItemPriceResDTO"
                    Data="@displayItems"
                    Count="@priceCount"
                    LoadData="@LoadPriceRowsAsync"
                    IsLoading="@isLoading"
                    AllowSorting="true"
                    AllowAlternatingRows="false"
                    AllowMultiColumnSorting="false"
                    ShowMultiColumnSortingIndex="false"
                    AllowPaging="true"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    GotoFirstPageOnSort="true"
                    PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                    PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                    Density="Density.Compact"
                    EmptyText="@GridEmptyText"
                    GridLines="DataGridGridLines.Horizontal"
                    AllowFiltering="false"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    AllowColumnResize="true"
                    AllowColumnPicking="false"
                    AllowPickAllColumns="true"
                    ColumnsPickerAllowFiltering="true"
                    RowRender="@OnRowRenderPrice"
                    class="vpp-admin-grid vpp-admin-page-grid vpp-price-grid vpp-data-grid vpp-data-density-compact"
                    ColumnWidth="150px"
                    Style="--vpp-admin-grid-min-width: 1260px; --vpp-admin-actions-width: 128px;">
        <Columns>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Title="#" Width="52px" MinWidth="52px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                <Template Context="row">
                    @(currentSkip + displayItems.IndexOf(row) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VppName" Title="@Loc["ProductName"]" Width="240px" MinWidth="210px"><Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.VppName ?? "–")</strong><small>@(row.VppCode ?? "–")</small></div></Template></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="CategoryName" Title="@Loc["Category"]" Width="140px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="UomName" Title="@Loc["UOM"]" Width="84px" TextAlign="TextAlign.Center" Filterable="false"><HeaderTemplate><span title="@Loc["UOM"]">@Loc["UomCompact"]</span></HeaderTemplate></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="SupplierSku" Title="@Loc["SupplierSku"]" Width="110px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="Price" Title="@Loc["Price"]" Width="105px" TextAlign="TextAlign.Right" FormatString="{0:N0}" Filterable="false">
                <Template Context="row">
                    @if (row.Price.HasValue)
                    {
                        <span>@row.Price.Value.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="text-muted vpp-admin-empty-value">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* Thuế VAT là dữ liệu cấp mức giá, không suy ra từ bảng giá. *@
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VatRate" Title="@Loc["VatRate"]" Width="80px" TextAlign="TextAlign.Right" Filterable="false">
                <HeaderTemplate><span title="@Loc["VatRate"]">@Loc["VatRateCompact"]</span></HeaderTemplate>
                <Template Context="row">
                    @if (row.PriceMappingId.HasValue)
                    {
                        <span>@row.VatRate.ToString("0.##")%</span>
                    }
                    else
                    {
                        <span class="text-muted vpp-admin-empty-value">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="MinimumOrderQuantity" Title="@Loc["MinimumOrderQuantity"]" Width="100px" TextAlign="TextAlign.Right" FormatString="{0:0.##}" Filterable="false"><HeaderTemplate><span title="@Loc["MinimumOrderQuantity"]">@Loc["MinimumOrderQuantityCompact"]</span></HeaderTemplate></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="LeadTimeDays" Title="@Loc["LeadTimeDays"]" Width="96px" TextAlign="TextAlign.Center" Filterable="false"><HeaderTemplate><span title="@Loc["LeadTimeDays"]">@Loc["LeadTimeCompact"]</span></HeaderTemplate></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="IsDefault" Title="@Loc["DefaultPrice"]" Width="96px" TextAlign="TextAlign.Center" Filterable="false">
                <Template Context="row">
                    <RadzenSwitch TValue="bool" Value="@row.IsDefault" Disabled="true" class="vpp-admin-switch-readonly" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VppCode" Title="@Loc["ProductCode"]" Width="124px" Visible="false" Pickable="true" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" Pickable="true" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Title="@Loc["Actions"]" Width="128px" MinWidth="128px" Sortable="false" Filterable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-medium" HeaderCssClass="rz-col-actions rz-col-actions-medium">
                <Template Context="row">
                    <div class="vpp-admin-actions">
                        <RadzenButton Icon="edit"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      title="@GetEditPriceActionTitle(row)"
                             Disabled="@(row.IsDeleted || !IsSelectedPriceListDraft)"
                                      Click="@(() => EditPriceAsync(row))" />
                        <RadzenButton Icon="star"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Info"
                                      title="@Loc["SetDefault"]"
                                      Disabled="@(!row.PriceMappingId.HasValue || row.IsDefault || row.IsDeleted)"
                                      Click="@(() => SetDefaultAsync(row))" />
                        <RadzenButton Icon="@(row.IsDeleted ? "restore_from_trash" : "delete")"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="@(row.IsDeleted ? ButtonStyle.Light : ButtonStyle.Danger)"
                                      title="@(row.IsDeleted ? Loc["Restore"] : Loc["Deactivate"])"
                                      Disabled="@(!row.PriceMappingId.HasValue || !IsSelectedPriceListDraft)"
                                      Click="@(() => SetDeletedPriceAsync(row, !row.IsDeleted))" />
                        <RadzenButton Icon="delete_forever"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Danger"
                                      title="@Loc["HardDelete"]"
                             Disabled="@(!row.PriceMappingId.HasValue || !IsSelectedPriceListDraft)"
                                      Click="@(() => HardDeletePriceAsync(row))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
