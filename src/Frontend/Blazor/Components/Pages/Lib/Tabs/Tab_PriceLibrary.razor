@using gtas_vpp_shared.DTOs.Res.Library


<VppCollectionWorkspace Class="vpp-admin-workspace vpp-price-workspace">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["Prices"]"
                         TestId="prices-data-surface"
                         Class="vpp-admin-data-surface">
    <Toolbar>
    <VppDataToolbar AriaLabel="@Loc["Prices"]" Class="vpp-admin-filterbar vpp-price-filterbar">
        <RadzenFormField Text="@Loc["PriceList"]" Style="min-width:280px;">
            <RadzenDropDown TValue="Guid?"
                            Data="@priceLists"
                            TextProperty="PriceListName"
                            ValueProperty="Id"
                            @bind-Value="selectedPriceListId"
                            Change="@(async _ => await OnPriceListChangedAsync())"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@(!HasPriceLists)"
                            Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="@Loc["Supplier"]" Style="min-width:320px;">
            <RadzenDropDown TValue="Guid?"
                            Data="@suppliers"
                            TextProperty="SupplierName"
                            ValueProperty="Id"
                            @bind-Value="selectedSupplierId"
                            Change="@(async _ => await OnSupplierChangedAsync())"
                            AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@(!HasPriceListSelected)"
                            Style="width:100%" />
        </RadzenFormField>
        <RadzenFormField Text="@Loc["Search"]" Style="min-width:240px;">
            <RadzenTextBox @bind-Value="searchText"
                           @oninput="@(async args => await OnSearchInputAsync(args.Value?.ToString()))"
                           Placeholder="@Loc["LibrarySearchPrices"]"
                           aria-label="@Loc["LibrarySearchPrices"]"
                           Style="width:100%" />
        </RadzenFormField>
        <RadzenButton Icon="refresh"
                      Text="@Loc["Reload"]"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Light"
                      class="vpp-library-refresh-action"
                      Title="@Loc["Reload"]"
                      aria-label="@Loc["Reload"]"
                      Click="@LoadPricesAsync"
                      Disabled="@(!HasPriceListSelected)" />
        <VppColumnPicker TItem="VppItemPriceResDTO" GridAccessor="@(() => grid)" />
    </VppDataToolbar>
    </Toolbar>
    <ChildContent>

    @if (!HasPriceLists)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
            @Loc["NoPriceListAvailable"]
        </RadzenAlert>
    }

    <RadzenDataGrid @ref="grid"
                    data-vpp-grid-region="true"
                    aria-label="@Loc["Prices"]"
                    TItem="VppItemPriceResDTO"
                    Data="@displayItems"
                    Count="@priceCount"
                    LoadData="@LoadPriceRowsAsync"
                    LoadColumnFilterData="@LoadPriceFilterDataAsync"
                    IsLoading="@isLoading"
                    AllowSorting="true"
                    AllowMultiColumnSorting="false"
                    ShowMultiColumnSortingIndex="false"
                    AllowPaging="true"
                    GotoFirstPageOnSort="true"
                    PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                    PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                    Density="Density.Compact"
                    EmptyText="@GridEmptyText"
                    GridLines="DataGridGridLines.Horizontal"
                    AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    AllowColumnResize="true"
                    AllowColumnPicking="false"
                    AllowPickAllColumns="true"
                    ColumnsPickerAllowFiltering="true"
                    RowRender="@OnRowRenderPrice"
                    class="vpp-admin-grid vpp-admin-page-grid vpp-price-grid vpp-data-grid vpp-data-density-compact"
                    ColumnWidth="150px"
                    Style="--vpp-admin-grid-min-width: 1380px;">
        <Columns>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Title="#" Width="52px" MinWidth="52px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                <Template Context="row">
                    @(currentSkip + displayItems.IndexOf(row) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VppCode" Title="@Loc["ProductCode"]" Width="124px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VppName" Title="@Loc["ProductName"]" Width="220px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="CategoryName" Title="@Loc["Category"]" Width="165px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="UomName" Title="@Loc["UOM"]" Width="78px" TextAlign="TextAlign.Center" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="Price" Title="@Loc["Price"]" Width="112px" TextAlign="TextAlign.Right" FormatString="{0:N0}">
                <Template Context="row">
                    @if (row.Price.HasValue)
                    {
                        <span>@row.Price.Value.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="text-muted vpp-admin-empty-value">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* Thuế VAT là dữ liệu cấp mức giá, không suy ra từ bảng giá. *@
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VatRate" Title="@Loc["VatRate"]" Width="86px" TextAlign="TextAlign.Right">
                <Template Context="row">
                    @if (row.PriceMappingId.HasValue)
                    {
                        <span>@row.VatRate.ToString("0.##")%</span>
                    }
                    else
                    {
                        <span class="text-muted vpp-admin-empty-value">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="IsDefault" Title="@Loc["DefaultPrice"]" Width="126px" TextAlign="TextAlign.Center">
                <Template Context="row">
                    <RadzenSwitch TValue="bool" Value="@row.IsDefault" Disabled="true" class="vpp-admin-switch-readonly" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="IsDeleted" Title="@Loc["IsDeleted"]" Width="90px" MinWidth="90px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                <Template Context="row">
                    @if (row.PriceMappingId.HasValue)
                    {
                        <div class="vpp-admin-is-deleted-cell">
                            <RadzenSwitch TValue="bool"
                            Value="@row.IsDeleted"
                            Disabled="@(!IsSelectedPriceListDraft)"
                                          Change="@(async (bool value) => await SetDeletedPriceAsync(row, value))"
                                          class="isDeleteSwitch vpp-admin-switch-compact" />
                        </div>
                    }
                    else
                    {
                        <span class="vpp-admin-inline-note">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Title="@Loc["Actions"]" Width="128px" MinWidth="128px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-medium" HeaderCssClass="rz-col-actions rz-col-actions-medium">
                <Template Context="row">
                    <div class="vpp-admin-actions">
                        <RadzenButton Icon="edit"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Light"
                                      title="@GetEditPriceActionTitle(row)"
                             Disabled="@(row.IsDeleted || !IsSelectedPriceListDraft)"
                                      Click="@(() => EditPriceAsync(row))" />
                        <RadzenButton Icon="star"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Info"
                                      title="@Loc["SetDefault"]"
                                      Disabled="@(!row.PriceMappingId.HasValue || row.IsDefault || row.IsDeleted)"
                                      Click="@(() => SetDefaultAsync(row))" />
                        <RadzenButton Icon="delete_forever"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Danger"
                                      title="@Loc["HardDelete"]"
                             Disabled="@(!row.PriceMappingId.HasValue || !IsSelectedPriceListDraft)"
                                      Click="@(() => HardDeletePriceAsync(row))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
