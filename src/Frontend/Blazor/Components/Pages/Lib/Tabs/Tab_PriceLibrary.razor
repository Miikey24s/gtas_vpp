@* PAGE: Lib/Tabs/Tab_PriceLibrary.razor *@
@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<VppItemPriceResDTO>


<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading" Class="vpp-admin-workspace vpp-price-workspace">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         IsBusy="@isLoading"
                         State="@PriceSurfaceState"
                         AriaLabel="@Loc["Prices"]"
                          TestId="prices-data-surface"
                          Class="vpp-admin-data-surface">
    <Header>
        <VppCollectionHeader Title="@Loc["Prices"]"
                             Summary="@Loc["RecordsCount", priceCount]">
            <Actions>
                @if (CanModify)
                {
                    <RadzenButton Text="@Loc["ImportPriceList"]"
                                  Icon="upload_file"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(!CanImportPrices)"
                                  title="@(CanImportPrices ? Loc["ImportPriceList"] : Loc["RequestActionUnavailable"])"
                                  Click="@ImportPricesAsync" />
                }
            </Actions>
        </VppCollectionHeader>
        <section class="vpp-price-context" aria-label="@Loc["PriceContext"]" data-testid="price-context">
            <label class="vpp-price-context-selector">
                <span>@Loc["PriceList"]</span>
                <VppFilterSelect TValue="Guid?"
                                 Value="@selectedPriceListId"
                                 Options="@PriceListFilterOptions"
                                 ValueChanged="@OnPriceListChangedAsync"
                                 Placeholder="@Loc["SelectPriceList"]"
                                 AriaLabel="@Loc["PriceList"]"
                                 Disabled="@(!HasPriceLists)" />
            </label>
            <dl class="vpp-price-context-facts">
                <div>
                    <dt>@Loc["Supplier"]</dt>
                    <dd>@SelectedSupplierName</dd>
                </div>
                <div>
                    <dt>@Loc["Status"]</dt>
                    <dd><VppStatusBadge Text="@SelectedPriceListStatusLabel" Tone="@SelectedPriceListStatusTone" /></dd>
                </div>
            </dl>
        </section>
    </Header>
    <Toolbar>
    <VppDataToolbar AriaLabel="@Loc["Prices"]" Class="vpp-admin-grid-toolbar vpp-price-filterbar">
        <VppFilterSearch Value="@searchText" Input="@OnSearchInputAsync" Placeholder="@Loc["LibrarySearchPrices"]" AriaLabel="@Loc["LibrarySearchPrices"]" />
        <VppFilterSelect TValue="string" Value="@selectedCategory" Options="@CategoryFilterOptions" ValueChanged="@OnCategoryChangedAsync" Placeholder="@Loc["AllCategories"]" AriaLabel="@Loc["AllCategories"]" Disabled="@(!HasPriceListSelected)" />
        <VppFilterSelect TValue="string" Value="@selectedUom" Options="@UomFilterOptions" ValueChanged="@OnUomChangedAsync" Placeholder="@Loc["AllUnits"]" AriaLabel="@Loc["AllUnits"]" Disabled="@(!HasPriceListSelected)" />
        <VppFilterSelect TValue="string" Value="@selectedMappingStatus" Options="@MappingStatusOptions" ValueChanged="@OnMappingStatusChangedAsync" Placeholder="@Loc["AllPriceMappings"]" AriaLabel="@Loc["AllPriceMappings"]" Disabled="@(!HasPriceListSelected)" />
        <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasPriceFilters" Clicked="@ClearFiltersAsync" />
        <VppColumnPicker TItem="VppItemPriceResDTO" GridAccessor="@(() => grid)" />
    </VppDataToolbar>
    </Toolbar>
    <ChildContent>

    @if (!HasPriceLists)
    {
        <VppInlineNotice Tone="VppStatusTone.Warning">
            @Loc["NoPriceListAvailable"]
        </VppInlineNotice>
    }

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <VppContentState State="VppContentStateKind.Error"
                         FillAvailable="true"
                         Icon="error_outline"
                         Title="@Loc["LoadLibraryDataFailed"]"
                         Description="@loadError"
                         PrimaryActionText="@Loc["Retry"]"
                         PrimaryAction="@(async _ => await LoadPricesAsync())" />
    }
    else
    {
    <RadzenDataGrid @ref="grid"
                    data-vpp-grid-region="true"
                    aria-label="@Loc["Prices"]"
                    TItem="VppItemPriceResDTO"
                    Data="@displayItems"
                    Count="@priceCount"
                    LoadData="@LoadPriceRowsAsync"
                    IsLoading="@isLoading"
                    AllowSorting="true"
                    AllowAlternatingRows="false"
                    AllowMultiColumnSorting="false"
                    ShowMultiColumnSortingIndex="false"
                    AllowPaging="true"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    GotoFirstPageOnSort="true"
                    PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                    PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                    Density="Density.Compact"
                    GridLines="DataGridGridLines.Horizontal"
                    AllowFiltering="false"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    AllowColumnResize="true"
                    AllowColumnPicking="false"
                    AllowPickAllColumns="true"
                    ColumnsPickerAllowFiltering="true"
                    RowRender="@OnRowRenderPrice"
                    class="vpp-admin-grid vpp-admin-page-grid vpp-price-grid vpp-data-grid vpp-data-density-compact"
                    ColumnWidth="150px">
        <EmptyTemplate>
            <VppDataGridEmptyState State="@(HasPriceFilters ? VppContentStateKind.FilteredEmpty : VppContentStateKind.Empty)"
                                   Title="@GridEmptyText"
                                   Description="@(HasPriceFilters ? Loc["HistoryAdjustFilters"].Value : null)" />
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Title="#" Width="52px" MinWidth="52px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" Reorderable="false" Pickable="false" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                <Template Context="row">
                    @(currentSkip + displayItems.IndexOf(row) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VppName" Title="@Loc["ItemName"]" Width="220px" MinWidth="190px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VppCode" Title="@Loc["ProductCode"]" Width="145px" MinWidth="130px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="PriceMappingId" Title="@Loc["SystemId"]" Width="270px" MinWidth="240px" Visible="false" Pickable="true" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="CategoryName" Title="@Loc["Category"]" Width="140px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="UomName" Title="@Loc["UOM"]" Width="100px" MinWidth="90px" TextAlign="TextAlign.Center" Filterable="false" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="IsDeleted" Title="@Loc["PriceStatus"]" Width="125px" MinWidth="115px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                <Template Context="row"><VppStatusBadge Text="@GetPriceStatusLabel(row)" Tone="@GetPriceStatusTone(row)" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="SupplierSku" Title="@Loc["SupplierSku"]" Width="170px" MinWidth="150px" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="Price" Title="@Loc["Price"]" Width="105px" TextAlign="TextAlign.Right" FormatString="{0:N0}" Filterable="false">
                <Template Context="row">
                    @if (row.Price.HasValue)
                    {
                        <span>@row.Price.Value.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="text-muted vpp-admin-empty-value">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* Thuế VAT là dữ liệu cấp mức giá, không suy ra từ bảng giá. *@
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="VatRate" Title="@Loc["VatRate"]" Width="90px" TextAlign="TextAlign.Right" Filterable="false">
                <Template Context="row">
                    @if (row.PriceMappingId.HasValue)
                    {
                        <span>@row.VatRate.ToString("0.##")%</span>
                    }
                    else
                    {
                        <span class="text-muted vpp-admin-empty-value">--</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="MinimumOrderQuantity" Title="@Loc["MinimumOrderShort"]" Width="125px" MinWidth="115px" TextAlign="TextAlign.Right" FormatString="{0:0.##}" Filterable="false" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="LeadTimeDays" Title="@Loc["LeadTimeDays"]" Width="110px" MinWidth="100px" TextAlign="TextAlign.Center" Filterable="false" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="IsDefault" Title="@Loc["DefaultPrice"]" Width="120px" MinWidth="110px" TextAlign="TextAlign.Center" Filterable="false">
                <Template Context="row">
                    @if (row.IsDefault)
                    {
                        <VppStatusBadge Text="@Loc["Default"]" Tone="VppStatusTone.Neutral" />
                    }
                    else
                    {
                        <span aria-label="@Loc["No"]">–</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" Pickable="true" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Property="UpdatedAtUtc" Title="@Loc["UpdatedAt"]" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
            <RadzenDataGridColumn TItem="VppItemPriceResDTO" Title="@Loc["Actions"]" Width="128px" MinWidth="128px" Sortable="false" Filterable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-medium" HeaderCssClass="rz-col-actions rz-col-actions-medium" Visible="@CanModify">
                <Template Context="row">
                    <div class="vpp-admin-actions">
                        <VppAdminIconAction Icon="edit"
                                            Text="@GetEditPriceActionTitle(row)"
                                            Title="@GetEditPriceActionTitle(row)"
                                            Disabled="@row.IsDeleted"
                                            DisabledReason="@Loc["RequestActionUnavailable"]"
                                            Click="@(() => EditPriceAsync(row))" />
                        @if (CanModify)
                        {
                            <VppAdminActionMenu Title="@Loc["MoreActions"]"
                                                Items="@PriceRowSecondaryActions(row)"
                                                AllowOpenWhenAllDisabled="true"
                                                TestId="price-row-more-actions" />
                        }
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    }
    </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
