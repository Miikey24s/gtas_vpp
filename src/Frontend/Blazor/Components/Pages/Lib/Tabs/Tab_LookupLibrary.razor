@* PAGE: Lib/Tabs/Tab_LookupLibrary.razor *@
@using Microsoft.AspNetCore.Components.Authorization
@using gtas_vpp_shared.DTOs.Share
@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_fe.Helpers
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject NavigationManager UriHelper
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject ContextMenuService ContextMenuService
@inject IToastService Toast
@inject IJSRuntime js


<VppSplitEditorWorkspace Resizable="false"
                         Ratio="VppSplitEditorRatio.CompactPrimary"
                         Class="vpp-admin-class-split">
    <Primary>
        <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                                 Density="VppDataDensity.Compact"
                                 AriaLabel="@Loc["ClassDefinitions"]"
                                 TestId="lookup-categories-data-surface"
                                 Class="vpp-admin-data-surface">
            <Header>
                <VppCollectionHeader Title="@Loc["ClassDefinitions"]"
                                     Summary="@Loc["RecordsCount", categoryCount]"
                                     AddText="@Loc["AddClass"]"
                                     CompactAddText="@Loc["Add"]"
                                     Disabled="@(!CanModifyLookup)"
                                     AddClicked="@OpenAddCategoryAsync" />
            </Header>
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["ClassDefinitions"]" Class="vpp-admin-grid-toolbar">
                    <VppFilterSearch Value="@categorySearchText"
                                     Input="@OnCategorySearchInputAsync"
                                     Placeholder="@Loc["LibrarySearchClasses"]"
                                     AriaLabel="@Loc["LibrarySearchClasses"]" />
                    <VppFilterSelect TValue="string"
                                     Value="@categoryStatusFilter"
                                     Options="@CategoryStatusOptions"
                                     ValueChanged="@OnCategoryStatusChangedAsync"
                                     Placeholder="@Loc["LibraryAllStatuses"]"
                                     AriaLabel="@Loc["LibraryAllStatuses"]" />
                    <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                           IsActive="@HasCategoryFilters"
                                           Clicked="@ClearCategoryFiltersAsync" />
                    <VppColumnPicker TItem="LookupCategoryResDTO" GridAccessor="@(() => categoryGrid)" />
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
            <RadzenDataGrid @ref="categoryGrid" TItem="LookupCategoryResDTO"
                            data-vpp-grid-region="true"
                            aria-label="@Loc["ClassDefinitions"]"
                            Data="@lookupCategories"
                            Count="@categoryCount"
                            LoadData="@LoadCategories"
                            IsLoading="@isCategoryLoading"
                            AllowFiltering="false"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            AllowSorting="true"
                            AllowAlternatingRows="false"
                            AllowMultiColumnSorting="false"
                            ShowMultiColumnSortingIndex="false"
                            AllowPaging="true"
                            PagerAlwaysVisible="true"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.SplitList.DefaultPageSize"
                            PageSizeOptions="@VppPagingProfiles.SplitList.PageSizeOptions"
                            Density="Density.Compact"
                            SelectionMode="DataGridSelectionMode.Single"
                            @bind-Value="@selectedLookupCategories"
                            RowSelect="@OnCategorySelected"
                            RowRender="@OnCategoryRowRender"
                            GridLines="DataGridGridLines.Horizontal"
                            class="auto-fit-grid vpp-admin-grid vpp-class-master-grid vpp-data-grid vpp-data-density-compact"
                            ColumnWidth="150px"
                            Style="--vpp-admin-grid-min-width: 480px; --vpp-admin-actions-width: 136px;">
                <Columns>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Title="#" Width="42px" MinWidth="42px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="data">
                            @(currentCategorySkip + lookupCategories.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Code" Title="@Loc["LookupCategoryCode"]" Width="85px" MinWidth="80px" CssClass="vpp-class-code-column" HeaderCssClass="vpp-class-code-column">
                        <Template Context="data"><span class="vpp-class-code-value">@data.Code</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Name" Title="@Loc["LookupCategoryName"]" Width="130px" MinWidth="120px" CssClass="vpp-class-name-column" HeaderCssClass="vpp-class-name-column">
                        <Template Context="data"><span class="vpp-class-name-value">@data.Name</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="IsDeleted" Title="@Loc["Status"]" Width="80px" MinWidth="80px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="vpp-class-status-column" HeaderCssClass="vpp-class-status-column">
                        <Template Context="data">
                            <VppStatusBadge Text="@(data.IsDeleted ? Loc["Inactive"] : Loc["Active"])" Tone="@VppStatusToneContract.Resolve(data.IsDeleted ? "Inactive" : "Active")" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="ModuleName" Title="@Loc["ModuleName"]" Width="120px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="CreatedByUserId" Title="Create User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="CreatedAtUtc" Title="Create Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="UpdatedByUserId" Title="Update User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Property="UpdatedAtUtc" Title="Update Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupCategoryResDTO" Title="@Loc["Actions"]" Width="136px" MinWidth="136px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                        <Template Context="data">
                            <div class="vpp-admin-actions">
                                <VppAdminIconAction Icon="edit" Text="@Loc["Edit"]" Title="@Loc["Edit"]" Disabled="@(!CanModifyLookup)" Click="@(() => OpenEditCategoryAsync(data))" />
                                <VppAdminLifecycleMenu Title="@Loc["MoreActions"]"
                                                       RestoreText="@Loc["Restore"]"
                                                       DeactivateText="@Loc["Deactivate"]"
                                                       HardDeleteText="@Loc["HardDelete"]"
                                                       IsDeleted="@data.IsDeleted"
                                                       CanToggle="@CanModifyLookup"
                                                       CanHardDelete="@(CanModifyLookup && data.IsDeleted)"
                                                       DeletedChanged="@((bool isDeleted) => ToggleCategoryDeleted(data, isDeleted))"
                                                       HardDeleteRequested="@(() => HardDeleteCategoryAsync(data))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            </ChildContent>
            </VppDataSurfaceFrame>
    </Primary>

    <Secondary>
        <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                                 Density="VppDataDensity.Compact"
                                 AriaLabel="@Loc["Value"]"
                                 TestId="lookup-values-data-surface"
                                 Class="vpp-admin-data-surface">
            <Header>
                <VppCollectionHeader Title="@Loc["Value"]"
                                     Summary="@Loc["RecordsCount", valueCount]"
                                     AddText="@Loc["AddLookupValue"]"
                                     CompactAddText="@Loc["Add"]"
                                     Disabled="@(selectedLookupCategory is null || !CanModifyLookup)"
                                     AddClicked="@OpenAddValueAsync" />
            </Header>
            <Toolbar>
                <VppDataToolbar AriaLabel="@Loc["Value"]" Class="vpp-admin-grid-toolbar">
                    <VppFilterSearch Value="@valueSearchText"
                                     Input="@OnValueSearchInputAsync"
                                     Placeholder="@Loc["LibrarySearchLookupValues"]"
                                     AriaLabel="@Loc["LibrarySearchLookupValues"]" />
                    <VppFilterSelect TValue="string"
                                     Value="@valueStatusFilter"
                                     Options="@ValueStatusOptions"
                                     ValueChanged="@OnValueStatusChangedAsync"
                                     Placeholder="@Loc["LibraryAllStatuses"]"
                                     AriaLabel="@Loc["LibraryAllStatuses"]" />
                    <VppClearFiltersButton Text="@Loc["ClearFilters"]"
                                           IsActive="@HasValueFilters"
                                           Clicked="@ClearValueFiltersAsync" />
                    <VppColumnPicker TItem="LookupValueResDTO" GridAccessor="@(() => valueGrid)" />
                </VppDataToolbar>
            </Toolbar>
            <ChildContent>
            <RadzenDataGrid @ref="valueGrid" TItem="LookupValueResDTO"
                            data-vpp-grid-region="true"
                            aria-label="@Loc["Value"]"
                            Data="@lookupValues"
                            Count="@valueCount"
                            LoadData="@LoadValues"
                            IsLoading="@isValueLoading"
                            AllowFiltering="false"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            AllowSorting="true"
                            AllowAlternatingRows="false"
                            AllowMultiColumnSorting="false"
                            ShowMultiColumnSortingIndex="false"
                            AllowPaging="true"
                            PagerAlwaysVisible="true"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.SplitList.DefaultPageSize"
                            PageSizeOptions="@VppPagingProfiles.SplitList.PageSizeOptions"
                            Density="Density.Compact"
                            EmptyText="@(selectedLookupCategory == null ? Loc["LookupSelectCategoryPrompt"].Value : Loc["LookupNoValues"].Value)"
                            RowRender="@OnValueRowRender"
                            GridLines="DataGridGridLines.Horizontal"
                            class="auto-fit-grid vpp-admin-grid vpp-class-detail-grid vpp-data-grid vpp-data-density-compact"
                            ColumnWidth="150px"
                            Style="--vpp-admin-grid-min-width: 760px; --vpp-admin-actions-width: 136px;">
                <Columns>
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                        <Template Context="data">
                            @(currentValueSkip + lookupValues.IndexOf(data) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="IsDeleted" Title="@Loc["Status"]" Width="90px" MinWidth="90px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                        <Template Context="data">
                            <VppStatusBadge Text="@(data.IsDeleted ? Loc["Inactive"] : Loc["Active"])" Tone="@VppStatusToneContract.Resolve(data.IsDeleted ? "Inactive" : "Active")" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Code" Title="@Loc["Code"]" Width="125px" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Value" Title="@Loc["Value"]" Width="170px" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Sort" Title="@Loc["SortOrder"]" Width="80px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Description" Title="@Loc["Description"]" Width="180px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="Id" Title="ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="LookupCategoryId" Title="Lookup category ID" Width="250px" CssClass="col-tight" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="CreatedByUserId" Title="Create User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="CreatedAtUtc" Title="Create Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="UpdatedByUserId" Title="Update User" Width="120px" TextAlign="TextAlign.Center" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Property="UpdatedAtUtc" Title="Update Date" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="LookupValueResDTO" Title="@Loc["Actions"]" Width="136px" MinWidth="136px" Filterable="false" Sortable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions" HeaderCssClass="rz-col-actions">
                        <Template Context="data">
                            <div class="vpp-admin-actions">
                                <VppAdminIconAction Icon="edit" Text="@Loc["Edit"]" Title="@Loc["Edit"]" Disabled="@(!CanModifyLookup)" Click="@(() => OpenEditValueAsync(data))" />
                                <VppAdminLifecycleMenu Title="@Loc["MoreActions"]"
                                                       RestoreText="@Loc["Restore"]"
                                                       DeactivateText="@Loc["Deactivate"]"
                                                       HardDeleteText="@Loc["HardDelete"]"
                                                       IsDeleted="@data.IsDeleted"
                                                       CanToggle="@CanModifyLookup"
                                                       CanHardDelete="@(CanModifyLookup && data.IsDeleted)"
                                                       DeletedChanged="@((bool isDeleted) => ToggleValueDeleted(data, isDeleted))"
                                                       HardDeleteRequested="@(() => HardDeleteValueAsync(data))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            </ChildContent>
            </VppDataSurfaceFrame>
    </Secondary>
</VppSplitEditorWorkspace>
