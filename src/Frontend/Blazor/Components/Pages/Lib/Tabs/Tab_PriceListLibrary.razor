@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<PriceListResDTO>

<VppCollectionWorkspace Class="vpp-admin-workspace vpp-price-list-workspace">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["PriceLists"]"
                         TestId="price-lists-data-surface"
                         Class="vpp-admin-data-surface">
        <Header>
            <VppCollectionHeader Title="@Loc["PriceLists"]"
                                 Summary="@Loc["RecordsCount", count]"
                                 AddText="@Loc["AddPriceList"]"
                                 CompactAddText="@Loc["Add"]"
                                 Disabled="@(!CanModify)"
                                 AddClicked="@AddAsync" />
        </Header>
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["PriceLists"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText"
                                 Input="@OnSearchInputAsync"
                                 Placeholder="@Loc["LibrarySearchPriceLists"]"
                                 AriaLabel="@Loc["LibrarySearchPriceLists"]" />
                <VppFilterSelect TValue="string"
                                 Value="@selectedStatus"
                                 Options="@PriceListStatusOptions"
                                 ValueChanged="@OnStatusChangedAsync"
                                 Placeholder="@Loc["LibraryAllStatuses"]"
                                 AriaLabel="@Loc["Status"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                <VppColumnPicker TItem="PriceListResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid"
                            data-vpp-grid-region="true"
                            aria-label="@Loc["PriceLists"]"
                            TItem="PriceListResDTO"
                            Data="@priceLists"
                            Count="@count"
                            LoadData="@LoadDataAsync"
                            LoadColumnFilterData="@LoadColumnFilterDataAsync"
                            IsLoading="@isLoading"
                            AllowAlternatingRows="false"
                            AllowSorting="true"
                            AllowMultiColumnSorting="false"
                            ShowMultiColumnSortingIndex="false"
                            AllowPaging="true"
                            PagerAlwaysVisible="true"
                            GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                            PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal"
                            EmptyText="@Loc["NoPriceListAvailable"]"
                            AllowFiltering="true"
                            FilterMode="FilterMode.CheckBoxList"
                            FilterPopupRenderMode="PopupRenderMode.OnDemand"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            RowRender="@OnRowRenderPriceList"
                            class="vpp-admin-grid vpp-admin-page-grid vpp-data-grid vpp-data-density-compact"
                            ColumnWidth="150px"
                            Style="--vpp-admin-grid-min-width: 1040px; --vpp-admin-isdeleted-width: 90px;">
                <Columns>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index"><Template Context="row">@(currentSkip + priceLists.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="PriceListName" Title="@Loc["PriceListName"]" Width="190px" MinWidth="180px"><Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.PriceListName ?? "–")</strong><small>@(row.PriceListCode ?? "–")</small></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="SupplierName" Title="@Loc["Supplier"]" Width="120px"><HeaderTemplate><span title="@Loc["Supplier"]">@Loc["SupplierCompact"]</span></HeaderTemplate></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="Version" Title="@Loc["Version"]" Width="82px" TextAlign="TextAlign.Center" Filterable="false"><HeaderTemplate><span title="@Loc["Version"]">@Loc["VersionCompact"]</span></HeaderTemplate></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="EffectiveFromUtc" Title="@Loc["EffectiveRange"]" Width="120px" TextAlign="TextAlign.Center" Filterable="false"><Template Context="row"><span>@FormatEffectiveRange(row)</span></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="Status" Title="@Loc["Status"]" Width="110px" TextAlign="TextAlign.Center" Filterable="false"><Template Context="row"><RadzenBadge Text="@GetStatusLabel(row.Status)" BadgeStyle="@GetStatusBadgeStyle(row.Status)" /></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="IsDefault" Title="@Loc["Default"]" Width="90px" TextAlign="TextAlign.Center" Filterable="false"><HeaderTemplate><span title="@Loc["Default"]">@Loc["DefaultCompact"]</span></HeaderTemplate><Template Context="row"><RadzenSwitch TValue="bool" Value="@row.IsDefault" Disabled="true" class="vpp-admin-switch-readonly" /></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="ItemCount" Title="@Loc["ItemCount"]" Width="90px" TextAlign="TextAlign.Center" Filterable="false"><HeaderTemplate><span title="@Loc["ItemCount"]">@Loc["ItemCountCompact"]</span></HeaderTemplate><Template Context="row">@row.ItemCount</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="PriceListCode" Title="@Loc["PriceListCode"]" Width="130px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" />
                    <RadzenDataGridColumn TItem="PriceListResDTO" Title="@Loc["Actions"]" Width="232px" MinWidth="232px" Sortable="false" Filterable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-xwide" HeaderCssClass="rz-col-actions rz-col-actions-xwide">
                        <Template Context="row"><div class="vpp-admin-actions"><RadzenButton Icon="payments" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" title="@Loc["EditPrice"]" Disabled="@(row.IsDeleted || !CanModify)" Click="@(() => OpenPricesAsync(row))" /><RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" title="@Loc["Edit"]" Disabled="@(row.IsDeleted || row.Status != "Draft" || !CanModify)" Click="@(() => EditAsync(row))" /><RadzenButton Icon="publish" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" title="Công bố" Disabled="@(row.IsDeleted || row.Status != "Draft" || !CanModify)" Click="@(() => PublishAsync(row))" /><RadzenButton Icon="timer_off" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" title="Đánh dấu hết hiệu lực" Disabled="@(row.IsDeleted || row.Status != "Published" || !CanModify)" Click="@(() => ExpireAsync(row))" /><RadzenButton Icon="star" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" title="@Loc["SetAsDefault"]" Disabled="@(row.IsDefault || row.IsDeleted || !CanModify)" Click="@(() => SetDefaultAsync(row))" /><RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" title="@Loc["Clone"]" Disabled="@(!CanModify)" Click="@(() => CloneAsync(row))" /><RadzenButton Icon="@(row.IsDeleted ? "restore_from_trash" : "delete")" Size="ButtonSize.Small" ButtonStyle="@(row.IsDeleted ? ButtonStyle.Light : ButtonStyle.Danger)" title="@(row.IsDeleted ? Loc["Restore"] : Loc["Deactivate"])" Disabled="@(row.Status == "Published" || !CanModify)" Click="@(() => SetDeletedAsync(row, !row.IsDeleted))" /></div></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
