@using gtas_vpp_shared.DTOs.Res.Library
@using gtas_vpp_fe.Components.Pages.Lib


<VppListDetailWorkspace Ratio="VppListDetailRatio.WideList"
                        Class="vpp-admin-workspace vpp-price-list-workspace vpp-atlas-admin-workspace"
                        ListClass="vpp-atlas-admin-collection"
                        DetailClass="vpp-atlas-admin-inspector">
<List>
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["PriceLists"]"
                         TestId="price-lists-data-surface"
                         Class="vpp-admin-data-surface">
    <Toolbar>
    <VppDataToolbar AriaLabel="@Loc["PriceLists"]" Class="vpp-admin-toolbar">
        <div class="vpp-library-actions">
            <RadzenButton Icon="add"
                          Text="@Loc["AddPriceList"]"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary"
                          class="vpp-library-primary-action"
                          Click="@AddAsync" />
            <RadzenButton Icon="refresh"
                          Text="@Loc["Reload"]"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Light"
                          class="vpp-library-refresh-action"
                          Title="@Loc["Reload"]"
                          aria-label="@Loc["Reload"]"
                          Click="@LoadAsync" />
            <RadzenDropDown TValue="string"
                            Data="@PriceListStatusOptions"
                            TextProperty="Label"
                            ValueProperty="Value"
                            Value="@selectedStatus"
                            Change="@OnStatusChangedAsync"
                            aria-label="@Loc["Status"]"
                            Style="width: 170px" />
        </div>
        <VppColumnPicker TItem="PriceListResDTO" GridAccessor="@(() => grid)" />
    </VppDataToolbar>
    </Toolbar>
    <ChildContent>
    <RadzenDataGrid @ref="grid"
                    data-vpp-grid-region="true"
                    aria-label="@Loc["PriceLists"]"
                    TItem="PriceListResDTO"
                    Data="@priceLists"
                    Count="@count"
                    LoadData="@LoadDataAsync"
                    LoadColumnFilterData="@LoadColumnFilterDataAsync"
                    IsLoading="@isLoading"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="20"
                    PageSizeOptions="@(new int[] { 20, 50, 100 })"
                    Density="Density.Compact"
                    GridLines="DataGridGridLines.Horizontal"
                    EmptyText="@Loc["NoPriceListAvailable"]"
                    AllowFiltering="true"
                    FilterMode="FilterMode.CheckBoxList"
                    FilterPopupRenderMode="PopupRenderMode.OnDemand"
                    LogicalFilterOperator="LogicalFilterOperator.And"
                    AllowColumnResize="true"
                    AllowColumnPicking="false"
                    AllowPickAllColumns="true"
                    ColumnsPickerAllowFiltering="true"
                    RowRender="@OnRowRenderPriceList"
                    @bind-Value="selectedPriceLists"
                    SelectionMode="DataGridSelectionMode.Single"
                    RowSelect="OnPriceListSelected"
                    class="@($"vpp-admin-grid vpp-admin-page-grid vpp-data-grid vpp-data-density-compact {(count <= 20 ? "vpp-admin-grid-single-page" : string.Empty)}")"
                    ColumnWidth="150px"
                    Style="--vpp-admin-grid-min-width: 1160px;">
        <Columns>
            <RadzenDataGridColumn TItem="PriceListResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index">
                <Template Context="row">
                    @(currentSkip + priceLists.IndexOf(row) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="IsDeleted" Title="Vô hiệu hóa" Width="90px" MinWidth="90px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" CssClass="rz-col-isdeleted" HeaderCssClass="rz-col-isdeleted">
                <Template Context="row">
                    <div class="vpp-admin-is-deleted-cell">
                        <RadzenSwitch TValue="bool"
                                      Value="@row.IsDeleted"
                                      Disabled="@(row.Status == "Published")"
                                      Change="@(async (bool value) => await SetDeletedAsync(row, value))"
                                      class="isDeleteSwitch vpp-admin-switch-compact" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="PriceListCode" Title="@Loc["PriceListCode"]" Width="130px" />
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="PriceListName" Title="@Loc["PriceListName"]" Width="190px" />
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="SupplierName" Title="Nhà cung cấp" Width="170px" />
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="Version" Title="Phiên bản" Width="92px" TextAlign="TextAlign.Center" />
            @* Khoảng hiệu lực được gộp trong một cột để giữ bảng dễ quét. *@
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="EffectiveFromUtc" Title="@Loc["EffectiveRange"]" Width="150px" TextAlign="TextAlign.Center" Filterable="false">
                <Template Context="row">
                    <span>@FormatEffectiveRange(row)</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="Status" Title="@Loc["Status"]" Width="115px" TextAlign="TextAlign.Center" Filterable="false">
                <Template Context="row">
                    <RadzenBadge Text="@GetStatusLabel(row.Status)" BadgeStyle="@GetStatusBadgeStyle(row.Status)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="IsDefault" Title="Mặc định" Width="104px" TextAlign="TextAlign.Center">
                <Template Context="row">
                    <RadzenSwitch TValue="bool" Value="@row.IsDefault" Disabled="true" class="vpp-admin-switch-readonly" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="ItemCount" Title="Số mặt hàng" Width="104px" TextAlign="TextAlign.Center">
                <Template Context="row">
                    <RadzenButton Text="@row.ItemCount.ToString()"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(() => OpenPricesAsync(row))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PriceListResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" />
            <RadzenDataGridColumn TItem="PriceListResDTO" Title="@Loc["Actions"]" Width="190px" MinWidth="190px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-wide" HeaderCssClass="rz-col-actions rz-col-actions-wide">
                <Template Context="row">
                    <div class="vpp-admin-actions">
                        <RadzenButton Icon="payments" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" title="@Loc["EditPrice"]" Disabled="@row.IsDeleted" Click="@(() => OpenPricesAsync(row))" />
                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" title="@Loc["Edit"]" Disabled="@(row.IsDeleted || row.Status != "Draft")" Click="@(() => EditAsync(row))" />
                        <RadzenButton Icon="publish" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" title="Công bố" Disabled="@(row.IsDeleted || row.Status != "Draft")" Click="@(() => PublishAsync(row))" />
                        <RadzenButton Icon="timer_off" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning" title="Đánh dấu hết hiệu lực" Disabled="@(row.IsDeleted || row.Status != "Published")" Click="@(() => ExpireAsync(row))" />
                        <RadzenButton Icon="star" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" title="@Loc["SetAsDefault"]" Disabled="@(row.IsDefault || row.IsDeleted)" Click="@(() => SetDefaultAsync(row))" />
                        <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" title="@Loc["Clone"]" Click="@(() => CloneAsync(row))" />
                    </div>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </ChildContent>
    </VppDataSurfaceFrame>
</List>
<Detail>
        @if (SelectedPriceList is not null)
        {
            <Component_RecordInspector TItem="PriceListResDTO"
                                       Record="SelectedPriceList"
                                       CanEdit="@(SelectedPriceList.Status == "Draft" && !SelectedPriceList.IsDeleted)"
                                       CanToggleStatus="@(SelectedPriceList.Status != "Published")"
                                       IsInactive="@SelectedPriceList.IsDeleted"
                                       EditRequested="@EditAsync"
                                       ToggleStatusRequested="@ToggleSelectedPriceListStatusAsync" />
        }
        else
        {
            <div class="vpp-atlas-admin-inspector-empty">
                <VppIcon Name="@VppIcons.PriceList" />
                <strong>Chọn bảng giá để xem vòng đời</strong>
                <span>Chỉ bản nháp được chỉnh sửa; bản đã công bố được bảo toàn theo nghiệp vụ hiện hành.</span>
            </div>
        }
</Detail>
</VppListDetailWorkspace>
