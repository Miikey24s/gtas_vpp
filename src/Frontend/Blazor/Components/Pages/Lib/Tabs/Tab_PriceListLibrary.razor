@* PAGE: Lib/Tabs/Tab_PriceListLibrary.razor *@
@using gtas_vpp_shared.DTOs.Res.Library
@inherits VppServerGridComponentBase<PriceListResDTO>

<VppCollectionWorkspace FillAvailableSpace="true" IsBusy="@isLoading" Class="vpp-admin-workspace vpp-price-list-workspace">
    <VppDataSurfaceFrame DataSourceMode="VppDataSourceMode.ServerPaging"
                         Density="VppDataDensity.Compact"
                         AriaLabel="@Loc["PriceLists"]"
                         TestId="price-lists-data-surface"
                         Class="vpp-admin-data-surface">
        <Header>
            <VppCollectionHeader Title="@Loc["PriceLists"]"
                                 Summary="@Loc["RecordsCount", count]"
                                 AddText="@Loc["AddPriceList"]"
                                 CompactAddText="@Loc["Add"]"
                                 Disabled="@(!CanModify)"
                                 AddClicked="@AddAsync" />
        </Header>
        <Toolbar>
            <VppDataToolbar AriaLabel="@Loc["PriceLists"]" Class="vpp-admin-grid-toolbar">
                <VppFilterSearch Value="@searchText"
                                 Input="@OnSearchInputAsync"
                                 Placeholder="@Loc["LibrarySearchPriceLists"]"
                                 AriaLabel="@Loc["LibrarySearchPriceLists"]" />
                <VppFilterSelect TValue="string"
                                 Value="@selectedActivity"
                                 Options="@PriceListStatusOptions"
                                 ValueChanged="@OnStatusChangedAsync"
                                 Placeholder="@Loc["LibraryAllStatuses"]"
                                 AriaLabel="@Loc["Status"]" />
                <VppClearFiltersButton Text="@Loc["ClearFilters"]" IsActive="@HasFilters" Clicked="@ClearFiltersAsync" />
                <VppColumnPicker TItem="PriceListResDTO" GridAccessor="@(() => grid)" />
            </VppDataToolbar>
        </Toolbar>
        <ChildContent>
            <RadzenDataGrid @ref="grid"
                            data-vpp-grid-region="true"
                            aria-label="@Loc["PriceLists"]"
                            TItem="PriceListResDTO"
                            Data="@priceLists"
                            Count="@count"
                            LoadData="@LoadDataAsync"
                            IsLoading="@isLoading"
                            AllowAlternatingRows="false"
                            AllowSorting="true"
                            AllowMultiColumnSorting="false"
                            ShowMultiColumnSortingIndex="false"
                            AllowPaging="true"
                            PagerAlwaysVisible="true"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            GotoFirstPageOnSort="true"
                            PageSize="@VppPagingProfiles.Collection.DefaultPageSize"
                            PageSizeOptions="@VppPagingProfiles.Collection.PageSizeOptions"
                            Density="Density.Compact"
                            GridLines="DataGridGridLines.Horizontal"
                            EmptyText="@Loc["NoPriceListAvailable"]"
                            AllowFiltering="false"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            AllowColumnResize="true"
                            AllowColumnPicking="false"
                            AllowPickAllColumns="true"
                            ColumnsPickerAllowFiltering="true"
                            RowRender="@OnRowRenderPriceList"
                            class="vpp-admin-grid vpp-admin-page-grid vpp-data-grid vpp-data-density-compact vpp-price-list-grid"
                            ColumnWidth="150px">
                <Columns>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Title="#" Width="52px" MinWidth="52px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" CssClass="rz-col-index" HeaderCssClass="rz-col-index"><Template Context="row">@(currentSkip + priceLists.IndexOf(row) + 1)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="PriceListName" Title="@Loc["PriceListName"]" Width="190px" MinWidth="180px"><Template Context="row"><div class="vpp-admin-two-line-cell"><strong>@(row.PriceListName ?? "–")</strong><small>@(row.PriceListCode ?? "–")</small></div></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="SupplierName" Title="@Loc["Supplier"]" Width="150px" MinWidth="140px" />
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="Version" Title="@Loc["Version"]" Width="110px" MinWidth="100px" TextAlign="TextAlign.Center" Filterable="false" />
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="Status" Title="@Loc["Status"]" Width="110px" TextAlign="TextAlign.Center" Filterable="false"><Template Context="row"><VppStatusBadge Text="@GetStatusLabel(row)" Tone="@GetStatusTone(row)" /></Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="IsDefault" Title="@Loc["Default"]" Width="110px" TextAlign="TextAlign.Center" Filterable="false">
                        <Template Context="row">
                            @if (row.IsDefault)
                            {
                                <VppStatusBadge Text="@Loc["Default"]" Tone="VppStatusTone.Neutral" />
                            }
                            else
                            {
                                <span aria-label="@Loc["No"]">–</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="ItemCount" Title="@Loc["ItemCount"]" Width="130px" MinWidth="120px" TextAlign="TextAlign.Center" Filterable="false"><Template Context="row">@row.ItemCount</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="PriceListCode" Title="@Loc["PriceListCode"]" Width="130px" Visible="false" Pickable="true" />
                    <RadzenDataGridColumn TItem="PriceListResDTO" Property="Description" Title="@Loc["Description"]" Width="210px" Visible="false" />
                    <RadzenDataGridColumn TItem="PriceListResDTO" Title="@Loc["Actions"]" Width="128px" MinWidth="128px" Sortable="false" Filterable="false" Reorderable="false" Resizable="false" Pickable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" CssClass="rz-col-actions rz-col-actions-medium" HeaderCssClass="rz-col-actions rz-col-actions-medium">
                        <Template Context="row">
                            <div class="vpp-admin-actions">
                                <VppAdminIconAction Icon="payments"
                                                    Text="@PriceListPrimaryActionText(row)"
                                                    Title="@PriceListPrimaryActionText(row)"
                                                    ButtonStyle="ButtonStyle.Warning"
                                                    Disabled="@(row.IsDeleted || !CanModify)"
                                                    Click="@(() => OpenPricesAsync(row))" />
                                <VppAdminActionMenu Title="@Loc["MoreActions"]"
                                                    Items="@PriceListSecondaryActions(row)"
                                                    Disabled="@(!CanModify)"
                                                    TestId="price-list-lifecycle-menu" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </ChildContent>
    </VppDataSurfaceFrame>
</VppCollectionWorkspace>
