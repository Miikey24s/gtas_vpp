@* PAGE: Authen/Logout.razor *@
@page "/logoutprocess"
@attribute [AllowAnonymous]
@using gtas_vpp_fe.Components.Layout
@using gtas_vpp_fe.Platform.Auth
@layout LoginLayout
@inject NavigationManager UriHelper
@inject IJSRuntime JS
@inject ILogger<Logout> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>GTAS VPP - @Loc["Logout"]</PageTitle>

<VppAccountWorkspace Title="@Loc["SigningOut"]"
                 TitleId="logout-title"
                 Compact="true">
    <div class="vpp-account-progress" role="status" aria-live="polite" aria-busy="true">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>@Loc["LogoutRedirectMessage"]</span>
    </div>
</VppAccountWorkspace>

@code {
    [SupplyParameterFromQuery(Name = "expectedSession")]
    public string? ExpectedSessionFingerprint { get; set; }

    private bool _logoutStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _logoutStarted)
        {
            return;
        }

        _logoutStarted = true;
        if (!string.IsNullOrWhiteSpace(ExpectedSessionFingerprint))
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentAccessToken = authenticationState.User.Claims.Get(ClaimKeys.AccessToken);
            if (!AuthSessionFingerprint.MatchesOrIsUnspecified(
                    ExpectedSessionFingerprint,
                    currentAccessToken))
            {
                Logger.LogInformation(
                    "Ignored a stale logout page because the browser already owns a newer login session.");
                UriHelper.NavigateTo("/", true);
                return;
            }
        }

        try
        {
            using var cleanupTimeout = new CancellationTokenSource(TimeSpan.FromSeconds(2));
            await JS.InvokeVoidAsync("vppDrafts.clearAll", cleanupTimeout.Token);
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Browser draft cleanup failed during logout; session revocation will continue.");
        }
        finally
        {
            var logoutPath = Config.PerformLogoutPath;
            if (!string.IsNullOrWhiteSpace(ExpectedSessionFingerprint))
            {
                logoutPath += $"?expectedSession={Uri.EscapeDataString(ExpectedSessionFingerprint)}";
            }

            UriHelper.NavigateTo(logoutPath, true);
        }
    }
}
