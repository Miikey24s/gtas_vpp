@* PAGE: Authen/ChangePassword.razor *@
@page "/Account/ChangePassword"
@attribute [Authorize]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["ChangePasswordTitle"]</PageTitle>

<VppAccountWorkspace Title="@Loc["ChangePasswordTitle"]"
                 TitleId="change-password-title"
                 Description="@Loc["ChangePasswordDescription"]"
                 Compact="true">
    @if (Required)
    {
        <VppInlineAlert Message="@Loc["ChangePasswordRequired"]" Tone="VppAlertTone.Warning" />
    }
    <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />

    <RadzenTemplateForm TItem="PasswordChangeReqDTO" Data="@Model" Submit="@SubmitAsync" class="vpp-login-form">
        <VppPasswordField Name="CurrentPassword"
                          Label="@Loc["CurrentPassword"]"
                          @bind-Value="Model.CurrentPassword"
                          Disabled="@IsLoading"
                          AutoComplete="current-password">
            <ValidationContent>
                <RadzenRequiredValidator Component="CurrentPassword" Text="@Loc["CurrentPasswordRequired"]" class="vpp-field-validator" />
            </ValidationContent>
        </VppPasswordField>
        <VppPasswordField Name="NewPassword"
                          Label="@Loc["NewPassword"]"
                          @bind-Value="Model.NewPassword"
                          Disabled="@IsLoading"
                          Hint="@Loc["PasswordRequirementHint"]">
            <ValidationContent>
                <RadzenRequiredValidator Component="NewPassword" Text="@Loc["NewPasswordRequired"]" class="vpp-field-validator" />
                <RadzenCustomValidator Component="NewPassword" Visible="@(!string.IsNullOrWhiteSpace(Model.NewPassword))" Validator="@(() => AccountPasswordPolicy.IsValid(Model.NewPassword))" Text="@Loc["PasswordRequirementHint"]" class="vpp-field-validator" />
            </ValidationContent>
        </VppPasswordField>
        <VppPasswordField Name="ConfirmPassword"
                          Label="@Loc["ConfirmNewPassword"]"
                          @bind-Value="Model.ConfirmPassword"
                          Disabled="@IsLoading">
            <ValidationContent>
                <RadzenRequiredValidator Component="ConfirmPassword" Text="@Loc["ConfirmPasswordRequired"]" class="vpp-field-validator" />
                <RadzenCompareValidator Component="ConfirmPassword" Value="@Model.NewPassword" Visible="@(!string.IsNullOrWhiteSpace(Model.ConfirmPassword))" Text="@Loc["PasswordConfirmationMismatch"]" class="vpp-field-validator" />
            </ValidationContent>
        </VppPasswordField>
        <RadzenButton Text="@Loc["SaveNewPassword"]"
                      ButtonType="ButtonType.Submit"
                      IsBusy="@IsLoading"
                      class="vpp-login-btn" />
    </RadzenTemplateForm>

    <div class="vpp-login-links vpp-login-links-single">
        <a class="vpp-account-back-link" href="@(Required ? "/logoutprocess" : "/dashboard")">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@(Required ? Loc["Logout"] : Loc["BackToApplication"])</span>
        </a>
    </div>
</VppAccountWorkspace>
