@* PAGE: Authen/ConfirmEmail.razor *@
@page "/Account/ConfirmEmail"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["ConfirmEmailTitle"] @Loc["ConfirmEmailAccent"]</PageTitle>

<VppAccountWorkspace Title="@Loc["ConfirmEmailTitle"]"
                 Accent="@Loc["ConfirmEmailAccent"]"
                 TitleId="confirm-email-title"
                 Compact="true">
    @if (IsLoading)
    {
        <VppInlineAlert Message="@Loc["CheckingConfirmationLink"]" Tone="VppAlertTone.Info" />
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    }
    else
    {
        <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />
    }

    <div class="vpp-login-links @(!string.IsNullOrWhiteSpace(ErrorMessage) ? string.Empty : "vpp-login-links-single")">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <a href="/Account/ResendConfirmation">@Loc["ResendConfirmationLink"]</a>
        }
        <a class="vpp-account-back-link" href="/Account/Login">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@Loc["GoToLogin"]</span>
        </a>
    </div>
</VppAccountWorkspace>
