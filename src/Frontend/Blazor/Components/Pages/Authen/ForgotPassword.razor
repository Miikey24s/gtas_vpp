@* PAGE: Authen/ForgotPassword.razor *@
@page "/Account/ForgotPassword"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["ForgotPasswordTitle"]</PageTitle>

<VppAccountWorkspace Title="@Loc["ForgotPasswordTitle"]"
                 TitleId="forgot-password-title"
                 Description="@Loc["ForgotPasswordDescription"]"
                 Compact="true">
    <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />
    @* Atlas account-forgot: báo trước hành vi chống dò tài khoản, hiển thị tĩnh trước khi submit. *@
    <VppInlineAlert Message="@Loc["ForgotPasswordSafetyNote"]" />

    <RadzenTemplateForm TItem="PasswordRecoveryReqDTO" Data="@Model" Submit="@SubmitAsync" class="vpp-login-form">
        <VppAccountTextField Name="Email"
                             Label="@Loc["CompanyEmail"]"
                             @bind-Value="Model.Email"
                             Disabled="@IsLoading"
                             AutoComplete="email">
            <ValidationContent>
                <RadzenRequiredValidator Component="Email" Text="@Loc["CompanyEmailRequired"]" class="vpp-field-validator" />
                <RadzenEmailValidator Component="Email" Visible="@(!string.IsNullOrWhiteSpace(Model.Email))" Text="@Loc["CompanyEmailInvalid"]" class="vpp-field-validator" />
            </ValidationContent>
        </VppAccountTextField>

        <RadzenButton Text="@Loc["SendRecoveryInstructions"]"
                      ButtonType="ButtonType.Submit"
                      IsBusy="@IsLoading"
                      class="vpp-login-btn" />
    </RadzenTemplateForm>

    <div class="vpp-login-links vpp-login-links-single">
        <a class="vpp-account-back-link" href="/Account/Login">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@Loc["BackToLogin"]</span>
        </a>
    </div>
</VppAccountWorkspace>
