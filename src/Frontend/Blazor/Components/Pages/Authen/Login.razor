@* PAGE: Authen/Login.razor *@
@page "/loginprocess"
@attribute [AllowAnonymous]
@layout LoginLayout

@inject NavigationManager UriHelper

<PageTitle>GTAS VPP - @Loc["Login"]</PageTitle>

<VppAccountWorkspace Title="@Loc["Login"]"
                 TitleId="login-process-title"
                 Compact="true">
    <div class="vpp-account-progress" role="status" aria-live="polite" aria-busy="true">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>@Loc["LoginRedirectMessage"]</span>
    </div>
    <a class="vpp-account-back-link" href="@Config.LoginPagePath" data-enhance-nav="false">
        <VppIcon Name="@VppIcons.ArrowBack" />
        <span>@Loc["BackToLogin"]</span>
    </a>
</VppAccountWorkspace>
