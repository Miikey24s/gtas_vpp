@* PAGE: Authen/ResetPassword.razor *@
@page "/Account/ResetPassword"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["ResetPasswordTitle"] @Loc["ResetPasswordAccent"]</PageTitle>

<VppAccountWorkspace Title="@Loc["ResetPasswordTitle"]"
                 Accent="@Loc["ResetPasswordAccent"]"
                 TitleId="reset-password-title"
                 Description="@Loc["ResetPasswordDescription"]"
                 Compact="true">
    <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />

    @if (HasValidResetLink)
    {
        <RadzenTemplateForm TItem="PasswordResetReqDTO" Data="@Model" Submit="@SubmitAsync" class="vpp-login-form">
            <VppPasswordField Name="NewPassword"
                              Label="@Loc["NewPassword"]"
                              @bind-Value="Model.NewPassword"
                              Disabled="@IsLoading"
                              Hint="@Loc["PasswordRequirementHint"]">
                <ValidationContent>
                    <RadzenRequiredValidator Component="NewPassword" Text="@Loc["NewPasswordRequired"]" class="vpp-field-validator" Style="position: absolute" />
                    <RadzenCustomValidator Component="NewPassword" Visible="@(!string.IsNullOrWhiteSpace(Model.NewPassword))" Validator="@(() => AccountPasswordPolicy.IsValid(Model.NewPassword))" Text="@Loc["PasswordRequirementHint"]" class="vpp-field-validator" Style="position: absolute" />
                </ValidationContent>
            </VppPasswordField>
            <VppPasswordField Name="ConfirmPassword"
                              Label="@Loc["ConfirmNewPassword"]"
                              @bind-Value="Model.ConfirmPassword"
                              Disabled="@IsLoading">
                <ValidationContent>
                    <RadzenRequiredValidator Component="ConfirmPassword" Text="@Loc["ConfirmPasswordRequired"]" class="vpp-field-validator" Style="position: absolute" />
                    <RadzenCompareValidator Component="ConfirmPassword" Value="@Model.NewPassword" Visible="@(!string.IsNullOrWhiteSpace(Model.ConfirmPassword))" Text="@Loc["PasswordConfirmationMismatch"]" class="vpp-field-validator" Style="position: absolute" />
                </ValidationContent>
            </VppPasswordField>
            <RadzenButton Text="@Loc["ResetPasswordAction"]"
                          ButtonType="ButtonType.Submit"
                          IsBusy="@IsLoading"
                          class="vpp-login-btn" />
        </RadzenTemplateForm>
    }

    <div class="vpp-login-links vpp-login-links-single">
        <a class="vpp-account-back-link" href="/Account/Login">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@Loc["BackToLogin"]</span>
        </a>
    </div>
</VppAccountWorkspace>
