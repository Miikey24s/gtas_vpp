@* PAGE: Authen/ResendConfirmation.razor *@
@page "/Account/ResendConfirmation"
@attribute [AllowAnonymous]
@layout LoginLayout

<PageTitle>GTAS VPP - @Loc["ResendConfirmationTitle"]</PageTitle>

<VppAccountWorkspace Title="@Loc["ResendConfirmationTitle"]"
                     TitleId="resend-confirmation-title"
                     Description="@Loc["ResendConfirmationDescription"]"
                     Compact="true">
    <VppInlineAlert Message="@ErrorMessage" Tone="VppAlertTone.Error" />
    <VppInlineAlert Message="@SuccessMessage" Tone="VppAlertTone.Success" />
    <VppInlineAlert Message="@Loc["ResendConfirmationSafetyNote"]" />

    <RadzenTemplateForm TItem="EmailConfirmationResendReqDTO" Data="@Model" Submit="@SubmitAsync" class="vpp-login-form">
        <VppAccountTextField Name="Email"
                             Label="@Loc["CompanyEmail"]"
                             @bind-Value="Model.Email"
                             Disabled="@IsLoading"
                             AutoComplete="email">
            <ValidationContent>
                <RadzenRequiredValidator Component="Email" Text="@Loc["CompanyEmailRequired"]" class="vpp-field-validator" />
                <RadzenEmailValidator Component="Email" Visible="@(!string.IsNullOrWhiteSpace(Model.Email))" Text="@Loc["CompanyEmailInvalid"]" class="vpp-field-validator" />
            </ValidationContent>
        </VppAccountTextField>

        <RadzenButton Text="@Loc["ResendConfirmationAction"]"
                      ButtonType="ButtonType.Submit"
                      IsBusy="@IsLoading"
                      class="vpp-login-btn" />
    </RadzenTemplateForm>

    <div class="vpp-login-links vpp-login-links-single">
        <a class="vpp-account-back-link" href="/Account/Login">
            <VppIcon Name="@VppIcons.ArrowBack" />
            <span>@Loc["BackToLogin"]</span>
        </a>
    </div>
</VppAccountWorkspace>
