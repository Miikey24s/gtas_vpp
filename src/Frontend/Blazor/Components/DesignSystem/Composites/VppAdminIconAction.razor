<RadzenButton Icon="@Icon"
              Size="ButtonSize.Small"
              ButtonStyle="@ButtonStyle"
              Variant="@Variant"
              Disabled="@Disabled"
              IsBusy="@IsBusy"
              Click="@Click"
              class="@CssClass"
              title="@Title"
              aria-label="@Title"
              data-testid="@TestId"
              @onclick:stopPropagation="true" />

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Light;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TestId { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "vpp-admin-icon-action"
        : $"vpp-admin-icon-action {Class}";
}
