<RadzenButton Icon="@Icon"
              Text="@Text"
              Size="ButtonSize.Small"
              ButtonStyle="@ButtonStyle"
              Variant="@Variant"
              Disabled="@Disabled"
              IsBusy="@IsBusy"
              Click="@Click"
              class="@CssClass"
              title="@EffectiveTitle"
              aria-label="@Title"
              aria-description="@EffectiveDescription"
              data-testid="@TestId"
              @onclick:stopPropagation="true" />

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Text { get; set; }
    [Parameter] public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Light;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TestId { get; set; }

    private string EffectiveTitle => Disabled && !string.IsNullOrWhiteSpace(DisabledReason)
        ? DisabledReason
        : Title;

    private string? EffectiveDescription => Disabled && !string.IsNullOrWhiteSpace(DisabledReason)
        ? DisabledReason
        : null;

    private string CssClass
    {
        get
        {
            var classes = new List<string> { "vpp-admin-icon-action" };
            if (!string.IsNullOrWhiteSpace(Text))
            {
                classes.Add("vpp-admin-action-label");
            }

            if (!string.IsNullOrWhiteSpace(Class))
            {
                classes.Add(Class);
            }

            return string.Join(' ', classes);
        }
    }
}
