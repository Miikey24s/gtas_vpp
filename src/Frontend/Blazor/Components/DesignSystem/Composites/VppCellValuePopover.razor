@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<span class="vpp-cell-value-popover vpp-cell-value-popover-@KindValue @Class" @ref="_root">
    <button type="button"
            class="vpp-cell-value-popover-trigger @TriggerClass"
            aria-haspopup="dialog"
            aria-expanded="@IsOpen"
            aria-label="@EffectiveTriggerLabel"
            title="@Value"
            @onclick="@(_ => Toggled.InvokeAsync())"
            @onclick:stopPropagation>
        @EffectiveDisplayText
    </button>

    @if (IsOpen)
    {
        <span class="vpp-cell-value-popover-panel vpp-transient-surface @PanelClass"
              role="dialog"
              aria-label="@Label"
              @onclick:stopPropagation>
            <span class="vpp-cell-value-popover-value">@Value</span>
            @if (AllowCopy && CopyRequested.HasDelegate)
            {
                <button type="button"
                        class="vpp-cell-value-popover-copy"
                        title="@CopyLabel"
                        aria-label="@CopyLabel"
                        @onclick="CopyAsync"
                        @onclick:stopPropagation>
                    <VppIcon Name="@VppIcons.Copy" />
                </button>
            }
        </span>
    }
</span>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? DisplayText { get; set; }
    [Parameter] public string EmptyText { get; set; } = "–";
    [Parameter] public string CopyLabel { get; set; } = string.Empty;
    [Parameter] public VppCellValueKind Kind { get; set; } = VppCellValueKind.Text;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool AllowCopy { get; set; } = true;
    [Parameter] public EventCallback Toggled { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public string? PanelClass { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && _module is null)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/DesignSystem/Composites/VppCellValuePopover.razor.js");
            await _module.InvokeVoidAsync("observeCellValuePopover", _root);
        }

        if (IsOpen && _module is not null)
        {
            await _module.InvokeVoidAsync("refreshCellValuePopover", _root);
        }
        else if (!IsOpen && _module is not null)
        {
            await DisposeModuleAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await DisposeModuleAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async ValueTask DisposeModuleAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("disposeCellValuePopover", _root);
        await _module.DisposeAsync();
        _module = null;
    }

    private string EffectiveDisplayText => string.IsNullOrWhiteSpace(DisplayText)
        ? (string.IsNullOrWhiteSpace(Value) ? EmptyText : Value)
        : DisplayText;

    private string EffectiveTriggerLabel => string.IsNullOrWhiteSpace(Value)
        ? Label
        : $"{Label}: {Value}";

    private string KindValue => Kind switch
    {
        VppCellValueKind.Code => "code",
        VppCellValueKind.Note => "note",
        _ => "text"
    };

    private Task CopyAsync() => CopyRequested.InvokeAsync(Value);
}
