<span class="vpp-cell-value-popover vpp-cell-value-popover-@KindValue @Class">
    <button type="button"
            class="vpp-cell-value-popover-trigger @TriggerClass"
            aria-haspopup="dialog"
            aria-expanded="@IsOpen"
            aria-label="@EffectiveTriggerLabel"
            title="@Value"
            @onclick="@(_ => Toggled.InvokeAsync())"
            @onclick:stopPropagation>
        @EffectiveDisplayText
    </button>

    @if (IsOpen)
    {
        <span class="vpp-cell-value-popover-panel vpp-transient-surface @PanelClass"
              role="dialog"
              aria-label="@Label"
              @onclick:stopPropagation>
            @* Alias history được giữ trong DS1 để JS/test/CSS consumer cũ tiếp tục hoạt động;
               DS2 chỉ xóa sau khi consumer ledger về 0. *@
            <span class="vpp-cell-value-popover-value vpp-history-popover-value">@Value</span>
            @if (AllowCopy && CopyRequested.HasDelegate)
            {
                <button type="button"
                        class="vpp-cell-value-popover-copy vpp-history-popover-copy"
                        title="@CopyLabel"
                        aria-label="@CopyLabel"
                        @onclick="CopyAsync"
                        @onclick:stopPropagation>
                    <VppIcon Name="@VppIcons.Copy" />
                </button>
            }
        </span>
    }
</span>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? DisplayText { get; set; }
    [Parameter] public string EmptyText { get; set; } = "–";
    [Parameter] public string CopyLabel { get; set; } = string.Empty;
    [Parameter] public VppCellValueKind Kind { get; set; } = VppCellValueKind.Text;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool AllowCopy { get; set; } = true;
    [Parameter] public EventCallback Toggled { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public string? PanelClass { get; set; }

    private string EffectiveDisplayText => string.IsNullOrWhiteSpace(DisplayText)
        ? (string.IsNullOrWhiteSpace(Value) ? EmptyText : Value)
        : DisplayText;

    private string EffectiveTriggerLabel => string.IsNullOrWhiteSpace(Value)
        ? Label
        : $"{Label}: {Value}";

    private string KindValue => Kind switch
    {
        VppCellValueKind.Code => "code",
        VppCellValueKind.Note => "note",
        _ => "text"
    };

    private Task CopyAsync() => CopyRequested.InvokeAsync(Value);
}
