<span class="vpp-admin-active-switch @Class"
      title="@Title"
      @onclick:stopPropagation="true">
    <RadzenSwitch TValue="bool"
                  Value="@IsActive"
                  Change="@Changed"
                  Disabled="@Disabled"
                  InputAttributes="@SwitchInputAttributes" />
</span>

@code {
    [Parameter] public bool IsActive { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<bool> Changed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    private IReadOnlyDictionary<string, object> SwitchInputAttributes =>
        new Dictionary<string, object> { ["aria-label"] = Title };
}
