<div class="vpp-action-column-header">
    <span>@Text</span>
    @if (AddClicked.HasDelegate)
    {
        <RadzenButton Icon="add"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Small"
                      Disabled="@Disabled"
                      Click="@OnAddAsync"
                      class="vpp-library-primary-action vpp-action-column-add"
                      title="@AddText"
                      aria-label="@AddText" />
    }
</div>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string AddText { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback AddClicked { get; set; }

    private Task OnAddAsync(MouseEventArgs _) => AddClicked.InvokeAsync();
}
