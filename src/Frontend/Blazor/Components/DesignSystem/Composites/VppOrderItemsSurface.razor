@using System.Globalization

<section class="vpp-order-items-surface @VariantClass" data-testid="@($"{TestId}-items")">
    @if (ShowFilters && TotalItemCount > 0)
    {
        <div class="vpp-order-items-toolbar vpp-history-detail-toolbar" aria-label="@FiltersAriaLabel">
            <label class="vpp-history-search vpp-history-detail-search @(!string.IsNullOrWhiteSpace(SearchText) ? "is-active" : string.Empty)">
                <VppIcon Name="search" />
                <input value="@SearchText"
                       @oninput="SearchChanged"
                       placeholder="@SearchPlaceholder"
                       aria-label="@SearchPlaceholder" />
            </label>
            <div class="vpp-history-select vpp-history-detail-select" @onclick:stopPropagation>
                <button type="button"
                        class="vpp-history-select-trigger @(!string.IsNullOrEmpty(SelectedCategory) ? "is-active" : string.Empty)"
                        aria-haspopup="listbox"
                        aria-expanded="@(OpenFilterMenu == CategoryMenu)"
                        aria-label="@CategoryAriaLabel"
                        title="@CategorySelectionLabel"
                        @onclick="@(() => FilterMenuToggled.InvokeAsync(CategoryMenu))"
                        @onclick:stopPropagation>
                    <span class="vpp-history-select-label">@CategorySelectionLabel</span>
                    <VppIcon Name="expand_more" />
                </button>
                @if (OpenFilterMenu == CategoryMenu)
                {
                    <div class="vpp-history-select-menu" role="listbox" @onclick:stopPropagation>
                        <button type="button" role="option" aria-selected="@string.IsNullOrEmpty(SelectedCategory)" @onclick="@(() => CategorySelected.InvokeAsync(string.Empty))">@AllCategoriesLabel</button>
                        @foreach (var category in Categories)
                        {
                            <button type="button" role="option" aria-selected="@(SelectedCategory == category)" title="@category" @onclick="@(() => CategorySelected.InvokeAsync(category))">@category</button>
                        }
                    </div>
                }
            </div>
            <div class="vpp-history-select vpp-history-detail-select" @onclick:stopPropagation>
                <button type="button"
                        class="vpp-history-select-trigger @(!string.IsNullOrEmpty(SelectedUnit) ? "is-active" : string.Empty)"
                        aria-haspopup="listbox"
                        aria-expanded="@(OpenFilterMenu == UnitMenu)"
                        aria-label="@EffectiveUnitHeaderLabel"
                        title="@UnitSelectionLabel"
                        @onclick="@(() => FilterMenuToggled.InvokeAsync(UnitMenu))"
                        @onclick:stopPropagation>
                    <span class="vpp-history-select-label">@UnitSelectionLabel</span>
                    <VppIcon Name="expand_more" />
                </button>
                @if (OpenFilterMenu == UnitMenu)
                {
                    <div class="vpp-history-select-menu" role="listbox" @onclick:stopPropagation>
                        <button type="button" role="option" aria-selected="@string.IsNullOrEmpty(SelectedUnit)" @onclick="@(() => UnitSelected.InvokeAsync(string.Empty))">@AllUnitsLabel</button>
                        @foreach (var unit in Units)
                        {
                            <button type="button" role="option" aria-selected="@(SelectedUnit == unit)" title="@unit" @onclick="@(() => UnitSelected.InvokeAsync(unit))">@unit</button>
                        }
                    </div>
                }
            </div>
            <button type="button"
                    class="vpp-history-clear vpp-history-detail-clear @(HasFilters ? "is-active" : string.Empty)"
                    @onclick="FiltersCleared">
                <VppIcon Name="filter_alt_off" />
                @ClearFiltersLabel
            </button>
        </div>
    }

    @if (!IsHistoryDrawer && HasOpenTransientSurface)
    {
        <button type="button"
                class="vpp-order-items-transient-backdrop"
                aria-label="@Loc["Close"]"
                @onclick="TransientSurfacesClosed"></button>
    }

    <div class="@RegionClass">
    @if (Items.Count > 0)
    {
        <div class="vpp-history-detail-grid-header" aria-hidden="true">
            <span class="vpp-history-detail-grid-header-cell vpp-history-detail-number">#</span>
            <span class="vpp-history-detail-grid-header-cell vpp-history-detail-item">@Loc["HistoryItem"]</span>
            <span class="vpp-history-detail-grid-header-cell vpp-history-detail-category">@Loc["Category"]</span>
            <span class="vpp-history-detail-grid-header-cell vpp-history-detail-uom">@EffectiveUnitHeaderLabel</span>
            <span class="vpp-history-detail-grid-header-cell vpp-history-detail-quantity">@Loc["Quantity"]</span>
            <span class="vpp-history-detail-grid-header-cell vpp-history-detail-note-column">@Loc["Note"]</span>
        </div>
    }

    @if (Items.Count == 0 && TotalItemCount > 0)
    {
        <VppContentState State="VppContentStateKind.FilteredEmpty"
                         Icon="search_off"
                         Title="@Loc["HistoryNoItems"]"
                         Description="@Loc["HistoryNoItemsDescription"]"
                         Class="vpp-history-state-panel vpp-history-detail-empty" />
    }
    else
    {
        <RadzenDataGrid TItem="VppOrderDetailItem"
                        data-vpp-grid-region="true"
                        aria-label="@AriaLabel"
                        @ref="_grid"
                        Data="@Items"
                        AllowPaging="false"
                        AllowVirtualization="true"
                        VirtualizationOverscanCount="@VirtualizationOverscanCount"
                        AllowFiltering="false"
                        AllowSorting="false"
                        AllowColumnResize="false"
                        AllowAlternatingRows="false"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Horizontal"
                        Style="@GridStyle"
                        class="@GridClass">
            <EmptyTemplate>
                <div class="vpp-order-grid-empty">
                    @if (TotalItemCount > 0)
                    {
                        <span class="vpp-orders-empty-icon"><VppIcon Name="search_off" /></span>
                        <strong>@Loc["HistoryNoItems"]</strong>
                        <p>@Loc["HistoryNoItemsDescription"]</p>
                    }
                    else
                    {
                        <span class="vpp-orders-empty-icon"><VppIcon Name="@EmptyIcon" /></span>
                        <strong>@EmptyTitle</strong>
                        <p>@EmptyDescription</p>
                        @if (HasEmptyAction)
                        {
                            <RadzenButton Text="@EmptyActionText"
                                          Icon="@VppIcons.Add"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Click="@(async _ => await EmptyActionClick.InvokeAsync())"
                                          data-testid="@($"{TestId}-empty-action")" />
                        }
                    }
                </div>
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn TItem="VppOrderDetailItem"
                                      Title="#"
                                      Width="@NumberColumnWidth"
                                      TextAlign="TextAlign.Center"
                                      CssClass="@HistoryNumberClass"
                                      HeaderCssClass="@HistoryNumberClass">
                    <Template Context="item">@item.Number</Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="VppOrderDetailItem"
                                      Property="Name"
                                      Title="@ItemHeaderLabel"
                                      TextAlign="TextAlign.Left"
                                      CssClass="@HistoryItemClass"
                                      HeaderCssClass="@HistoryItemClass">
                    <Template Context="item">
                        <div class="vpp-history-item-line">
                                <strong class="vpp-history-item-name" title="@item.Name">@item.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Code))
                                {
                                    <button type="button"
                                            class="vpp-history-detail-code"
                                            aria-haspopup="dialog"
                                            aria-expanded="@(ActiveCode == item.Code)"
                                            aria-label="@($"{Loc["ItemCode"]}: {item.Code}")"
                                            title="@item.Code"
                                            @onclick="@(() => CodeToggled.InvokeAsync(item.Code!))"
                                            @onclick:stopPropagation>
                                        @item.Code
                                    </button>
                                    @if (ActiveCode == item.Code)
                                    {
                                        <span class="vpp-history-detail-code-popover" role="dialog" aria-label="@Loc["ItemCode"]" @onclick:stopPropagation>
                                            <span class="vpp-history-popover-value">@item.Code</span>
                                            <button type="button" class="vpp-history-popover-copy" title="@Loc["Copy"]" aria-label="@Loc["Copy"]" @onclick="@(() => CopyRequested.InvokeAsync(item.Code))" @onclick:stopPropagation>
                                                <VppIcon Name="filter_none" />
                                            </button>
                                        </span>
                                    }
                                }
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="VppOrderDetailItem"
                                      Property="CategoryName"
                                      Title="@Loc["Category"]"
                                      Width="@CategoryColumnWidth"
                                      TextAlign="TextAlign.Left"
                                      CssClass="@HistoryCategoryClass"
                                      HeaderCssClass="@HistoryCategoryClass">
                    <Template Context="item">
                        <span class="vpp-history-cell-ellipsis" title="@item.CategoryName">@item.CategoryName</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="VppOrderDetailItem"
                                      Property="UomName"
                                      Title="@EffectiveUnitHeaderLabel"
                                      Width="@UnitColumnWidth"
                                      TextAlign="TextAlign.Center"
                                      CssClass="@HistoryUnitClass"
                                      HeaderCssClass="@HistoryUnitClass" />

                <RadzenDataGridColumn TItem="VppOrderDetailItem"
                                      Property="Quantity"
                                      Title="@Loc["Quantity"]"
                                      Width="@QuantityColumnWidth"
                                      TextAlign="TextAlign.Right"
                                      CssClass="@HistoryQuantityClass"
                                      HeaderCssClass="@HistoryQuantityClass">
                    <Template Context="item">
                        <span class="vpp-history-number">@FormatNumber(item.Quantity)</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="VppOrderDetailItem"
                                      Property="Note"
                                      Title="@Loc["Note"]"
                                      Width="@NoteColumnWidth"
                                      TextAlign="TextAlign.Left"
                                      Visible="@ShowNoteColumn"
                                      CssClass="@HistoryNoteClass"
                                      HeaderCssClass="@HistoryNoteClass">
                    <Template Context="item">
                        @if (string.IsNullOrWhiteSpace(item.Note))
                        {
                            <span class="vpp-history-note">–</span>
                        }
                        else
                        {
                            <div class="vpp-history-note-cell">
                                    <button type="button"
                                            class="vpp-history-note vpp-history-note-trigger"
                                            aria-haspopup="dialog"
                                            aria-expanded="@(ActiveNoteNumber == item.Number)"
                                            title="@item.Note"
                                            @onclick="@(() => NoteToggled.InvokeAsync(item.Number))"
                                            @onclick:stopPropagation>
                                        @item.Note
                                    </button>
                                    @if (ActiveNoteNumber == item.Number)
                                    {
                                        <div class="vpp-history-note-popover" role="dialog" aria-label="@Loc["Note"]" @onclick:stopPropagation>
                                            <span class="vpp-history-popover-value">@item.Note</span>
                                            <button type="button" class="vpp-history-popover-copy" title="@Loc["Copy"]" aria-label="@Loc["Copy"]" @onclick="@(() => CopyRequested.InvokeAsync(item.Note))" @onclick:stopPropagation>
                                                <VppIcon Name="filter_none" />
                                            </button>
                                        </div>
                                    }
                            </div>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</div>

@if (IsHistoryDrawer || TotalItemCount > 0)
{
    <footer class="@FooterClass">
        @Loc["HistoryDetailCount", Items.Count, TotalItemCount]
    </footer>
}
</section>

@code {
    [Parameter] public VppOrderItemsSurfaceVariant Variant { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<VppOrderDetailItem> Items { get; set; } = [];
    [Parameter] public int TotalItemCount { get; set; }
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public string? UnitHeaderLabel { get; set; }
    [Parameter] public string TestId { get; set; } = "order-items-surface";
    [Parameter] public string EmptyIcon { get; set; } = VppIcons.Orders;
    [Parameter] public string EmptyTitle { get; set; } = string.Empty;
    [Parameter] public string EmptyDescription { get; set; } = string.Empty;
    [Parameter] public string? EmptyActionText { get; set; }
    [Parameter] public EventCallback EmptyActionClick { get; set; }
    [Parameter] public string? ActiveCode { get; set; }
    [Parameter] public int? ActiveNoteNumber { get; set; }
    [Parameter] public EventCallback<string> CodeToggled { get; set; }
    [Parameter] public EventCallback<int> NoteToggled { get; set; }
    [Parameter] public EventCallback<string?> CopyRequested { get; set; }
    [Parameter] public bool ShowFilters { get; set; } = true;
    [Parameter] public IReadOnlyList<string> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Units { get; set; } = [];
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public string SelectedCategory { get; set; } = string.Empty;
    [Parameter] public string SelectedUnit { get; set; } = string.Empty;
    [Parameter] public string OpenFilterMenu { get; set; } = string.Empty;
    [Parameter] public bool HasFilters { get; set; }
    [Parameter] public string? SearchPlaceholder { get; set; }
    [Parameter] public string? FiltersAriaLabel { get; set; }
    [Parameter] public string? CategoryAriaLabel { get; set; }
    [Parameter] public string? AllCategoriesText { get; set; }
    [Parameter] public string? AllUnitsText { get; set; }
    [Parameter] public string? ClearFiltersText { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> SearchChanged { get; set; }
    [Parameter] public EventCallback<string> FilterMenuToggled { get; set; }
    [Parameter] public EventCallback<string> CategorySelected { get; set; }
    [Parameter] public EventCallback<string> UnitSelected { get; set; }
    [Parameter] public EventCallback FiltersCleared { get; set; }
    [Parameter] public EventCallback TransientSurfacesClosed { get; set; }

    private RadzenDataGrid<VppOrderDetailItem>? _grid;
    private bool IsHistoryDrawer => Variant == VppOrderItemsSurfaceVariant.HistoryDrawer;
    private bool HasEmptyAction => !string.IsNullOrWhiteSpace(EmptyActionText) && EmptyActionClick.HasDelegate;
    private const string CategoryMenu = "category";
    private const string UnitMenu = "uom";
    private bool ShowNoteColumn => true;
    private bool HasOpenTransientSurface => !string.IsNullOrEmpty(OpenFilterMenu) || !string.IsNullOrEmpty(ActiveCode) || ActiveNoteNumber.HasValue;
    private int VirtualizationOverscanCount => IsHistoryDrawer ? 4 : 10;
    private string VariantClass => IsHistoryDrawer ? "is-history" : "is-workspace";
    private string RegionClass => "vpp-history-detail-grid-region vpp-order-items-grid-region";
    private string GridClass => "vpp-history-detail-grid vpp-order-items-grid";
    private string GridStyle => "width: 100%;";
    private string FooterClass => "vpp-history-detail-footer vpp-order-items-footer";
    private string ItemHeaderLabel => Loc["HistoryItem"];
    private string EffectiveUnitHeaderLabel => string.IsNullOrWhiteSpace(UnitHeaderLabel) ? Loc["UOM"] : UnitHeaderLabel;
    private string CategorySelectionLabel => string.IsNullOrEmpty(SelectedCategory) ? AllCategoriesLabel : SelectedCategory;
    private string UnitSelectionLabel => string.IsNullOrEmpty(SelectedUnit) ? AllUnitsLabel : SelectedUnit;
    private string AllCategoriesLabel => AllCategoriesText ?? Loc["HistoryAllCategories"];
    private string AllUnitsLabel => AllUnitsText ?? Loc["HistoryAllUnits"];
    private string ClearFiltersLabel => ClearFiltersText ?? Loc["HistoryClearFilters"];
    private string NumberColumnWidth => "5%";
    private string CategoryColumnWidth => "18%";
    private string UnitColumnWidth => "12%";
    private string QuantityColumnWidth => "14%";
    private string NoteColumnWidth => "20%";
    private string HistoryNumberClass => "vpp-history-detail-number";
    private string HistoryItemClass => "vpp-history-detail-item";
    private string HistoryCategoryClass => "vpp-history-detail-category";
    private string HistoryUnitClass => "vpp-history-detail-uom";
    private string HistoryQuantityClass => "vpp-history-detail-quantity";
    private string HistoryNoteClass => "vpp-history-detail-note-column";

    public async Task ReloadAsync()
    {
        if (_grid is not null)
        {
            await _grid.Reload();
        }
    }

    private static string FormatNumber(int value) => value.ToString("N0", CultureInfo.CurrentCulture);
}
