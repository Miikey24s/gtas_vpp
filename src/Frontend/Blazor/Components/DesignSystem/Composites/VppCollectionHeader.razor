<header class="vpp-collection-header @Class" data-vpp-collection-header="true">
    <div class="vpp-collection-header-copy">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <span>@Summary</span>
        }
    </div>

    @if (AddClicked.HasDelegate)
    {
        <button type="button"
                class="vpp-collection-header-add vpp-library-primary-action"
                disabled="@Disabled"
                title="@EffectiveAddTitle"
                aria-label="@AddText"
                @onclick="AddClicked">
            <VppIcon Name="@VppIcons.Add" />
            <span class="vpp-collection-header-add-full">@AddText</span>
            <span class="vpp-collection-header-add-compact">@CompactAddText</span>
        </button>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string AddText { get; set; } = string.Empty;
    [Parameter] public string CompactAddText { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? DisabledReason { get; set; }
    [Parameter] public EventCallback AddClicked { get; set; }
    [Parameter] public string? Class { get; set; }

    private string EffectiveAddTitle => Disabled && !string.IsNullOrWhiteSpace(DisabledReason)
        ? DisabledReason
        : AddText;
}
