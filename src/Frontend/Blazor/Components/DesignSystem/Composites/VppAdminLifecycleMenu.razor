<VppAdminActionMenu Title="@Title"
                    Items="@MenuItems"
                    Disabled="@Disabled"
                    AllowOpenWhenAllDisabled="true"
                    TestId="@TestId" />

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string RestoreText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DeactivateText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HardDeleteText { get; set; } = string.Empty;
    [Parameter] public bool IsDeleted { get; set; }
    [Parameter] public bool CanToggle { get; set; }
    [Parameter] public bool CanHardDelete { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ToggleDisabledReason { get; set; }
    [Parameter] public string? HardDeleteDisabledReason { get; set; }
    [Parameter] public EventCallback<bool> DeletedChanged { get; set; }
    [Parameter] public EventCallback HardDeleteRequested { get; set; }
    [Parameter] public string? TestId { get; set; }

    private IReadOnlyList<VppAdminActionMenuItem> MenuItems =>
    [
        new(
            "toggle-active",
            IsDeleted ? RestoreText : DeactivateText,
            IsDeleted ? "restore_from_trash" : "block",
            async () => await DeletedChanged.InvokeAsync(!IsDeleted),
            !CanToggle,
            DisabledReason: ToggleDisabledReason ?? Loc["RequestActionUnavailable"].Value),
        new(
            "hard-delete",
            HardDeleteText,
            "delete_forever",
            async () => await HardDeleteRequested.InvokeAsync(),
            !CanHardDelete,
            VppAdminActionTone.Danger,
            HardDeleteDisabledReason ?? Loc["RequestActionUnavailable"].Value)
    ];
}
