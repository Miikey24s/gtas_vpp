@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@using System.Globalization

<span @ref="root" class="vpp-period-picker-host">
    @if (IsOpen)
    {
        <section class="vpp-period-picker-popover vpp-transient-surface @(IsRange ? "is-range" : "is-single")"
                 role="dialog"
                 aria-label="@Title"
                 @onclick:stopPropagation>
            <header>
                <div>
                    <h2>@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Summary))
                    {
                        <p>@Summary</p>
                    }
                </div>
                <button type="button"
                        class="vpp-period-picker-close"
                        title="@CancelText"
                        aria-label="@CancelText"
                        @onclick="CancelAsync">
                    <VppIcon Name="@VppIcons.Close" />
                </button>
            </header>

            <div class="vpp-period-picker-fields">
                <div class="vpp-period-picker-field" role="group" aria-label="@StartLabel">
                    <span class="vpp-period-picker-label">@StartLabel</span>
                    <div class="vpp-period-picker-selects">
                        <VppFilterSelect TValue="int"
                                         Value="@StartMonth"
                                         Options="@MonthOptions"
                                         ValueChanged="@OnStartMonthChangedAsync"
                                         Active="false"
                                         Placeholder="@Loc["Month"]"
                                         AriaLabel="@($"{StartLabel} · {Loc["Month"]}")" />
                        <VppFilterSelect TValue="int"
                                         Value="@StartYear"
                                         Options="@YearOptions"
                                         ValueChanged="@OnStartYearChangedAsync"
                                         Active="false"
                                         Placeholder="@Loc["Year"]"
                                         AriaLabel="@($"{StartLabel} · {Loc["Year"]}")" />
                    </div>
                </div>

                @if (IsRange)
                {
                    <span class="vpp-period-picker-separator" aria-hidden="true">→</span>
                    <div class="vpp-period-picker-field" role="group" aria-label="@EndLabel">
                        <span class="vpp-period-picker-label">@EndLabel</span>
                        <div class="vpp-period-picker-selects">
                            <VppFilterSelect TValue="int"
                                             Value="@EndMonth"
                                             Options="@MonthOptions"
                                             ValueChanged="@OnEndMonthChangedAsync"
                                             Active="false"
                                             Placeholder="@Loc["Month"]"
                                             AriaLabel="@($"{EndLabel} · {Loc["Month"]}")" />
                            <VppFilterSelect TValue="int"
                                             Value="@EndYear"
                                             Options="@YearOptions"
                                             ValueChanged="@OnEndYearChangedAsync"
                                             Active="false"
                                             Placeholder="@Loc["Year"]"
                                             AriaLabel="@($"{EndLabel} · {Loc["Year"]}")" />
                        </div>
                    </div>
                }
            </div>

            <footer>
                <button type="button" class="vpp-period-picker-secondary" @onclick="CancelAsync">@CancelText</button>
                <button type="button" class="vpp-period-picker-primary" disabled="@(!CanApply)" @onclick="ApplyAsync">@ApplyText</button>
            </footer>
        </section>
    }
</span>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsRange { get; set; } = true;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Summary { get; set; }
    [Parameter, EditorRequired] public string StartLabel { get; set; } = string.Empty;
    [Parameter] public string EndLabel { get; set; } = string.Empty;
    [Parameter] public string StartValue { get; set; } = string.Empty;
    [Parameter] public string EndValue { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ApplyText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CancelText { get; set; } = string.Empty;
    [Parameter] public EventCallback<ChangeEventArgs> StartChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> EndChanged { get; set; }
    [Parameter] public EventCallback Applied { get; set; }
    [Parameter] public EventCallback Dismissed { get; set; }
    [Parameter] public int? MinYear { get; set; }
    [Parameter] public int? MaxYear { get; set; }

    private ElementReference root;
    private IJSObjectReference? module;
    private DotNetObjectReference<VppPeriodPickerPopover>? dotNetReference;
    private bool isObserving;

    private bool CanApply => IsValidMonth(StartValue)
        && (!IsRange || (IsValidMonth(EndValue) && string.CompareOrdinal(StartValue, EndValue) <= 0));
    private int StartMonth => ParsePeriod(StartValue).Month;
    private int StartYear => ParsePeriod(StartValue).Year;
    private int EndMonth => ParsePeriod(EndValue).Month;
    private int EndYear => ParsePeriod(EndValue).Year;
    private int EffectiveMinYear => Math.Min(MinYear ?? (DateTime.Today.Year - 10), EffectiveMaxYear);
    private int EffectiveMaxYear => Math.Max(MaxYear ?? (DateTime.Today.Year + 1), DateTime.Today.Year);
    private IReadOnlyList<VppFilterOption<int>> MonthOptions => Enumerable.Range(1, 12)
        .Select(month => new VppFilterOption<int>(month, $"{Loc["Month"]} {month:00}"))
        .ToArray();
    private IReadOnlyList<VppFilterOption<int>> YearOptions => Enumerable.Range(
            EffectiveMinYear,
            (EffectiveMaxYear - EffectiveMinYear) + 1)
        .Reverse()
        .Select(year => new VppFilterOption<int>(year, year.ToString(CultureInfo.InvariantCulture)))
        .ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !isObserving)
        {
            module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/DesignSystem/Composites/VppPeriodPickerPopover.razor.js");
            dotNetReference ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("observe", root, dotNetReference);
            isObserving = true;
        }
        else if (!IsOpen && isObserving && module is not null)
        {
            await module.InvokeVoidAsync("dispose", root);
            isObserving = false;
        }
    }

    [JSInvokable]
    public Task DismissFromJsAsync() => Dismissed.InvokeAsync();

    private Task ApplyAsync() => CanApply ? Applied.InvokeAsync() : Task.CompletedTask;

    private Task CancelAsync() => Dismissed.InvokeAsync();

    private Task OnStartMonthChangedAsync(int month) => PublishPeriodAsync(StartChanged, StartYear, month);

    private Task OnStartYearChangedAsync(int year) => PublishPeriodAsync(StartChanged, year, StartMonth);

    private Task OnEndMonthChangedAsync(int month) => PublishPeriodAsync(EndChanged, EndYear, month);

    private Task OnEndYearChangedAsync(int year) => PublishPeriodAsync(EndChanged, year, EndMonth);

    private static Task PublishPeriodAsync(EventCallback<ChangeEventArgs> callback, int year, int month)
        => callback.InvokeAsync(new ChangeEventArgs
        {
            Value = $"{year:0000}-{month:00}"
        });

    private static bool IsValidMonth(string value)
        => DateTime.TryParseExact(value, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out _);

    private static (int Year, int Month) ParsePeriod(string value)
        => DateTime.TryParseExact(value, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var period)
            ? (period.Year, period.Month)
            : (DateTime.Today.Year, DateTime.Today.Month);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                if (isObserving)
                {
                    await module.InvokeVoidAsync("dispose", root);
                }

                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        dotNetReference?.Dispose();
    }
}
