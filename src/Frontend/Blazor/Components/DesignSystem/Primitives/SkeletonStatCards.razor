<div class="vpp-skeleton-stat-grid" aria-hidden="true">
    @for (int i = 0; i < Cards; i++)
    {
        <article class="vpp-skeleton-stat-card">
            <span class="vpp-skeleton vpp-skeleton-stat-label"></span>
            <span class="vpp-skeleton vpp-skeleton-stat-value"></span>
        </article>
    }
</div>

@code {
    [Parameter] public int Cards { get; set; } = 4;
}
