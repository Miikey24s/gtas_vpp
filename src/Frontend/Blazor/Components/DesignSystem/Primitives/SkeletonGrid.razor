<div class="vpp-skeleton-grid" aria-hidden="true">
    <div class="vpp-skeleton-grid-header">
        <span class="vpp-skeleton vpp-skeleton-grid-heading"></span>
        <span class="vpp-skeleton vpp-skeleton-grid-action"></span>
    </div>
    @for (int i = 0; i < Rows; i++)
    {
        <div class="vpp-skeleton-grid-row">
            @for (int j = 0; j < Cols; j++)
            {
                var widthClass = j == 0 ? "is-wide" : j == Cols - 1 ? "is-short" : "is-medium";
                <span class="vpp-skeleton vpp-skeleton-grid-cell @widthClass"></span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Rows { get; set; } = 5;
    [Parameter] public int Cols { get; set; } = 4;
}
