<span class="@CssClass" aria-hidden="true">
    <img src="images/vpp-app-icon.svg" alt="" draggable="false" />
</span>

@code {
    [Parameter]
    public string? Class { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "vpp-brand-mark"
        : $"vpp-brand-mark {Class}";
}
