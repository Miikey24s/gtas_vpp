<div class="@RootClass"
     data-vpp-workspace-pattern="operation"
     aria-busy="@IsBusy"
     aria-labelledby="@LabelledBy">
    @Header
    @Steps
    @Summary
    @ChildContent
    @Actions
</div>

@code {
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Steps { get; set; }
    [Parameter] public RenderFragment? Summary { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public VppWorkspaceGap Gap { get; set; } = VppWorkspaceGap.Standard;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? LabelledBy { get; set; }
    [Parameter] public string? Class { get; set; }

    private string RootClass => $"vpp-operation-workspace-pattern is-gap-{Gap.ToString().ToLowerInvariant()} {Class}";
}
