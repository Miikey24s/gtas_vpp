<div class="@RootClass" data-vpp-workspace-pattern="list-detail">
    <div class="vpp-list-detail-workspace-list @ListClass">
        @List
    </div>
    <aside class="vpp-list-detail-workspace-detail @DetailClass"
           aria-live="@(AnnounceDetailChanges ? "polite" : null)"
           aria-label="@DetailLabel">
        @Detail
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? List { get; set; }
    [Parameter, EditorRequired] public RenderFragment? Detail { get; set; }
    [Parameter] public VppListDetailRatio Ratio { get; set; } = VppListDetailRatio.Standard;
    [Parameter] public bool AnnounceDetailChanges { get; set; } = true;
    [Parameter] public string? DetailLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? ListClass { get; set; }
    [Parameter] public string? DetailClass { get; set; }

    private string RootClass => $"vpp-list-detail-workspace is-ratio-{Ratio.ToString().ToLowerInvariant()} {Class}";
}
