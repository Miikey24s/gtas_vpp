<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="OnNavigateAsync">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <VppContentState State="VppContentStateKind.Denied"
                                         FillAvailable="true"
                                         Icon="lock"
                                         Title="@Loc["AccessDenied"]"
                                         Description="@Loc["NoPermission"]"
                                         SecondaryActionText="@Loc["BackToAllowedPage"]"
                                         SecondaryActionHref="/" />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
