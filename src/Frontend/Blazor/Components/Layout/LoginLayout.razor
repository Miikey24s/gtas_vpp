@attribute [AllowAnonymous]
@inherits LayoutComponentBase

<RadzenComponents />

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @Body
    </ChildContent>
    <ErrorContent>
        <main class="vpp-system-page">
            <VppContentState State="VppContentStateKind.Error"
                             Icon="error_outline"
                             Title="@Loc["ErrorPageTitle"]"
                             Description="@Loc["ErrorPageDescription"]"
                             SecondaryActionText="@Loc["Login"]"
                             SecondaryActionHref="@Config.LoginPagePath" />
        </main>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
}
