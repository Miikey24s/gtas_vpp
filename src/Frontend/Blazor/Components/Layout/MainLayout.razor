@attribute [Authorize]
@inherits LayoutComponentBase
@using gtas_vpp_fe.Features.Notifications.State
@using gtas_vpp_fe.Services
@inject PermissionRealtimeService PermissionRealtime
@inject NotificationInboxState NotificationInbox
@inject ILogger<MainLayout> Logger

<RadzenComponents />

<a class="vpp-skip-link" href="#main-content">@Loc["SkipToContent"]</a>
<RadzenLayout class="vpp-layout">
    <LeftSidebar />
    <RadzenBody class="vpp-layout-body">
        <div id="main-content" class="vpp-content" role="main" tabindex="-1">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <VppContentState State="VppContentStateKind.Error"
                                     FillAvailable="true"
                                     Icon="error_outline"
                                     Title="@Loc["ErrorPageTitle"]"
                                     Description="@Loc["ErrorPageDescription"]"
                                     PrimaryActionText="@Loc["Retry"]"
                                     PrimaryActionIcon="@VppIcons.Reset"
                                     PrimaryAction="@RecoverFromError"
                                     SecondaryActionText="@Loc["BackToDashboard"]"
                                     SecondaryActionHref="/" />
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await PermissionRealtime.StartAsync();
        }
        catch (Exception ex)
        {
            // Backend authorization vẫn kiểm tra mọi API call. Realtime chỉ tăng tốc
            // refresh UI, nên sự cố hub tạm thời không được làm hỏng page.
            Logger.LogWarning(ex, "Permission realtime connection is unavailable.");
        }

        try
        {
            await NotificationInbox.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Notification inbox could not be initialized.");
        }
    }
}

