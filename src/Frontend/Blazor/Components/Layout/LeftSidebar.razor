@inject AuthenticationStateProvider AuthenticationStateProvider
@using Radzen.Blazor.Rendering
@using gtas_vpp_shared.Constants
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStore

<RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Visible=@BusyState.IsBusy AriaLabel="Loading progress" class="vpp-global-loader" />

<RadzenHeader class="vpp-header-glass vpp-layout-header">
    <RadzenStack Orientation="Orientation.Horizontal" class="vpp-header-row">
        <button type="button"
                class="vpp-mobile-sidebar-toggle"
                title="@Loc["ToggleNavigation"]"
                aria-label="@Loc["ToggleNavigation"]"
                aria-expanded="@_sideBarExpanded"
                @onclick="@(() => SetSidebarExpandedAsync(!_sideBarExpanded))">
            <VppIcon Name="@VppIcons.Menu" />
        </button>
        @if (HeaderTabs.Count > 0)
        {
            <nav class="vpp-header-tabs" aria-label="@Loc["SectionNavigation"]">
                @foreach (var headerTab in HeaderTabs)
                {
                    @if (headerTab.IsExpanded)
                    {
                        <VppHeaderTabGroup ParentLabel="@headerTab.Label"
                                           Tabs="@(headerTab.Children!)" />
                    }
                    else
                    {
                        <a class="vpp-header-tab @(headerTab.IsActive ? "is-active" : string.Empty)"
                           href="@headerTab.Path"
                           aria-current="@(headerTab.IsActive ? "page" : null)">
                            @headerTab.Label
                        </a>
                    }
                }
            </nav>
        }
    </RadzenStack>
</RadzenHeader>

@* FullHeight bắt buộc cho trục Atlas "brand + tab cùng hàng 72px": Radzen 11 áp
   grid-template-areas bằng selector :has() có specificity cao hơn vpp-layout.css,
   nên thiếu FullHeight thì theme sẽ đặt header tràn hết bề ngang phía trên sidebar
   (header left = 0, brand rơi xuống y = 72 + 36). Với FullHeight="true" theme sinh
   "rz-sidebar rz-header" / "rz-sidebar rz-body" — đúng template mà vpp-layout.css mô tả. *@
<RadzenSidebar Responsive="true" FullHeight="true" class="@GetSidebarClass()" data-shell-ready="@(_shellStateReady ? "true" : "false")" Style="@(_sideBarExpanded ? "width: var(--vpp-sidebar-width);" : "width: var(--vpp-sidebar-collapsed-width);")">
    <div class="vpp-sidebar-header">
        <div class="vpp-sidebar-expanded-chrome" aria-hidden="@(!_sideBarExpanded)">
            <div class="vpp-sidebar-expanded-brand" aria-label="GTAS VPP">
                <VppBrandMark Class="vpp-sidebar-brand-mark vpp-sidebar-expanded-logo" />
                <span class="vpp-sidebar-product">GTAS VPP</span>
            </div>
            <div class="vpp-sidebar-header-actions">
                @if (HasExpandableSidebarGroups)
                {
                    <button type="button"
                            class="vpp-sidebar-tree-toggle"
                            title="@SidebarTreeToggleLabel"
                            aria-label="@SidebarTreeToggleLabel"
                            aria-pressed="@(AreAllSidebarGroupsExpanded ? "true" : "false")"
                            tabindex="@(_sideBarExpanded ? "0" : "-1")"
                            @onclick="ToggleAllSidebarGroups">
                        <VppIcon Name="@(AreAllSidebarGroupsExpanded ? VppIcons.CollapseAll : VppIcons.ExpandAll)" />
                    </button>
                }
                <button type="button"
                        class="vpp-sidebar-toggle"
                        title="@Loc["ToggleNavigation"]"
                        aria-label="@Loc["ToggleNavigation"]"
                        aria-expanded="true"
                        tabindex="@(_sideBarExpanded ? "0" : "-1")"
                        @onclick="@(() => SetSidebarExpandedAsync(false))">
                    <VppIcon Name="@VppIcons.SidebarCollapse" />
                </button>
            </div>
        </div>
        <button type="button"
                class="vpp-sidebar-brand vpp-sidebar-collapsed-brand"
                title="@Loc["ToggleNavigation"]"
                aria-label="@Loc["ToggleNavigation"]"
                aria-expanded="false"
                aria-hidden="@_sideBarExpanded"
                tabindex="@(_sideBarExpanded ? "-1" : "0")"
                @onclick="@(() => SetSidebarExpandedAsync(true))">
            <VppBrandMark Class="vpp-sidebar-brand-mark vpp-sidebar-collapsed-logo" />
            <VppIcon Name="@VppIcons.SidebarExpand" Class="vpp-sidebar-collapsed-expand-icon" />
        </button>
    </div>
    <nav class="vpp-sidebar-nav" aria-label="@Loc["PrimaryNavigation"]">
        <RadzenPanelMenu DisplayStyle="@(_sideBarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="true" Multiple="true" Click="@OnMenuItemClick">
        @if (CanViewDashboardMenu)
        {
            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Dashboard.LabelKey]" Icon="@ShellNavigationCatalog.Dashboard.Icon" class="ppjsidebarmenu" title="@Loc[ShellNavigationCatalog.Dashboard.LabelKey]" @bind-Expanded="_dashboardMenuExpanded">
                @if (CanViewShellItem(ShellNavigationCatalog.MyOrders))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.MyOrders.LabelKey]" Path="@ShellNavigationCatalog.MyOrders.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.MyOrders.Icon" title="@Loc[ShellNavigationCatalog.MyOrders.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.History))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.History.LabelKey]" Path="@ShellNavigationCatalog.History.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.History.Icon" title="@Loc[ShellNavigationCatalog.History.LabelKey]" />
                }
                @* Tổng hợp toàn công ty nằm trong dữ liệu quản lý kỳ, không tạo thêm mục điều hướng. *@
                @if (CanViewShellItem(ShellNavigationCatalog.DepartmentSummary))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.DepartmentSummary.LabelKey]" Path="@ShellNavigationCatalog.DepartmentSummary.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.DepartmentSummary.Icon" title="@Loc[ShellNavigationCatalog.DepartmentSummary.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.Catalog))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Catalog.LabelKey]" Path="@ShellNavigationCatalog.Catalog.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Catalog.Icon" title="@Loc[ShellNavigationCatalog.Catalog.LabelKey]" />
                }
                @if (CanViewPeriodMenu)
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.PeriodOperations.LabelKey]" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.PeriodOperations.Icon" title="@Loc[ShellNavigationCatalog.PeriodOperations.LabelKey]" @bind-Expanded="_periodMenuExpanded">
                        @if (CanViewShellItem(ShellNavigationCatalog.PeriodReview))
                        {
                            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.PeriodReview.LabelKey]" Path="@ShellNavigationCatalog.PeriodReview.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.PeriodReview.Icon" title="@Loc[ShellNavigationCatalog.PeriodReview.LabelKey]" />
                        }
                        @if (CanViewShellItem(ShellNavigationCatalog.PendingApproval))
                        {
                            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.PendingApproval.LabelKey]" Path="@ShellNavigationCatalog.PendingApproval.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.PendingApproval.Icon" title="@Loc[ShellNavigationCatalog.PendingApproval.LabelKey]" />
                        }
                    </RadzenPanelMenuItem>
                }
            </RadzenPanelMenuItem>
        }
        @if (CanViewLibraryMenu)
        {
            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Library.LabelKey]" Icon="@ShellNavigationCatalog.Library.Icon" class="ppjsidebarmenu" title="@Loc[ShellNavigationCatalog.Library.LabelKey]" @bind-Expanded="_libraryMenuExpanded">
                @if (CanViewShellItem(ShellNavigationCatalog.Classes))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Classes.LabelKey]" Path="@ShellNavigationCatalog.Classes.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Classes.Icon" title="@Loc[ShellNavigationCatalog.Classes.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.Categories))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Categories.LabelKey]" Path="@ShellNavigationCatalog.Categories.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Categories.Icon" title="@Loc[ShellNavigationCatalog.Categories.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.Items))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Items.LabelKey]" Path="@ShellNavigationCatalog.Items.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Items.Icon" title="@Loc[ShellNavigationCatalog.Items.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.Suppliers))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Suppliers.LabelKey]" Path="@ShellNavigationCatalog.Suppliers.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Suppliers.Icon" title="@Loc[ShellNavigationCatalog.Suppliers.LabelKey]" />
                }
                @if (CanViewPricingMenu)
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Pricing.LabelKey]" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Pricing.Icon" title="@Loc[ShellNavigationCatalog.Pricing.LabelKey]" @bind-Expanded="_pricingMenuExpanded">
                        @if (CanViewShellItem(ShellNavigationCatalog.PriceLists))
                        {
                            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.PriceLists.LabelKey]" Path="@ShellNavigationCatalog.PriceLists.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.PriceLists.Icon" title="@Loc[ShellNavigationCatalog.PriceLists.LabelKey]" />
                        }
                        @if (CanViewShellItem(ShellNavigationCatalog.Prices))
                        {
                            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Prices.LabelKey]" Path="@ShellNavigationCatalog.Prices.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Prices.Icon" title="@Loc[ShellNavigationCatalog.Prices.LabelKey]" />
                        }
                    </RadzenPanelMenuItem>
                }
                @if (CanViewShellItem(ShellNavigationCatalog.Departments))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Departments.LabelKey]" Path="@ShellNavigationCatalog.Departments.Path" class="ppjsidebarmenu submenu" Icon="@ShellNavigationCatalog.Departments.Icon" title="@Loc[ShellNavigationCatalog.Departments.LabelKey]" />
                }
            </RadzenPanelMenuItem>
        }
        @if (CanViewReportMenu)
        {
            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Reports.LabelKey]" Icon="@ShellNavigationCatalog.Reports.Icon" class="ppjsidebarmenu" Path="@ShellNavigationCatalog.Reports.Path" title="@Loc[ShellNavigationCatalog.Reports.LabelKey]" />
        }
        @if (CanViewPermissionMenu)
        {
            <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Permission.LabelKey]" Icon="@ShellNavigationCatalog.Permission.Icon" class="ppjsidebarmenu" title="@Loc[ShellNavigationCatalog.Permission.LabelKey]" @bind-Expanded="_permissionMenuExpanded">
                @if (CanViewShellItem(ShellNavigationCatalog.Users))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.Users.LabelKey]" Icon="@ShellNavigationCatalog.Users.Icon" class="ppjsidebarmenu submenu" Path="@ShellNavigationCatalog.Users.Path" title="@Loc[ShellNavigationCatalog.Users.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.GroupsAndPermissions))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.GroupsAndPermissions.LabelKey]" Icon="@ShellNavigationCatalog.GroupsAndPermissions.Icon" class="ppjsidebarmenu submenu" Path="@ShellNavigationCatalog.GroupsAndPermissions.Path" title="@Loc[ShellNavigationCatalog.GroupsAndPermissions.LabelKey]" />
                }
                @if (CanViewShellItem(ShellNavigationCatalog.SecurityAudit))
                {
                    <RadzenPanelMenuItem Text="@Loc[ShellNavigationCatalog.SecurityAudit.LabelKey]" Icon="@ShellNavigationCatalog.SecurityAudit.Icon" class="ppjsidebarmenu submenu" Path="@ShellNavigationCatalog.SecurityAudit.Path" title="@Loc[ShellNavigationCatalog.SecurityAudit.LabelKey]" />
                }
            </RadzenPanelMenuItem>
        }
        </RadzenPanelMenu>
    </nav>
    <footer class="vpp-sidebar-user-footer">
        <UserMenu UserFullName="@CurrentUserState.Current?.FullName"
                  UserLogin="@CurrentUserState.Current?.UserLogin"
                  UserEmail="@CurrentUserState.Current?.Email"
                  SidebarSubline="@RoleBadgeLabel"
                  DepartmentName="@CurrentUserState.Current?.PrimaryDepartmentName"
                  DepartmentCode="@CurrentUserState.Current?.PrimaryDepartmentCode"
                  IsLightTheme="@LightTheme"
                  IsLightThemeChanged="@(isLight => LightTheme = isLight)"
                  OnThemeToggle="ThemeOnChange"
                  OnLanguageToggle="ToggleLanguage"
                  ShowName="true"
                  SidebarMode="true" />
    </footer>
</RadzenSidebar>
@if (_sideBarExpanded)
{
    <button type="button"
            class="vpp-sidebar-backdrop"
            title="@Loc["CloseNavigation"]"
            aria-label="@Loc["CloseNavigation"]"
            @onclick="@(() => SetSidebarExpandedAsync(false))"></button>
}
