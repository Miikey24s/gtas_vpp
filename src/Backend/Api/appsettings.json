{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "",
    "Issuer": "gtas_vpp_be",
    "Audience": "",
    "AccessTokenMinutes": 60
  },
  "VPP": {
    "DeadlineDay": 5,
    "SupplementApprovalGraceDays": 5,
    "MaxApprovedSupplements": 3,
    "MaxSupplementAttempts": 6,
    "PeriodRecoveryIntervalSeconds": 300
  },
  "ReportInsights": {
    "Enabled": false,
    "ProviderPriority": [
      "groq",
      "gemini",
      "ollama",
      "openai"
    ],
    "TimeoutSeconds": 20,
    "MaxOutputTokens": 700,
    "MaxProvidersPerRequest": 3,
    "Providers": {
      "Groq": {
        "Enabled": true,
        "BaseUrl": "https://api.groq.com/openai/v1",
        "Model": "qwen/qwen3-32b",
        "DailyRequestLimit": 100,
        "StructuredOutputMode": "json_object"
      },
      "Gemini": {
        "Enabled": true,
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "Model": "gemini-2.5-flash-lite",
        "DailyRequestLimit": 100,
        "StructuredOutputMode": "json_schema"
      },
      "Ollama": {
        "Enabled": false,
        "BaseUrl": "http://localhost:11434",
        "Model": "qwen3:8b",
        "DailyRequestLimit": 0,
        "StructuredOutputMode": "json_schema"
      },
      "OpenAI": {
        "Enabled": true,
        "BaseUrl": "https://api.openai.com",
        "Model": "gpt-5.6-luna",
        "DailyRequestLimit": 100,
        "StructuredOutputMode": "json_schema"
      }
    }
  },
  "EmailNotifications": {
    "Enabled": false,
    "RequireConfirmationWhenEnabled": true,
    "PublicBaseUrl": "https://gtas-vpp.annam.id.vn",
    "FromAddress": "noreply@gtas-vpp.local",
    "FromDisplayName": "GTAS VPP",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseSsl": false,
    "Username": "",
    "Password": ""
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://0.0.0.0:5001"
    ]
  }
}
