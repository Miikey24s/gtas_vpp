# ─────────────────────────────────────────────────────────────
# GTAS VPP – Environment Configuration (VPS Live Demo)
# Copy to .env and fill in production values:  cp .env.example .env
# Domain: gtas-vpp.annam.id.vn
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Database name: GTAS_VPP_LIVE (cả TestEnv + LiveEnv trỏ cùng DB này)
DB_SA_PASSWORD=Gtas!2026@Vpp
MSSQL_MEMORY_LIMIT_MB=1536

# ── JWT Authentication (tối thiểu 32 ký tự) ─────────────────
# Tạo key ngẫu nhiên: openssl rand -base64 48
JWT_KEY=CHANGE_THIS_TO_A_STRONG_PRODUCTION_KEY_MIN_32_CHARS

# ─────────────────────────────────────────────────────────────
# AI CONFIGURATION
# ─────────────────────────────────────────────────────────────
#
# OPTION A – Google AI (Khuyến nghị cho DigitalOcean)
#   Ưu điểm: Không tốn RAM, phản hồi nhanh, model mạnh
#   Khuyết: Cần API key, có giới hạn miễn phí
#   Lệnh:   docker compose up -d --build
#
# OPTION B – Self-hosted Ollama (CPU only)
#   Ưu điểm: Hoàn toàn miễn phí, offline
#   Khuyết: Chậm trên CPU, tốn ~3GB RAM, model yếu hơn
#   Lệnh:   docker compose --profile ollama up -d --build
#            docker exec gtas-vpp-ollama ollama pull gemma:2b
#            docker exec gtas-vpp-ollama ollama pull nomic-embed-text
# ─────────────────────────────────────────────────────────────

# Chọn provider: "Google" hoặc "Ollama"
AI_PROVIDER=Google

# ── Google AI Settings ───────────────────────────────────────
# ⚠️ Tạo key mới tại: https://aistudio.google.com/apikey
# ⚠️ KHÔNG dùng key cũ đã commit trong git!
# Hỗ trợ cấu hình nhiều API Key cách nhau bằng dấu phẩy (,) cho hệ thống Load Balancer
GEMINI_API_KEYS=AIzaSyB7_rFIJ0unEYOEW7Dln0q5GPfQVICDxxQ,AIzaSyCRB8k1z3dem-SZUeRpOJeePIgCSAbIa44,AIzaSyB2dorr6tyq-EaZNE25zM0Kv7_43MufbZQ,AIzaSyBzRfkVoiT6gmfp_-Yft4WcLm--igie5t4,AIzaSyBgKmhafw3yqHOZN1TliKdGREKPWuwSqQM,AIzaSyAnpk217Oir6D0Beh-Rsmp1zsg3YGpneT8,AIzaSyCRXpFIz4mIfeoV-qBhycQp3onF0X161kk,AIzaSyAU-ZSxAVD0Hicq0HYUUb7GG46gB37AR-I
GEMINI_API_ACCOUNTS=namveo04@gmail.com,annamnguyen04@gmail.com,annamnguyen204@gmail.com,miikeynguyen00@gmail.com,annamnguyen05@gmail.com,thuhuongvu3000@gmail.com,annamgaming04@gmail.com,annamnguyen40@gmail.com
AI_CHAT_MODEL=auto
AI_EMBEDDING_MODEL=text-embedding-004

# ── Ollama Settings (bỏ comment nếu dùng Ollama) ────────────
# AI_PROVIDER=Ollama
# AI_CHAT_MODEL=gemma:2b
# AI_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434

# ── AI General ───────────────────────────────────────────────
AI_TIMEOUT_SECONDS=60
